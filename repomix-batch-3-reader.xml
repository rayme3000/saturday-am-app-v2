  "directoryStructure": "src/\n  Components/\n    QuickReacts.tsx\n    RewardedAdModal.tsx\n    SeriesCommentsSection.tsx\n  MainViews/\n    Browse.tsx\n    CharacterRoster.tsx\n    MyFaves.tsx\n    SeriesDetailPage.tsx",
  "files": {
    "src/Components/RewardedAdModal.tsx": "import React, { useState, useEffect, useRef, useMemo } from 'react';\r\nimport {\r\n  X,\r\n  Play,\r\n  Volume2,\r\n  VolumeX,\r\n  ExternalLink,\r\n  Zap,\r\n  Lock,\r\n  CheckCircle2,\r\n  Sparkles,\r\n  Film\r\n} from 'lucide-react';\r\nimport { supabase, trackTelemetry } from '../supabase';\r\nimport {\r\n  DEFAULT_HOUSE_AD_CAMPAIGNS,\r\n  HouseAdVisualSlide,\r\n  loadSavedHouseAdCampaigns,\r\n  normalizeHouseAdVideoUrl\r\n} from '../AmCommandCenter/HouseAdBuilder';\r\nimport type { HouseAdCampaign } from '../AmCommandCenter/HouseAdBuilder';\r\n\r\nconst STORAGE_ENABLED_KEY = 'am_rewarded_ads_enabled_v2';\r\nconst STORAGE_ROTATION_KEY = 'am_house_ad_rotation_idx';\r\nconst GLOBAL_CONFIG_PATH = 'house-ads/global_config.json';\r\n\r\nexport const AD_UNLOCK_DURATION_MS = 12 * 60 * 60 * 1000; // 12 Hours\r\nexport const MAX_DAILY_AD_UNLOCKS = 3; // Max 3 ad unlocks per 24h rolling window\r\nconst LOCAL_UNLOCK_TIMESTAMPS_KEY = 'am_temp_unlock_timestamps_v2';\r\n\r\n// Helper: Read local unlock timestamps map { [chapterId]: timestampMs }\r\nexport const getLocalUnlockTimestamps = (): Record<string, number> => {\r\n  try {\r\n    const raw = localStorage.getItem(LOCAL_UNLOCK_TIMESTAMPS_KEY);\r\n    if (raw) {\r\n      const parsed = JSON.parse(raw);\r\n      if (parsed && typeof parsed === 'object') return parsed;\r\n    }\r\n  } catch {\r\n    // ignore\r\n  }\r\n  return {};\r\n};\r\n\r\n// Helper: Record a new chapter unlock timestamp locally\r\nexport const recordLocalChapterUnlock = (chapterId: string | number) => {\r\n  try {\r\n    const current = getLocalUnlockTimestamps();\r\n    current[String(chapterId)] = Date.now();\r\n    localStorage.setItem(LOCAL_UNLOCK_TIMESTAMPS_KEY, JSON.stringify(current));\r\n  } catch {\r\n    // ignore\r\n  }\r\n};\r\n\r\nexport const isRewardedAdsFeatureEnabled = (): boolean => {\r\n  try {\r\n    const raw = localStorage.getItem(STORAGE_ENABLED_KEY);\r\n    if (raw === 'true') return true;\r\n    if (raw === 'false') return false;\r\n  } catch {\r\n    // ignore\r\n  }\r\n  return false;\r\n};\r\n\r\nexport const setRewardedAdsFeatureEnabledLocal = (enabled: boolean) => {\r\n  try {\r\n    localStorage.setItem(STORAGE_ENABLED_KEY, enabled ? 'true' : 'false');\r\n    window.dispatchEvent(\r\n      new CustomEvent('rewardedAdsConfigChanged', { detail: { enabled } })\r\n    );\r\n  } catch {\r\n    // ignore\r\n  }\r\n};\r\n\r\nexport const syncRewardedAdsGlobalConfig = async (): Promise<{\r\n  enabled: boolean;\r\n  campaigns?: HouseAdCampaign[];\r\n}> => {\r\n  try {\r\n    const { data } = supabase.storage.from('assets').getPublicUrl(GLOBAL_CONFIG_PATH);\r\n    if (data?.publicUrl) {\r\n      const res = await fetch(`${data.publicUrl}?t=${Date.now()}`, { cache: 'no-store' });\r\n      if (res.ok) {\r\n        const json = await res.json();\r\n        const enabled = Boolean(json?.rewardedAdsEnabled);\r\n        localStorage.setItem(STORAGE_ENABLED_KEY, enabled ? 'true' : 'false');\r\n        if (Array.isArray(json?.campaigns) && json.campaigns.length > 0) {\r\n          localStorage.setItem('am_house_ad_campaigns_v2', JSON.stringify(json.campaigns));\r\n        }\r\n        return { enabled, campaigns: json?.campaigns };\r\n      }\r\n    }\r\n  } catch {\r\n    // Fallback to local storage state\r\n  }\r\n  return {\r\n    enabled: isRewardedAdsFeatureEnabled(),\r\n    campaigns: loadSavedHouseAdCampaigns()\r\n  };\r\n};\r\n\r\ninterface RewardedAdModalProps {\r\n  isOpen: boolean;\r\n  onClose: () => void;\r\n  onRewardEarned: () => void;\r\n  onUpgradeClick: () => void;\r\n  chapterNumber?: number | string;\r\n  seriesTitle?: string;\r\n  dailyUnlocksUsed?: number;\r\n  maxDailyUnlocks?: number;\r\n}\r\n\r\nexport const RewardedAdModal: React.FC<RewardedAdModalProps> = ({\r\n  isOpen,\r\n  onClose,\r\n  onRewardEarned,\r\n  onUpgradeClick,\r\n  chapterNumber,\r\n  seriesTitle,\r\n  dailyUnlocksUsed = 0,\r\n  maxDailyUnlocks = MAX_DAILY_AD_UNLOCKS\r\n}) => {\r\n  const [totalDuration, setTotalDuration] = useState<number>(15);\r\n  const [secondsLeft, setSecondsLeft] = useState<number>(15);\r\n  const [isCompleted, setIsCompleted] = useState<boolean>(false);\r\n  const [isMuted, setIsMuted] = useState<boolean>(false);\r\n  const [videoFailed, setVideoFailed] = useState<boolean>(false);\r\n  const [adSourceMode, setAdSourceMode] = useState<'checking_gam' | 'in_house'>('in_house');\r\n  const [activeCampaign, setActiveCampaign] = useState<HouseAdCampaign>(\r\n    () => DEFAULT_HOUSE_AD_CAMPAIGNS[0]\r\n  );\r\n\r\n  const videoRef = useRef<HTMLVideoElement | null>(null);\r\n  const hasLoggedCompletionRef = useRef<boolean>(false);\r\n\r\n  // Pick the next active campaign in rotation when the modal opens\r\n  useEffect(() => {\r\n    if (!isOpen) return;\r\n\r\n    const allCampaigns = loadSavedHouseAdCampaigns().filter(\r\n      c =>\r\n        c.enabled !== false &&\r\n        (c.placementMode === 'rewarded_unlock' ||\r\n          c.placementMode === 'both' ||\r\n          !c.placementMode)\r\n    );\r\n    const pool = allCampaigns.length > 0 ? allCampaigns : DEFAULT_HOUSE_AD_CAMPAIGNS;\r\n\r\n    let nextIdx = 0;\r\n    try {\r\n      const savedIdx = parseInt(localStorage.getItem(STORAGE_ROTATION_KEY) || '0', 10);\r\n      nextIdx = isNaN(savedIdx) ? 0 : savedIdx % pool.length;\r\n      localStorage.setItem(STORAGE_ROTATION_KEY, String((nextIdx + 1) % pool.length));\r\n    } catch {\r\n      nextIdx = 0;\r\n    }\r\n\r\n    const chosenCampaign = pool[nextIdx] || pool[0];\r\n    const durationSec = Math.max(5, Number(chosenCampaign?.rewardDurationSeconds) || 15);\r\n\r\n    setActiveCampaign(chosenCampaign);\r\n    setTotalDuration(durationSec);\r\n    setSecondsLeft(durationSec);\r\n    setIsCompleted(false);\r\n    setVideoFailed(false);\r\n    hasLoggedCompletionRef.current = false;\r\n\r\n    trackTelemetry('rewarded_ad_started', {\r\n      campaign_id: chosenCampaign?.id || 'default',\r\n      headline: chosenCampaign?.headline || '',\r\n      has_video: Boolean(chosenCampaign?.videoUrl),\r\n      series_title: seriesTitle || '',\r\n      chapter_number: String(chapterNumber || ''),\r\n      duration_seconds: durationSec\r\n    });\r\n\r\n    const win = window as any;\r\n    if (win.googletag && win.amGamRewardedSlotReady) {\r\n      setAdSourceMode('checking_gam');\r\n      const fallbackTimer = setTimeout(() => {\r\n        setAdSourceMode('in_house');\r\n      }, 2000);\r\n      return () => clearTimeout(fallbackTimer);\r\n    } else {\r\n      setAdSourceMode('in_house');\r\n    }\r\n  }, [isOpen, seriesTitle, chapterNumber]);\r\n\r\n  // Countdown Timer\r\n  useEffect(() => {\r\n    if (!isOpen || adSourceMode === 'checking_gam') return;\r\n\r\n    if (secondsLeft <= 0) {\r\n      setIsCompleted(true);\r\n      if (!hasLoggedCompletionRef.current) {\r\n        hasLoggedCompletionRef.current = true;\r\n        trackTelemetry('rewarded_ad_completed', {\r\n          campaign_id: activeCampaign?.id || 'default',\r\n          headline: activeCampaign?.headline || '',\r\n          has_video: Boolean(activeCampaign?.videoUrl),\r\n          series_title: seriesTitle || '',\r\n          chapter_number: String(chapterNumber || ''),\r\n          duration_seconds: totalDuration\r\n        });\r\n      }\r\n      return;\r\n    }\r\n\r\n    const timer = setInterval(() => {\r\n      setSecondsLeft(prev => {\r\n        if (prev <= 1) {\r\n          setIsCompleted(true);\r\n          return 0;\r\n        }\r\n        return prev - 1;\r\n      });\r\n    }, 1000);\r\n\r\n    return () => clearInterval(timer);\r\n  }, [isOpen, secondsLeft, adSourceMode, activeCampaign, seriesTitle, chapterNumber, totalDuration]);\r\n\r\n  const resolvedVideoUrl = useMemo(\r\n    () => normalizeHouseAdVideoUrl(activeCampaign?.videoUrl),\r\n    [activeCampaign?.videoUrl]\r\n  );\r\n\r\n  // Ensure video plays smoothly when modal opens (falls back to muted autoplay if browser blocks unmuted autoplay)\r\n  useEffect(() => {\r\n    if (!isOpen || !resolvedVideoUrl || videoFailed) return;\r\n    const vid = videoRef.current;\r\n    if (!vid) return;\r\n\r\n    vid.currentTime = 0;\r\n    const playPromise = vid.play();\r\n    if (playPromise !== undefined) {\r\n      playPromise.catch(() => {\r\n        setIsMuted(true);\r\n        if (videoRef.current) {\r\n          videoRef.current.muted = true;\r\n          videoRef.current.play().catch(() => {\r\n            setVideoFailed(true);\r\n          });\r\n        }\r\n      });\r\n    }\r\n  }, [isOpen, resolvedVideoUrl, videoFailed]);\r\n\r\n  const progressPercentage = useMemo(() => {\r\n    return Math.min(100, Math.max(0, ((totalDuration - secondsLeft) / Math.max(1, totalDuration)) * 100));\r\n  }, [secondsLeft, totalDuration]);\r\n\r\n  if (!isOpen) return null;\r\n\r\n  const remainingAfterThis = Math.max(0, maxDailyUnlocks - dailyUnlocksUsed - 1);\r\n  const hasActiveVideo = Boolean(resolvedVideoUrl && !videoFailed);\r\n\r\n  const zoom = (activeCampaign.cropZoom ?? 100) / 100;\r\n  const panX = activeCampaign.cropPanX ?? 50;\r\n  const panY = activeCampaign.cropPanY ?? 50;\r\n\r\n  const handleCtaClick = () => {\r\n    trackTelemetry('rewarded_ad_clicked', {\r\n      campaign_id: activeCampaign?.id || 'default',\r\n      headline: activeCampaign?.headline || '',\r\n      has_video: Boolean(resolvedVideoUrl),\r\n      click_url: activeCampaign?.clickUrl || '',\r\n      series_title: seriesTitle || '',\r\n      chapter_number: String(chapterNumber || '')\r\n    });\r\n\r\n    if (activeCampaign.actionType === 'in_app_plus_upgrade') {\r\n      onUpgradeClick();\r\n      return;\r\n    }\r\n    if (activeCampaign.clickUrl) {\r\n      window.open(activeCampaign.clickUrl, '_blank', 'noopener,noreferrer');\r\n    }\r\n  };\r\n\r\n  const handleClaimReward = () => {\r\n    trackTelemetry('rewarded_ad_unlock_claimed', {\r\n      campaign_id: activeCampaign?.id || 'default',\r\n      headline: activeCampaign?.headline || '',\r\n      has_video: Boolean(resolvedVideoUrl),\r\n      series_title: seriesTitle || '',\r\n      chapter_number: String(chapterNumber || '')\r\n    });\r\n    onRewardEarned();\r\n  };\r\n\r\n  return (\r\n    <div\r\n      className=\"fixed inset-0 z-[8500] bg-black/95 backdrop-blur-xl flex items-center justify-center p-4 sm:p-6 animate-fade-in\"\r\n      onClick={e => e.stopPropagation()}\r\n    >\r\n      <div className=\"w-full max-w-2xl bg-zinc-950 border-2 border-[#fe9a00]/60 rounded-3xl overflow-hidden shadow-[0_0_60px_rgba(254,154,0,0.2)] flex flex-col relative\">\r\n        {/* TOP STATUS HEADER BAR */}\r\n        <div className=\"px-4 sm:px-6 py-3.5 bg-zinc-900/90 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-2\">\r\n          <div className=\"flex items-center gap-2.5\">\r\n            <span className=\"px-2.5 py-1 rounded-md bg-[#fe9a00] text-black text-[9px] font-black uppercase tracking-widest flex items-center gap-1\">\r\n              {hasActiveVideo ? <Film className=\"w-3 h-3\" /> : <Sparkles className=\"w-3 h-3\" />}\r\n              {activeCampaign.badge || 'Saturday AM Spotlight'}\r\n            </span>\r\n            <span className=\"text-[10px] sm:text-xs font-black uppercase tracking-wider text-zinc-200\">\r\n              {isCompleted\r\n                ? `Chapter ${chapterNumber || ''} Unlocked (12h)!`\r\n                : `Unlocking Ch. ${chapterNumber || ''} in ${secondsLeft}s...`}\r\n            </span>\r\n          </div>\r\n\r\n          <div className=\"flex items-center gap-2.5\">\r\n            {/* Daily Ad Unlock Counter Pill */}\r\n            <span className=\"hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-black/80 border border-zinc-700 text-[9px] font-black uppercase tracking-widest text-zinc-300\">\r\n              <Zap className=\"w-3 h-3 text-[#fe9a00]\" />\r\n              Daily Unlocks: {Math.max(0, maxDailyUnlocks - dailyUnlocksUsed)}/{maxDailyUnlocks} Left\r\n            </span>\r\n\r\n            {hasActiveVideo && (\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => setIsMuted(prev => !prev)}\r\n                className=\"p-2 rounded-full bg-black/80 border border-zinc-700 text-zinc-300 hover:text-white hover:border-[#fe9a00] transition-colors cursor-pointer\"\r\n                title={isMuted ? 'Unmute Audio' : 'Mute Audio'}\r\n              >\r\n                {isMuted ? (\r\n                  <VolumeX className=\"w-4 h-4 text-zinc-400\" />\r\n                ) : (\r\n                  <Volume2 className=\"w-4 h-4 text-[#fe9a00]\" />\r\n                )}\r\n              </button>\r\n            )}\r\n\r\n            <button\r\n              type=\"button\"\r\n              onClick={onClose}\r\n              className=\"p-2 rounded-full bg-black/80 border border-zinc-700 text-zinc-400 hover:text-white transition-colors cursor-pointer\"\r\n              title=\"Close\"\r\n            >\r\n              <X className=\"w-4 h-4\" />\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        {/* 16:9 VIDEO OR VISUAL SPOTLIGHT STAGE */}\r\n        <div className=\"relative w-full aspect-video bg-black overflow-hidden\">\r\n          {hasActiveVideo ? (\r\n            <video\r\n              ref={videoRef}\r\n              key={resolvedVideoUrl}\r\n              src={resolvedVideoUrl}\r\n              autoPlay\r\n              playsInline\r\n              muted={isMuted}\r\n              loop\r\n              // @ts-expect-error referrerPolicy is supported in modern browsers for Imgur/CDN MP4s\r\n              referrerPolicy=\"no-referrer\"\r\n              onError={() => setVideoFailed(true)}\r\n              onClick={handleCtaClick}\r\n              className={`w-full h-full ${\r\n                (activeCampaign.cropZoom ?? 100) > 100 ? 'object-cover' : 'object-contain'\r\n              } cursor-pointer transition-transform duration-200`}\r\n              style={{\r\n                objectPosition: `${panX}% ${panY}%`,\r\n                transform: `scale(${zoom})`,\r\n                transformOrigin: `${panX}% ${panY}%`\r\n              }}\r\n            />\r\n          ) : (\r\n            <div onClick={handleCtaClick} className=\"w-full h-full cursor-pointer\">\r\n              <HouseAdVisualSlide ad={activeCampaign} />\r\n            </div>\r\n          )}\r\n\r\n          {/* Subtle Bottom Progress Bar */}\r\n          <div className=\"absolute bottom-0 left-0 right-0 h-1.5 bg-zinc-800/90 z-30\">\r\n            <div\r\n              className=\"h-full bg-gradient-to-r from-[#fe9a00] to-yellow-400 transition-all duration-1000 ease-linear\"\r\n              style={{ width: `${progressPercentage}%` }}\r\n            />\r\n          </div>\r\n        </div>\r\n\r\n        {/* CAMPAIGN INFO & ACTION FOOTER */}\r\n        <div className=\"p-4 sm:p-6 bg-zinc-950 border-t border-zinc-800 space-y-4\">\r\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-zinc-800/80\">\r\n            <div className=\"min-w-0\">\r\n              <p className=\"text-[9px] font-black uppercase tracking-widest text-[#fe9a00]\">\r\n                {activeCampaign.badge}\r\n              </p>\r\n              <h3 className=\"text-base sm:text-lg font-black italic uppercase tracking-tight text-white truncate\">\r\n                {activeCampaign.headline}\r\n              </h3>\r\n              <p className=\"text-xs text-zinc-400 font-bold truncate\">\r\n                {activeCampaign.subheadline}\r\n              </p>\r\n            </div>\r\n\r\n            <button\r\n              type=\"button\"\r\n              onClick={handleCtaClick}\r\n              className=\"px-4 py-2.5 rounded-xl bg-zinc-900 hover:bg-white text-[#fe9a00] hover:text-black border border-[#fe9a00]/50 font-black uppercase tracking-widest text-[10px] flex items-center justify-center gap-1.5 transition-all shrink-0 cursor-pointer\"\r\n            >\r\n              <span>{activeCampaign.ctaLabel || 'Learn More'}</span>\r\n              <ExternalLink className=\"w-3.5 h-3.5\" />\r\n            </button>\r\n          </div>\r\n\r\n          {/* PRIMARY UNLOCK OR UPGRADE ACTIONS */}\r\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3\">\r\n            <button\r\n              type=\"button\"\r\n              disabled={!isCompleted}\r\n              onClick={handleClaimReward}\r\n              className={`flex-1 py-3.5 px-5 rounded-xl font-black uppercase tracking-widest text-xs flex items-center justify-center gap-2 transition-all ${\r\n                isCompleted\r\n                  ? 'bg-[#fe9a00] hover:bg-white text-black shadow-[0_0_25px_rgba(254,154,0,0.4)] cursor-pointer'\r\n                  : 'bg-zinc-900 border border-zinc-800 text-zinc-500 cursor-not-allowed'\r\n              }`}\r\n            >\r\n              {isCompleted ? (\r\n                <>\r\n                  <CheckCircle2 className=\"w-4 h-4\" />\r\n                  <span>\r\n                    Read {seriesTitle ? `${seriesTitle} ` : ''}Ch. {chapterNumber} Now (12h Unlock)\r\n                  </span>\r\n                </>\r\n              ) : (\r\n                <>\r\n                  <Lock className=\"w-3.5 h-3.5 animate-pulse text-[#fe9a00]\" />\r\n                  <span>Wait {secondsLeft}s to Unlock Chapter (12h)...</span>\r\n                </>\r\n              )}\r\n            </button>\r\n\r\n            <button\r\n              type=\"button\"\r\n              onClick={onUpgradeClick}\r\n              className=\"py-3.5 px-4 rounded-xl bg-purple-950/50 hover:bg-purple-600 text-purple-200 hover:text-white border border-purple-500/40 font-black uppercase tracking-widest text-[10px] flex items-center justify-center gap-1.5 transition-all cursor-pointer shrink-0\"\r\n            >\r\n              <Play className=\"w-3 h-3 fill-current\" />\r\n              <span>Skip Ads • Go PLUS ($1.99)</span>\r\n            </button>\r\n          </div>\r\n\r\n          <div className=\"flex items-center justify-between text-[9px] font-bold text-zinc-500 uppercase tracking-widest pt-1\">\r\n            <span>12-Hour Chapter Access</span>\r\n            <span>\r\n              {isCompleted\r\n                ? `${remainingAfterThis} of ${maxDailyUnlocks} daily ad unlocks remaining after this`\r\n                : `Daily Unlocks Remaining Today: ${Math.max(0, maxDailyUnlocks - dailyUnlocksUsed)}/${maxDailyUnlocks}`}\r\n            </span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};",
    "src/MainViews/MyFaves.tsx": "import { useState, useEffect, useCallback } from 'react';\r\nimport { Search, ChevronRight, ArrowLeft, Play, Library, ChevronLeft } from 'lucide-react';\r\nimport { useSeriesData } from '../userSeriesData';\r\nimport { supabase } from '../supabase';\r\nimport { isChapterReleasedForUser, isActiveOneShotWednesday } from '../oneshotWednesday';\r\n\r\nconst CLOUDFLARE_BASE_URL = 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev';\r\n\r\nconst getPatternStyle = (color: string, pattern: string) => {\r\n  const baseColor = color || '#18181b';\r\n  const overlay = 'rgba(0,0,0,0.2)';\r\n  if (pattern === 'dots') return { backgroundColor: baseColor, backgroundImage: `radial-gradient(${overlay} 2px, transparent 2px)`, backgroundSize: '12px 12px' };\r\n  if (pattern === 'lines') return { backgroundColor: baseColor, backgroundImage: `repeating-linear-gradient(45deg, transparent, transparent 5px, ${overlay} 5px, ${overlay} 10px)` };\r\n  if (pattern === 'grid') return { backgroundColor: baseColor, backgroundImage: `linear-gradient(${overlay} 1px, transparent 1px), linear-gradient(90deg, ${overlay} 1px, transparent 1px)`, backgroundSize: '20px 20px' };\r\n  if (pattern === 'pinstripes') return { backgroundColor: baseColor, backgroundImage: `repeating-linear-gradient(45deg, ${overlay} 0, ${overlay} 1px, transparent 1px, transparent 8px)` };\r\n  if (pattern === 'mesh') return { backgroundColor: baseColor, backgroundImage: `linear-gradient(${overlay} 1px, transparent 1px), linear-gradient(90deg, ${overlay} 1px, transparent 1px)`, backgroundSize: '14px 14px' };\r\n  if (pattern === 'glow') return { backgroundColor: baseColor, backgroundImage: `radial-gradient(circle at 50% 0%, rgba(255,255,255,0.15) 0%, transparent 70%)` };\r\n  if (pattern === 'cut') return { backgroundColor: baseColor, backgroundImage: `linear-gradient(135deg, rgba(255,255,255,0.04) 50%, transparent 50%)` };\r\n  return { backgroundColor: baseColor };\r\n};\r\n\r\nexport const Favorites = ({ userTier = 'visitor', setActiveTab, onNavigate }: any) => {\r\n  const { seriesList = [], isLoading } = useSeriesData();\r\n  const [myFaves, setMyFaves] = useState<any[]>([]);\r\n  const [recentReads, setRecentReads] = useState<any[]>([]);\r\n  const [currentUser, setCurrentUser] = useState<any>(null);\r\n\r\n  const [activeIndex, setActiveIndex] = useState(0);\r\n  const [touchStartX, setTouchStartX] = useState(0);\r\n  const [touchEndX, setTouchEndX] = useState(0);\r\n\r\n  const isPlusSubscriber = userTier === 'premium';\r\n  const suggestedSeries = seriesList.filter((s: any) => !s.is_hidden).slice(0, 5);\r\n\r\n  const fetchUserData = useCallback(async () => {\r\n    const { data: { user } } = await supabase.auth.getUser();\r\n    if (!user) return;\r\n    setCurrentUser(user);\r\n\r\n    const [{ data: profile }, { data: history }] = await Promise.all([\r\n      supabase.from('profiles').select('favorites, is_premium').eq('id', user.id).maybeSingle(),\r\n      supabase.from('reading_history').select('*').eq('user_id', user.id).order('updated_at', { ascending: false })\r\n    ]);\r\n\r\n    const isPlus = isPlusSubscriber || Boolean(profile?.is_premium);\r\n\r\n    if (profile?.favorites && Array.isArray(profile.favorites) && seriesList.length > 0) {\r\n      const { data: chapterData } = await supabase\r\n        .from('chapters')\r\n        .select('series_slug, id, publish_at, is_published')\r\n        .eq('is_published', true);\r\n\r\n      const faves = seriesList\r\n        .filter((s: any) => !s.is_hidden && profile.favorites.includes(s.slug))\r\n        .map((s: any) => {\r\n          const isFreeOsw = isActiveOneShotWednesday(s, seriesList);\r\n          // Only count chapters that have actually released for this user tier!\r\n          const releasedChapters = (chapterData || []).filter(\r\n            (c: any) =>\r\n              c.series_slug === s.slug &&\r\n              c.is_published &&\r\n              (isFreeOsw || isChapterReleasedForUser(c.publish_at, isPlus))\r\n          );\r\n          const readChaptersForSeries = (history || []).filter((h: any) =>\r\n            releasedChapters.some((sc: any) => String(sc.id) === String(h.chapter_id))\r\n          );\r\n\r\n          const clearedCount = parseInt(localStorage.getItem(`cleared_updates_${s.slug}`) || '0', 10);\r\n          const hasUpdate =\r\n            releasedChapters.length > readChaptersForSeries.length &&\r\n            releasedChapters.length > clearedCount;\r\n\r\n          return {\r\n            ...s,\r\n            has_update: hasUpdate,\r\n            current_chapter_count: releasedChapters.length\r\n          };\r\n        });\r\n\r\n      setMyFaves(faves);\r\n      setActiveIndex(prev => (faves.length > 0 ? Math.min(prev, faves.length - 1) : 0));\r\n    } else {\r\n      setMyFaves([]);\r\n    }\r\n\r\n    if (history && history.length > 0 && seriesList.length > 0) {\r\n      const recentLimit = history.slice(0, 12);\r\n      const chapterIds = recentLimit.map((h: any) => h.chapter_id).filter(Boolean);\r\n\r\n      if (chapterIds.length > 0) {\r\n        const { data: chaptersData } = await supabase\r\n          .from('chapters')\r\n          .select('id, series_slug, chapter_number, title, thumbnail_url, is_published')\r\n          .in('id', chapterIds)\r\n          .eq('is_published', true);\r\n\r\n        const chapters = chaptersData || [];\r\n        const seenSeriesSlugs = new Set<string>();\r\n\r\n        const combined = recentLimit\r\n          .map((h: any) => {\r\n            const chap = chapters.find((c: any) => String(c.id) === String(h.chapter_id));\r\n            if (!chap) return null;\r\n            const series = seriesList.find((s: any) => s.slug === chap.series_slug && !s.is_hidden);\r\n            if (!series || seenSeriesSlugs.has(series.slug)) return null;\r\n            seenSeriesSlugs.add(series.slug);\r\n\r\n            return {\r\n              ...h,\r\n              type: 'series',\r\n              target: {\r\n                ...series,\r\n                autoOpenChapterId: chap.id,\r\n                autoOpenPage: h.page_index || 0\r\n              },\r\n              title: series.title,\r\n              subtitle: `Ch. ${chap.chapter_number}`,\r\n              image: chap.thumbnail_url || series.cover_url\r\n            };\r\n          })\r\n          .filter(Boolean);\r\n\r\n        setRecentReads(combined);\r\n      }\r\n    }\r\n  }, [seriesList, isPlusSubscriber]);\r\n\r\n  useEffect(() => {\r\n    fetchUserData();\r\n    window.addEventListener('seriesUpdated', fetchUserData);\r\n    window.addEventListener('vaultUpdated', fetchUserData);\r\n    window.addEventListener('progressUpdated', fetchUserData);\r\n    return () => {\r\n      window.removeEventListener('seriesUpdated', fetchUserData);\r\n      window.removeEventListener('vaultUpdated', fetchUserData);\r\n      window.removeEventListener('progressUpdated', fetchUserData);\r\n    };\r\n  }, [fetchUserData]);\r\n\r\n  const handleSeriesClick = (s: any) => {\r\n    if (s.has_update) {\r\n      localStorage.setItem(`cleared_updates_${s.slug}`, String(s.current_chapter_count || 0));\r\n      setMyFaves(prev =>\r\n        prev.map(fave => (fave.slug === s.slug ? { ...fave, has_update: false } : fave))\r\n      );\r\n    }\r\n    if (onNavigate) onNavigate(s);\r\n  };\r\n\r\n  const handleTouchStart = (e: React.TouchEvent) => {\r\n    setTouchStartX(e.targetTouches[0].clientX);\r\n  };\r\n\r\n  const handleTouchMove = (e: React.TouchEvent) => {\r\n    setTouchEndX(e.targetTouches[0].clientX);\r\n  };\r\n\r\n  const handleTouchEnd = () => {\r\n    if (!touchStartX || !touchEndX) return;\r\n    const distance = touchStartX - touchEndX;\r\n    if (distance > 50 && activeIndex < myFaves.length - 1) {\r\n      setActiveIndex(prev => prev + 1);\r\n    } else if (distance < -50 && activeIndex > 0) {\r\n      setActiveIndex(prev => prev - 1);\r\n    }\r\n    setTouchStartX(0);\r\n    setTouchEndX(0);\r\n  };\r\n\r\n  if (isLoading) {\r\n    return (\r\n      <div className=\"min-h-screen bg-transparent text-[#fe9a00] flex items-center justify-center font-black tracking-widest uppercase text-xs\">\r\n        Loading Bookshelf...\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-transparent text-white pb-32 relative overflow-x-hidden\">\r\n      <div className=\"sticky top-0 z-40 bg-black/90 backdrop-blur-xl px-4 pt-6 pb-4 border-b border-zinc-800 mb-8\">\r\n        <button\r\n          onClick={() => setActiveTab('home')}\r\n          className=\"mb-4 flex items-center gap-2 text-zinc-400 hover:text-white transition-colors cursor-pointer\"\r\n        >\r\n          <ArrowLeft className=\"w-5 h-5\" />\r\n          <span className=\"text-[10px] font-black uppercase tracking-widest\">Back</span>\r\n        </button>\r\n        <h1 className=\"text-3xl font-black italic uppercase tracking-tighter text-white pr-16\">\r\n          My Bookshelf\r\n        </h1>\r\n      </div>\r\n\r\n      <div className=\"px-4 max-w-6xl mx-auto\">\r\n        {myFaves.length === 0 ? (\r\n          <div className=\"flex flex-col items-center justify-center text-center py-16 px-4 mb-12 bg-zinc-900/60 rounded-2xl border border-zinc-800/80\">\r\n            <Library className=\"w-16 h-16 text-zinc-700 mb-4\" strokeWidth={1.5} />\r\n            <h2 className=\"text-xl font-bold mb-2\">Nothing saved yet!</h2>\r\n            <p className=\"text-zinc-400 text-sm mb-8 max-w-[260px]\">\r\n              Bookmark your favorite series to track new chapter drops right from your Bookshelf.\r\n            </p>\r\n            <button\r\n              onClick={() => setActiveTab('browse')}\r\n              className=\"flex items-center gap-2 bg-[#fe9a00] text-black font-black uppercase tracking-widest py-3 px-6 rounded-xl hover:bg-white transition-colors cursor-pointer\"\r\n            >\r\n              <Search className=\"w-4 h-4\" />\r\n              Browse Series\r\n            </button>\r\n          </div>\r\n        ) : (\r\n          <div className=\"mb-12\">\r\n            <div\r\n              className=\"relative h-[340px] sm:h-[460px] w-full flex items-center justify-center overflow-visible\"\r\n              onTouchStart={handleTouchStart}\r\n              onTouchMove={handleTouchMove}\r\n              onTouchEnd={handleTouchEnd}\r\n            >\r\n              {myFaves.map((s, idx) => {\r\n                const offset = idx - activeIndex;\r\n                const isCenter = offset === 0;\r\n                const isLeft = offset === -1;\r\n                const isRight = offset === 1;\r\n\r\n                let transformStyle = '';\r\n                let zIndex = 10;\r\n                let opacity = 'opacity-100';\r\n\r\n                if (isCenter) {\r\n                  transformStyle = 'translateX(0) scale(1)';\r\n                  zIndex = 30;\r\n                } else if (isLeft) {\r\n                  transformStyle = 'translateX(-55%) scale(0.85)';\r\n                  zIndex = 20;\r\n                  opacity = 'opacity-45';\r\n                } else if (isRight) {\r\n                  transformStyle = 'translateX(55%) scale(0.85)';\r\n                  zIndex = 20;\r\n                  opacity = 'opacity-45';\r\n                } else {\r\n                  transformStyle = offset < 0 ? 'translateX(-100%) scale(0.6)' : 'translateX(100%) scale(0.6)';\r\n                  zIndex = 0;\r\n                  opacity = 'opacity-0';\r\n                }\r\n\r\n                return (\r\n                  <div\r\n                    key={s.id || s.slug}\r\n                    className={`absolute flex flex-col items-center transition-all duration-500 ease-out w-[300px] sm:w-[460px] ${opacity} ${\r\n                      !isCenter ? 'pointer-events-none' : ''\r\n                    }`}\r\n                    style={{ transform: transformStyle, zIndex }}\r\n                  >\r\n                    <div\r\n   