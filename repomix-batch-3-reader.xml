\n    const secInterval = setInterval(() => setSecondTick(prev => (prev + 1) % 60), 1000);\r\n    return () => clearInterval(secInterval);\r\n  }, [isReaderOpen, isPlusActive, isUnlockedForOneShotWednesday]);\r\n\r\n  useEffect(() => {\r\n    const params = new URLSearchParams(window.location.search);\r\n    if (params.get('donation_status') === 'success') {\r\n      const returnedCreator = params.get('creator') || 'the Creator';\r\n      const returnedAmount = Number(params.get('amount') || 5);\r\n      const returnedSessionId = params.get('session_id') || '';\r\n\r\n      setDonationCreator({ name: returnedCreator, avatar_url: '' });\r\n      setDonationAmount(returnedAmount);\r\n      setDonationStep('success');\r\n\r\n      if (returnedSessionId) {\r\n        supabase.functions.invoke('create-checkout-session', {\r\n          body: { type: 'confirm_donation', sessionId: returnedSessionId, creatorName: returnedCreator, amountDollars: returnedAmount }\r\n        });\r\n      }\r\n\r\n      supabase.auth.getUser().then(async ({ data: { user } }) => {\r\n        if (user) {\r\n          const { data: prof } = await supabase.from('profiles').select('creator_supports, fandom_score').eq('id', user.id).maybeSingle();\r\n          if (prof) {\r\n            await supabase.from('profiles').update({\r\n              creator_supports: (prof.creator_supports || 0) + 1,\r\n              fandom_score: (prof.fandom_score || 0) + Math.max(10, returnedAmount * 2)\r\n            }).eq('id', user.id);\r\n          }\r\n          window.dispatchEvent(new Event('profileUpdated'));\r\n        }\r\n      });\r\n      window.history.replaceState({}, '', window.location.pathname);\r\n    } else if (params.get('donation_status') === 'cancelled') {\r\n      window.history.replaceState({}, '', window.location.pathname);\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    const checkMobile = () => setIsMobile(window.innerWidth < 640);\r\n    checkMobile();\r\n    window.addEventListener(