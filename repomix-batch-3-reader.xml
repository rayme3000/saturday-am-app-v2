>\r\n            </div>\r\n\r\n            <div className=\"flex overflow-x-auto gap-3 pb-4 scroll-smooth snap-x no-scrollbar\">\r\n              {suggestedSeries.map((s: any) => (\r\n                <div\r\n                  key={s.id || s.slug}\r\n                  className=\"w-1/3 sm:w-1/4 md:w-1/5 flex-shrink-0 snap-start cursor-pointer group/card\"\r\n                  onClick={() => (onNavigate ? onNavigate(s) : null)}\r\n                >\r\n                  <div\r\n                    className=\"relative overflow-hidden rounded-lg cursor-pointer aspect-[2/3] border border-white shadow-[5px_5px_0px_0px_#fe9a00] group-hover/card:shadow-[8px_8px_0px_0px_#fe9a00] group-hover/card:-translate-y-1 group-hover/card:-translate-x-1 transition-all duration-300 mb-3\"\r\n                    style={getPatternStyle(s.card_color, s.card_pattern)}\r\n                  >\r\n                    <div className=\"absolute inset-0 bg-gradient-to-br from-transparent to-black/60 z-0\" />\r\n                    <img\r\n                      src={s.character_url || s.cover_url}\r\n                      alt={`${s.title} Character`}\r\n                      loading=\"lazy\"\r\n                      decoding=\"async\"\r\n                      className={`absolute left-1/2 -translate-x-1/2 max-w-none object-contain transform transition-transform duration-500 ease-out group-hover/card:scale-[1.15] z-10 ${\r\n                        s.character_align === 'top'\r\n                          ? 'top-0'\r\n                          : s.character_align === 'center'\r\n                          ? 'top-1/2 -translate-y-1/2'\r\n                          : 'bottom-0'\r\n                      }`}\r\n                      style={{ width: `${s.character_scale || 140}%`, height: '120%' }}\r\n                    />\r\n                    <div className=\"absolute inset-x-0 bottom-0 h-[50%] bg-gradient-to-t from-black via-black/80 to-transparent z-20\" />\r\n                    <div\r\n                      className=\"absolute left-0 right-0 flex justify-center z-30 px-3 transition-all duration-300\"\r\n                      style={{ bottom: `${s.logo_offset ?? 16}px` }}\r\n                    >\r\n                      <img\r\n                        src={\r\n                          s.logo_url ||\r\n                          (s.title === 'Apple Black'\r\n                            ? `${CLOUDFLARE_BASE_URL}/series-logos/apple-black-logo.png`\r\n                            : '')\r\n                        }\r\n                        alt={`${s.title} Logo`}\r\n                        loading=\"lazy\"\r\n                        decoding=\"async\"\r\n                        className=\"w-full max-h-24 object-contain transform transition-transform duration-300 group-hover/card:-translate-y-1 drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)]\"\r\n                        style={{ width: `${s.logo_scale ?? 100}%` }}\r\n                      />\r\n                    </div>\r\n                  </div>\r\n\r\n                  <div className=\"px-1 text-left bg-black/50 rounded-lg mt-1 p-1.5\">\r\n                    <h3 className=\"text-white font-bold text-xs truncate tracking-wide group-hover/card:text-[#fe9a00] transition-colors\">\r\n                      {s.title}\r\n                    </h3>\r\n                    <p className=\"text-zinc-500 text-[10px] font-bold uppercase tracking-widest truncate mt-0.5\">\r\n                      {s.creator_name || 'Saturday AM'}\r\n                    </p>\r\n                  </div>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          </div>\r\n        )}\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Favorites;",
    "src/Components/QuickReacts.tsx": "import React, { useState, useEffect, useMemo } from 'react';\r\nimport { MessageSquare, X, Flag, User, Shield, AlertCircle, CheckCircle2, Lock } from 'lucide-react';\r\nimport { supabase } from '../supabase';\r\nimport { cleanText } from '../profanityFilter';\r\nimport { APP_ICONS } from '../appIcons';\r\n\r\n// --- THE SMART COMMENTS LIST (8 EMOJIS) ---\r\nconst SMART_COMMENTS = [\"🔥🔥🔥\", \"😱😱😱\", \"🤯🤯🤯\", \"🐐🐐🐐\", \"👀👀👀\", \"👏👏👏\", \"😭😭😭\", \"💯💯💯\"];\r\n\r\n// --- 1. THE LOGIC HOOK ---\r\nexport const useQuickReacts = (chapterId: string, currentPage: number, currentUser: any, onRequireAuth?: () => void) => {\r\n  const [localComments, setLocalComments] = useState<any[]>([]);\r\n  const [reportedReacts, setReportedReacts] = useState<number[]>([]);\r\n  const [showAllReacts, setShowAllReacts] = useState(false);\r\n  const [isReactInputOpen, setIsReactInputOpen] = useState(false);\r\n  const [reactText, setReactText] = useState('');\r\n  const [activeCommentIndex, setActiveCommentIndex] = useState(0);\r\n  \r\n  const [toastConfig, setToastConfig] = useState<{ message: string, type: 'error' | 'success' } | null>(null);\r\n\r\n  useEffect(() => {\r\n    if (!chapterId) return;\r\n    const fetchReacts = async () => {\r\n      const { data } = await supabase.from('page_reacts').select('*').eq('chapter_id', chapterId).order('created_at', { ascending: true });\r\n      if (data) setLocalComments(data.map((r: any) => ({ id: r.id, pageIndex: r.page_index, user: r.user_name, avatar: r.avatar_url, text: r.text })));\r\n    };\r\n    fetchReacts();\r\n  }, [chapterId]);\r\n\r\n  const visibleComments = useMemo(() => localComments.filter(c => c.pageIndex === currentPage), [localComments, currentPage]);\r\n  \r\n  useEffect(() => {\r\n    if (visibleComments.length <= 1) return;\r\n    const interval = setInterval(() => { setActiveCommentIndex((prev) => (prev + 1) % visibleComments.length); }, 3500);\r\n    return () => clearInterval(interval);\r\n  }, [visibleComments.length, currentPage]);\r\n  \r\n  useEffect(() => { setActiveCommentIndex(visibleComments.length > 0 ? visibleComments.length - 1 : 0); }, [currentPage, localComments.length]);\r\n\r\n  useEffect(() => {\r\n    if (toastConfig) {\r\n      const timer = setTimeout(() => setToastConfig(null), 3000);\r\n      return () => clearTimeout(timer);\r\n    }\r\n  }, [toastConfig]);\r\n\r\n  const submitReact = async (overrideText?: string) => {\r\n    if (!currentUser || !currentUser.id) {\r\n      if (onRequireAuth) onRequireAuth();\r\n      return;\r\n    }\r\n\r\n    const textToSubmit = overrideText || reactText.trim();\r\n    if (!textToSubmit || !chapterId) return;\r\n    \r\n    const safeText = cleanText(textToSubmit);\r\n    const newReactPayload = {\r\n      chapter_id: chapterId,\r\n      page_index: currentPage,\r\n      user_id: currentUser.id,\r\n      user_name: currentUser.name,\r\n      avatar_url: currentUser.avatar,\r\n      text: safeText\r\n    };\r\n    const tempId = Date.now();\r\n    \r\n    setLocalComments(prev => [...prev, { id: tempId, pageIndex: currentPage, user: currentUser.name, avatar: currentUser.avatar, text: safeText }]);\r\n    setReactText('');\r\n    setIsReactInputOpen(false);\r\n\r\n    try {\r\n      const { data, error: insertErr } = await supabase.from('page_reacts').insert([newReactPayload]).select().single();\r\n      if (insertErr) throw insertErr;\r\n      if (data) setLocalComments(prev => prev.map(c => c.id === tempId ? { ...c, id: data.id } : c));\r\n      \r\n      // Single authoritative update: +1 quick_reacts and +2 fandom_score\r\n      const { data: profile } = await supabase\r\n        .from('profiles')\r\n        .select('quick_reacts, fandom_score')\r\n        .eq('id', currentUser.id)\r\n        .maybeSingle();\r\n\r\n      if (profile) {\r\n        await supabase\r\n          .from('profiles')\r\n          .update({\r\n            quick_reacts: (profile.quick_reacts || 0) + 1,\r\n            fandom_score: (profile.fandom_score || 0) + 2\r\n          })\r\n          .eq('id', currentUser.id);\r\n        window.dispatchEvent(new Event('profileUpdated'));\r\n      }\r\n    } catch (err) {\r\n      console.error(\"Failed to save Smart Comment:\", err);\r\n    }\r\n  };\r\n\r\n  const reportReact = async (reactId: any) => {\r\n    if (!currentUser) { alert(\"Please log in to report content.\"); return; }\r\n    \r\n    const numId = Number(reactId);\r\n    if (reportedReacts.includes(numId)) return;\r\n    \r\n    setReportedReacts(prev => [...prev, numId]);\r\n\r\n    try {\r\n      const { error } = await supabase.rpc('submit_quick_react_report', { target_react_id: numId });\r\n      if (error) throw error;\r\n      setToastConfig({ message: 'Report submitted successfully.', type: 'success' });\r\n    } catch (err: any) {\r\n      setReportedReacts(prev => prev.filter(id => id !== numId));\r\n      setToastConfig({ message: `Failed: ${err.message || 'Error'}`, type: 'error' });\r\n    }\r\n  };\r\n\r\n  return { localComments, reportedReacts, showAllReacts, setShowAllReacts, isReactInputOpen, setIsReactInputOpen, reactText, setReactText, submitReact, reportReact, activeCommentIndex, visibleComments, toastConfig };\r\n};\r\n\r\n// --- 2. TOAST NOTIFICATION ---\r\nexport const QuickReactToast = ({ toastConfig }: any) => {\r\n  if (!toastConfig) return null;\r\n  return (\r\n    <div className=\"fixed bottom-24 sm:bottom-28 left-1/2 -translate-x-1/2 z-[6000] bg-black border border-zinc-700 text-white px-6 py-3 rounded-full shadow-[0_10px_40px_rgba(0,0,0,0.8)] flex items-center gap-3 animate-fade-in pointer-events-none\">\r\n      {toastConfig.type === 'error' ? <AlertCircle className=\"w-4 h-4 text-red-500\" /> : <CheckCircle2 className=\"w-4 h-4 text-green-500\" />}\r\n      <span className=\"text-[10px] font-black uppercase tracking-widest\">{toastConfig.message}</span>\r\n    </div>\r\n  );\r\n};\r\n\r\n// --- 3. TIMELINE BUBBLE & AVATARS ---\r\nexport const QuickReactTimeline = ({ mode, localComments, maxPage, currentPage, activeCommentIndex, onOpenDrawer }: any) => {\r\n  const timelineComments = useMemo(() => localComments.slice(-25), [localComments]);\r\n  const visibleComments = useMemo(() => localComments.filter((c: any) => c.pageIndex === currentPage), [localComments, currentPage]);\r\n  const activeComment = visibleComments[activeCommentIndex];\r\n\r\n  const percent = maxPage > 0 ? (currentPage / maxPage) * 100 : 0;\r\n  const shift = 50 - percent;\r\n\r\n  return (\r\n    <>\r\n      {timelineComments.map((comment: any) => (\r\n        <div \r\n          key={comment.id}\r\n          onClick={(e) => { e.stopPropagation(); onOpenDrawer(); }}\r\n          className=\"absolute pointer-events-auto cursor-pointer transition-transform hover:scale-125 drop-shadow-md z-[100]\"\r\n          style={mode === 'vertical' \r\n            ? { top: `${(comment.pageIndex / maxPage) * 100}%`, left: '50%', transform: 'translate(-50%, -50%)', zIndex: comment.pageIndex === currentPage ? 100 : 5 } \r\n            : { left: `${(comment.pageIndex / maxPage) * 100}%`, top: '50%', transform: 'translate(-50%, -50%)', zIndex: comment.pageIndex === currentPage ? 100 : 5 }\r\n          }\r\n        >\r\n          {comment.avatar && !comment.avatar.includes('pravatar') ? (\r\n            <img src={comment.avatar} className={`w-4 h-4 sm:w-6 sm:h-6 rounded-full object-cover shadow-lg transition-all ${comment.pageIndex === currentPage ? 'border-2 border-[#fe9a00] scale-125 opacity-100' : 'opacity-50 grayscale-[50%]'}`} alt=\"\" />\r\n          ) : (\r\n            <div className={`w-4 h-4 sm:w-6 sm:h-6 rounded-full bg-zinc-800/90 flex items-center justify-center shadow-lg transition-all ${comment.pageIndex === currentPage ? 'border-2 border-[#fe9a00] scale-125 opacity-100' : 'opacity-50 grayscale-[50%]'}`}>\r\n              <User className=\"w-2 h-2 sm:w-3 sm:h-3 text-zinc-400\" />\r\n            </div>\r\n          )}\r\n        </div>\r\n      ))}\r\n\r\n      {activeComment && (\r\n        <div \r\n          key={`active_${activeComment.id}`} \r\n          onClick={(e) => { e.stopPropagation(); onOpenDrawer(); }}\r\n          className={`absolute pointer-events-auto cursor-pointer z-[110] ${mode === 'vertical' ? 'left-full ml-3 sm:ml-4' : 'bottom-full mb-3 sm:mb-4'}`}\r\n          style={mode === 'vertical' ? { top: `${percent}%`, transform: 'translateY(-50%)' } : { left: `${percent}%`, transform: 'translateX(-50%)' }}\r\n        >\r\n          <div className={`animate-slide-${mode === 'vertical' ? 'right' : 'up'}-fade flex ${mode === 'vertical' ? 'items-center' : 'flex-col items-center'}`}>\r\n            {mode === 'vertical' && <div className=\"w-0 h-0 border-t-[5px] border-t-transparent border-b-[5px] border-b-transparent border-r-[5px] border-r-black/70 -mr-[1px]\" />}\r\n            \r\n            <div \r\n              className=\"bg-black/70 backdrop-blur-md text-white px-3 py-2 rounded-lg shadow-2xl max-w-[180px] sm:max-w-[250px] border border-white/5 flex flex-col items-start hover:border-[#fe9a00]/50 transition-colors\"\r\n              style={mode === 'vertical' ? { transform: `translateY(${shift}%)` } : { transform: `translateX(${shift}%)` }}\r\n            >\r\n              <span className=\"text-[#fe9a00] font-semibold uppercase text-[8px] mb-0.5 w-full truncate\">\r\n                {activeComment.user.length > 15 ? `${activeComment.user.slice(0, 15)}...` : activeComment.user}\r\n              </span>\r\n              <span className=\"text-[10px] sm:text-[11px] leading-tight break-words text-left whitespace-normal\">\r\n                {activeComment.text}\r\n              </span>\r\n            </div>\r\n\r\n            {mode === 'horizontal' && <div className=\"w-0 h-0 border-l-[5px] border-l-transparent border-r-[5px] border-r-transparent border-t-[5px] border-t-black/70 -mt-[1px]\" />}\r\n          </div>\r\n        </div>\r\n      )}\r\n    </>\r\n  );\r\n};\r\n\r\n// --- 4. ALL REACTS DRAWER ---\r\nexport const QuickReactDrawer = ({ showAllReacts, setShowAllReacts, localComments, setCurrentPage, handleReportReact, reportedReacts }: any) => {\r\n  if (!showAllReacts) return null;\r\n  return (\r\n    <div className=\"fixed inset-0 z-[5000] bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center sm:p-6 animate-fade-in pointer-events-auto\" onClick={() => setShowAllReacts(false)}>\r\n      <div className=\"bg-zinc-900 border border-zinc-800 w-full sm:max-w-md h-[70vh] sm:h-[80vh] rounded-t-2xl sm:rounded-2xl flex flex-col shadow-2xl overflow-hidden relative\" onClick={e => e.stopPropagation()}>\r\n        <div className=\"flex justify-between items-center p-5 border-b border-zinc-800 bg-black/50\">\r\n          <h3 className=\"text-white font-black uppercase tracking-widest text-sm flex items-center gap-2\">\r\n            <MessageSquare className=\"w-4 h-4 text-[#fe9a00]\" /> All Quick Reacts\r\n          </h3>\r\n          <button onClick={() => setShowAllReacts(false)} className=\"text-zinc-500 hover:text-white transition-colors cursor-pointer\"><X className=\"w-5 h-5\" /></button>\r\n        </div>\r\n        \r\n        <div className=\"flex-1 overflow-y-auto p-4 space-y-3 no-scrollbar pb-12\">\r\n          {localComments.length === 0 ? (\r\n             <div className=\"flex flex-col items-center justify-center mt-20 text-center\">\r\n               <MessageSquare className=\"w-10 h-10 text-zinc-700 mb-3\" />\r\n               <p className=\"text-zinc-500 font-bold text-xs uppercase tracking-widest\">No reacts on this chapter yet.</p>\r\n             </div>\r\n          ) : (\r\n             localComments.map((react: any) => (\r\n               <div key={react.id} className=\"bg-black border border-zinc-800 hover:border-zinc-700 rounded-xl p-4 flex gap-3 transition-colors\">\r\n                  <img src={react.avatar || 'https://i.pravatar.cc/150'} alt=\"avatar\" className=\"w-10 h-10 rounded-full object-cover shadow-md\" />\r\n                  <div className=\"flex-1 min-w-0\">\r\n                     <div className=\"flex justify-between items-start mb-2\">\r\n                       <span className=\"text-[#fe9a00] text-[10px] font-black uppercase tracking-widest truncate pr-2\">{react.user}</span>\r\n                       <button \r\n                         onClick={() => { setCurrentPage(react.pageIndex); setShowAllReacts(false); }}\r\n                         className=\"text-zinc-400 hover:text-white text-[9px] font-black tracking-widest uppercase whitespace-nowrap bg-zinc-800 px-2 py-1 rounded transition-colors cursor-pointer\"\r\n                       >\r\n                         Pg {react.pageIndex + 1}\r\n                       </button>\r\n                     </div>\r\n                     <p className=\"text-zinc-300 text-xs break-words leading-relaxed\">{react.text}</p>\r\n                     <div className=\"flex justify-end mt-3\">\r\n                       <button \r\n                         onClick={() => handleReportReact(react.id)} \r\n                         disabled={reportedReacts.includes(Number(react.id))} \r\n                         className={`text-[9px] font-black uppercase tracking-widest flex items-center gap-1 transition-colors cursor-pointer ${reportedReacts.includes(Number(react.id)) ? 'text-red-500/50' : 'text-zinc-500 hover:text-red-500'}`}\r\n                       >\r\n                         <Flag className=\"w-3 h-3\" /> {reportedReacts.includes(Number(react.id)) ? 'Reported' : 'Report'}\r\n                       </button>\r\n                     </div>\r\n                  </div>\r\n               </div>\r\n             ))\r\n          )}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\n// --- 5. ACTION BUTTONS ---\r\nexport const QuickReactToggleButton = ({ isReactInputOpen, setIsReactInputOpen }: any) => (\r\n  <button onClick={() => setIsReactInputOpen(!isReactInputOpen)} className={`p-2.5 sm:p-3 flex items-center justify-center rounded-full transition-colors shadow-xl border border-white/5 cursor-pointer ${isReactInputOpen ? 'bg-zinc-800' : 'bg-black/40 backdrop-blur-md hover:bg-black/60'}`} title=\"Add React\">\r\n    <img src={APP_ICONS.QUICK_REACT} alt=\"Quick React\" className=\"w-5 h-5 sm:w-6 sm:h-6 object-contain drop-shadow-md\" />\r\n  </button>\r\n);\r\n\r\nexport const QuickReactViewAllButton = ({ setShowAllReacts }: any) => (\r\n  <button onClick={() => setShowAllReacts(true)} className=\"p-2 sm:p-2.5 bg-black/40 backdrop-blur-md border border-white/5 shadow-lg rounded-full transition-colors text-white/70 hover:text-white hover:bg-black/60 cursor-pointer\" title=\"View All Reacts\">\r\n    <MessageSquare className=\"w-3 h-3 sm:w-4 sm:h-4\" />\r\n  </button>\r\n);\r\n\r\n// --- 6. INPUT OVERLAY (TIER GATED: VISITOR SIGNUP / FREE EMOJIS / PRO CUSTOM TEXT) ---\r\nexport const QuickReactInputOverlay = ({ \r\n  isReactInputOpen, \r\n  setIsReactInputOpen, \r\n  reactText, \r\n  setReactText, \r\n  submitReact, \r\n  isPremium, \r\n  currentUser,\r\n  onRequireAuth,\r\n  onRequirePremium\r\n}: any) => {\r\n  if (!isReactInputOpen) return null;\r\n\r\n  const isLoggedIn = Boolean(currentUser && currentUser.id);\r\n\r\n  const handleEmojiClick = (emoji: string) => {\r\n    if (!isLoggedIn) {\r\n      setIsReactInputOpen(false);\r\n      if (onRequireAuth) onRequireAuth();\r\n      return;\r\n    }\r\n    submitReact(emoji);\r\n  };\r\n\r\n  const handleCustomTextSend = () => {\r\n    if (!isLoggedIn) {\r\n      setIsReactInputOpen(false);\r\n      if (onRequireAuth) onRequireAuth();\r\n      return;\r\n    }\r\n    if (!isPremium) {\r\n      setIsReactInputOpen(false);\r\n      if (onRequirePremium) onRequirePremium();\r\n      return;\r\n    }\r\n    submitReact();\r\n  };\r\n\r\n  return (\r\n    <div className=\"w-full bg-black/80 backdrop-blur-xl border border-white/10 p-3 rounded-2xl shadow-2xl animate-fade-in pointer-events-auto flex flex-col gap-2.5\">\r\n      {/* Drawer Header */}\r\n      <div className=\"flex justify-between items-center px-1 border-b border-white/10 pb-2\">\r\n        <div className=\"flex items-center gap-1.5\">\r\n          <Shield className=\"w-3.5 h-3.5 text-[#fe9a00]\" />\r\n          <span className=\"text-[10px] font-black text-[#fe9a00] uppercase tracking-widest\">Smart Comments</span>\r\n        </div>\r\n        <button \r\n          onClick={() => setIsReactInputOpen(false)} \r\n          className=\"text-white/50 hover:text-white transition-colors cursor-pointer\"\r\n        >\r\n          <X className=\"w-4 h-4\" />\r\n        </button>\r\n      </div>\r\n\r\n      {/* 1. Emoji Grid (Available to everyone) */}\r\n      <div className=\"grid grid-cols-4 gap-1.5 sm:gap-2\">\r\n        {SMART_COMMENTS.map((c) => (\r\n          <button \r\n            key={c} \r\n            onClick={() => handleEmojiClick(c)} \r\n            className=\"bg-zinc-800/80 hover:bg-[#fe9a00] py-2 sm:py-2.5 rounded-xl text-base sm:text-xl transition-all border border-zinc-700/60 hover:border-[#fe9a00] flex items-center justify-center leading-none cursor-pointer hover:scale-105 active:scale-95\"\r\n            title={isLoggedIn ? `React ${c}` : \"Sign up to react\"}\r\n          >\r\n            {c}\r\n          </button>\r\n        ))}\r\n      </div>\r\n\r\n      {/* 2. Custom Text Field / Tier Gate Action */}\r\n      {isPremium ? (\r\n        <div className=\"flex items-center gap-2 pt-1 border-t border-white/10\">\r\n          <input\r\n            autoFocus\r\n            type=\"text\"\r\n            maxLength={30}\r\n            value={reactText}\r\n            onChange={(e) => setReactText(e.target.value)}\r\n            onKeyDown={(e) => { if (e.key === 'Enter') handleCustomTextSend(); }}\r\n            placeholder=\"Type custom reaction...\"\r\n            className=\"bg-black/60 border border-zinc-700 text-white text-[11px] sm:text-xs px-3 py-2 rounded-xl flex-1 focus:outline-none focus:border-[#fe9a00] font-medium\"\r\n          />\r\n          <button \r\n            onClick={handleCustomTextSend} \r\n            disabled={!reactText.trim()} \r\n            className=\"bg-[#fe9a00] text-black px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-white disabled:opacity-40 transition-colors cursor-pointer\"\r\n          >\r\n            Send\r\n          </button>\r\n        </div>\r\n      ) : !isLoggedIn ? (\r\n        <button \r\n          onClick={() => {\r\n            setIsReactInputOpen(false);\r\n            if (onRequireAuth) onRequireAuth();\r\n          }} \r\n          className=\"w-full bg-[#fe9a00] text-black py-2.5 rounded-xl font-black uppercase text-[10px] tracking-widest hover:bg-white transition-colors mt-0.5 shadow-[0_0_15px_rgba(254,154,0,0.3)] cursor-pointer\"\r\n        >\r\n          Sign Up Free to Drop Comments\r\n        </button>\r\n      ) : (\r\n        <button \r\n          onClick={() => {\r\n            setIsReactInputOpen(false);\r\n            if (onRequirePremium) onRequirePremium();\r\n          }} \r\n          className=\"w-full bg-zinc-900 border border-zinc-700 hover:border-[#fe9a00] text-zinc-300 hover:text-white py-2.5 rounded-xl font-black uppercase text-[9px] sm:text-[10px] tracking-widest transition-all flex items-center justify-center gap-2 cursor-pointer group\"\r\n        >\r\n          <Lock className=\"w-3.5 h-3.5 text-[#fe9a00] group-hover:scale-110 transition-transform\" />\r\n          <span>Type Custom Comment • <strong className=\"text-[#fe9a00]\">Pro Only ($1.99)</strong></span>\r\n        </button>\r\n      )}\r\n    </div>\r\n  );\r\n};",
    "src/MainViews/Browse.tsx": "import { useState, useMemo, useEffect, useCallback } from 'react';\r\nimport { useSeriesData } from '../userSeriesData';\r\nimport { supabase } from '../supabase';\r\nimport { Search, Library, ArrowUpDown, Clock, Zap } from 'lucide-react';\r\nimport {\r\n  isCompletedRunSeries,\r\n  isActiveOneShotWednesday,\r\n  isInOneShotDebutWindow,\r\n  getOneShotFreeCountdown\r\n} from '../oneshotWednesday';\r\n\r\nconst CLOUDFLARE_BASE_URL = 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev';\r\n\r\nconst getPatternStyle = (color: string, pattern: string) => {\r\n  const baseColor = color || '#18181b';\r\n  const overlay = 'rgba(0,0,0,0.2)';\r\n  if (pattern === 'dots') return { backgroundColor: baseColor, backgroundImage: `radial-gradient(${overlay} 2px, transparent 2px)`, backgroundSize: '12px 12px' };\r\n  if (pattern === 'lines') return { backgroundColor: baseColor, backgroundImage: `repeating-linear-gradient(45deg, transparent, transparent 5px, ${overlay} 5px, ${overlay} 10px)` };\r\n  if (pattern === 'grid') return { backgroundColor: baseColor, backgroundImage: `linear-gradient(${overlay} 1px, transparent 1px), linear-gradient(90deg, ${overlay} 1px, transparent 1px)`, backgroundSize: '20px 20px' };\r\n  if (pattern === 'pinstripes') return { backgroundColor: baseColor, backgroundImage: `repeating-linear-gradient(45deg, ${overlay} 0, ${overlay} 1px, transparent 1px, transparent 8px)` };\r\n  if (pattern === 'mesh') return { backgroundColor: baseColor, backgroundImage: `linear-gradient(${overlay} 1px, transparent 1px), linear-gradient(90deg, ${overlay} 1px, transparent 1px)`, backgroundSize: '14px 14px' };\r\n  if (pattern === 'glow') return { backgroundColor: baseColor, backgroundImage: `radial-gradient(circle at 50% 0%, rgba(255,255,255,0.15) 0%, transparent 70%)` };\r\n  if (pattern === 'cut') return { backgroundColor: baseColor, backgroundImage: `linear-gradient(135deg, rgba(255,255,255,0.04) 50%, transparent 50%)` };\r\n  return { backgroundColor: baseColor };\r\n};\r\n\r\nconst isReleasedYet = (publishAt?: string | null) => {\r\n  if (!publishAt) return true;\r\n  return new Date(publishAt).getTime() <= Date.now();\r\n};\r\n\r\n// Synced 72-hour (3-day) NEW badge window (ignores updated_at so admin edits don't re-badge old series)\r\nconst isNewSeriesRelease = (publishAt?: string | null, createdAt?: string | null) => {\r\n  const now = Date.now();\r\n  const threeDaysMs = 3 * 24 * 60 * 60 * 1000;\r\n  const candidates = [publishAt, createdAt].filter(Boolean);\r\n  for (const dateStr of candidates) {\r\n    const t = new Date(dateStr as string).getTime();\r\n    if (!isNaN(t) && t <= now && now - t < threeDaysMs) {\r\n      return true;\r\n    }\r\n  }\r\n  return false;\r\n};\r\n\r\nexport const Browse = ({ onNavigate, userTier = 'visitor' }: any) => {\r\n  const { seriesList = [] } = useSeriesData();\r\n  const [searchQuery, setSearchQuery] = useState('');\r\n  const [sortBy, setSortBy] = useState<'title-asc' | 'title-desc' | 'creator-asc'>('title-asc');\r\n  const [creatorsMap, setCreatorsMap] = useState<Record<string, string[]>>({});\r\n\r\n  const isPlusSubscriber = userTier === 'premium';\r\n\r\n  const fetchAllCredits = useCallback(async () => {\r\n    try {\r\n      const { data } = await supabase\r\n        .from('series_creators')\r\n        .select('series_slug, name');\r\n\r\n      if (data) {\r\n        const map: Record<string, string[]> = {};\r\n        data.forEach((row: any) => {\r\n          if (!row.series_slug || !row.name) return;\r\n          if (!map[row.series_slug]) map[row.series_slug] = [];\r\n          map[row.series_slug].push(row.name.toLowerCase());\r\n        });\r\n        setCreatorsMap(map);\r\n      }\r\n    } catch (err) {\r\n      console.error('Failed to load creator credits:', err);\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    fetchAllCredits();\r\n    window.addEventListener('seriesUpdated', fetchAllCredits);\r\n    window.addEventListener('vaultUpdated', fetchAllCredits);\r\n    return () => {\r\n      window.removeEventListener('seriesUpdated', fetchAllCredits);\r\n      window.removeEventListener('vaultUpdated', fetchAllCredits);\r\n    };\r\n  }, [fetchAllCredits]);\r\n\r\n  const sortedSeries = useMemo(() => {\r\n    const query = searchQuery.toLowerCase().trim();\r\n\r\n    const filtered = seriesList.filter((s: any) => {\r\n      if (s.is_hidden) return false;\r\n      const isFreeOswOrDebut = isActiveOneShotWednesday(s, seriesList);\r\n      if (!isFreeOswOrDebut && !isReleasedYet(s.publish_at)) return false;\r\n\r\n      if (!query) return true;\r\n\r\n      const titleMatch = s.title?.toLowerCase().includes(query);\r\n      const primaryCreatorMatch = s.creator_name?.toLowerCase().includes(query);\r\n      const coCreators = creatorsMap[s.slug] || [];\r\n      const coCreatorMatch = coCreators.some(name => name.includes(query));\r\n\r\n      return titleMatch || primaryCreatorMatch || coCreatorMatch;\r\n    });\r\n\r\n    return [...filtered].sort((a, b) => {\r\n      if (sortBy === 'title-asc') {\r\n        return (a.title || '').localeCompare(b.title || '');\r\n      }\r\n      if (sortBy === 'title-desc') {\r\n        return (b.title || '').localeCompare(a.title || '');\r\n      }\r\n      if (sortBy === 'creator-asc') {\r\n        const creatorA = (a.creator_name || '').trim().toLowerCase();\r\n        const creatorB = (b.creator_name || '').trim().toLowerCase();\r\n        if (!creatorA) return 1;\r\n        if (!creatorB) return -1;\r\n        return creatorA.localeCompare(creatorB);\r\n      }\r\n      return 0;\r\n    });\r\n  }, [seriesList, searchQuery, creatorsMap, sortBy]);\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-transparent text-white pb-24 relative px-4 pt-6\">\r\n      <div className=\"sticky top-0 z-40 bg-black/85 backdrop-blur-xl pb-4 pt-2 mb-4 border-b border-zinc-800 rounded-b-2xl px-2\">\r\n        <div className=\"flex justify-between items-end mb-4 pr-16 sm:pr-20\">\r\n          <h1 className=\"text-3xl font-black italic uppercase tracking-tighter text-white drop-shadow-md\">\r\n            The Vault\r\n          </h1>\r\n          <div className=\"flex items-center gap-2 text-zinc-400 bg-zinc-900/80 px-3 py-1.5 rounded-full border border-zinc-800\">\r\n            <Library className=\"w-4 h-4\" />\r\n            <span className=\"text-[10px] font-black uppercase tracking-widest\">\r\n              {sortedSeries.length} Series\r\n            </span>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full\">\r\n          <div className=\"relative flex-1\">\r\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500\" />\r\n            <input\r\n              type=\"text\"\r\n              placeholder=\"Search by series title or creator...\"\r\n              value={searchQuery}\r\n              onChange={e => setSearchQuery(e.target.value)}\r\n              className=\"w-full bg-zinc-900/90 border border-zinc-800 text-white pl-10 pr-4 py-3 rounded-xl text-sm focus:outline-none focus:border-[#fe9a00] transition-colors shadow-inner\"\r\n            />\r\n          </div>\r\n\r\n          <div className=\"flex items-center gap-2 bg-zinc-900/90 border border-zinc-800 px-3 py-1.5 rounded-xl\">\r\n            <ArrowUpDown className=\"w-4 h-4 text-[#fe9a00] shrink-0\" />\r\n            <select\r\n              value={sortBy}\r\n              onChange={e => setSortBy(e.target.value as any)}\r\n              aria-label=\"Sort series\"\r\n              className=\"bg-transparent text-white text-xs font-black uppercase tracking-wider py-1.5 focus:outline-none cursor-pointer\"\r\n            >\r\n              <option value=\"title-asc\" className=\"bg-zinc-950 text-white\">Title: A-Z</option>\r\n              <option value=\"title-desc\" className=\"bg-zinc-950 text-white\">Title: Z-A</option>\r\n              <option value=\"creator-asc\" className=\"bg-zinc-950 text-white\">Creator: A-Z</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {sortedSeries.length === 0 ? (\r\n        <div className=\"text-center text-zinc-500 py-16 font-bold uppercase tracking-widest text-xs border-2 border-dashed border-zinc-800 rounded-xl mt-8 bg-black/40\">\r\n          No series found matching \"{searchQuery}\".\r\n        </div>\r\n      ) : (\r\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 gap-y-6 mt-6 pb-8\">\r\n          {sortedSeries.map((item: any) => {\r\n            const isCompleted = isCompletedRunSeries(item, seriesList);\r\n            const is48hDebut = isCompleted && isInOneShotDebutWindow(item, seriesList);\r\n            const showFreeWednesdayCue = !isPlusSubscriber && isCompleted && isActiveOneShotWednesday(item, seriesList);\r\n            const showPlusVaultTag = !isPlusSubscriber && isCompleted && !showFreeWednesdayCue;\r\n            const freeCountdown = showFreeWednesdayCue ? getOneShotFreeCountdown(item, seriesList) : null;\r\n            const showNewBadge = isNewSeriesRelease(item.publish_at, item.created_at);\r\n\r\n            return (\r\n              <div\r\n                key={item.id || item.slug}\r\n                className=\"flex-shrink-0 cursor-pointer group/card\"\r\n                onClick={() => onNavigate(item)}\r\n              >\r\n                <div\r\n                  className=\"relative overflow-hidden rounded-lg aspect-[2/3] border border-white shadow-[5px_5px_0px_0px_#fe9a00] group-hover/card:shadow-[8px_8px_0px_0px_#fe9a00] group-hover/card:-translate-y-1 group-hover/card:-translate-x-1 transition-all duration-300 mb-3\"\r\n                  style={getPatternStyle(item.card_color, item.card_pattern)}\r\n                >\r\n                  <div className=\"absolute inset-0 bg-gradient-to-br from-transparent to-black/60 z-0\" />\r\n                  <img\r\n                    src={item.character_url || item.cover_url}\r\n                    alt={`${item.title} Character`}\r\n                    loading=\"lazy\"\r\n                    decoding=\"async\"\r\n                    className={`absolute left-1/2 -translate-x-1/2 max-w-none object-contain transform transition-transform duration-500 ease-out group-hover/card:scale-[1.15] z-10 ${\r\n                      item.character_align === 'top' ? 'top-0' :\r\n                      item.character_align === 'center' ? 'top-1/2 -translate-y-1/2' :\r\n                      'bottom-0'\r\n                    }`}\r\n                    style={{ width: `${item.character_scale || 140}%`, height: '120%' }}\r\n                  />\r\n                  <div className=\"absolute inset-x-0 bottom-0 h-[50%] bg-gradient-to-t from-black via-black/80 to-transparent z-20\" />\r\n                  <div\r\n                    className=\"absolute left-0 right-0 flex justify-center z-30 px-3 transition-all duration-300\"\r\n                    style={{ bottom: `${item.logo_offset ?? 16}px` }}\r\n                  >\r\n                    <img\r\n                      src={item.logo_url || (item.title === 'Apple Black' ? `${CLOUDFLARE_BASE_URL}/series-logos/apple-black-logo.png` : '')}\r\n                      alt={`${item.title} Logo`}\r\n                      loading=\"lazy\"\r\n                      decoding=\"async\"\r\n                      className=\"w-full max-h-24 object-contain transform transition-transform duration-300 group-hover/card:-translate-y-1 drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)]\"\r\n                      style={{ width: `${item.logo_scale ?? 100}%` }}\r\n                    />\r\n                  </div>\r\n\r\n                  {showFreeWednesdayCue ? (\r\n                    <div className=\"absolute top-1.5 left-1.5 z-40 bg-[#fe9a00] text-black text-[8px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded shadow-md flex items-center gap-1 pointer-events-none\">\r\n                      <Zap className=\"w-2.5 h-2.5 fill-black shrink-0\" />\r\n                      <span>{is48hDebut ? 'FREE DEBUT' : `FREE: ${freeCountdown}`}</span>\r\n                    </div>\r\n                  ) : showPlusVaultTag ? (\r\n                    <div className=\"absolute top-1.5 left-1.5 z-40 bg-purple-900/90 text-purple-200 border border-purple-400/50 text-[8px] font-black uppercase tracking-widest px-1.5 py-0.5 rounded shadow-md pointer-events-none\">\r\n                      PLUS VAULT\r\n                    </div>\r\n                  ) : showNewBadge && (\r\n                    <div className=\"absolute top-1.5 left-1.5 z-40 bg-red-600 text-white text-[8px] font-black uppercase tracking-widest px-1.5 py-0.5 rounded shadow-[0_0_10px_rgba(220,38,38,0.8)] animate-pulse pointer-events-none\">\r\n                      NEW!\r\n                    </div>\r\n                  )}\r\n                </div>\r\n\r\n                <div className=\"px-1 text-left bg-black/60 rounded-lg mt-1 p-2 border border-zinc-800/50\">\r\n                  <h3 className=\"text-white font-bold text-xs truncate tracking-wide group-hover/card:text-[#fe9a00] transition-colors\">\r\n                    {item.title}\r\n                  </h3>\r\n                  {showFreeWednesdayCue && freeCountdown ? (\r\n                    <p className=\"text-[#fe9a00] text-[9px] font-black uppercase tracking-wider truncate mt-0.5 flex items-center gap-1\">\r\n                      <Clock className=\"w-2.5 h-2.5 shrink-0\" /> {freeCountdown} left\r\n                    </p>\r\n                  ) : (\r\n                    <p className=\"text-zinc-500 text-[10px] font-bold uppercase tracking-widest truncate mt-0.5\">\r\n                      {item.creator_name || 'Saturday AM'}\r\n                    </p>\r\n                  )}\r\n                </div>\r\n              </div>\r\n            );\r\n          })}\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Browse;",
    "src/Components/SeriesCommentsSection.tsx": "import { useState, useEffect } from 'react';\r\nimport { Lock, Flame, Flag, AlertCircle, CheckCircle2, MessageSquare, CornerDownRight, Shield } from 'lucide-react';\r\nimport { supabase } from '../supabase';\r\nimport { DecoratedAvatar } from './DecoratedAvatar';\r\nimport { cleanText, containsInappropriateLanguage } from '../profanityFilter';\r\n\r\n// Silent window: Free users can comment until Sunday, Nov 8, 2026 @ 11:59:59 PM EST\r\nconst FREE_COMMENTS_END_MS = new Date('2026-11-08T23:59:59-05:00').getTime();\r\n\r\n// Helper to ensure no user ever shows up as generic \"Reader\"\r\nconst resolveDisplayUsername = (\r\n  profile?: any,\r\n  authUser?: any,\r\n  savedCommentUserName?: string,\r\n  fallbackUserId?: string\r\n): string => {\r\n  const isGeneric = (val?: string | null) => {\r\n    const clean = String(val || '').trim().toLowerCase();\r\n    return !clean || clean === 'reader' || clean === 'user' || clean === 'anonymous';\r\n  };\r\n\r\n  if (profile?.username && !isGeneric(profile.username)) {\r\n    return String(profile.username).trim();\r\n  }\r\n\r\n  const fullName = `${profile?.first_name || ''} ${profile?.last_name || ''}`.trim();\r\n  if (fullName && !isGeneric(fullName)) {\r\n    return fullName;\r\n  }\r\n\r\n  if (savedCommentUserName && !isGeneric(savedCommentUserName)) {\r\n    return String(savedCommentUserName).trim();\r\n  }\r\n\r\n  const metaName =\r\n    authUser?.user_metadata?.username ||\r\n    authUser?.user_metadata?.display_name ||\r\n    authUser?.user_metadata?.full_name ||\r\n    authUser?.user_metadata?.name;\r\n  if (metaName && !isGeneric(metaName)) {\r\n    return String(metaName).trim();\r\n  }\r\n\r\n  const emailToUse = profile?.email || authUser?.email || '';\r\n  if (emailToUse && emailToUse.includes('@')) {\r\n    return emailToUse.split('@')[0];\r\n  }\r\n\r\n  const shortId = String(fallbackUserId || profile?.id || authUser?.id || '')\r\n    .replace(/[^a-zA-Z0-9]/g, '')\r\n    .slice(0, 5)\r\n    .toUpperCase();\r\n  return shortId ? `Reader_${shortId}` : 'Reader';\r\n};\r\n\r\nexport const SeriesCommentsSection = ({ seriesSlug, onRequireAuth }: { seriesSlug: string, onRequireAuth: () => void }) => {\r\n  const [commentText, setCommentText] = useState('');\r\n  const [comments, setComments] = useState<any[]>([]);\r\n  const [currentUser, setCurrentUser] = useState<any>(null);\r\n  const [isSubmitting, setIsSubmitting] = useState(false);\r\n  const [isPremiumUser, setIsPremiumUser] = useState(false);\r\n\r\n  // --- THREADED REPLIES STATE ---\r\n  const [replyingTo, setReplyingTo] = useState<string | null>(null);\r\n  const [replies, setReplies] = useState<Record<string, any[]>>({});\r\n  const [expandedReplies, setExpandedReplies] = useState<Record<string, boolean>>({});\r\n\r\n  const [commentHypes, setCommentHypes] = useState<Record<string, { count: number, hasHyped: boolean }>>({});\r\n  const [reportedComments, setReportedComments] = useState<string[]>([]);\r\n  const [toastConfig, setToastConfig] = useState<{ message: string, type: 'error' | 'success' | 'pending' } | null>(null);\r\n\r\n  const [page, setPage] = useState(0);\r\n  const [hasMore, setHasMore] = useState(true);\r\n  const [isLoadingMore, setIsLoadingMore] = useState(false);\r\n  const COMMENTS_PER_PAGE = 10;\r\n  const MAX_CHARS = 140;\r\n\r\n  useEffect(() => {\r\n    supabase.auth.getUser().then(async ({ data: { user } }) => {\r\n      if (user) {\r\n        const { data: profile } = await supabase\r\n          .from('profiles')\r\n          .select('id, username, first_name, last_name, email, avatar_url, avatar_frame_id, is_premium')\r\n          .eq('id', user.id)\r\n          .maybeSingle();\r\n\r\n        const resolvedName = resolveDisplayUsername(profile, user, undefined, user.id);\r\n\r\n        // If their profile in DB still had generic \"Reader\", silently heal it to their real handle\r\n        if (profile && (!profile.username || profile.username.trim().toLowerCase() === 'reader') && resolvedName !== 'Reader') {\r\n          supabase\r\n            .from('profiles')\r\n            .update({ username: resolvedName })\r\n            .eq('id', user.id)\r\n            .then(() => {});\r\n        }\r\n\r\n        setCurrentUser({\r\n          id: user.id,\r\n          name: resolvedName,\r\n          avatar: profile?.avatar_url || user.user_metadata?.avatar_url || '',\r\n          frameId: profile?.avatar_frame_id || 'none'\r\n        });\r\n        setIsPremiumUser(Boolean(profile?.is_premium));\r\n      }\r\n    });\r\n  }, []);\r\n\r\n  const fetchComments = async (pageIndex: number, isInitialLoad = false) => {\r\n    if (!seriesSlug) return;\r\n    if (!isInitialLoad) setIsLoadingMore(true);\r\n\r\n    const { data: { user } } = await supabase.auth.getUser();\r\n    const currentUserId = user?.id || '00000000-0000-0000-0000-000000000000';\r\n\r\n    const from = pageIndex * COMMENTS_PER_PAGE;\r\n    const to = from + COMMENTS_PER_PAGE - 1;\r\n\r\n    // SHADOW-BAN FILTER: Fetch unflagged comments OR comments authored by current user\r\n    const { data } = await supabase\r\n      .from('series_comments')\r\n      .select('*')\r\n      .eq('series_slug', seriesSlug)\r\n      .is('parent_id', null)\r\n      .or(`is_flagged.eq.false,user_id.eq.${currentUserId}`)\r\n      .order('created_at', { ascending: false })\r\n      .range(from, to);\r\n\r\n    if (data) {\r\n      const userIds = [...new Set(data.map((c: any) => c.user_id))].filter(Boolean);\r\n      const profileMap: Record<string, any> = {};\r\n      if (userIds.length > 0) {\r\n        const { data: profiles } = await supabase\r\n          .from('profiles')\r\n          .select('id, username, first_name, last_name, email, avatar_url, avatar_frame_id')\r\n          .in('id', userIds);\r\n        profiles?.forEach((p: any) => {\r\n          profileMap[p.id] = p;\r\n        });\r\n      }\r\n      const enrichedData = data.map((c: any) => {\r\n        const prof = profileMap[c.user_id];\r\n        return {\r\n          ...c,\r\n          user_name: resolveDisplayUsername(prof, null, c.user_name, c.user_id),\r\n          avatar_url: c.avatar_url || prof?.avatar_url || '',\r\n          frame_id: prof?.avatar_frame_id || 'none'\r\n        };\r\n      });\r\n\r\n      if (isInitialLoad) setComments(enrichedData);\r\n      else setComments(prev => [...prev, ...enrichedData]);\r\n\r\n      setHasMore(data.length === COMMENTS_PER_PAGE);\r\n    }\r\n    setIsLoadingMore(false);\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (seriesSlug) {\r\n      setPage(0);\r\n      setHasMore(true);\r\n      fetchComments(0, true);\r\n    }\r\n    // eslint-disable-next-line react-hooks/exhaustive-deps\r\n  }, [seriesSlug]);\r\n\r\n  useEffect(() => {\r\n    const loadInteractions = async () => {\r\n      if (comments.length === 0) return;\r\n      const commentIds = comments.map(c => String(c.id));\r\n\r\n      const { data: hypesData } = await supabase\r\n        .from('hypes')\r\n        .select('target_id, user_id')\r\n        .eq('target_type', 'comment')\r\n        .in('target_id', commentIds);\r\n      const newHypes: Record<string, { count: number, hasHyped: boolean }> = {};\r\n\r\n      commentIds.forEach(id => {\r\n        const commentHypesList = hypesData?.filter((h: any) => String(h.target_id) === String(id)) || [];\r\n        newHypes[id] = {\r\n          count: commentHypesList.length,\r\n          hasHyped: currentUser ? commentHypesList.some((h: any) => h.user_id === currentUser.id) : false\r\n        };\r\n      });\r\n      setCommentHypes(newHypes);\r\n\r\n      if (currentUser) {\r\n        const { data: reportsData } = await supabase\r\n          .from('comment_reports')\r\n          .select('comment_id')\r\n          .eq('reported_by', currentUser.id)\r\n          .in('comment_id', commentIds);\r\n        if (reportsData) setReportedComments(reportsData.map((r: any) => r.comment_id));\r\n      }\r\n    };\r\n    loadInteractions();\r\n  }, [comments, currentUser]);\r\n\r\n  useEffect(() => {\r\n    if (toastConfig) {\r\n      const timer = setTimeout(() => setToastConfig(null), 4000);\r\n      return () => clearTimeout(timer);\r\n    }\r\n  }, [toastConfig]);\r\n\r\n  const handleLoadMore = () => {\r\n    const nextPage = page + 1;\r\n    setPage(nextPage);\r\n    fetchComments(nextPage);\r\n  };\r\n\r\n  const loadReplies = async (parentId: string) => {\r\n    if (expandedReplies[parentId]) {\r\n      setExpandedReplies(prev => ({ ...prev, [parentId]: false }));\r\n      return;\r\n    }\r\n\r\n    const { data: { user } } = await supabase.auth.getUser();\r\n    const currentUserId = user?.id || '00000000-0000-0000-0000-000000000000';\r\n\r\n    // SHADOW-BAN FILTER: Fetch unflagged replies OR replies authored by current user\r\n    const { data } = await supabase\r\n      .from('series_comments')\r\n      .select('*')\r\n      .eq('parent_id', parentId)\r\n      .or(`is_flagged.eq.false,user_id.eq.${currentUserId}`)\r\n      .order('created_at', { ascending: true });\r\n\r\n    if (data) {\r\n      const userIds = [...new Set(data.map((c: any) => c.user_id))].filter(Boolean);\r\n      const profileMap: Record<string, any> = {};\r\n      if (userIds.length > 0) {\r\n        const { data: profiles } = await supabase\r\n          .from('profiles')\r\n          .select('id, username, first_name, last_name, email, avatar_url, avatar_frame_id')\r\n          .in('id', userIds);\r\n        profiles?.forEach((p: any) => {\r\n          profileMap[p.id] = p;\r\n        });\r\n      }\r\n      setReplies(prev => ({\r\n        ...prev,\r\n        [parentId]: data.map((c: any) => {\r\n          const prof = profileMap[c.user_id];\r\n          return {\r\n            ...c,\r\n            user_name: resolveDisplayUsername(prof, null, c.user_name, c.user_id),\r\n            avatar_url: c.avatar_url || prof?.avatar_url || '',\r\n            frame_id: prof?.avatar_frame_id || 'none'\r\n          };\r\n        })\r\n      }));\r\n    }\r\n    setExpandedReplies(prev => ({ ...prev, [parentId]: true }));\r\n  };\r\n\r\n  const handleCommentSubmit = async (parentId: string | null = null) => {\r\n    if (!commentText.trim() || commentText.length > MAX_CHARS) return;\r\n    setIsSubmitting(true);\r\n\r\n    const { data: { user }, error: authError } = await supabase.auth.getUser();\r\n    if (authError || !user) {\r\n      setIsSubmitting(false);\r\n      onRequireAuth();\r\n      return;\r\n    }\r\n\r\n    if (!seriesSlug) {\r\n      setIsSubmitting(false);\r\n      setToastConfig({ message: 'Error: Series identifier is missing.', type: 'error' });\r\n      return;\r\n    }\r\n\r\n    const isFlagged = containsInappropriateLanguage(commentText);\r\n    const cleaned = cleanText(commentText.trim());\r\n    const resolvedPosterName = resolveDisplayUsername(\r\n      currentUser ? { username: currentUser.name } : null,\r\n      user,\r\n      currentUser?.name,\r\n      user.id\r\n    );\r\n\r\n    const newComment = {\r\n      series_slug: seriesSlug,\r\n      user_id: user.id,\r\n      user_name: resolvedPosterName,\r\n      avatar_url: currentUser?.avatar || '',\r\n      text: cleaned,\r\n      parent_id: parentId,\r\n      is_flagged: isFlagged\r\n    };\r\n\r\n    const { data, error } = await supabase.from('series_comments').insert([newComment]).select().single();\r\n\r\n    if (!error && data) {\r\n      const newCommentWithFrame = {\r\n        ...data,\r\n        user_name: resolvedPosterName,\r\n        frame_id: currentUser?.frameId || 'none'\r\n      };\r\n      if (parentId) {\r\n        setReplies(prev => ({ ...prev, [parentId]: [...(prev[parentId] || []), newCommentWithFrame] }));\r\n        setExpandedReplies(prev => ({ ...prev, [parentId]: true }));\r\n        setReplyingTo(null);\r\n      } else {\r\n        setComments(prev => [newCommentWithFrame, ...prev]);\r\n      }\r\n      setCommentText('');\r\n\r\n      // --- FANDOM SCORE & SMART COMMENT COUNT INCREMENT (+3 Score, +1 Comment) ---\r\n      supabase\r\n        .from('profiles')\r\n        .select('fandom_score, quick_reacts')\r\n        .eq('id', user.id)\r\n        .maybeSingle()\r\n        .then(({ data: profileData }) => {\r\n          if (profileData) {\r\n            supabase\r\n              .from('profiles')\r\n              .update({\r\n                fandom_score: (profileData.fandom_score || 0) + 3,\r\n                quick_reacts: (profileData.quick_reacts || 0) + 1\r\n              })\r\n              .eq('id', user.id)\r\n              .then(() => {\r\n                window.dispatchEvent(new Event('profileUpdated'));\r\n              });\r\n          }\r\n        });\r\n    } else {\r\n      console.error('Supabase insert error:', error);\r\n      setToastConfig({\r\n        message: error ? `Error: ${error.message}` : 'Failed to post comment.',\r\n        type: 'error'\r\n      });\r\n    }\r\n    setIsSubmitting(false);\r\n  };\r\n\r\n  const handleHypeComment = async (commentId: string) => {\r\n    if (!currentUser) {\r\n      onRequireAuth();\r\n      return;\r\n    }\r\n    const isHyped = commentHypes[commentId]?.hasHyped;\r\n    const currentCount = commentHypes[commentId]?.count || 0;\r\n\r\n    setCommentHypes(prev => ({\r\n      ...prev,\r\n      [commentId]: { count: isHyped ? Math.max(0, currentCount - 1) : currentCount + 1, hasHyped: !isHyped }\r\n    }));\r\n\r\n    if (isHyped) {\r\n      await supabase\r\n        .from('hypes')\r\n        .delete()\r\n        .match({ target_type: 'comment', target_id: String(commentId), user_id: currentUser.id });\r\n    } else {\r\n      await supabase\r\n        .from('hypes')\r\n        .insert([{ target_type: 'comment', target_id: String(commentId), user_id: currentUser.id }]);\r\n    }\r\n  };\r\n\r\n  const handleReportComment = async (commentId: string) => {\r\n    if (!currentUser) {\r\n      onRequireAuth();\r\n      return;\r\n    }\r\n    if (reportedComments.includes(commentId)) return;\r\n    setReportedComments(prev => [...prev, commentId]);\r\n\r\n    const { error } = await supabase\r\n      .from('comment_reports')\r\n      .insert([{ comment_id: commentId, reported_by: currentUser.id }]);\r\n    if (error) {\r\n      setReportedComments(prev => prev.filter(id => id !== commentId));\r\n      setToastConfig({ message: 'Failed to send report.', type: 'error' });\r\n    } else {\r\n      setToastConfig({ message: 'Report submitted.', type: 'success' });\r\n    }\r\n  };\r\n\r\n  const isFreeCommentingOpen = Date.now() <= FREE_COMMENTS_END_MS;\r\n\r\n  // --- PREMIUM ONLY GATE (Automatically bypassed until Sunday, Nov 8 @ Midnight EST) ---\r\n  if (!isPremiumUser && currentUser && !isFreeCommentingOpen) {\r\n    return (\r\n      <div className=\"relative w-full max-w-4xl mx-auto px-6 py-12 border-t border-zinc-900 mt-12\">\r\n        <h3 className=\"text-2xl font-black italic uppercase tracking-tighter text-white mb-8\">Community <span className=\"text-[#fe9a00]\">Discussion</span></h3>\r\n        <div className=\"bg-zinc-900/50 border border-zinc-800 rounded-2xl p-12 flex flex-col items-center text-center shadow-2xl relative overflow-hidden\">\r\n          <div className=\"absolute top-0 right-0 w-32 h-32 bg-[#fe9a00]/10 rounded-bl-full blur-2xl pointer-events-none\" />\r\n          <Lock className=\"w-12 h-12 text-[#fe9a00] mb-6 drop-shadow-lg\" />\r\n          <h4 className=\"text-2xl font-black italic uppercase text-white mb-3\">Pro Exclusive Lounge</h4>\r\n          <p className=\"text-zinc-400 text-sm max-w-md mb-8 leading-relaxed font-bold\">\r\n            The community discussion is a highly curated, troll-free zone reserved for Saturday AM+ members. Upgrade to join the conversation and reply to fans!\r\n          </p>\r\n          <button onClick={() => window.dispatchEvent(new CustomEvent('navigate', { detail: { action: 'sub' } }))} className=\"bg-[#fe9a00] text-black px-10 py-4 rounded-full font-black uppercase tracking-widest hover:bg-white transition-all shadow-[0_0_20px_rgba(254,154,0,0.4)] hover:scale-105 cursor-pointer\">\r\n            Upgrade to Pro\r\n          </button>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"relative w-full max-w-4xl mx-auto px-6 py-12 border-t border-zinc-900 mt-12\">\r\n\r\n      {toastConfig && (\r\n        <div className=\"fixed bottom-24 sm:bottom-28 left-1/2 -translate-x-1/2 z-[6000] bg-black border border-zinc-700 text-white px-6 py-3 rounded-full shadow-[0_10px_40px_rgba(0,0,0,0.8)] flex items-center gap-3 animate-fade-in pointer-events-none\">\r\n          {toastConfig.type === 'error' ? <AlertCircle className=\"w-4 h-4 text-red-500\" /> :\r\n           toastConfig.type === 'pending' ? <Shield className=\"w-4 h-4 text-[#fe9a00]\" /> :\r\n           <CheckCircle2 className=\"w-4 h-4 text-green-500\" />}\r\n          <span className=\"text-[10px] font-black uppercase tracking-widest\">{toastConfig.message}</span>\r\n        </div>\r\n      )}\r\n\r\n      <div className=\"flex items-center justify-between mb-8\">\r\n        <h3 className=\"text-2xl font-black italic uppercase tracking-tighter text-white\">Community <span className=\"text-[#fe9a00]\">Discussion</span></h3>\r\n      </div>\r\n\r\n      <div className=\"flex gap-4 mb-10 bg-zinc-900/40 p-4 rounded-xl border border-zinc-800/50\">\r\n        <DecoratedAvatar avatarUrl={currentUser?.avatar} frameId={currentUser?.frameId} size=\"w-10 h-10\" iconSize=\"w-5 h-5\" />\r\n        <div className=\"flex-1 flex flex-col items-end gap-2\">\r\n          <div className=\"relative w-full\">\r\n            <textarea\r\n              value={replyingTo === null ? commentText : ''}\r\n              onChange={(e) => { if (replyingTo === null) setCommentText(e.target.value.slice(0, MAX_CHARS)); }}\r\n              placeholder={`Start a discussion... (${MAX_CHARS} characters max)`}\r\n              className=\"w-full bg-zinc-900 border border-zinc-800 text-white text-sm px-4 py-3 pb-8 rounded-lg focus:outline-none focus:border-[#fe9a00] transition-colors resize-none h-24\"\r\n              onFocus={() => setReplyingTo(null)}\r\n            />\r\n            <span className={`absolute bottom-3 right-3 text-[10px] font-black uppercase tracking-widest ${replyingTo === null && commentText.length >= MAX_CHARS ? 'text-red-500' : 'text-zinc-500'}`}>\r\n              {replyingTo === null ? commentText.length : 0}/{MAX_CHARS}\r\n            </span>\r\n          </div>\r\n          <button\r\n            onClick={() => handleCommentSubmit(null)}\r\n            disabled={isSubmitting || !commentText.trim() || replyingTo !== null}\r\n            className=\"bg-zinc-800 text-[#fe9a00] border border-[#fe9a00]/30 px-6 py-2 rounded text-[10px] font-black uppercase tracking-widest hover:bg-[#fe9a00] hover:text-black hover:border-[#fe9a00] transition-all flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer\"\r\n          >\r\n            {isSubmitting && replyingTo === null ? 'Posting...' : 'Post Thread'}\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"flex flex-col gap-6 mb-8\">\r\n{comments.map((comment) => {\r\n          return (\r\n            <div key={comment.id} className=\"flex flex-col gap-3 group animate-fade-in border-b border-zinc-900/50 pb-6\">\r\n              <div className=\"flex gap-4\">\r\n                <DecoratedAvatar avatarUrl={comment.avatar_url} frameId={comment.frame_id} size=\"w-10 h-10\" iconSize=\"w-5 h-5\" />\r\n                <div className=\"flex-1 flex flex-col\">\r\n                  <div className=\"flex items-baseline gap-2 mb-1\">\r\n                    <span className=\"text-[#fe9a00] font-black tracking-widest uppercase text-[10px]\">\r\n                      {comment.user_name}\r\n                    </span>\r\n                    <span className=\"text-zinc-600 text-[8px] font-bold tracking-widest uppercase\">\r\n                      {new Date(comment.created_at).toLocaleDateString()}\r\n                    </span>\r\n                  </div>\r\n                  <p className=\"text-zinc-300 text-xs leading-relaxed whitespace-pre-wrap break-words\">{comment.text}</p>\r\n\r\n                  <div className=\"flex items-center gap-4 mt-2\">\r\n                    <button onClick={() => handleHypeComment(comment.id)} className={`flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest transition-colors cursor-pointer ${commentHypes[comment.id]?.hasHyped ? 'text-[#fe9a00]' : 'text-zinc-500 hover:text-white'}`}>\r\n                      <Flame className={`w-3.5 h-3.5 ${commentHypes[comment.id]?.hasHyped ? 'fill-[#fe9a00]' : ''}`} />\r\n                      {commentHypes[comment.id]?.count || 0}\r\n                    </button>\r\n                    <button onClick={() => setReplyingTo(comment.id)} className=\"flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-zinc-500 hover:text-white transition-colors cursor-pointer\">\r\n                      <MessageSquare className=\"w-3.5 h-3.5\" /> Reply\r\n                    </button>\r\n                    <button onClick={() => handleReportComment(comment.id)} disabled={reportedComments.includes(comment.id)} className={`flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest transition-colors cursor-pointer ${reportedComments.includes(comment.id) ? 'text-red-500/50 cursor-not-allowed' : 'text-zinc-500 hover:text-red-500'}`} title=\"Report Comment\">\r\n                      <Flag className=\"w-3.5 h-3.5\" /> {reportedComments.includes(comment.id) ? 'Reported' : 'Report'}\r\n                    </button>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n\r\n              {/* --- REPLIES SECTION --- */}\r\n              <div className=\"pl-14 flex flex-col gap-3\">\r\n                <button onClick={() => loadReplies(comment.id)} className=\"text-[9px] font-black uppercase tracking-widest text-zinc-600 hover:text-[#fe9a00] transition-colors flex items-center gap-1 w-max cursor-pointer\">\r\n                  <CornerDownRight className=\"w-3 h-3\" /> {expandedReplies[comment.id] ? 'Hide Replies' : 'View Replies'}\r\n                </button>\r\n\r\n                {expandedReplies[comment.id] && replies[comment.id]?.map(reply => (\r\n                  <div key={reply.id} className=\"flex gap-3 mt-2 animate-fade-in bg-zinc-900/20 p-3 rounded-lg border border-zinc-800/30\">\r\n                    <DecoratedAvatar avatarUrl={reply.avatar_url} frameId={reply.frame_id} size=\"w-8 h-8\" iconSize=\"w-4 h-4\" />\r\n                    <div className=\"flex-1 flex flex-col\">\r\n                      <div className=\"flex items-baseline gap-2 mb-1\">\r\n                        <span className=\"text-[#fe9a00] font-black tracking-widest uppercase text-[9px]\">{reply.user_name}</span>\r\n                      </div>\r\n                      <p className=\"text-zinc-300 text-[11px] leading-relaxed break-words\">{reply.text}</p>\r\n                    </div>\r\n                  </div>\r\n                ))}\r\n\r\n                {replyingTo === comment.id && (\r\n                  <div className=\"flex flex-col items-end gap-2 mt-2 animate-fade-in-up\">\r\n                    <textarea\r\n                      value={commentText}\r\n                      onChange={(e) => setCommentText(e.target.value.slice(0, MAX_CHARS))}\r\n                      placeholder=\"Write a reply...\"\r\n                      className=\"w-full bg-zinc-900 border border-[#fe9a00]/30 text-white text-xs px-3 py-2 rounded-lg focus:outline-none focus:border-[#fe9a00] transition-colors resize-none h-16\"\r\n                    />\r\n                    <div className=\"flex items-center gap-2\">\r\n                      <button onClick={() => { setReplyingTo(null); setCommentText(''); }} className=\"text-zinc-500 hover:text-white text-[9px] font-black uppercase tracking-widest px-3 py-1.5 cursor-pointer\">Cancel</button>\r\n                      <button\r\n                        onClick={() => handleCommentSubmit(comment.id)}\r\n                        disabled={isSubmitting || !commentText.trim()}\r\n                        className=\"bg-[#fe9a00] text-black px-4 py-1.5 rounded text-[9px] font-black uppercase tracking-widest hover:bg-white transition-all disabled:opacity-50 cursor-pointer\"\r\n                      >\r\n                        {isSubmitting ? '...' : 'Reply'}\r\n                      </button>\r\n                    </div>\r\n                  </div>\r\n                )}\r\n              </div>\r\n\r\n            </div>\r\n          );\r\n        })}\r\n\r\n        {comments.length === 0 && (\r\n          <div className=\"text-center py-12 border-2 border-dashed border-zinc-800 rounded-xl\">\r\n            <p className=\"text-zinc-500 font-bold uppercase tracking-widest text-xs\">No comments yet. Be the first to start a thread!</p>\r\n          </div>\r\n        )}\r\n      </div>\r\n\r\n      {hasMore && comments.length > 0 && (\r\n        <div className=\"flex justify-center mt-4\">\r\n          <button\r\n            onClick={handleLoadMore}\r\n            disabled={isLoadingMore}\r\n            className=\"border border-zinc-700 text-zinc-400 px-8 py-3 rounded-full text-[10px] font-black uppercase tracking-widest hover:bg-zinc-800 hover:text-white transition-all disabled:opacity-50 flex items-center gap-2 cursor-pointer\"\r\n          >\r\n            {isLoadingMore ? (\r\n              <><div className=\"w-3 h-3 border-2 border-zinc-500 border-t-white rounded-full animate-spin\" /> Loading...</>\r\n            ) : (\r\n              'Load More Comments'\r\n            )}\r\n          </button>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};",
    "src/MainViews/CharacterRoster.tsx": "import React, { useState, useEffect, useMemo, useCallback } from 'react';\r\nimport {\r\n  Search, X, ArrowLeft, Swords, MapPin, Activity, User,\r\n  Lock, Heart, BookOpen, Zap, AlertCircle, FileText\r\n} from 'lucide-react';\r\nimport { supabase } from '../supabase';\r\nimport { useSeriesData } from '../userSeriesData';\r\nimport { HypeButton } from '../Components/HypeButton';\r\nimport { LikeButton } from '../Components/LikeButton';\r\n\r\nconst getGridGlowClasses = (role: string, isMc: boolean) => {\r\n  if (role === 'Support' && isMc) return 'border-[#fe9a00]/80 hover:border-[#fe9a00] shadow-[0_0_20px_rgba(254,154,0,0.35)]';\r\n  if (role === 'Support') return 'border-cyan-400/70 hover:border-cyan-400 shadow-[0_0_20px_rgba(34,211,238,0.3)]';\r\n  if (role === 'Villain') return 'border-red-600/80 hover:border-red-500 shadow-[0_0_20px_rgba(220,38,38,0.35)]';\r\n  return 'border-zinc-700 hover:border-white shadow-[0_0_15px_rgba(255,255,255,0.15)]';\r\n};\r\n\r\nconst getModalGlowClasses = (role: string, isMc: boolean) => {\r\n  if (role === 'Support' && isMc) return 'border-[#fe9a00] shadow-[0_0_35px_rgba(254,154,0,0.5)]';\r\n  if (role === 'Support') return 'border-cyan-400 shadow-[0_0_35px_rgba(34,211,238,0.5)]';\r\n  if (role === 'Villain') return 'border-red-600 shadow-[0_0_35px_rgba(220,38,38,0.5)]';\r\n  return 'border-white shadow-[0_0_35px_rgba(255,255,255,0.3)]';\r\n};\r\n\r\nconst getModalBackdropGlow = (role: string, isMc: boolean) => {\r\n  if (role === 'Support' && isMc) return 'from-[#fe9a00]/25';\r\n  if (role === 'Support') return 'from-cyan-400/25';\r\n  if (role === 'Villain') return 'from-red-600/25';\r\n  return 'from-white/15';\r\n};\r\n\r\nconst getGroupHeaderColor = (groupName: string) => {\r\n  if (groupName === 'Support') return 'text-cyan-400 drop-shadow-[0_0_8px_rgba(34,211,238,0.5)]';\r\n  if (groupName === 'Villains') return 'text-red-500 drop-shadow-[0_0_8px_rgba(239,68,68,0.5)]';\r\n  if (groupName === 'Neutral') return 'text-zinc-400';\r\n  return 'text-[#fe9a00]';\r\n};\r\n\r\nconst formatLoreChunks = (rawText?: string): string[] => {\r\n  if (!rawText || !rawText.trim()) return [];\r\n  const clean = rawText.trim();\r\n\r\n  if (/\\b1\\.\\s/.test(clean) && /\\b2\\.\\s/.test(clean)) {\r\n    return clean\r\n      .split(/(?=\\b\\d+\\.\\s)/)\r\n      .map(s => s.trim())\r\n      .filter(Boolean);\r\n  }\r\n\r\n  const paragraphs = clean.split(/\\n+/).map(p => p.trim()).filter(Boolean);\r\n  if (paragraphs.length > 1) return paragraphs;\r\n\r\n  const sentences = clean.match(/[^.!?]+[.!?]+(\\s|$)|[^.!?]+$/g) || [clean];\r\n  const chunks: string[] = [];\r\n  for (let i = 0; i < sentences.length; i += 2) {\r\n    const chunk = sentences.slice(i, i + 2).join(' ').trim();\r\n    if (chunk) chunks.push(chunk);\r\n  }\r\n  return chunks;\r\n};\r\n\r\nexport const CharacterRoster = ({ onBack, onNavigate, currentUser, onLoginClick }: any) => {\r\n  const { seriesList = [] } = useSeriesData() || {};\r\n\r\n  const [rawCharacters, setRawCharacters] = useState<any[]>([]);\r\n  const [isLoading, setIsLoading] = useState(true);\r\n  const [searchQuery, setSearchQuery] = useState('');\r\n  const [viewSelection, setViewSelection] = useState('Sort:Role');\r\n  const [selectedChar, setSelectedChar] = useState<any>(null);\r\n  const [activeTab, setActiveTab] = useState<'combat' | 'origin' | 'vitals'>('combat');\r\n\r\n  const [charLikes, setCharLikes] = useState<Record<string, boolean>>({});\r\n  const [upsellConfig, setUpsellConfig] = useState<{ type: 'visitor' | 'premium'; message: string } | null>(null);\r\n\r\n  useEffect(() => {\r\n    if (selectedChar) {\r\n      window.dispatchEvent(new CustomEvent('appOverlayActive', { detail: true }));\r\n      return () => {\r\n        window.dispatchEvent(new CustomEvent('appOverlayActive', { detail: false }));\r\n      };\r\n    }\r\n  }, [selectedChar]);\r\n\r\n  const fetchCharacters = useCallback(async () => {\r\n    setIsLoading(true);\r\n    try {\r\n      const { data, error } = await supabase\r\n        .from('series_characters')\r\n        .select('*')\r\n        .or('is_hidden.is.null,is_hidden.eq.false')\r\n        .order('id', { ascending: true });\r\n      if (error) throw error;\r\n      const updatedRoles = (data || []).map(c => ({\r\n        ...c,\r\n        role_type: c.role_type === 'Hero' ? 'Support' : c.role_type\r\n      }));\r\n      setRawCharacters(updatedRoles);\r\n    } catch (err) {\r\n      console.error('Failed to fetch characters:', err);\r\n      setRawCharacters([]);\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    fetchCharacters();\r\n    window.addEventListener('seriesUpdated', fetchCharacters);\r\n    window.addEventListener('vaultUpdated', fetchCharacters);\r\n    return () => {\r\n      window.removeEventListener('seriesUpdated', fetchCharacters);\r\n      window.removeEventListener('vaultUpdated', fetchCharacters);\r\n    };\r\n  }, [fetchCharacters]);\r\n\r\n  useEffect(() => {\r\n    if (!currentUser || !rawCharacters.length) return;\r\n    const fetchCharLikes = async () => {\r\n      const charIds = rawCharacters.map(c => c.id);\r\n      const { data } = await supabase\r\n        .from('character_likes')\r\n        .select('character_id')\r\n        .eq('user_id', currentUser.id)\r\n        .in('character_id', charIds);\r\n      if (data) {\r\n        const likesMap: Record<string, boolean> = {};\r\n        data.forEach(row => {\r\n          likesMap[row.character_id] = true;\r\n        });\r\n        setCharLikes(likesMap);\r\n      }\r\n    };\r\n    fetchCharLikes();\r\n  }, [currentUser, rawCharacters]);\r\n\r\n  const characters = useMemo(() => {\r\n    if (!Array.isArray(rawCharacters)) return [];\r\n    const safeSeriesList = Array.isArray(seriesList) ? seriesList : [];\r\n    return rawCharacters.map(c => {\r\n      const s = safeSeriesList.find((series: any) => series?.slug === c?.series_slug);\r\n      return { ...c, series_title: s?.title || 'Unknown Series' };\r\n    });\r\n  }, [rawCharacters, seriesList]);\r\n\r\n  useEffect(() => {\r\n    if (isLoading || characters.length === 0) return;\r\n    const targetId = sessionStorage.getItem('am_target_character_id');\r\n    const targetName = sessionStorage.getItem('am_target_character_name');\r\n    if (!targetId && !targetName) return;\r\n\r\n    sessionStorage.removeItem('am_target_character_id');\r\n    sessionStorage.removeItem('am_target_character_name');\r\n\r\n    const matched = characters.find(\r\n      (c: any) =>\r\n        (targetId && String(c.id) === String(targetId)) ||\r\n        (targetName &&\r\n          String(c.name || '')\r\n            .trim()\r\n            .toLowerCase() === String(targetName).trim().toLowerCase())\r\n    );\r\n    if (matched) {\r\n      setSelectedChar(matched);\r\n      setActiveTab('combat');\r\n    }\r\n  }, [isLoading, characters]);\r\n\r\n  const uniqueAffiliations = Array.from(new Set((characters || []).map(c => c?.element).filter(Boolean))).sort();\r\n\r\n  const groupedChars = useMemo(() => {\r\n    let result = characters || [];\r\n\r\n    if (searchQuery) {\r\n      const lowerQuery = searchQuery.toLowerCase();\r\n      result = result.filter(\r\n        c =>\r\n          (c?.name || '').toLowerCase().includes(lowerQuery) ||\r\n          (c?.series_title || '').toLowerCase().includes(lowerQuery)\r\n      );\r\n    }\r\n\r\n    const isRoleFilter = viewSelection.startsWith('RoleFilter:');\r\n    const isAffilFilter = viewSelection.startsWith('AffilFilter:');\r\n    const isSort = viewSelection.startsWith('Sort:');\r\n\r\n    if (isRoleFilter) {\r\n      const activeRole = viewSelection.replace('RoleFilter:', '');\r\n      result = result.filter(c => c?.role_type === activeRole);\r\n    }\r\n    if (isAffilFilter) {\r\n      const activeAffil = viewSelection.replace('AffilFilter:', '');\r\n      result = result.filter(c => c?.element === activeAffil);\r\n    }\r\n\r\n    const groups: { name: string | null; items: any[] }[] = [];\r\n    const currentSortBy = isSort ? viewSelection.replace('Sort:', '') : 'A-Z';\r\n\r\n    if (currentSortBy === 'Role') {\r\n      const mcHeroes = result.filter(c => c?.is_mc && c?.role_type === 'Support');\r\n      const heroes = result.filter(c => !c?.is_mc && c?.role_type === 'Support');\r\n      const villains = result.filter(c => c?.role_type === 'Villain');\r\n      const neutrals = result.filter(c => c?.role_type === 'Neutral');\r\n\r\n      if (mcHeroes.length) groups.push({ name: 'Main Characters', items: mcHeroes });\r\n      if (heroes.length) groups.push({ name: 'Support', items: heroes });\r\n      if (villains.length) groups.push({ name: 'Villains', items: villains });\r\n      if (neutrals.length) groups.push({ name: 'Neutral', items: neutrals });\r\n    } else if (currentSortBy === 'Series' || currentSortBy === 'Affiliation') {\r\n      const key = currentSortBy === 'Series' ? 'series_title' : 'element';\r\n      const uniqueKeys = Array.from(new Set(result.map(c => c[key]).filter(Boolean))).sort();\r\n      uniqueKeys.forEach(k => {\r\n        groups.push({ name: k as string, items: result.filter(c => c[key] === k) });\r\n      });\r\n      const unassigned = result.filter(c => !c[key]);\r\n      if (unassigned.length) groups.push({ name: 'Unassigned', items: unassigned });\r\n    } else {\r\n      const sorted = [...result].sort((a, b) => {\r\n        if (currentSortBy === 'A-Z') return (a.name || '').localeCompare(b.name || '');\r\n        if (currentSortBy === 'Z-A') return (b.name || '').localeCompare(a.name || '');\r\n        return 0;\r\n      });\r\n      groups.push({ name: null, items: sorted });\r\n    }\r\n\r\n    return groups;\r\n  }, [characters, searchQuery, viewSelection]);\r\n\r\n  const handleToggleGridLike = async (e: React.MouseEvent, char: any) => {\r\n    e.stopPropagation();\r\n    if (!currentUser) {\r\n      setUpsellConfig({ type: 'visitor', message: 'Create a Free Account to like characters!' });\r\n      return;\r\n    }\r\n    const currentlyLiked = charLikes[char.id];\r\n    setCharLikes(prev => ({ ...prev, [char.id]: !currentlyLiked }));\r\n\r\n    try {\r\n      if (currentlyLiked) {\r\n        await supabase.from('character_likes').delete().match({ user_id: currentUser.id, character_id: char.id });\r\n      } else {\r\n        await supabase.from('character_likes').insert([{ user_id: currentUser.id, character_id: char.id }]);\r\n      }\r\n    } catch (err) {\r\n      console.error('Failed to sync character like:', err);\r\n      setCharLikes(prev => ({ ...prev, [char.id]: currentlyLiked }));\r\n    }\r\n  };\r\n\r\n  const openCharacterDossier = (char: any) => {\r\n    setSelectedChar(char);\r\n    setActiveTab('combat');\r\n  };\r\n\r\n  const powerChunks = useMemo(() => formatLoreChunks(selectedChar?.powers), [selectedChar?.powers]);\r\n  const weaknessChunks = useMemo(() => formatLoreChunks(selectedChar?.weakness), [selectedChar?.weakness]);\r\n  const originChunks = useMemo(() => formatLoreChunks(selectedChar?.origin), [selectedChar?.origin]);\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-transparent text-white relative z-[100] pb-48\">\r\n      {upsellConfig && (\r\n        <div\r\n          className=\"fixed inset-0 z-[7000] bg-black/90 backdrop-blur-md flex items-center justify-center p-6 animate-fade-in\"\r\n          onClick={e => e.stopPropagation()}\r\n        >\r\n          <div className=\"bg-zinc-900 border border-zinc-800 p-8 rounded-2xl w-full max-w-sm flex flex-col items-center text-center shadow-2xl relative\">\r\n            <button\r\n              onClick={() => setUpsellConfig(null)}\r\n              className=\"absolute top-4 right-4 text-zinc-500 hover:text-white transition-colors cursor-pointer\"\r\n            >\r\n              <X className=\"w-5 h-5\" />\r\n            </button>\r\n            <div className=\"w-16 h-16 bg-zinc-800 rounded-full flex items-center justify-center mb-6 shadow-[0_0_20px_rgba(254,154,0,0.2)]\">\r\n              <Lock className=\"w-8 h-8 text-[#fe9a00]\" />\r\n            </div>\r\n            <h2 className=\"text-2xl font-black italic uppercase tracking-tighter text-white mb-2\">\r\n              {upsellConfig.type === 'visitor' ? 'Account Required' : 'Premium Feature'}\r\n            </h2>\r\n            <p className=\"text-zinc-400 text-xs font-bold leading-relaxed mb-8\">{upsellConfig.message}</p>\r\n            <button\r\n              onClick={() => {\r\n                setUpsellConfig(null);\r\n                if (onLoginClick) onLoginClick();\r\n                else if (onNavigate) onNavigate({ action: 'login' });\r\n              }}\r\n              className=\"w-full bg-[#fe9a00] text-black font-black uppercase tracking-widest py-3 rounded hover:bg-white transition-colors cursor-pointer\"\r\n            >\r\n              Log In / Sign Up\r\n            </button>\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* Top Sticky Filter Header */}\r\n      <div className=\"sticky top-0 z-50 w-full bg-black/90 backdrop-blur-xl px-6 pt-6 pb-4 border-b border-zinc-800 mb-8 shadow-xl pr-16 sm:pr-24\">\r\n        <div className=\"flex flex-col gap-4 max-w-7xl mx-auto\">\r\n          <button\r\n            onClick={onBack}\r\n            className=\"flex items-center gap-2 text-zinc-400 hover:text-white transition-colors w-max cursor-pointer\"\r\n          >\r\n            <ArrowLeft className=\"w-4 h-4\" />\r\n            <span className=\"text-[10px] font-black uppercase tracking-widest\">Back</span>\r\n          </button>\r\n\r\n          <div className=\"flex flex-col lg:flex-row lg:items-end justify-between gap-4\">\r\n            <div>\r\n              <h1 className=\"text-3xl sm:text-4xl font-black italic uppercase tracking-tighter text-white drop-shadow-md\">\r\n                Character <span className=\"text-[#fe9a00]\">Roster</span>\r\n              </h1>\r\n              <p className=\"text-[11px] font-bold text-zinc-400 mt-1\">\r\n                Tap any fighter card to inspect combat abilities, origin files & drop Hypes\r\n              </p>\r\n            </div>\r\n\r\n            <div className=\"flex flex-wrap items-center gap-3 w-full lg:w-auto\">\r\n              <div className=\"relative flex-1 lg:flex-initial\">\r\n                <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500\" />\r\n                <input\r\n                  type=\"text\"\r\n                  placeholder=\"Search character or series...\"\r\n                  value={searchQuery}\r\n                  onChange={e => setSearchQuery(e.target.value)}\r\n                  className=\"bg-zinc-900/90 border border-zinc-700 text-white text-xs rounded-xl pl-9 pr-4 py-2.5 focus:border-[#fe9a00] outline-none w-full sm:w-56 lg:w-64 shadow-inner font-bold\"\r\n                />\r\n              </div>\r\n              <select\r\n                value={viewSelection}\r\n                onChange={e => setViewSelection(e.target.value)}\r\n                className=\"bg-zinc-900/90 border border-zinc-700 text-white text-xs font-bold rounded-xl px-4 py-2.5 outline-none cursor-pointer shadow-inner flex-1 lg:flex-initial min-w-[170px]\"\r\n              >\r\n                <optgroup label=\"Sort & Group\">\r\n                  <option value=\"Sort:Role\">Group: Roles (Default)</option>\r\n                  <option value=\"Sort:Custom Order\">Sort: Custom Order</option>\r\n                  <option value=\"Sort:A-Z\">Sort: A-Z</option>\r\n                  <option value=\"Sort:Z-A\">Sort: Z-A</option>\r\n                  <option value=\"Sort:Series\">Group: Series</option>\r\n                  <option value=\"Sort:Affiliation\">Group: Affiliation</option>\r\n                </optgroup>\r\n                <optgroup label=\"Filter by Role\">\r\n                  <option value=\"RoleFilter:Support\">Role: Support</option>\r\n                  <option value=\"RoleFilter:Villain\">Role: Villain</option>\r\n                  <option value=\"RoleFilter:Neutral\">Role: Neutral</option>\r\n                </optgroup>\r\n                {uniqueAffiliations.length > 0 && (\r\n                  <optgroup label=\"Filter by Affiliation\">\r\n                    {uniqueAffiliations.map((el: any) => (\r\n                      <option key={el} value={`AffilFilter:${el}`}>\r\n                        Affiliation: {el}\r\n                      </option>\r\n                    ))}\r\n                  </optgroup>\r\n                )}\r\n              </select>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Main Character Grid */}\r\n      <div className=\"max-w-7xl mx-auto px-6 py-4 relative z-10\">\r\n        {isLoading ? (\r\n          <div className=\"text-center py-20 bg-black/50 rounded-2xl border border-zinc-800\">\r\n            <div className=\"w-10 h-10 border-4 border-zinc-800 border-t-[#fe9a00] rounded-full animate-spin mx-auto mb-4\" />\r\n            <p className=\"text-zinc-500 text-xs font-bold uppercase tracking-widest\">Loading Roster...</p>\r\n          </div>\r\n        ) : (\r\n          <>\r\n            {groupedChars.map((group, gIdx) => (\r\n              <div key={gIdx} className=\"mb-12\">\r\n                {group.name && (\r\n                  <div className=\"flex items-center gap-4 mb-6\">\r\n                    <h3 className={`font-black italic uppercase text-xl whitespace-nowrap ${getGroupHeaderColor(group.name)}`}>\r\n                      {group.name}\r\n                    </h3>\r\n                    <span className=\"text-[10px] font-black uppercase tracking-widest text-zinc-500 bg-zinc-900 border border-zinc-800 px-2.5 py-0.5 rounded-full\">\r\n                      {group.items.length}\r\n                    </span>\r\n                    <div className=\"flex-1 h-px bg-zinc-800/80\" />\r\n                  </div>\r\n                )}\r\n\r\n                <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-7 gap-4\">\r\n                  {group.items.map((char, index) => (\r\n                    <div\r\n                      key={char?.id || index}\r\n                      onClick={() => openCharacterDossier(char)}\r\n                      className={`group relative rounded-2xl bg-zinc-950/90 border-2 overflow-hidden transition-all duration-300 hover:-translate-y-1.5 cursor-pointer flex flex-col ${getGridGlowClasses(\r\n                        char?.role_type,\r\n                        char?.is_mc\r\n                      )}`}\r\n                    >\r\n                      <div className=\"relative w-full aspect-[4/4.3] bg-zinc-900 overflow-hidden flex items-center justify-center\">\r\n                        <User className=\"w-10 h-10 text-zinc-700 absolute z-0\" />\r\n                        {char?.headshot_url && (\r\n                          <img\r\n                            src={char.headshot_url}\r\n                            alt={char?.name}\r\n                            loading=\"lazy\"\r\n                            decoding=\"async\"\r\n                            onError={e => {\r\n                              e.currentTarget.style.display = 'none';\r\n                            }}\r\n                            className=\"w-full h-full object-cover relative z-10 group-hover:scale-105 transition-transform duration-500\"\r\n                          />\r\n                        )}\r\n\r\n                        {char?.is_mc && (\r\n                          <div className=\"absolute top-2 right-2 bg-[#fe9a00] text-black text-[8px] font-black px-2 py-0.5 rounded-md z-20 uppercase tracking-widest shadow\">\r\n                            MC\r\n                          </div>\r\n                        )}\r\n\r\n                        <button\r\n                          onClick={e => handleToggleGridLike(e, char)}