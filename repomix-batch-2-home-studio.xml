text-black border border-[#fe9a00]/50 font-black uppercase tracking-widest text-[10px] rounded-xl transition-colors cursor-pointer shrink-0\"\r\n                >\r\n                  {isVisitor ? 'Join Free →' : 'Get PLUS →'}\r\n                </button>\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* =====================================================================\r\n          STICKY NAVBAR: VISITORS -> \"JOIN FREE\" | FREE USERS -> \"GET PLUS\"\r\n      ===================================================================== */}\r\n      <nav className=\"sticky top-0 w-full z-[100] px-4 py-3 sm:px-6 sm:py-4 flex justify-between items-center bg-black/85 backdrop-blur-xl border-b border-white/5 shadow-2xl mb-6\">\r\n        <div className=\"flex items-center cursor-pointer flex-shrink-0\" onClick={() => onNavigate({ action: 'home' })}>\r\n          <img src=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/logos/SATURDAY%20AM%20Logo.png\" alt=\"Saturday AM\" className=\"h-9 sm:h-11 md:h-12 object-contain drop-shadow-md hover:scale-105 transition-transform\" />\r\n        </div>\r\n\r\n        <div className=\"flex items-center justify-end gap-1.5 sm:gap-2.5\">\r\n          {isVisitor ? (\r\n            <button\r\n              type=\"button\"\r\n              onClick={onLoginClick}\r\n              className=\"whitespace-nowrap flex items-center gap-1.5 bg-gradient-to-r from-[#fe9a00] to-amber-400 hover:from-white hover:to-white text-black px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full font-black uppercase tracking-widest text-[9px] sm:text-[10px] transition-all shadow-[0_0_15px_rgba(254,154,0,0.45)] hover:scale-105 cursor-pointer\"\r\n              title=\"Create a Free Saturday AM Account\"\r\n            >\r\n              <UserPlus className=\"w-3 h-3 shrink-0\" />\r\n              <span>Join Free</span>\r\n            </button>\r\n          ) : isFreeMember ? (\r\n            <button\r\n              type=\"button\"\r\n              onClick={() => onNavigate({ action: 'sub' })}\r\n              className=\"whitespace-nowrap flex items-center gap-1 bg-gradient-to-r from-[#fe9a00] to-amber-400 hover:from-white hover:to-white text-black px-3 py-1.5 sm:px-4 sm:py-2 rounded-full font-black uppercase tracking-widest text-[9px] sm:text-[10px] transition-all shadow-[0_0_15px_rgba(254,154,0,0.45)] hover:scale-105 cursor-pointer\"\r\n              title=\"Upgrade to Saturday AM+ PLUS ($1.99/mo)\"\r\n            >\r\n              <Zap className=\"w-3 h-3 fill-black shrink-0\" />\r\n              <span>Get PLUS</span>\r\n            </button>\r\n          ) : null}\r\n\r\n          {/* Top-Right Redeem Code / PIN Pill */}\r\n          <button\r\n            type=\"button\"\r\n            onClick={() => {\r\n              setQuickRedeemFeedback(null);\r\n              setShowQuickRedeemModal(true);\r\n            }}\r\n            className=\"whitespace-nowrap flex items-center gap-1 bg-zinc-900 hover:bg-[#fe9a00] text-[#fe9a00] hover:text-black border border-[#fe9a00]/50 px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-full font-black uppercase tracking-widest text-[9px] sm:text-[10px] transition-all cursor-pointer\"\r\n            title=\"Redeem Flash Contest Code, Store Key, or 5-Digit Autograph PIN\"\r\n          >\r\n            <KeyRound className=\"w-3 h-3 shrink-0\" />\r\n            <span className=\"hidden xs:inline sm:inline\">Redeem</span>\r\n          </button>\r\n\r\n          {!currentUser ? null : (\r\n            <div className=\"hidden sm:flex items-center gap-2 cursor-pointer hover:opacity-80 transition-opacity mr-0.5\" onClick={() => onNavigate({ action: 'profile' })}>\r\n              <DecoratedAvatar avatarUrl={currentUser.avatar_url} frameId={currentUser.frame_id} size=\"w-8 h-8\" iconSize=\"w-4 h-4\" />\r\n              {isPlusSubscriber && <span className=\"bg-purple-900/40 border border-purple-500 text-purple-400 px-1.5 py-0.5 rounded text-[8px] sm:text-[9px] font-black tracking-widest uppercase\">PLUS</span>}\r\n            </div>\r\n          )}\r\n\r\n          <button type=\"button\" onClick={handleHardRefresh} disabled={isRefreshingApp} className=\"p-2 bg-zinc-900 border border-zinc-700 rounded-full hover:bg-[#fe9a00] hover:border-[#fe9a00] group transition-all cursor-pointer\" title=\"Refresh App & Clear Cache\">\r\n            <RefreshCw className={`w-4 h-4 sm:w-5 sm:h-5 text-zinc-400 group-hover:text-black transition-colors ${isRefreshingApp ? 'animate-spin text-[#fe9a00]' : ''}`} />\r\n          </button>\r\n\r\n          <div className=\"relative\">\r\n            <button onClick={() => setShowNotifications(!showNotifications)} className=\"p-2 bg-zinc-900 border border-zinc-700 rounded-full hover:bg-[#fe9a00] hover:border-[#fe9a00] group transition-all relative cursor-pointer\">\r\n              <Bell className=\"w-4 h-4 sm:w-5 sm:h-5 text-zinc-400 group-hover:text-black transition-colors\" />\r\n              {visibleNotifications.length > 0 && <span className=\"absolute top-0 right-0 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-zinc-900 animate-pulse\" />}\r\n            </button>\r\n            {showNotifications && (\r\n              <>\r\n                <div className=\"fixed inset-0 z-[190]\" onClick={() => setShowNotifications(false)} />\r\n                <div className=\"absolute top-full mt-2 right-0 w-72 sm:w-80 bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl overflow-hidden z-[200] animate-fade-in-up\">\r\n                  <div className=\"p-4 border-b border-zinc-800 flex justify-between items-center bg-black/50\">\r\n                    <h3 className=\"font-black italic uppercase text-white tracking-widest text-sm\">Updates</h3>\r\n                    <div className=\"flex items-center gap-3\">\r\n                      {visibleNotifications.length > 0 && <button onClick={handleClearAllNotifs} className=\"text-[9px] text-zinc-500 hover:text-white uppercase tracking-widest font-black cursor-pointer\">Clear All</button>}\r\n                      <button onClick={() => setShowNotifications(false)} className=\"text-zinc-500 hover:text-white cursor-pointer\"><X className=\"w-4 h-4 sm:w-5 sm:h-5\" /></button>\r\n                    </div>\r\n                  </div>\r\n                  <div className=\"max-h-96 min-h-[120px] overflow-y-auto no-scrollbar relative bg-black/20\">\r\n                    {visibleNotifications.length === 0 ? (\r\n                      <div className=\"absolute inset-0 flex flex-col items-center justify-center p-6 text-center\">\r\n                        <CheckCircle className=\"w-8 h-8 text-zinc-700 mb-3\" />\r\n                        <span className=\"text-zinc-500 font-bold text-[10px] uppercase tracking-widest\">You're all caught up</span>\r\n                      </div>\r\n                    ) : (\r\n                      visibleNotifications.map(n => (\r\n                        <div key={n.id} onClick={() => handleNotificationClick(n)} className=\"relative group p-4 border-b border-zinc-800/50 hover:bg-zinc-800 cursor-pointer flex gap-3.5 transition-colors pr-10\">\r\n                          <button onClick={e => handleDismissNotif(e, n)} className=\"absolute top-2 right-2 p-1.5 text-zinc-600 hover:text-red-500 opacity-0 group-hover:opacity-100 rounded-full z-10 cursor-pointer\"><X className=\"w-4 h-4\" /></button>\r\n                          {n.thumbnail_url && <img src={n.thumbnail_url} className=\"w-12 h-12 rounded object-cover flex-shrink-0 border border-zinc-700 bg-black\" alt=\"Notification\" />}\r\n                          <div className=\"flex flex-col justify-center w-full min-w-0\">\r\n                            <span className=\"text-white font-black text-xs uppercase tracking-wider truncate\">{n.title}</span>\r\n                            <span className=\"text-zinc-300 text-[10px] font-bold mt-1 line-clamp-2\">{n.message}</span>\r\n                          </div>\r\n                        </div>\r\n                      ))\r\n                    )}\r\n                  </div>\r\n                </div>\r\n              </>\r\n            )}\r\n          </div>\r\n\r\n          <button onClick={onMenuToggle} className=\"p-2 bg-zinc-900 border border-zinc-700 hover:bg-[#fe9a00] hover:border-[#fe9a00] group rounded-full transition-colors cursor-pointer\">\r\n            <Menu className=\"w-4 h-4 sm:w-5 sm:h-5 text-zinc-400 group-hover:text-black transition-colors\" />\r\n          </button>\r\n        </div>\r\n      </nav>\r\n\r\n      <div className=\"px-6\">\r\n        <div className=\"flex justify-between items-center mb-6\">\r\n          <h1 className=\"text-2xl md:text-3xl font-black italic uppercase text-white drop-shadow-md\">Discover</h1>\r\n          <TutorialHelpButton onClick={() => setForceTutorial(true)} />\r\n        </div>\r\n\r\n        {/* Hero Banner Carousel with Left/Right Arrows */}\r\n        <div className=\"mb-8 w-full flex flex-col items-center\">\r\n          <div className=\"w-full relative overflow-hidden rounded-lg mb-4 aspect-[2/3] md:aspect-[3/1] bg-zinc-900/80 border border-zinc-800/50 shadow-xl group\">\r\n            {heroSlides.map((slide, index) => (\r\n              <div key={slide.id} onClick={() => handleSlideClick(slide)} className={`absolute inset-0 transition-opacity duration-1000 ease-in-out cursor-pointer ${index === currentSlide ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}>\r\n                <img src={slide.mobile_url} alt={`Slide ${index}`} className=\"md:hidden w-full h-full object-cover\" />\r\n                <img src={slide.desktop_url} alt={`Slide ${index}`} className=\"hidden md:block w-full h-full object-cover\" />\r\n              </div>\r\n            ))}\r\n\r\n            {heroSlides.length > 1 && (\r\n              <>\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={e => {\r\n                    e.stopPropagation();\r\n                    setCurrentSlide(prev => (prev - 1 + heroSlides.length) % heroSlides.length);\r\n                  }}\r\n                  aria-label=\"Previous slide\"\r\n                  className=\"absolute left-3 top-1/2 -translate-y-1/2 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/75 hover:bg-[#fe9a00] text-white hover:text-black border border-zinc-700 hover:border-[#fe9a00] flex items-center justify-center transition-all shadow-lg cursor-pointer\"\r\n                >\r\n                  <ChevronLeft className=\"w-5 h-5 sm:w-6 sm:h-6\" />\r\n                </button>\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={e => {\r\n                    e.stopPropagation();\r\n                    setCurrentSlide(prev => (prev + 1) % heroSlides.length);\r\n                  }}\r\n                  aria-label=\"Next slide\"\r\n                  className=\"absolute right-3 top-1/2 -translate-y-1/2 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/75 hover:bg-[#fe9a00] text-white hover:text-black border border-zinc-700 hover:border-[#fe9a00] flex items-center justify-center transition-all shadow-lg cursor-pointer\"\r\n                >\r\n                  <ChevronRight className=\"w-5 h-5 sm:w-6 sm:h-6\" />\r\n                </button>\r\n\r\n                <div className=\"absolute bottom-4 left-0 right-0 z-20 flex justify-center gap-2\">\r\n                  {heroSlides.map((_, index) => (\r\n                    <button key={index} onClick={e => { e.stopPropagation(); setCurrentSlide(index); }} className={`h-1.5 rounded-full transition-all duration-300 cursor-pointer ${index === currentSlide ? 'bg-[#fe9a00] w-6' : 'bg-white/50 w-1.5 hover:bg-white'}`} />\r\n                  ))}\r\n                </div>\r\n              </>\r\n            )}\r\n          </div>\r\n        </div>\r\n\r\n        {/* Latest Chapters Slider */}\r\n        {visibleLatestChapters.length > 0 && (\r\n          <div className=\"mb-10 relative group px-2\">\r\n            <div className=\"flex items-center justify-between gap-3 mb-4\">\r\n              <div className=\"flex items-center gap-3\">\r\n                <svg className=\"w-5 h-5 text-[#fe9a00] ml-1 drop-shadow-[0_0_8px_rgba(254,154,0,0.8)] shrink-0\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\r\n                  <polygon points=\"0,0 8,0 8,24 0,24\" /><polygon points=\"10,0 24,0 24,14 10,8\" /><polygon points=\"10,10 24,16 24,24 10,24\" />\r\n                </svg>\r\n                <h2 className=\"text-xl font-black text-white tracking-wider uppercase drop-shadow-md\">Latest Chapters</h2>\r\n              </div>\r\n\r\n              <div className=\"flex items-center gap-1.5 shrink-0\">\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => scrollContainerByRef(latestChaptersScrollRef, 'left')}\r\n                  aria-label=\"Scroll Latest Chapters left\"\r\n                  className=\"w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-zinc-900/90 hover:bg-[#fe9a00] text-zinc-200 hover:text-black border border-zinc-700 hover:border-[#fe9a00] flex items-center justify-center transition-all shadow-md active:scale-95 cursor-pointer\"\r\n                >\r\n                  <ChevronLeft className=\"w-4 h-4 sm:w-5 sm:h-5\" />\r\n                </button>\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => scrollContainerByRef(latestChaptersScrollRef, 'right')}\r\n                  aria-label=\"Scroll Latest Chapters right\"\r\n                  className=\"w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-zinc-900/90 hover:bg-[#fe9a00] text-zinc-200 hover:text-black border border-zinc-700 hover:border-[#fe9a00] flex items-center justify-center transition-all shadow-md active:scale-95 cursor-pointer\"\r\n                >\r\n                  <ChevronRight className=\"w-4 h-4 sm:w-5 sm:h-5\" />\r\n                </button>\r\n              </div>\r\n            </div>\r\n\r\n            <div ref={latestChaptersScrollRef} className=\"flex overflow-x-auto gap-4 pb-4 scroll-smooth snap-x no-scrollbar items-start\">\r\n              {visibleLatestChapters.map(chapter => {\r\n                const seriesData = seriesList.find((s: any) => s.slug === chapter.series_slug) || {};\r\n                const isFreeOneshotActive = !isPlusSubscriber && isActiveOneShotWednesday(seriesData, seriesList);\r\n                const freeOneshotCountdown = isFreeOneshotActive ? getOneShotFreeCountdown(seriesData, seriesList) : null;\r\n                const showNewBadge = isNewRelease(chapter.publish_at, chapter.created_at);\r\n\r\n                return (\r\n                  <div\r\n                    key={chapter.id}\r\n                    onClick={() => onNavigate({ ...seriesData, autoOpenChapterId: chapter.id })}\r\n                    className={`w-[45%] sm:w-[35%] md:w-[25%] flex-shrink-0 cursor-pointer group/card snap-start flex flex-col transition-opacity ${\r\n                      chapter.isAlreadyRead ? 'opacity-75 hover:opacity-100' : ''\r\n                    }`}\r\n                  >\r\n                    <div className=\"relative overflow-hidden rounded-lg aspect-square border-[1px] border-[#fe9a00]/50 shadow-[0_0_20px_rgba(254,154,0,0.4)] group-hover/card:-translate-y-1 group-hover/card:border-[#fe9a00] group-hover/card:shadow-[0_0_30px_rgba(254,154,0,0.8)] transition-all duration-300\">\r\n                      <img src={chapter.thumbnail_url || seriesData.cover_url || `${CLOUDFLARE_BASE_URL}/assets/placeholder-thumb.jpg`} className=\"w-full h-full object-cover\" style={{ objectPosition: chapter.thumbnail_position || '50% 50%', transform: `scale(${(chapter.thumbnail_scale || 100) / 100})` }} alt=\"Chapter Thumbnail\" />\r\n                      <div className=\"absolute bottom-0 inset-x-0 bg-gradient-to-t from-black via-black/80 to-transparent p-3 pt-12 flex items-center justify-between\">\r\n                        <p className=\"text-[#fe9a00] font-black text-[10px] uppercase tracking-widest drop-shadow-[0_0_5px_rgba(254,154,0,0.8)]\">CH. {chapter.chapter_number}</p>\r\n                        {chapter.isAlreadyRead && (\r\n                          <span className=\"text-[8px] font-black uppercase tracking-widest bg-zinc-900/90 text-zinc-400 border border-zinc-700 px-1.5 py-0.5 rounded\">\r\n                            Read\r\n                          </span>\r\n                        )}\r\n                      </div>\r\n                      {freeOneshotCountdown ? (\r\n                        <div className=\"absolute top-1.5 right-1.5 z-30 bg-[#fe9a00] text-black text-[8px] font-black uppercase tracking-tight px-2 py-0.5 rounded shadow-[0_0_12px_rgba(254,154,0,0.9)] flex items-center gap-1 pointer-events-none\">\r\n                          <Clock className=\"w-2.5 h-2.5 shrink-0\" /><span>FREE: {freeOneshotCountdown}</span>\r\n                        </div>\r\n                      ) : showNewBadge && !chapter.isAlreadyRead && (\r\n                        <div className=\"absolute top-1.5 right-1.5 z-30 bg-red-600 text-white text-[8px] font-black uppercase tracking-widest px-1.5 py-0.5 rounded shadow-[0_0_10px_rgba(220,38,38,0.8)] animate-pulse pointer-events-none\">NEW!</div>\r\n                      )}\r\n                    </div>\r\n                    <div className=\"mt-3 px-1 flex flex-col flex-1\">\r\n                      <h3 className=\"text-white font-bold text-xs truncate group-hover/card:text-[#fe9a00] transition-colors\">{seriesData.title}</h3>\r\n                      <p className=\"text-zinc-400 text-[10px] font-bold truncate mt-0.5\">{chapter.title || `Chapter ${chapter.chapter_number}`}</p>\r\n                    </div>\r\n                  </div>\r\n                );\r\n              })}\r\n            </div>\r\n          </div>\r\n        )}\r\n\r\n        {/* Jump Back In Slider */}\r\n        {recentReads.length > 0 && (\r\n          <div className=\"mb-12 animate-fade-in bg-black/40 p-4 rounded-xl border border-zinc-800/50\">\r\n            <div className=\"flex items-center justify-between gap-3 mb-4 px-2\">\r\n              <h2 className=\"text-xl md:text-2xl font-black italic uppercase tracking-wider text-white drop-shadow-md\">Jump Back In</h2>\r\n              <div className=\"flex items-center gap-1.5 shrink-0\">\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => scrollContainerByRef(recentReadsScrollRef, 'left')}\r\n                  aria-label=\"Scroll Jump Back In left\"\r\n                  className=\"w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-zinc-900/90 hover:bg-[#fe9a00] text-zinc-200 hover:text-black border border-zinc-700 hover:border-[#fe9a00] flex items-center justify-center transition-all shadow-md active:scale-95 cursor-pointer\"\r\n                >\r\n                  <ChevronLeft className=\"w-4 h-4 sm:w-5 sm:h-5\" />\r\n                </button>\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => scrollContainerByRef(recentReadsScrollRef, 'right')}\r\n                  aria-label=\"Scroll Jump Back In right\"\r\n                  className=\"w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-zinc-900/90 hover:bg-[#fe9a00] text-zinc-200 hover:text-black border border-zinc-700 hover:border-[#fe9a00] flex items-center justify-center transition-all shadow-md active:scale-95 cursor-pointer\"\r\n                >\r\n                  <ChevronRight className=\"w-4 h-4 sm:w-5 sm:h-5\" />\r\n                </button>\r\n              </div>\r\n            </div>\r\n            <div ref={recentReadsScrollRef} className=\"flex gap-4 overflow-x-auto pb-4 px-2 scroll-smooth no-scrollbar\">\r\n              {recentReads.map(read => (\r\n                <div key={read.id} onClick={() => onNavigate({ ...read.target, autoOpenChapterId: read.chapter_id, autoOpenPage: read.page_index })} className=\"relative min-w-[140px] w-[140px] md:min-w-[180px] md:w-[180px] aspect-[2/3] rounded-xl overflow-hidden cursor-pointer group border-[1px] border-white shadow-[5px_5px_0px_0px_#fe9a00] hover:-translate-y-1 transition-all duration-300 flex-shrink-0 mb-3\">\r\n                  <img src={read.image} alt={read.title} className=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" />\r\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex flex-col justify-end p-3 z-10\">\r\n                    <h3 className=\"text-white font-black uppercase text-xs md:text-sm leading-tight line-clamp-1\">{read.title}</h3>\r\n                    <div className=\"flex justify-between items-center mt-1\">\r\n                      <p className=\"text-[#fe9a00] font-bold text-[9px] md:text-[10px] uppercase tracking-widest\">{read.subtitle}</p>\r\n                      <p className=\"text-zinc-300 font-bold text-[8px] md:text-[9px] uppercase tracking-widest bg-black/60 px-1.5 py-0.5 rounded border border-zinc-700\">Pg. {read.page_index + 1}</p>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          </div>\r\n        )}\r\n\r\n        {homeSections.map(section => {\r\n          const seriesInSection = seriesList\r\n            .filter((s: any) => s.home_section === section.title && !s.is_hidden && isReleasedYet(s.publish_at))\r\n            .sort((a: any, b: any) => (a.display_order || 99) - (b.display_order || 99));\r\n          if (seriesInSection.length === 0) return null;\r\n          return (\r\n            <SeriesSection\r\n              key={section.id} title={section.title} series={seriesInSection} onSeriesClick={onNavigate}\r\n              currentUser={currentUser} userTier={userTier} nextScheduledBySeries={nextScheduledBySeries} onRequireAuth={onLoginClick}\r\n            />\r\n          );\r\n        })}\r\n      </div>\r\n    </div>\r\n  );\r\n};"
  }
}