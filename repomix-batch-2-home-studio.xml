  <input\r\n                  type=\"text\"\r\n                  placeholder=\"Paste direct .mp4 URL or click Upload .MP4...\"\r\n                  value={activeCampaign.videoUrl || ''}\r\n                  onChange={e => {\r\n                    setVideoUploadError('');\r\n                    updateActiveCampaign({\r\n                      videoUrl: normalizeHouseAdVideoUrl(e.target.value)\r\n                    });\r\n                  }}\r\n                  className=\"flex-1 bg-black border border-zinc-700 rounded-lg px-3 py-2 text-xs text-white font-bold focus:outline-none focus:border-emerald-400\"\r\n                />\r\n\r\n                <label className=\"px-3.5 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-black text-[10px] font-black uppercase tracking-widest flex items-center gap-1.5 cursor-pointer shrink-0 shadow-[0_0_15px_rgba(16,185,129,0.25)]\">\r\n                  <Upload className=\"w-3.5 h-3.5\" />\r\n                  {uploadingField === 'videoUrl' ? 'Uploading...' : 'Upload .MP4'}\r\n                  <input\r\n                    type=\"file\"\r\n                    accept=\"video/mp4,video/webm,video/quicktime\"\r\n                    onChange={handleVideoFileUpload}\r\n                    className=\"hidden\"\r\n                  />\r\n                </label>\r\n              </div>\r\n\r\n              {hasImgurAlbumUrl && (\r\n                <div className=\"bg-amber-950/70 border border-amber-500/60 text-amber-200 rounded-xl p-2.5 text-[10px] font-bold flex items-start gap-2 leading-relaxed\">\r\n                  <AlertCircle className=\"w-4 h-4 text-amber-400 shrink-0 mt-0.5\" />\r\n                  <span>\r\n                    <strong className=\"text-white\">Imgur Album Link Detected (`imgur.com/a/...`):</strong> Imgur album webpages hide the actual `.mp4` filename. Either click <strong className=\"text-emerald-400\">&ldquo;Upload .MP4&rdquo;</strong> on the right to upload your video file directly from your PC, or right-click the playing video on Imgur and select <strong className=\"text-white\">&ldquo;Copy video address&rdquo;</strong> (`https://i.imgur.com/...mp4`).\r\n                  </span>\r\n                </div>\r\n              )}\r\n\r\n              {videoUploadError && (\r\n                <p className=\"text-[10px] text-amber-300 font-bold\">{videoUploadError}</p>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1\">\r\n                Top Badge Label\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                value={activeCampaign.badge}\r\n                onChange={e => updateActiveCampaign({ badge: e.target.value })}\r\n                className=\"w-full bg-black border border-zinc-700 rounded-lg px-3 py-2 text-xs text-white font-bold\"\r\n              />\r\n            </div>\r\n            <div className=\"sm:col-span-2\">\r\n              <label className=\"block text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1\">\r\n                Main Headline (Auto-scales so full title is always visible)\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                value={activeCampaign.headline}\r\n                onChange={e => updateActiveCampaign({ headline: e.target.value })}\r\n                className=\"w-full bg-black border border-zinc-700 rounded-lg px-3 py-2 text-xs text-white font-bold\"\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\r\n            <div className=\"sm:col-span-2\">\r\n              <label className=\"block text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1\">\r\n                Subheadline / Perks Strip\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                value={activeCampaign.subheadline}\r\n                onChange={e => updateActiveCampaign({ subheadline: e.target.value })}\r\n                className=\"w-full bg-black border border-zinc-700 rounded-lg px-3 py-2 text-xs text-white font-bold\"\r\n              />\r\n            </div>\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1\">\r\n                Price Tag Badge\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                placeholder=\"e.g. $24.99\"\r\n                value={activeCampaign.priceLabel || ''}\r\n                onChange={e => updateActiveCampaign({ priceLabel: e.target.value })}\r\n                className=\"w-full bg-black border border-zinc-700 rounded-lg px-3 py-2 text-xs text-[#fe9a00] font-black\"\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-zinc-800\">\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1\">\r\n                CTA Button Text\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                value={activeCampaign.ctaLabel}\r\n                onChange={e => updateActiveCampaign({ ctaLabel: e.target.value })}\r\n                className=\"w-full bg-black border border-zinc-700 rounded-lg px-3 py-2 text-xs text-white font-bold\"\r\n              />\r\n            </div>\r\n\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1\">\r\n                Button Action\r\n              </label>\r\n              <select\r\n                value={activeCampaign.actionType}\r\n                onChange={e =>\r\n                  updateActiveCampaign({\r\n                    actionType: e.target.value as 'external_url' | 'in_app_plus_upgrade'\r\n                  })\r\n                }\r\n                className=\"w-full bg-black border border-zinc-700 rounded-lg px-3 py-2 text-xs text-white font-bold\"\r\n              >\r\n                <option value=\"external_url\">Open URL / Store Item Link</option>\r\n                <option value=\"in_app_plus_upgrade\">Open In-App PLUS Upgrade</option>\r\n              </select>\r\n            </div>\r\n\r\n            {activeCampaign.actionType === 'external_url' && (\r\n              <div>\r\n                <label className=\"block text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1\">\r\n                  Destination URL\r\n                </label>\r\n                <input\r\n                  type=\"text\"\r\n                  value={activeCampaign.clickUrl || ''}\r\n                  onChange={e => updateActiveCampaign({ clickUrl: e.target.value })}\r\n                  className=\"w-full bg-black border border-zinc-700 rounded-lg px-3 py-2 text-xs text-white font-bold\"\r\n                />\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"lg:col-span-5 flex flex-col\">\r\n          <div className=\"bg-black/80 border border-zinc-800 rounded-2xl p-4 space-y-3.5 sticky top-6\">\r\n            <div className=\"flex items-center justify-between\">\r\n              <span className=\"text-[10px] font-black uppercase tracking-widest text-[#fe9a00] flex items-center gap-1.5\">\r\n                <Eye className=\"w-3.5 h-3.5\" /> Live Modal Preview (Cinematic Hero Crop)\r\n              </span>\r\n              <span className=\"text-[9px] font-bold uppercase tracking-widest text-zinc-400\">\r\n                {currentPlacement === 'rewarded_unlock'\r\n                  ? 'Reward Ad Mode'\r\n                  : currentPlacement === 'timed_popup'\r\n                  ? 'Timed Popup Mode'\r\n                  : 'Reward + Popup'}\r\n              </span>\r\n            </div>\r\n\r\n            <div className=\"bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl\">\r\n              <div className=\"px-3.5 py-2.5 bg-zinc-950 border-b border-zinc-800 flex items-center justify-between\">\r\n                <div className=\"flex items-center gap-2\">\r\n                  <span className=\"px-2 py-0.5 rounded bg-[#fe9a00] text-black text-[8px] font-black uppercase tracking-widest\">\r\n                    {activeCampaign.badge}\r\n                  </span>\r\n                  {currentPlacement === 'timed_popup' ? (\r\n                    <span className=\"text-[10px] font-black uppercase tracking-wider text-zinc-300\">\r\n                      Featured Store Drop\r\n                    </span>\r\n                  ) : (\r\n                    <span className=\"text-[10px] font-black uppercase tracking-wider text-zinc-300\">\r\n                      Unlocking in {activeCampaign.rewardDurationSeconds ?? 15}s...\r\n                    </span>\r\n                  )}\r\n                </div>\r\n\r\n                {currentPlacement === 'timed_popup' && (\r\n                  <span className=\"p-1 rounded-full bg-zinc-900 text-zinc-400 border border-zinc-800\">\r\n                    <X className=\"w-3 h-3\" />\r\n                  </span>\r\n                )}\r\n              </div>\r\n\r\n              <div className=\"relative w-full aspect-video bg-black overflow-hidden\">\r\n                <HouseAdVisualSlide ad={activeCampaign} />\r\n                {currentPlacement !== 'timed_popup' && (\r\n                  <div className=\"absolute bottom-0 left-0 right-0 h-1.5 bg-zinc-800 z-20\">\r\n                    <div className=\"h-full bg-[#fe9a00] w-1/3\" />\r\n                  </div>\r\n                )}\r\n              </div>\r\n\r\n              <div className=\"p-3.5 bg-zinc-950 border-t border-zinc-800 flex items-center justify-between gap-3\">\r\n                <div className=\"min-w-0 flex-1\">\r\n                  <p className=\"text-[9px] font-black uppercase tracking-widest text-[#fe9a00]\">\r\n                    {activeCampaign.badge}\r\n                  </p>\r\n                  <p className=\"text-xs font-black text-white leading-snug break-words\">\r\n                    {activeCampaign.headline}\r\n                  </p>\r\n                </div>\r\n                <span className=\"px-3.5 py-2 rounded-xl bg-[#fe9a00] text-black text-[9px] font-black uppercase tracking-widest flex items-center gap-1 shrink-0 shadow-[0_0_15px_rgba(254,154,0,0.3)]\">\r\n                  {activeCampaign.ctaLabel} <ExternalLink className=\"w-2.5 h-2.5\" />\r\n                </span>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"grid grid-cols-2 gap-2 pt-1\">\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => {\r\n                  setTestCountdown(activeCampaign.rewardDurationSeconds ?? 15);\r\n                  setTestModalMode('rewarded');\r\n                }}\r\n                className=\"py-2.5 px-3 rounded-xl bg-zinc-900 hover:bg-[#fe9a00] text-zinc-200 hover:text-black border border-zinc-700 text-[9px] font-black uppercase tracking-widest flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\r\n              >\r\n                <PlayCircle className=\"w-3.5 h-3.5\" /> Test as Reward Ad\r\n              </button>\r\n\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => {\r\n                  setTestCountdown(0);\r\n                  setTestModalMode('timed_popup');\r\n                }}\r\n                className=\"py-2.5 px-3 rounded-xl bg-zinc-900 hover:bg-[#fe9a00] text-zinc-200 hover:text-black border border-zinc-700 text-[9px] font-black uppercase tracking-widest flex items-center justify-center gap-1.5 transition-colors cursor-pointer\"\r\n              >\r\n                <BellRing className=\"w-3.5 h-3.5\" /> Test Timed Popup\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {testModalMode && (\r\n        <div\r\n          className=\"fixed inset-0 z-[9500] bg-black/90 backdrop-blur-xl flex items-center justify-center p-4 animate-fade-in\"\r\n          onClick={() => setTestModalMode(null)}\r\n        >\r\n          <div\r\n            onClick={e => e.stopPropagation()}\r\n            className=\"bg-zinc-950 border-2 border-[#fe9a00] rounded-3xl overflow-hidden max-w-2xl w-full shadow-[0_0_60px_rgba(254,154,0,0.35)]\"\r\n          >\r\n            <div className=\"px-5 py-3.5 bg-zinc-950 border-b border-zinc-800 flex items-center justify-between\">\r\n              <div className=\"flex items-center gap-2.5\">\r\n                <span className=\"px-2.5 py-0.5 rounded-full bg-[#fe9a00] text-black text-[9px] font-black uppercase tracking-widest\">\r\n                  {activeCampaign.badge}\r\n                </span>\r\n                {testModalMode === 'rewarded' ? (\r\n                  <span className=\"text-xs font-black uppercase tracking-wider text-white\">\r\n                    {testCountdown > 0\r\n                      ? `Chapter Unlocking in ${testCountdown}s...`\r\n                      : '✓ Chapter Unlocked!'}\r\n                  </span>\r\n                ) : (\r\n                  <span className=\"text-xs font-black uppercase tracking-wider text-zinc-300\">\r\n                    Special Event Spotlight\r\n                  </span>\r\n                )}\r\n              </div>\r\n\r\n              {(testModalMode === 'timed_popup' || testCountdown === 0) && (\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => setTestModalMode(null)}\r\n                  className=\"p-1.5 rounded-full bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white border border-zinc-700 cursor-pointer\"\r\n                >\r\n                  <X className=\"w-4 h-4\" />\r\n                </button>\r\n              )}\r\n            </div>\r\n\r\n            <div className=\"relative w-full aspect-video bg-black overflow-hidden\">\r\n              <HouseAdVisualSlide ad={activeCampaign} allowAudio={true} />\r\n            </div>\r\n\r\n            <div className=\"p-5 bg-zinc-950 border-t border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\r\n              <div className=\"min-w-0 flex-1\">\r\n                <span className=\"text-[10px] font-black uppercase tracking-widest text-[#fe9a00] block\">\r\n                  {activeCampaign.badge}\r\n                </span>\r\n                <h4 className=\"text-base sm:text-lg font-black italic uppercase text-white leading-snug break-words\">\r\n                  {activeCampaign.headline}\r\n                </h4>\r\n              </div>\r\n\r\n              <div className=\"flex items-center gap-2.5 shrink-0\">\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => {\r\n                    if (activeCampaign.clickUrl) {\r\n                      window.open(activeCampaign.clickUrl, '_blank');\r\n                    }\r\n                  }}\r\n                  className=\"px-5 py-3 rounded-xl bg-gradient-to-r from-[#fe9a00] via-amber-400 to-[#fe9a00] hover:from-white hover:to-white text-black font-black uppercase tracking-widest text-xs flex items-center gap-1.5 shadow-[0_0_20px_rgba(254,154,0,0.4)] cursor-pointer\"\r\n                >\r\n                  {activeCampaign.ctaLabel} <ExternalLink className=\"w-3.5 h-3.5\" />\r\n                </button>\r\n\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => setTestModalMode(null)}\r\n                  className=\"px-4 py-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white text-xs font-black uppercase tracking-widest border border-zinc-800 cursor-pointer\"\r\n                >\r\n                  Close Preview\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};",
    "src/MainViews/AMNewsPage.tsx": "import { useState, useEffect } from 'react';\r\nimport { ExternalLink, BookOpen, ArrowLeft } from 'lucide-react';\r\nimport { supabase } from '../supabase';\r\n\r\nexport const AMNewsPage = ({ onBack }: any) => {\r\n  const [posts, setPosts] = useState<any[]>([]);\r\n  const [loading, setLoading] = useState(true);\r\n\r\n  useEffect(() => {\r\n    const awardNewsPoints = async () => {\r\n      try {\r\n        const { data: { user } } = await supabase.auth.getUser();\r\n        if (!user) return;\r\n\r\n        const today = new Date().toDateString();\r\n        const storageKey = `am_news_check_${user.id}`;\r\n        if (localStorage.getItem(storageKey) === today) return;\r\n\r\n        const { data: profile } = await supabase\r\n          .from('profiles')\r\n          .select('news_checks, fandom_score')\r\n          .eq('id', user.id)\r\n          .maybeSingle();\r\n\r\n        if (profile) {\r\n          await supabase\r\n            .from('profiles')\r\n            .update({\r\n              news_checks: (profile.news_checks || 0) + 1,\r\n              fandom_score: (profile.fandom_score || 0) + 2\r\n            })\r\n            .eq('id', user.id);\r\n\r\n          localStorage.setItem(storageKey, today);\r\n          window.dispatchEvent(new Event('profileUpdated'));\r\n        }\r\n      } catch (err) {\r\n        console.error('Silent error awarding news points:', err);\r\n      }\r\n    };\r\n\r\n    awardNewsPoints();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    window.scrollTo(0, 0);\r\n    const fetchPosts = async () => {\r\n      try {\r\n        const res = await fetch('https://www.saturday-am.com/wp-json/wp/v2/posts?per_page=12&_embed');\r\n        if (!res.ok) throw new Error('Failed to fetch blog feed');\r\n        const data = await res.json();\r\n        setPosts(Array.isArray(data) ? data : []);\r\n      } catch (err) {\r\n        console.error('Error fetching blog posts:', err);\r\n      } finally {\r\n        setLoading(false);\r\n      }\r\n    };\r\n\r\n    fetchPosts();\r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"relative min-h-screen bg-transparent text-white pb-32\">\r\n      <div className=\"sticky top-0 z-50 bg-black/90 backdrop-blur-xl px-6 pt-6 pb-4 border-b border-zinc-800 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xl pr-16 sm:pr-24\">\r\n        <div className=\"flex flex-col gap-4\">\r\n          <button\r\n            onClick={onBack}\r\n            className=\"flex items-center gap-2 text-zinc-400 hover:text-white transition-colors font-black uppercase tracking-widest text-[10px] w-max cursor-pointer\"\r\n          >\r\n            <ArrowLeft className=\"w-4 h-4\" /> Back to Home\r\n          </button>\r\n          <h2 className=\"text-3xl md:text-4xl font-black italic uppercase tracking-wider text-white drop-shadow-md flex items-center gap-4\">\r\n            <BookOpen className=\"w-8 h-8 text-[#fe9a00]\" /> AM News\r\n          </h2>\r\n        </div>\r\n        <a\r\n          href=\"https://www.saturday-am.com/blog/\"\r\n          target=\"_blank\"\r\n          rel=\"noopener noreferrer\"\r\n          className=\"text-xs text-[#fe9a00] hover:text-white font-black uppercase tracking-widest flex items-center justify-center gap-2 transition-colors bg-zinc-900 border border-zinc-800 px-5 py-2.5 rounded-full w-full sm:w-auto\"\r\n        >\r\n          Website <ExternalLink className=\"w-4 h-4\" />\r\n        </a>\r\n      </div>\r\n\r\n      <div className=\"max-w-5xl mx-auto px-6\">\r\n        {loading ? (\r\n          <div className=\"flex flex-col items-center justify-center py-32 gap-4 bg-black/40 rounded-2xl border border-zinc-800\">\r\n            <div className=\"w-10 h-10 border-4 border-zinc-800 border-t-[#fe9a00] rounded-full animate-spin\" />\r\n            <span className=\"text-zinc-500 font-bold tracking-widest text-xs uppercase animate-pulse\">\r\n              Loading Transmissions...\r\n            </span>\r\n          </div>\r\n        ) : (\r\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6\">\r\n            {posts.map(post => {\r\n              const imageUrl =\r\n                post._embedded?.['wp:featuredmedia']?.[0]?.source_url ||\r\n                'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/assets/placeholder-thumb.jpg';\r\n\r\n              return (\r\n                <a\r\n                  key={post.id}\r\n                  href={post.link}\r\n                  target=\"_blank\"\r\n                  rel=\"noopener noreferrer\"\r\n                  className=\"relative aspect-[4/3] rounded-xl overflow-hidden cursor-pointer group border border-zinc-800 hover:border-[#fe9a00] transition-all shadow-lg bg-zinc-900 flex flex-col\"\r\n                >\r\n                  <img\r\n                    src={imageUrl}\r\n                    alt=\"Blog Thumbnail\"\r\n                    loading=\"lazy\"\r\n                    className=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-60 group-hover:opacity-80\"\r\n                  />\r\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent flex flex-col justify-end p-5 z-10\">\r\n                    <h3\r\n                      className=\"text-white font-black uppercase text-sm md:text-base leading-tight line-clamp-3 drop-shadow-md group-hover:text-[#fe9a00] transition-colors\"\r\n                      dangerouslySetInnerHTML={{ __html: post.title?.rendered }}\r\n                    />\r\n                    <p className=\"text-zinc-400 font-bold text-[10px] uppercase tracking-widest mt-3 border-t border-zinc-800/50 pt-3\">\r\n                      {new Date(post.date).toLocaleDateString('en-US', {\r\n                        month: 'short',\r\n                        day: 'numeric',\r\n                        year: 'numeric'\r\n                      })}\r\n                    </p>\r\n                  </div>\r\n                </a>\r\n              );\r\n            })}\r\n          </div>\r\n        )}\r\n\r\n        {!loading && (\r\n          <div className=\"mt-12 border-t border-zinc-800 pt-8\">\r\n            <button\r\n              onClick={onBack}\r\n              className=\"w-full max-w-sm mx-auto py-4 bg-zinc-900 border border-zinc-800 text-white font-black uppercase tracking-widest text-[10px] rounded-xl hover:bg-zinc-800 transition-colors flex items-center justify-center gap-2 cursor-pointer\"\r\n            >\r\n              <ArrowLeft className=\"w-4 h-4\" /> Return to App\r\n            </button>\r\n          </div>\r\n        )}\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default AMNewsPage;",
    "src/AmCommandCenter/HomeEditor.tsx": "import { useState, useEffect, useCallback, useMemo } from 'react';\r\nimport {\r\n  X,\r\n  ChevronUp,\r\n  ChevronDown,\r\n  Edit2,\r\n  Plus,\r\n  LayoutGrid,\r\n  Image as ImageIcon,\r\n  RefreshCw,\r\n  CheckCircle2,\r\n  EyeOff,\r\n  FolderOpen,\r\n  Sparkles,\r\n  Package,\r\n  Crop,\r\n  Monitor,\r\n  Smartphone,\r\n  Loader2,\r\n  Crown,\r\n  Flame,\r\n  CreditCard,\r\n  Layers\r\n} from 'lucide-react';\r\nimport { supabase } from '../supabase';\r\nimport { useSeriesData } from '../userSeriesData';\r\n\r\nconst CREATOR_ALIAS_GROUPS: string[][] = [\r\n  ['odunze oguguo', 'whyt manga', 'whyt', 'odunze oguguo (whyt manga)'],\r\n  ['jeyodin', 'jey odin'],\r\n  ['raymond brown', 'rayme3000'],\r\n  ['frank simmonds', 'effessart'],\r\n  ['stefano romano', 'dropkickanimation'],\r\n  ['erick pedrucci', 'eric pedrucci', 'erick perducci', 'eric perducci'],\r\n  ['huzayfa umar', 'zayf', 'huzayfa umar (zayf)'],\r\n  ['yvan soudy', 'staark', 'yvan soudy (staark)'],\r\n  ['frederick l. jones', 'frederick jones', 'fred jones'],\r\n  ['oscar fong', 'oscar ed fong'],\r\n  ['jr de bard', 'j.r. de bard', 'jr debard']\r\n];\r\n\r\nconst matchCreatorNames = (nameA?: string, nameB?: string): boolean => {\r\n  if (!nameA || !nameB) return false;\r\n  const cleanA = String(nameA).trim().toLowerCase().replace(/\\s+/g, ' ');\r\n  const cleanB = String(nameB).trim().toLowerCase().replace(/\\s+/g, ' ');\r\n  if (!cleanA || !cleanB) return false;\r\n  if (cleanA === cleanB || cleanA.includes(cleanB) || cleanB.includes(cleanA)) return true;\r\n  for (const group of CREATOR_ALIAS_GROUPS) {\r\n    const aIn = group.some(a => cleanA === a || cleanA.includes(a) || a.includes(cleanA));\r\n    const bIn = group.some(b => cleanB === b || cleanB.includes(b) || b.includes(cleanB));\r\n    if (aIn && bIn) return true;\r\n  }\r\n  return false;\r\n};\r\n\r\ninterface StudioAssetOption {\r\n  id: string;\r\n  label: string;\r\n  type: 'card_skin' | 'avatar';\r\n  image_url: string;\r\n}\r\n\r\ninterface StudioSignature {\r\n  creator_name: string;\r\n  signature_url: string;\r\n}\r\n\r\nconst loadCorsImage = (url: string): Promise<HTMLImageElement | null> => {\r\n  return new Promise(resolve => {\r\n    if (!url) return resolve(null);\r\n    const img = new Image();\r\n    img.crossOrigin = 'anonymous';\r\n    img.onload = () => resolve(img);\r\n    img.onerror = () => resolve(null);\r\n    img.src = url;\r\n  });\r\n};\r\n\r\nconst drawRoundedRect = (\r\n  ctx: CanvasRenderingContext2D,\r\n  x: number,\r\n  y: number,\r\n  w: number,\r\n  h: number,\r\n  r: number\r\n) => {\r\n  const radius = Math.min(r, w / 2, h / 2);\r\n  ctx.beginPath();\r\n  ctx.moveTo(x + radius, y);\r\n  ctx.arcTo(x + w, y, x + w, y + h, radius);\r\n  ctx.arcTo(x + w, y + h, x, y + h, radius);\r\n  ctx.arcTo(x, y + h, x, y, radius);\r\n  ctx.arcTo(x, y, x + w, y, radius);\r\n  ctx.closePath();\r\n};\r\n\r\nexport const HomeEditor = ({ Dropzone, setIsDirty, onDirty, onClean }: any) => {\r\n  const {\r\n    seriesList: contextSeriesList = [],\r\n    cardSkins: seriesDataSkins = [],\r\n    vaultAvatars: seriesDataAvatars = []\r\n  } = useSeriesData();\r\n\r\n  const [allSeries, setAllSeries] = useState<any[]>([]);\r\n  const [isLoading, setIsLoading] = useState(true);\r\n  const [isSaving, setIsSaving] = useState(false);\r\n\r\n  const [slides, setSlides] = useState<any[]>([]);\r\n  const [sections, setSections] = useState<any[]>([]);\r\n  const [sectionSeries, setSectionSeries] = useState<Record<string, any[]>>({});\r\n\r\n  const [storeProducts, setStoreProducts] = useState<any[]>([]);\r\n  const [dbSkins, setDbSkins] = useState<any[]>([]);\r\n  const [dbAvatars, setDbAvatars] = useState<any[]>([]);\r\n  const [creatorSignatures, setCreatorSignatures] = useState<any[]>([]);\r\n\r\n  // Active Hero Banner Studio State\r\n  const [activeStudioSlideId, setActiveStudioSlideId] = useState<any | null>(null);\r\n  const [studioProductId, setStudioProductId] = useState<string>('');\r\n  const [studioBgUrl, setStudioBgUrl] = useState<string>('');\r\n  const [activeCropDevice, setActiveCropDevice] = useState<'pc' | 'mobile'>('pc');\r\n\r\n  // Separate PC (3:1) Crop Sliders\r\n  const [pcZoom, setPcZoom] = useState<number>(112);\r\n  const [pcPanX, setPcPanX] = useState<number>(50);\r\n  const [pcPanY, setPcPanY] = useState<number>(30);\r\n  const [pcVignette, setPcVignette] = useState<number>(40);\r\n\r\n  // Separate Mobile (2:3) Crop Sliders\r\n  const [mobileZoom, setMobileZoom] = useState<number>(118);\r\n  const [mobilePanX, setMobilePanX] = useState<number>(50);\r\n  const [mobilePanY, setMobilePanY] = useState<number>(25);\r\n  const [mobileVignette, setMobileVignette] = useState<number>(45);\r\n\r\n  const [studioBadge, setStudioBadge] = useState<string>('SPECIAL EDITION DROP');\r\n  const [studioHeadline, setStudioHeadline] = useState<string>('');\r\n  const [studioSubheadline, setStudioSubheadline] = useState<string>('');\r\n  const [studioPriceLabel, setStudioPriceLabel] = useState<string>('');\r\n  const [studioOrigPriceLabel, setStudioOrigPriceLabel] = useState<string>('');\r\n  const [studioCtaLabel, setStudioCtaLabel] = useState<string>('UNLOCK NOW');\r\n  const [studioAvatars, setStudioAvatars] = useState<string[]>([]);\r\n  const [studioSigs, setStudioSigs] = useState<StudioSignature[]>([]);\r\n  const [studioBonusHypes, setStudioBonusHypes] = useState<number>(0);\r\n  const [studioIncludePass, setStudioIncludePass] = useState<boolean>(false);\r\n  const [studioCardCount, setStudioCardCount] = useState<number>(0);\r\n  const [isGeneratingBanners, setIsGeneratingBanners] = useState<boolean>(false);\r\n\r\n  const [draggedSeriesInfo, setDraggedSeriesInfo] = useState<{\r\n    sectionTitle: string;\r\n    index: number;\r\n  } | null>(null);\r\n\r\n  const markDirty = () => {\r\n    if (setIsDirty) setIsDirty(true);\r\n    if (onDirty) onDirty();\r\n  };\r\n\r\n  const markClean = () => {\r\n    if (se