  "files": {
    "public/robots.txt": "User-agent: *\r\nAllow: /\r\n\r\nSitemap: https://www.mangahype.com/sitemap.xml",
    "public/sitemap.xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\r\n  <url>\r\n    <loc>https://www.mangahype.com/</loc>\r\n    <changefreq>daily</changefreq>\r\n    <priority>1.0</priority>\r\n  </url>\r\n</urlset>",
    "src/userSeriesData.tsx": "import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';\r\nimport { supabase } from './supabase';\r\n\r\nconst SeriesContext = createContext<any>(null);\r\n\r\nexport const SeriesProvider = ({ children }: { children: React.ReactNode }) => {\r\n  const [seriesList, setSeriesList] = useState<any[]>([]);\r\n  const [magazines, setMagazines] = useState<any[]>([]);\r\n  const [vaultAvatars, setVaultAvatars] = useState<any[]>([]);\r\n  const [cardSkins, setCardSkins] = useState<any[]>([]);\r\n  const [vaultFrames, setVaultFrames] = useState<any[]>([]);\r\n  const [isLoading, setIsLoading] = useState(true);\r\n\r\n  const fetchAllGlobalData = useCallback(async () => {\r\n    try {\r\n      const [\r\n        seriesRes,\r\n        magazinesRes,\r\n        avatarsRes,\r\n        skinsRes,\r\n        framesRes\r\n      ] = await Promise.all([\r\n        supabase.from('series').select('*, creators:series_creators(*)').order('display_order', { ascending: true }),\r\n        supabase.from('magazines').select('*').order('publish_date', { ascending: false }),\r\n        supabase.from('avatars').select('*').eq('is_active', true).order('created_at', { ascending: false }),\r\n        supabase.from('card_skins').select('*').eq('is_active', true).order('created_at', { ascending: false }),\r\n        supabase.from('avatar_frames').select('*').eq('is_active', true).order('created_at', { ascending: false })\r\n      ]);\r\n\r\n      if (seriesRes.error) throw seriesRes.error;\r\n\r\n      if (seriesRes.data) setSeriesList(seriesRes.data);\r\n      if (magazinesRes.data) setMagazines(magazinesRes.data);\r\n      if (avatarsRes.data) setVaultAvatars(avatarsRes.data);\r\n      if (skinsRes.data) setCardSkins(skinsRes.data);\r\n      if (framesRes.data) setVaultFrames(framesRes.data);\r\n    } catch (error) {\r\n      console.error(\"Global cache fetch error:\", error);\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  }, []);\r\n\r\n  const refreshSeriesData = useCallback(async () => {\r\n    try {\r\n      const { data, error } = await supabase\r\n        .from('series')\r\n        .select('*, creators:series_creators(*)')\r\n        .order('display_order', { ascending: true });\r\n      if (!error && data) {\r\n        setSeriesList(data);\r\n      }\r\n    } catch (err) {\r\n      console.error(\"Failed to refresh series cache:\", err);\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    fetchAllGlobalData();\r\n    window.addEventListener('seriesUpdated', refreshSeriesData);\r\n    return () => window.removeEventListener('seriesUpdated', refreshSeriesData);\r\n  }, [fetchAllGlobalData, refreshSeriesData]);\r\n\r\n  return (\r\n    <SeriesContext.Provider value={{ \r\n      seriesList, \r\n      magazines, \r\n      vaultAvatars, \r\n      cardSkins, \r\n      vaultFrames, \r\n      isLoading,\r\n      refreshSeriesData \r\n    }}>\r\n      {children}\r\n    </SeriesContext.Provider>\r\n  );\r\n};\r\n\r\nexport const useSeriesData = () => useContext(SeriesContext);",
    "functions/share.ts": "export async function onRequest(context: any) {\r\n  const { request } = context;\r\n  const url = new URL(request.url);\r\n  \r\n  // 1. Grab the image and where the user should actually go\r\n  const panelImg = url.searchParams.get('panel');\r\n  const targetUrl = url.searchParams.get('target') || 'https://saturday-am-app-v2.pages.dev';\r\n\r\n  // 2. If we have a panel image, serve the meta tags and a JS redirect!\r\n  // No more User-Agent guessing games. Every visitor gets the tags.\r\n  if (panelImg) {\r\n    const html = `\r\n      <!DOCTYPE html>\r\n      <html lang=\"en\">\r\n      <head>\r\n        <meta charset=\"UTF-8\">\r\n        <meta property=\"og:title\" content=\"Saturday AM - Epic Manga Panel\" />\r\n        <meta property=\"og:description\" content=\"I'm reading the best diverse manga on the Saturday AM app! Check out this panel:\" />\r\n        <meta property=\"og:image\" content=\"${panelImg}\" />\r\n        <meta property=\"og:image:width\" content=\"1080\" />\r\n        <meta property=\"og:image:height\" content=\"1080\" />\r\n        <meta property=\"og:url\" content=\"${request.url}\" />\r\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n        <meta name=\"twitter:image\" content=\"${panelImg}\" />\r\n      </head>\r\n      <body style=\"background: black; color: #fe9a00; font-family: sans-serif; text-align: center; padding-top: 20vh;\">\r\n        <h2>Loading Saturday AM...</h2>\r\n        <!-- Real humans will execute this and redirect instantly -->\r\n        <script>window.location.href=\"${targetUrl}\";</script>\r\n      </body>\r\n      </html>\r\n    `;\r\n    return new Response(html, { headers: { 'Content-Type': 'text/html' } });\r\n  }\r\n\r\n  // 3. Fallback redirect if no panel image is provided\r\n  return Response.redirect(targetUrl, 302);\r\n}",
    "src/Components/ShareModal.tsx": "import { useState, useRef } from 'react';\r\nimport { X, Share2, Copy, CheckCircle2, Image as ImageIcon } from 'lucide-react';\r\nimport { supabase, trackTelemetry } from '../supabase';\r\n\r\nconst MAX_DAILY_REWARDED_SHARES = 3;\r\n\r\nexport const ShareModal = ({ isOpen, onClose, series, chapter, currentUser, targetImage }: any) => {\r\n  const [copied, setCopied] = useState(false);\r\n  const [rewardMessage, setRewardMessage] = useState<string | null>(null);\r\n  const isAwardingRef = useRef(false);\r\n\r\n  if (!isOpen) return null;\r\n\r\n  const isAppShare = !series;\r\n\r\n  const targetSlug = series?.slug || 'app';\r\n  const trackingParams = currentUser?.id ? `?ref=${currentUser.id}&slug=${targetSlug}` : '';\r\n  const baseTargetUrl = isAppShare\r\n    ? `https://www.mangahype.com/${trackingParams}`\r\n    : `https://www.mangahype.com/series/${series.slug}${trackingParams}`;\r\n\r\n  const finalShareUrl = targetImage\r\n    ? `https://www.mangahype.com/share?panel=${encodeURIComponent(targetImage)}&target=${encodeURIComponent(baseTargetUrl)}`\r\n    : baseTargetUrl;\r\n\r\n  const chapterText = chapter ? `Chapter ${chapter.chapter_number} of ` : '';\r\n  const shareText = isAppShare\r\n    ? `I'm reading the best diverse manga on the Saturday AM app! Join me here:`\r\n    : `I'm reading ${chapterText}${series.title} on the Saturday AM app! Read it here:`;\r\n\r\n  const encodedText = encodeURIComponent(`${shareText}\\n\\n${finalShareUrl}`);\r\n  const bskyLink = `https://bsky.app/intent/compose?text=${encodedText}`;\r\n  const threadsLink = `https://www.threads.net/intent/post?text=${encodedText}`;\r\n  const fbLink = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(finalShareUrl)}`;\r\n\r\n  // Anti-Exploit Share Point Awarder:\r\n  // Max 1 reward per unique target per day, capped at MAX_DAILY_REWARDED_SHARES (3) per day\r\n  const awardSharePoints = async () => {\r\n    trackTelemetry('share', {\r\n      series_slug: targetSlug,\r\n      chapter_id: chapter?.id || null,\r\n      share_type: targetImage ? 'panel' : 'link'\r\n    });\r\n\r\n    if (!currentUser?.id || isAwardingRef.current) return;\r\n\r\n    const todayKey = new Date().toISOString().split('T')[0];\r\n    const targetIdentifier = `${targetSlug}_${chapter?.id || chapter?.chapter_number || 'main'}_${targetImage ? 'panel' : 'link'}`;\r\n    const storageKey = `am_share_rewards_${currentUser.id}_${todayKey}`;\r\n\r\n    let rewardedTargets: string[] = [];\r\n    try {\r\n      rewardedTargets = JSON.parse(localStorage.getItem(storageKey) || '[]');\r\n    } catch {\r\n      rewardedTargets = [];\r\n    }\r\n\r\n    // Block point farming if user already shared this exact item today or hit the daily cap\r\n    if (rewardedTargets.includes(targetIdentifier) || rewardedTargets.length >= MAX_DAILY_REWARDED_SHARES) {\r\n      return;\r\n    }\r\n\r\n    isAwardingRef.current = true;\r\n    try {\r\n      const { data: profile } = await supabase\r\n        .from('profiles')\r\n        .select('fandom_score, shares')\r\n        .eq('id', currentUser.id)\r\n        .maybeSingle();\r\n\r\n      if (profile) {\r\n        const updatedTargets = [...rewardedTargets, targetIdentifier];\r\n        localStorage.setItem(storageKey, JSON.stringify(updatedTargets));\r\n\r\n        await supabase\r\n          .from('profiles')\r\n          .update({\r\n            fandom_score: (profile.fandom_score || 0) + 5,\r\n            shares: (profile.shares || 0) + 1\r\n          })\r\n          .eq('id', currentUser.id);\r\n\r\n        setRewardMessage('+5 Fandom Points Earned!');\r\n        setTimeout(() => setRewardMessage(null), 3000);\r\n        window.dispatchEvent(new Event('profileUpdated'));\r\n      }\r\n    } catch (e) {\r\n      console.error('Error awarding share points:', e);\r\n    } finally {\r\n      isAwardingRef.current = false;\r\n    }\r\n  };\r\n\r\n  const handleCopy = () => {\r\n    navigator.clipboard.writeText(`${shareText}\\n\\n${finalShareUrl}`);\r\n    setCopied(true);\r\n    awardSharePoints();\r\n    setTimeout(() => setCopied(false), 2000);\r\n  };\r\n\r\n  const previewImage = targetImage || \"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20load%20screen.jpg\";\r\n\r\n  return (\r\n    <div className=\"fixed inset-0 z-[7000] bg-black/90 backdrop-blur-md flex items-center justify-center p-6 animate-fade-in\" onClick={onClose}>\r\n      <div className=\"bg-zinc-950 border border-zinc-800 p-6 sm:p-8 rounded-2xl w-full max-w-sm flex flex-col items-center text-center shadow-2xl relative\" onClick={e => e.stopPropagation()}>\r\n        <button onClick={onClose} className=\"absolute top-4 right-4 text-zinc-500 hover:text-white transition-colors cursor-pointer\"><X className=\"w-5 h-5\" /></button>\r\n\r\n        <div className=\"w-16 h-16 bg-[#fe9a00]/10 border border-[#fe9a00]/30 rounded-full flex items-center justify-center mb-4 shadow-[0_0_20px_rgba(254,154,0,0.2)]\">\r\n          {targetImage ? <ImageIcon className=\"w-8 h-8 text-[#fe9a00]\" /> : <Share2 className=\"w-8 h-8 text-[#fe9a00]\" />}\r\n        </div>\r\n\r\n        <h2 className=\"text-2xl font-black italic uppercase tracking-tighter text-white mb-2\">\r\n          {targetImage ? 'Share Manga Panel' : 'Spread the Hype'}\r\n        </h2>\r\n        <p className=\"text-zinc-400 text-[10px] font-bold uppercase tracking-widest leading-relaxed mb-4\">\r\n          {targetImage\r\n            ? 'This panel is too epic to keep to yourself! Share it with your followers.'\r\n            : `Share this ${isAppShare ? 'app' : 'series'} with your friends and fellow manga fans!`}\r\n        </p>\r\n\r\n        {rewardMessage && (\r\n          <div className=\"mb-4 px-3 py-1.5 bg-[#fe9a00]/15 border border-[#fe9a00]/50 rounded-full text-[#fe9a00] text-[10px] font-black uppercase tracking-widest animate-fade-in\">\r\n            {rewardMessage}\r\n          </div>\r\n        )}\r\n\r\n        <div className=\"flex flex-col gap-3 w-full\">\r\n\r\n          <div className=\"relative w-full h-40 mb-2 rounded-xl overflow-hidden border border-zinc-800 bg-black\">\r\n            <img src={previewImage} className=\"w-full h-full object-contain opacity-80\" alt=\"Link Preview\" />\r\n            <div className=\"absolute inset-0 flex flex-col justify-end p-2 bg-gradient-to-t from-black to-transparent pointer-events-none\">\r\n              <span className=\"text-[8px] font-black uppercase tracking-widest text-[#fe9a00]\">Link Preview</span>\r\n            </div>\r\n          </div>\r\n\r\n          <a\r\n            href={bskyLink}\r\n            target=\"_blank\"\r\n            rel=\"noopener noreferrer\"\r\n            onClick={awardSharePoints}\r\n            className=\"w-full flex items-center justify-center gap-3 bg-[#0560FF] text-white font-black uppercase tracking-widest py-3 rounded-xl hover:opacity-80 transition-opacity cursor-pointer\"\r\n          >\r\n            <svg viewBox=\"0 0 320 286\" className=\"w-5 h-5 fill-current\">\r\n              <path d=\"M69.3642 19.1462C101.487 39.5444 142.146 80.9702 160 102.73C177.854 80.9702 218.513 39.5444 250.636 19.1462C278.435 1.50343 320 -11.9056 320 28.5283C320 48.7402 301.328 126.857 288.75 142.5C266.398 170.297 220.076 177.674 186.851 170.082C241.97 181.714 278.461 206.592 278.461 234.341C278.461 262.089 203.882 284.582 160 252.052C116.118 284.582 41.5388 262.089 41.5388 234.341C41.5388 206.592 78.0298 181.714 133.149 170.082C99.9239 177.674 53.6015 170.297 31.25 142.5C18.6723 126.857 0 48.7402 0 28.5283C0 -11.9056 41.5645 1.50343 69.3642 19.1462Z\" />\r\n            </svg>\r\n            Bluesky\r\n          </a>\r\n\r\n          <a\r\n            href={threadsLink}\r\n            target=\"_blank\"\r\n            rel=\"noopener noreferrer\"\r\n            onClick={awardSharePoints}\r\n            className=\"w-full flex items-center justify-center gap-3 bg-zinc-900 border border-zinc-700 text-white font-black uppercase tracking-widest py-3 rounded-xl hover:bg-white hover:text-black transition-all group cursor-pointer\"\r\n          >\r\n            <svg viewBox=\"0 0 192 192\" className=\"w-5 h-5 fill-current text-white group-hover:text-black transition-colors\">\r\n              <path d=\"M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.838 116.888 137.71 107.133C137.767 106.666 137.817 106.205 137.861 105.752C138.363 105.536 138.873 105.327 139.367 105.148C146.423 102.582 153.251 100.864 158.462 100.279C160.031 100.101 161.423 99.9818 162.628 99.9079C162.83 104.708 162.775 110.155 162.152 116.313C161.264 125.042 159.043 133.155 155.611 140.354C151.042 149.948 144.174 157.986 135.405 163.955C125.795 170.496 114.475 173.918 101.996 173.918C101.272 173.918 100.548 173.91 99.8251 173.896C84.3414 173.57 71.0505 168.17 60.5284 158.423C50.2319 148.887 44.597 136.314 44.208 121.666C43.8227 107.151 48.7188 94.675 58.4871 85.086C68.0418 75.7077 81.0827 71.0664 96.9743 71.0664C97.1062 71.0664 97.2378 71.0671 97.3698 71.0681C108.319 71.1648 117.857 73.9142 125.59 79.1601C131.258 83.006 136.191 88.0838 140.234 94.2464C140.669 92.5186 141.096 90.7635 141.537 88.9883ZM98.8413 130.016C104.945 129.684 110.151 127.359 114.215 123.143C118.236 118.974 120.301 113.882 120.301 108.067C120.301 103.882 119.167 100.543 116.953 98.1481C114.858 95.882 111.895 94.6192 108.204 94.4173C108.077 94.411 107.949 94.4079 107.82 94.4079C102.946 94.4079 98.6644 96.126 95.2078 99.4795C91.6881 102.894 89.8519 107.411 89.8519 112.871C89.8519 118.243 91.6421 122.686 95.0569 126.046C95.0569 126.046 95.0583 126.047 95.0594 126.049C96.0828 127.054 97.2346 127.912 98.4907 128.583C98.6083 128.647 98.7247 128.706 98.8413 130.016Z\" />\r\n            </svg>\r\n            Threads\r\n          </a>\r\n\r\n          <a\r\n            href={fbLink}\r\n            target=\"_blank\"\r\n            rel=\"noopener noreferrer\"\r\n            onClick={awardSharePoints}\r\n            className=\"w-full flex items-center justify-center gap-3 bg-[#1877F2] text-white font-black uppercase tracking-widest py-3 rounded-xl hover:opacity-80 transition-opacity cursor-pointer\"\r\n          >\r\n            <svg viewBox=\"0 0 24 24\" className=\"w-5 h-5 fill-current\">\r\n              <path d=\"M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z\" />\r\n            </svg>\r\n            Facebook\r\n          </a>\r\n\r\n          <button onClick={handleCopy} className=\"w-full mt-2 bg-black border border-[#fe9a00] text-[#fe9a00] font-black uppercase tracking-widest py-3 rounded-xl hover:bg-[#fe9a00] hover:text-black transition-all flex items-center justify-center gap-2 cursor-pointer\">\r\n            {copied ? <CheckCircle2 className=\"w-4 h-4\" /> : <Copy className=\"w-4 h-4\" />}\r\n            {copied ? 'Link Copied!' : 'Copy Link'}\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};",
    "index.html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    \r\n    <!-- Standard Favicon -->\r\n    <link rel=\"icon\" type=\"image/png\" href=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/pwa-512x512-v4.png?v=4\" />\r\n    \r\n    <!-- Apple Touch Icon (iOS Home Screen) -->\r\n    <link rel=\"apple-touch-icon\" href=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/pwa-512x512-v4.png?v=4\" />\r\n    \r\n    <!-- iOS PWA Standalone Support -->\r\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\r\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\r\n    <meta name=\"apple-mobile-web-app-title\" content=\"Saturday AM\" />\r\n\r\n    <!-- Canonical URL -->\r\n    <link rel=\"canonical\" href=\"https://www.mangahype.com/\" />\r\n    \r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" />\r\n    <meta name=\"theme-color\" content=\"#000000\" />\r\n    <title>Saturday AM App - Read Diverse Manga Online</title>\r\n    \r\n    <!-- Comprehensive Meta Description for Search Engine Indexing -->\r\n    <meta name=\"description\" content=\"Read original diverse manga online with Saturday AM. Explore Apple Black, Clock Striker, Hammer, Underground, Gun+Bone, Orisha, Oblivion Rouge, and more by global creators.\" />\r\n    \r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap\" rel=\"stylesheet\">\r\n\r\n    <!-- Preload the Hype Flame Loader Image so it renders instantaneously -->\r\n    <link rel=\"preload\" as=\"image\" href=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/Hype%20flame.png\" />\r\n\r\n    <!-- OpenGraph & Social Preview Meta Tags -->\r\n    <meta property=\"og:title\" content=\"Saturday AM - Manga Hype\" />\r\n    <meta property=\"og:description\" content=\"Read original diverse manga online with Saturday AM. Discover Apple Black, Clock Striker, Hammer, Underground, and over 20+ flagship series from global creators.\" />\r\n    <meta property=\"og:image\" content=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20load%20screen.jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"630\" />\r\n    <meta property=\"og:url\" content=\"https://www.mangahype.com/\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:image\" content=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20load%20screen.jpg\" />\r\n\r\n    <!-- Early Global Event Listener for PWA Installation -->\r\n    <script>\r\n      window.deferredPrompt = null;\r\n\r\n      window.addEventListener('beforeinstallprompt', (e) => {\r\n        e.preventDefault();\r\n        window.deferredPrompt = e;\r\n        localStorage.removeItem('am_pwa_installed');\r\n        window.dispatchEvent(new Event('pwa-install-ready'));\r\n      });\r\n\r\n      window.addEventListener('appinstalled', () => {\r\n        window.deferredPrompt = null;\r\n        localStorage.setItem('am_pwa_installed', 'true');\r\n      });\r\n    </script>\r\n\r\n    <!-- Schema.org JSON-LD Structured Data for Full Catalog & Creators -->\r\n    <script type=\"application/ld+json\">\r\n    {\r\n      \"@context\": \"https://schema.org\",\r\n      \"@type\": \"WebApplication\",\r\n      \"name\": \"Saturday AM - Manga Hype\",\r\n      \"url\": \"https://www.mangahype.com/\",\r\n      \"applicationCategory\": \"EntertainmentApplication\",\r\n      \"operatingSystem\": \"All\",\r\n      \"descriptio