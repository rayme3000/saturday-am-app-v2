import React, { useState, useEffect } from 'react';
import { User } from 'lucide-react';
import { supabase } from '../supabase';

// Global cache so we only query the DB once per app load
let cachedFrames: any[] | null = null;
let isFetching = false;
let fetchPromise: Promise<void> | null = null;

export const useAvatarFrames = () => {
  const [frames, setFrames] = useState<any[]>(cachedFrames || []);

  useEffect(() => {
    if (cachedFrames) return;
    if (!isFetching) {
      isFetching = true;
      fetchPromise = supabase.from('avatar_frames').select('*').eq('is_active', true).then(({ data }) => {
        if (data) {
          cachedFrames = data;
          setFrames(data);
        }
        isFetching = false;
      });
    } else if (fetchPromise) {
      fetchPromise.then(() => setFrames(cachedFrames || []));
    }
  }, []);

  return frames;
};

export const DecoratedAvatar = ({ avatarUrl, frameId, size = "w-10 h-10", iconSize = "w-5 h-5", isProfileActive = false }: any) => {
  const frames = useAvatarFrames();
  
  const activeFrame = frames.find((f: any) => String(f.id) === String(frameId));
  const hasNoCustomFrame = !frameId || String(frameId) === 'none';

  // Default active state fallback for the Nav Pill
  const frameStyle = (isProfileActive && hasNoCustomFrame) 
    ? 'border-[#fe9a00] shadow-[0_0_15px_rgba(254,154,0,0.6)]' 
    : (activeFrame?.style || 'border-transparent');
    
  const orbitStyle = activeFrame?.orbit || '';

  return (
    <div className={`relative flex items-center justify-center flex-shrink-0 ${size}`}>
       <div className={`w-full h-full rounded-full overflow-hidden bg-zinc-800 flex items-center justify-center z-10 border-2 transition-all duration-300 ${frameStyle} ${isProfileActive ? 'scale-110' : ''}`}>
         {avatarUrl && avatarUrl.trim() !== '' ? (
           <img src={avatarUrl} alt="Profile" className="w-full h-full object-cover" />
         ) : (
           <User className={`${iconSize} text-zinc-400`} />
         )}
       </div>
       
       {orbitStyle && (
         <div className={`absolute -inset-1.5 rounded-full border-2 border-transparent pointer-events-none transition-transform duration-300 ${orbitStyle} ${isProfileActive ? 'scale-110' : ''}`} />
       )}
    </div>
  );
};
</file>

