                              <div className={`absolute w-14 h-14 rounded-full border-2 border-transparent ${frame.orbit}`} />
                            </div>
                            <span className="text-[9px] font-black uppercase tracking-widest text-center text-purple-400">{frame.name}</span>

                            {!isSubscriber && (
