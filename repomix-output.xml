import React, { useState, useEffect } from 'react';
import { X, User } from 'lucide-react';
import { supabase } from '../supabase';

export const FrameMaker = () => {
  const [frames, setFrames] = useState<any[]>([]);
  const [isSaving, setIsSaving] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);
  
  const [formData, setFormData] = useState({
    name: '',
    tier: 'basic',
    style: '',
    orbit: '',
    isActive: true
  });

  const fetchFrames = async () => {
    const { data } = await supabase.from('avatar_frames').select('*').order('created_at', { ascending: false });
    if (data) setFrames(data);
  };

  useEffect(() => { fetchFrames(); }, []);

  const handleSaveFrame = async () => {
    if (!formData.name || !formData.style) return alert("Name and Style classes are required.");
    setIsSaving(true);
    try {
      const payload = {
        name: formData.name,
        tier: formData.tier,
        style: formData.style,
        orbit: formData.orbit,
        is_active: formData.isActive
      };

      if (editingId) {
        const { error } = await supabase.from('avatar_frames').update(payload).eq('id', editingId);
        if (error) throw error;
        alert("Frame updated!");
      } else {
        const { error } = await supabase.from('avatar_frames').insert([payload]);
        if (error) throw error;
        alert("New frame added to vault!");
      }
      
      cancelEdit();
      fetchFrames();
    } catch (e: any) { alert("Error saving frame: " + e.message); }
    finally { setIsSaving(false); }
  };

  const handleEditClick = (frame: any) => {
    setEditingId(frame.id);
    setFormData({
      name: frame.name,
      tier: frame.tier,
      style: frame.style,
      orbit: frame.orbit || '',
      isActive: frame.is_active
    });
    window.scrollTo({ top: 0, behavior: 'smooth' }); 
  };

  const cancelEdit = () => {
    setEditingId(null);
    setFormData({ name: '', tier: 'basic', style: '', orbit: '', isActive: true });
  };

  const toggleActiveStatus = async (id: string, currentStatus: boolean) => {
    await supabase.from('avatar_frames').update({ is_active: !currentStatus }).eq('id', id);
    fetchFrames();
  };

  const deleteFrame = async (id: string) => {
    if (!window.confirm("Permanently delete this frame? Users equipped with it will default to a transparent border.")) return;
    await supabase.from('avatar_frames').delete().eq('id', id);
    if (editingId === id) cancelEdit(); 
    fetchFrames();
  };

  return (
    <div className="space-y-6 animate-fade-in-up">
      {/* CREATE/EDIT SECTION */}
      <div className={`bg-zinc-900 border p-6 rounded-xl shadow-md transition-colors ${editingId ? 'border-purple-500' : 'border-zinc-800'}`}>
        <div className="flex justify-between items-center mb-6 border-b border-zinc-800 pb-4">
          <h3 className="font-bold text-[#fe9a00] uppercase tracking-widest text-xs">
            {editingId ? `Editing Frame: ${formData.name}` : 'Create New Frame'}
          </h3>
          {editingId && (
             <button onClick={cancelEdit} className="text-[10px] font-black text-red-500 uppercase tracking-widest hover:text-white transition-colors bg-red-900/20 px-3 py-1 rounded">
               Cancel Edit
             </button>
          )}
        </div>
        
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          {/* LIVE PREVIEW */}
          <div className="md:col-span-1 flex flex-col items-center justify-center border-r border-zinc-800 pb-6 md:pb-0">
            <span className="text-[10px] font-black text-zinc-500 uppercase tracking-widest mb-6">Live Preview</span>
            <div className="relative w-32 h-32 flex items-center justify-center">
              <div className={`w-20 h-20 rounded-full bg-zinc-800 z-10 flex items-center justify-center border-2 transition-all ${formData.style}`}>
                <User className="w-8 h-8 text-zinc-500" />
              </div>
              {formData.orbit && (
                <div className={`absolute w-28 h-28 rounded-full border-2 border-transparent pointer-events-none transition-all ${formData.orbit}`} />
              )}
            </div>
          </div>

          <div className="md:col-span-2 space-y-4">
            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2">Frame Name</label>
                <input type="text" placeholder="e.g., Toxic Sludge" value={formData.name} onChange={(e) => setFormData({...formData, name: e.target.value})} className="w-full bg-black border border-zinc-700 rounded p-3 text-white font-bold focus:border-[#fe9a00]" />
              </div>
              <div>
                <label className="block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2">Tier</label>
                <select value={formData.tier} onChange={(e) => setFormData({...formData, tier: e.target.value})} className="w-full bg-black border border-zinc-700 rounded p-3 text-white text-sm focus:border-[#fe9a00]">
                  <option value="basic">Basic (Free)</option>
                  <option value="premium">Premium (Pro Only)</option>
                </select>
              </div>
            </div>

            <div>
              <label className="block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2">Base Style (Tailwind Classes)</label>
              <input type="text" placeholder="e.g., border-green-500 shadow-[0_0_10px_rgba(34,197,94,0.5)]" value={formData.style} onChange={(e) => setFormData({...formData, style: e.target.value})} className="w-full bg-black border border-zinc-700 rounded p-3 text-white font-mono text-xs focus:border-[#fe9a00]" />
            </div>

            <div>
              <label className="block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2">Animated Orbit (Tailwind Classes)</label>
              <input type="text" placeholder="e.g., border-t-green-500 animate-spin" value={formData.orbit} onChange={(e) => setFormData({...formData, orbit: e.target.value})} className="w-full bg-black border border-zinc-700 rounded p-3 text-white font-mono text-xs focus:border-[#fe9a00]" />
            </div>

            <button onClick={handleSaveFrame} disabled={isSaving || !formData.name || !formData.style} className={`w-full py-4 mt-4 font-black uppercase tracking-widest rounded transition-all ${isSaving || !formData.name || !formData.style ? 'bg-zinc-800 text-zinc-500 cursor-not-allowed' : editingId ? 'bg-purple-500 text-white hover:bg-white hover:text-black shadow-[0_0_15px_rgba(168,85,247,0.4)]' : 'bg-[#fe9a00] text-black hover:bg-white'}`}>
              {isSaving ? 'SAVING...' : editingId ? 'UPDATE FRAME' : 'ADD TO VAULT'}
            </button>
          </div>
        </div>
      </div>

      {/* VAULT GALLERY */}
      <div className="bg-zinc-900 border border-zinc-800 p-6 rounded-xl shadow-md">
        <h3 className="font-bold text-[#fe9a00] uppercase tracking-widest text-xs mb-6 border-b border-zinc-800 pb-4">Frame Vault ({frames.length})</h3>
        
        <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          {frames.map(frame => (
            <div key={frame.id} className={`bg-black border rounded-lg p-4 flex flex-col items-center text-center relative group transition-colors ${frame.is_active ? 'border-zinc-700 hover:border-[#fe9a00]' : 'border-red-900/50 opacity-60'} ${editingId === frame.id ? 'ring-2 ring-purple-500 ring-offset-2 ring-offset-black' : ''}`}>
              <button onClick={() => deleteFrame(frame.id)} className="absolute top-1 right-1 p-1 bg-black/80 text-zinc-500 hover:text-red-500 rounded opacity-0 group-hover:opacity-100 transition-opacity z-20" title="Delete Frame"><X className="w-3 h-3" /></button>
              <button onClick={() => handleEditClick(frame)} className="absolute top-1 left-1 px-1.5 py-0.5 bg-black/80 text-zinc-400 hover:text-[#fe9a00] text-[8px] font-black uppercase tracking-widest rounded opacity-0 group-hover:opacity-100 transition-opacity z-20 border border-zinc-800 hover:border-[#fe9a00]" title="Edit Frame">Edit</button>
              
              <div className="relative w-16 h-16 flex items-center justify-center mb-4 mt-2">
                <div className={`w-10 h-10 rounded-full bg-zinc-800 z-10 border-2 ${frame.style}`} />
                {frame.orbit && <div className={`absolute w-14 h-14 rounded-full border-2 border-transparent pointer-events-none ${frame.orbit}`} />}
              </div>
              
              <h4 className="text-[10px] font-bold text-white leading-tight mb-1">{frame.name}</h4>
              <p className={`text-[8px] font-black uppercase tracking-widest mb-3 ${frame.tier === 'premium' ? 'text-purple-400' : 'text-zinc-500'}`}>{frame.tier}</p>

              <button onClick={() => toggleActiveStatus(frame.id, frame.is_active)} className={`w-full py-1.5 text-[8px] font-black uppercase tracking-widest rounded transition-colors ${frame.is_active ? 'bg-zinc-800 text-zinc-300 hover:bg-red-900/50 hover:text-red-500' : 'bg-red-900/20 text-red-500 hover:bg-green-900/30 hover:text-green-500'}`}>
                {frame.is_active ? 'Vault' : 'Unvault'}
              </button>
            </div>
          ))}
          {frames.length === 0 && <p className="col-span-full text-center text-zinc-600 text-xs py-8 uppercase tracking-widest font-bold">No frames found.</p>}
        </div>
      </div>
    </div>
  );
};
</file>

