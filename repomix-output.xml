                        <button onClick={() => setPenColor('#ffffff')} className={`w-8 h-8 sm:w-6 sm:h-6 rounded-full bg-white shadow-lg ${penColor === '#ffffff' ? 'ring-2 ring-[#fe9a00] ring-offset-2 ring-offset-black' : ''}`} />
