ifetimeStats.topCreator.count} Tips)\r\n              </p>\r\n            </>\r\n          ) : (\r\n            <div className=\"text-sm font-bold text-zinc-600 italic my-2\">No tips recorded yet</div>\r\n          )}\r\n        </div>\r\n      </div>\r\n\r\n      {/* OPTIONAL DRAWER 1: CREATOR NOTIFICATION EMAILS DIRECTORY */}\r\n      {showEmailDirectory && (\r\n        <div className=\"bg-black border border-[#fe9a00]/40 rounded-xl p-5 animate-fade-in space-y-4\">\r\n          <div className=\"flex items-center justify-between border-b border-zinc-800 pb-3\">\r\n            <div>\r\n              <h3 className=\"text-xs font-black uppercase tracking-widest text-[#fe9a00] flex items-center gap-2\">\r\n                <Users className=\"w-4 h-4\" /> Creator Fan Mail & Tip Alert Emails\r\n              </h3>\r\n              <p className=\"text-[10px] text-zinc-400 font-bold mt-0.5\">\r\n                Assign an email address to any creator below. When a fan tips them on Stripe, Resend will automatically email the creator their tip amount and fan mail message!\r\n              </p>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 max-h-64 overflow-y-auto pr-2 custom-scrollbar\">\r\n            {creators.map((c) => (\r\n              <div\r\n                key={c.name}\r\n                className=\"flex items-center justify-between gap-2 bg-zinc-900 border border-zinc-800 p-2.5 rounded-lg\"\r\n              >\r\n                <div className=\"min-w-0 flex-1\">\r\n                  <div className=\"text-xs font-black text-white uppercase tracking-wider truncate\">\r\n                    {c.name}\r\n                  </div>\r\n                  <input\r\n                    type=\"email\"\r\n                    placeholder=\"creator@email.com\"\r\n                    value={creatorEmails[c.name] || ''}\r\n                    onChange={(e) =>\r\n                      setCreatorEmails((prev) => ({ ...prev, [c.name]: e.target.value }))\r\n                    }\r\n                    className=\"mt-1 w-full bg-black border border-zinc-700 rounded px-2.5 py-1.5 text-xs text-[#fe9a00] font-bold focus:outline-none focus:border-[#fe9a00]\"\r\n                  />\r\n                </div>\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => handleSaveCreatorEmail(c.name)}\r\n                  disabled={savingCreatorEmail === c.name}\r\n                  className=\"px-3 py-2 bg-[#fe9a00] hover:bg-white text-black font-black uppercase tracking-widest text-[9px] rounded-lg transition-colors shrink-0 cursor-pointer flex items-center gap-1\"\r\n                >\r\n                  {savingCreatorEmail === c.name ? (\r\n                    <Loader2 className=\"w-3 h-3 animate-spin\" />\r\n                  ) : (\r\n                    <Save className=\"w-3 h-3\" />\r\n                  )}\r\n                  Save\r\n                </button>\r\n              </div>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* OPTIONAL DRAWER 2: MANUAL PAYOUT / TIP ENTRY FORM */}\r\n      {showAddForm && (\r\n        <form\r\n          onSubmit={handleManualAddTip}\r\n          className=\"bg-black border border-[#fe9a00]/40 rounded-xl p-5 animate-fade-in space-y-4\"\r\n        >\r\n          <div className=\"flex items-center justify-between border-b border-zinc-800 pb-3\">\r\n            <h3 className=\"text-xs font-black uppercase tracking-widest text-[#fe9a00] flex items-center gap-2\">\r\n              <PlusCircle className=\"w-4 h-4\" /> Log Manual Creator Payout or Test Tip\r\n            </h3>\r\n          </div>\r\n\r\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-1\">\r\n                Creator Name *\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                list=\"creator-payout-list\"\r\n                required\r\n                placeholder=\"e.g. Raymond Brown\"\r\n                value={newCreatorName}\r\n                onChange={(e) => setNewCreatorName(e.target.value)}\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2.5 text-xs font-bold text-white focus:border-[#fe9a00] outline-none\"\r\n              />\r\n              <datalist id=\"creator-payout-list\">\r\n                {creators.map((c) => (\r\n                  <option key={c.name} value={c.name} />\r\n                ))}\r\n              </datalist>\r\n            </div>\r\n\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-1\">\r\n                Amount ($ USD) *\r\n              </label>\r\n              <input\r\n                type=\"number\"\r\n                step=\"0.01\"\r\n                min=\"0.50\"\r\n                required\r\n                placeholder=\"e.g. 10.00\"\r\n                value={newAmount}\r\n                onChange={(e) => setNewAmount(e.target.value)}\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2.5 text-xs font-bold text-[#fe9a00] focus:border-[#fe9a00] outline-none\"\r\n              />\r\n            </div>\r\n\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-1\">\r\n                Payout Status\r\n              </label>\r\n              <select\r\n                value={newStatus}\r\n                onChange={(e) => setNewStatus(e.target.value)}\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2.5 text-xs font-bold text-white focus:border-[#fe9a00] outline-none cursor-pointer\"\r\n              >\r\n                <option value=\"paid\">Paid / Transferred</option>\r\n                <option value=\"pending\">Pending Transfer</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-1\">\r\n                Donor / Fan Name\r\n              </label>\r\n              <input\r\n                type=\"text\"\r\n                placeholder=\"e.g. MangaFan99 or Saturday AM Bonus\"\r\n                value={newDonorName}\r\n                onChange={(e) => setNewDonorName(e.target.value)}\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2.5 text-xs font-bold text-white focus:border-[#fe9a00] outline-none\"\r\n              />\r\n            </div>\r\n\r\n            <div>\r\n              <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-1\">\r\n                Donor Email\r\n              </label>\r\n              <input\r\n                type=\"email\"\r\n                placeholder=\"fan@example.com\"\r\n                value={newDonorEmail}\r\n                onChange={(e) => setNewDonorEmail(e.target.value)}\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2.5 text-xs font-bold text-white focus:border-[#fe9a00] outline-none\"\r\n              />\r\n            </div>\r\n          </div>\r\n\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-1\">\r\n              Fan Mail Comment / Payout Note\r\n            </label>\r\n            <input\r\n              type=\"text\"\r\n              placeholder=\"e.g. Keep up the amazing artwork on Apple Black!\"\r\n              value={newFanMessage}\r\n              onChange={(e) => setNewFanMessage(e.target.value)}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg px-3 py-2.5 text-xs font-bold text-white focus:border-[#fe9a00] outline-none\"\r\n            />\r\n          </div>\r\n\r\n          <div className=\"flex justify-end gap-3\">\r\n            <button\r\n              type=\"button\"\r\n              onClick={() => setShowAddForm(false)}\r\n              className=\"px-4 py-2 rounded-lg bg-zinc-800 text-zinc-400 hover:text-white text-[10px] font-black uppercase tracking-widest cursor-pointer\"\r\n            >\r\n              Cancel\r\n            </button>\r\n            <button\r\n              type=\"submit\"\r\n              disabled={isSubmittingManual}\r\n              className=\"px-5 py-2 rounded-lg bg-[#fe9a00] hover:bg-white text-black text-[10px] font-black uppercase tracking-widest cursor-pointer\"\r\n            >\r\n              {isSubmittingManual ? 'Saving...' : 'Save Transaction'}\r\n            </button>\r\n          </div>\r\n        </form>\r\n      )}\r\n\r\n      {/* CREATOR EARNINGS LEADERBOARD PILLS */}\r\n      {lifetimeStats.creatorBreakdown.length > 0 && (\r\n        <div className=\"bg-black border border-zinc-800 rounded-xl p-4\">\r\n          <div className=\"text-[10px] font-black uppercase tracking-widest text-zinc-400 mb-3 flex items-center gap-1.5\">\r\n            <TrendingUp className=\"w-3.5 h-3.5 text-[#fe9a00]\" /> Lifetime Totals by Creator (Click to Filter)\r\n          </div>\r\n          <div className=\"flex flex-wrap gap-2\">\r\n            <button\r\n              type=\"button\"\r\n              onClick={() => setSelectedCreator('all')}\r\n              className={`px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest border transition-colors cursor-pointer ${\r\n                selectedCreator === 'all'\r\n                  ? 'bg-[#fe9a00] text-black border-[#fe9a00]'\r\n                  : 'bg-zinc-900 text-zinc-400 border-zinc-800 hover:text-white'\r\n              }`}\r\n            >\r\n              All Creators ({formatCurrency(lifetimeStats.totalLifetimeDollars)})\r\n            </button>\r\n            {lifetimeStats.creatorBreakdown.map((c) => (\r\n              <button\r\n                key={c.name}\r\n                type=\"button\"\r\n                onClick={() => setSelectedCreator(c.name)}\r\n                className={`px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest border transition-colors cursor-pointer flex items-center gap-1.5 ${\r\n                  selectedCreator.toLowerCase() === c.name.toLowerCase()\r\n                    ? 'bg-[#fe9a00] text-black border-[#fe9a00]'\r\n                    : 'bg-zinc-900 text-zinc-300 border-zinc-800 hover:border-[#fe9a00]/50'\r\n                }`}\r\n              >\r\n                <span>{c.name}:</span>\r\n                <span className={selectedCreator.toLowerCase() === c.name.toLowerCase() ? 'text-black' : 'text-[#fe9a00]'}>\r\n                  {formatCurrency(c.total)}\r\n                </span>\r\n                <span className=\"opacity-70\">({c.count})</span>\r\n              </button>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* FILTER & SORT CONTROLS BAR */}\r\n      <div className=\"flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 bg-black p-4 rounded-xl border border-zinc-800\">\r\n        <div className=\"relative flex-1\">\r\n          <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\r\n          <input\r\n            type=\"text\"\r\n            placeholder=\"Search donor name, email, creator, or fan mail message...\"\r\n            value={searchQuery}\r\n            onChange={(e) => setSearchQuery(e.target.value)}\r\n            className=\"w-full bg-zinc-900 border border-zinc-700 text-white pl-9 pr-3 py-2 rounded-lg text-xs font-bold focus:outline-none focus:border-[#fe9a00]\"\r\n          />\r\n        </div>\r\n\r\n        <div className=\"flex flex-wrap items-center gap-2\">\r\n          <div className=\"relative\">\r\n            <Calendar className=\"w-3.5 h-3.5 text-[#fe9a00] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\r\n            <select\r\n              value={selectedMonth}\r\n              onChange={(e) => setSelectedMonth(e.target.value)}\r\n              className=\"bg-zinc-900 border border-zinc-700 text-white pl-8 pr-4 py-2 rounded-lg text-xs font-bold focus:outline-none focus:border-[#fe9a00] cursor-pointer\"\r\n            >\r\n              <option value=\"all\">All Months (Lifetime)</option>\r\n              {availableMonths.map((ym) => (\r\n                <option key={ym} value={ym}>\r\n                  {formatMonthLabel(ym)}\r\n                </option>\r\n              ))}\r\n            </select>\r\n          </div>\r\n\r\n          <div className=\"relative\">\r\n            <ArrowUpDown className=\"w-3.5 h-3.5 text-[#fe9a00] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\r\n            <select\r\n              value={sortBy}\r\n              onChange={(e) => setSortBy(e.target.value as PayoutSortOption)}\r\n              className=\"bg-zinc-900 border border-zinc-700 text-white pl-8 pr-4 py-2 rounded-lg text-xs font-bold focus:outline-none focus:border-[#fe9a00] cursor-pointer\"\r\n            >\r\n              <option value=\"date_desc\">Sort: Newest Activity First</option>\r\n              <option value=\"date_asc\">Sort: Oldest Activity First</option>\r\n              <option value=\"amount_desc\">Sort: Highest Amount ($ → $)</option>\r\n              <option value=\"amount_asc\">Sort: Lowest Amount ($ → $)</option>\r\n              <option value=\"creator_asc\">Sort: Creator Name (A → Z)</option>\r\n              <option value=\"creator_desc\">Sort: Creator Name (Z → A)</option>\r\n              <option value=\"donor_asc\">Sort: Donor Name (A → Z)</option>\r\n              <option value=\"donor_desc\">Sort: Donor Name (Z → A)</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* TRANSACTIONS & FAN MAIL TABLE */}\r\n      <div className=\"overflow-x-auto no-scrollbar bg-black border border-zinc-800 rounded-xl\">\r\n        <table className=\"w-full text-left border-collapse min-w-[900px]\">\r\n          <thead>\r\n            <tr className=\"border-b border-zinc-800 text-[9px] font-black uppercase tracking-widest text-zinc-500\">\r\n              <th className=\"py-3.5 px-4\">Date & Time</th>\r\n              <th className=\"py-3.5 px-4\">Creator Recipient</th>\r\n              <th className=\"py-3.5 px-4\">Donor / Supporter Info</th>\r\n              <th className=\"py-3.5 px-4\">Fan Mail Message</th>\r\n              <th className=\"py-3.5 px-4 text-center\">Payout Status</th>\r\n              <th className=\"py-3.5 px-4 text-right text-[#fe9a00]\">Tip Amount</th>\r\n              <th className=\"py-3.5 px-3 text-right\">Actions</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody className=\"divide-y divide-zinc-800/60 text-xs\">\r\n            {loading ? (\r\n              <tr>\r\n                <td colSpan={7} className=\"py-12 text-center text-zinc-500 font-bold uppercase tracking-widest text-[10px]\">\r\n                  <Loader2 className=\"w-6 h-6 animate-spin text-[#fe9a00] mx-auto mb-2\" />\r\n                  Loading Creator Payout Ledger...\r\n                </td>\r\n              </tr>\r\n            ) : filteredAndSortedTips.length === 0 ? (\r\n              <tr>\r\n                <td colSpan={7} className=\"py-12 text-center text-zinc-500 font-bold italic\">\r\n                  No creator tips or payouts match this filter yet.\r\n                </td>\r\n              </tr>\r\n            ) : (\r\n              filteredAndSortedTips.map((t) => {\r\n                const isPaid = (t.payout_status || 'paid') === 'paid';\r\n                const cEmail = t.creator_email || creatorEmails[t.creator_name] || '';\r\n\r\n                return (\r\n                  <tr key={t.id} className=\"hover:bg-zinc-900/60 transition-colors\">\r\n                    <td className=\"py-3.5 px-4 align-top font-mono text-[11px] text-zinc-300 whitespace-nowrap\">\r\n                      {t.created_at ? (\r\n                        <div>\r\n                          <div className=\"font-bold text-white\">\r\n                            {new Date(t.created_at).toLocaleDateString(undefined, {\r\n                              month: 'short',\r\n                              day: 'numeric',\r\n                              year: 'numeric'\r\n                            })}\r\n                          </div>\r\n                          <div className=\"text-[10px] text-zinc-500\">\r\n                            {new Date(t.created_at).toLocaleTimeString([], {\r\n                              hour: '2-digit',\r\n                              minute: '2-digit'\r\n                            })}\r\n                          </div>\r\n                        </div>\r\n                      ) : (\r\n                        '—'\r\n                      )}\r\n                    </td>\r\n\r\n                    <td className=\"py-3.5 px-4 align-top\">\r\n                      <div className=\"font-black text-white uppercase tracking-wider text-xs\">\r\n                        {t.creator_name}\r\n                      </div>\r\n                      {cEmail ? (\r\n                        <div className=\"text-[10px] text-[#fe9a00] flex items-center gap-1 mt-0.5\">\r\n                          <Mail className=\"w-3 h-3 shrink-0\" /> {cEmail}\r\n                        </div>\r\n                      ) : (\r\n                        <div className=\"text-[10px] text-zinc-600 italic mt-0.5\">\r\n                          No creator email assigned\r\n                        </div>\r\n                      )}\r\n                    </td>\r\n\r\n                    <td className=\"py-3.5 px-4 align-top\">\r\n                      <div className=\"font-bold text-zinc-200 flex items-center gap-1.5\">\r\n                        <User className=\"w-3 h-3 text-[#fe9a00] shrink-0\" />\r\n                        <span>{t.donor_name || 'Saturday AM Fan'}</span>\r\n                      </div>\r\n                      {t.donor_email && (\r\n                        <div className=\"text-[10px] text-zinc-400 flex items-center gap-1 mt-0.5\">\r\n                          <Mail className=\"w-3 h-3 text-zinc-500 shrink-0\" />\r\n                          <span>{t.donor_email}</span>\r\n                        </div>\r\n                      )}\r\n                    </td>\r\n\r\n                    <td className=\"py-3.5 px-4 align-top max-w-xs\">\r\n                      {t.fan_message ? (\r\n                        <div className=\"bg-zinc-900 border-l-2 border-[#fe9a00] px-3 py-2 rounded text-zinc-200 italic text-xs leading-relaxed\">\r\n                          <MessageSquare className=\"w-3 h-3 text-[#fe9a00] inline mr-1.5 -mt-0.5\" />\r\n                          \"{t.fan_message}\"\r\n                        </div>\r\n                      ) : (\r\n                        <span className=\"text-zinc-600 italic text-[11px]\">No fan mail message</span>\r\n                      )}\r\n                    </td>\r\n\r\n                    <td className=\"py-3.5 px-4 align-top text-center\">\r\n                      <button\r\n                        type=\"button\"\r\n                        onClick={() => handleTogglePayoutStatus(t)}\r\n                        title=\"Click to toggle Paid / Pending status\"\r\n                        className=\"cursor-pointer\"\r\n                      >\r\n                        {isPaid ? (\r\n                          <span className=\"inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-950/40 border border-emerald-800/60 px-2.5 py-1 rounded-full\">\r\n                            <CheckCircle2 className=\"w-3 h-3\" /> Paid\r\n                          </span>\r\n                        ) : (\r\n                          <span className=\"inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-widest text-amber-400 bg-amber-950/40 border border-amber-800/60 px-2.5 py-1 rounded-full\">\r\n                            <Clock className=\"w-3 h-3\" /> Pending\r\n                          </span>\r\n                        )}\r\n                      </button>\r\n                    </td>\r\n\r\n                    <td className=\"py-3.5 px-4 align-top text-right font-black text-base text-[#fe9a00] whitespace-nowrap\">\r\n                      {formatCurrency(Number(t.amount_dollars || 0))}\r\n                    </td>\r\n\r\n                    <td className=\"py-3.5 px-3 align-top text-right\">\r\n                      <button\r\n                        type=\"button\"\r\n                        onClick={() => handleDeleteTip(t.id)}\r\n                        className=\"p-1.5 text-zinc-600 hover:text-red-500 hover:bg-red-950/30 rounded-lg transition-colors cursor-pointer\"\r\n                        title=\"Delete Transaction\"\r\n                      >\r\n                        <Trash2 className=\"w-4 h-4\" />\r\n                      </button>\r\n                    </td>\r\n                  </tr>\r\n                );\r\n              })\r\n            )}\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n    </div>\r\n  );\r\n};",
    "src/AmCommandCenter/ModerationDashboard.tsx": "import React, { useState, useEffect } from 'react';\r\nimport { Flag, Trash2, CheckCircle, AlertTriangle, RefreshCw, MessageSquare, Zap } from 'lucide-react';\r\nimport { supabase } from '../supabase';\r\n\r\nexport const ModerationDashboard = () => {\r\n  const [activeTab, setActiveTab] = useState<'comments' | 'reacts'>('comments');\r\n  \r\n  const [reportedComments, setReportedComments] = useState<any[]>([]);\r\n  const [reportedReacts, setReportedReacts] = useState<any[]>([]);\r\n  \r\n  const [isLoading, setIsLoading] = useState(true);\r\n  const [isProcessing, setIsProcessing] = useState<string | null>(null);\r\n\r\n  const fetchReports = async () => {\r\n    setIsLoading(true);\r\n    try {\r\n      // --- 1. FETCH GENERAL COMMENTS ---\r\n      const { data: reports, error: reportsError } = await supabase.from('comment_reports').select('*');\r\n\r\n      if (!reportsError && reports && reports.length > 0) {\r\n        const reportCounts: Record<string, number> = {};\r\n        reports.forEach((report: any) => {\r\n          reportCounts[report.comment_id] = (reportCounts[report.comment_id] || 0) + 1;\r\n        });\r\n\r\n        const commentIds = Object.keys(reportCounts);\r\n        const { data: comments } = await supabase.from('series_comments').select('*').in('id', commentIds);\r\n\r\n        const combinedData = (comments || []).map((comment: any) => ({\r\n          ...comment,\r\n          report_count: reportCounts[comment.id] || 0\r\n        })).sort((a, b) => b.report_count - a.report_count);\r\n\r\n        setReportedComments(combinedData);\r\n      } else {\r\n        setReportedComments([]);\r\n      }\r\n\r\n      // --- 2. FETCH QUICK REACTS ---\r\n      const { data: reacts, error: reactsError } = await supabase\r\n        .from('page_reacts')\r\n        .select('*')\r\n        .gt('flags', 0)\r\n        .order('flags', { ascending: false });\r\n\r\n      if (!reactsError && reacts) {\r\n        setReportedReacts(reacts);\r\n      } else {\r\n        setReportedReacts([]);\r\n      }\r\n\r\n    } catch (error) {\r\n      console.error(\"Error fetching reported content:\", error);\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchReports();\r\n  }, []);\r\n\r\n  // --- GENERAL COMMENT MODERATION ---\r\n  const handleDismissComment = async (commentId: string) => {\r\n    if (!window.confirm(\"Are you sure you want to dismiss all reports for this comment? It will remain visible to the public.\")) return;\r\n    setIsProcessing(commentId);\r\n    try {\r\n      const { error } = await supabase.from('comment_reports').delete().eq('comment_id', commentId);\r\n      if (error) throw error;\r\n      \r\n      setReportedComments(prev => prev.filter(c => c.id !== commentId));\r\n    } catch (error: any) {\r\n      console.error(\"Failed to dismiss reports:\", error);\r\n      alert(\"Error dismissing reports: \" + error.message);\r\n    } finally {\r\n      setIsProcessing(null);\r\n    }\r\n  };\r\n\r\n  const handleDeleteComment = async (commentId: string) => {\r\n    if (!window.confirm(\"Are you sure you want to permanently DELETE this comment? This cannot be undone.\")) return;\r\n    setIsProcessing(commentId);\r\n    try {\r\n      const { error } = await supabase.from('series_comments').delete().eq('id', commentId);\r\n      if (error) throw error;\r\n      \r\n      setReportedComments(prev => prev.filter(c => c.id !== commentId));\r\n    } catch (error: any) {\r\n      console.error(\"Failed to delete comment:\", error);\r\n      alert(\"Error deleting comment: \" + error.message);\r\n    } finally {\r\n      setIsProcessing(null);\r\n    }\r\n  };\r\n\r\n  // --- QUICK REACT MODERATION ---\r\n  const handleDismissReact = async (reactId: any) => {\r\n    if (!window.confirm(\"Dismiss all reports for this Quick React? It will remain visible.\")) return;\r\n    setIsProcessing(`react_${reactId}`);\r\n    try {\r\n      // Reset the flags counter to 0 so it disappears from the queue\r\n      const { error } = await supabase.from('page_reacts').update({ flags: 0 }).eq('id', reactId);\r\n      if (error) throw error;\r\n      \r\n      setReportedReacts(prev => prev.filter(r => String(r.id) !== String(reactId)));\r\n    } catch (error: any) {\r\n      console.error(\"Failed to dismiss react:\", error);\r\n      alert(\"Error dismissing react: \" + error.message);\r\n    } finally {\r\n      setIsProcessing(null);\r\n    }\r\n  };\r\n\r\n  const handleDeleteReact = async (reactId: any) => {\r\n    if (!window.confirm(\"Permanently DELETE this Quick React?\")) return;\r\n    setIsProcessing(`react_${reactId}`);\r\n    try {\r\n      const { error } = await supabase.from('page_reacts').delete().eq('id', reactId);\r\n      if (error) throw error;\r\n      \r\n      setReportedReacts(prev => prev.filter(r => String(r.id) !== String(reactId)));\r\n    } catch (error: any) {\r\n      console.error(\"Failed to delete react:\", error);\r\n      alert(\"Error deleting react: \" + error.message);\r\n    } finally {\r\n      setIsProcessing(null);\r\n    }\r\n  };\r\n\r\n  if (isLoading) {\r\n    return (\r\n      <div className=\"flex flex-col items-center justify-center py-20 gap-4\">\r\n        <RefreshCw className=\"w-8 h-8 text-[#fe9a00] animate-spin\" />\r\n        <span className=\"text-zinc-500 font-black uppercase tracking-widest text-[10px]\">Loading Reports...</span>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-6 text-white w-full max-w-5xl mx-auto mt-8 shadow-2xl\">\r\n      <div className=\"flex justify-between items-center mb-6 border-b border-zinc-800 pb-4\">\r\n        <div className=\"flex items-center gap-3\">\r\n          <div className=\"p-3 bg-red-500/10 rounded-lg border border-red-500/20\">\r\n            <AlertTriangle className=\"w-6 h-6 text-red-500\" />\r\n          </div>\r\n          <div>\r\n            <h2 className=\"text-2xl font-black italic uppercase tracking-widest text-white\">Moderation Queue</h2>\r\n            <p className=\"text-zinc-400 text-[10px] font-bold uppercase tracking-widest mt-1\">Review flagged community content</p>\r\n          </div>\r\n        </div>\r\n        <button \r\n          onClick={fetchReports} \r\n          className=\"flex items-center gap-2 px-4 py-2 bg-black border border-zinc-700 rounded text-[10px] font-black uppercase tracking-widest hover:border-[#fe9a00] hover:text-[#fe9a00] transition-colors\"\r\n        >\r\n          <RefreshCw className=\"w-3 h-3\" /> Refresh\r\n        </button>\r\n      </div>\r\n\r\n      {/* TAB SWITCHER */}\r\n      <div className=\"flex bg-black p-1 rounded-lg mb-8 border border-zinc-800 max-w-sm\">\r\n        <button \r\n          onClick={() => setActiveTab('comments')} \r\n          className={`flex-1 py-2 rounded-md text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-2 transition-colors ${activeTab === 'comments' ? 'bg-zinc-800 text-white' : 'text-zinc-500 hover:text-white'}`}\r\n        >\r\n          <MessageSquare className=\"w-3 h-3\" /> Discussion ({reportedComments.length})\r\n        </button>\r\n        <button \r\n          onClick={() => setActiveTab('reacts')} \r\n          className={`flex-1 py-2 rounded-md text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-2 transition-colors ${activeTab === 'reacts' ? 'bg-zinc-800 text-white' : 'text-zinc-500 hover:text-white'}`}\r\n        >\r\n          <Zap className=\"w-3 h-3\" /> Quick Reacts ({reportedReacts.length})\r\n        </button>\r\n      </div>\r\n\r\n      <div className=\"flex flex-col gap-4\">\r\n        \r\n        {/* --- RENDER GENERAL COMMENTS --- */}\r\n        {activeTab === 'comments' && reportedComments.map((comment) => (\r\n          <div key={comment.id} className=\"bg-black border border-zinc-800 rounded-xl p-5 flex flex-col md:flex-row gap-6 items-start md:items-center relative overflow-hidden group hover:border-zinc-700 transition-colors\">\r\n            <div className=\"absolute top-0 left-0 w-1 h-full bg-red-500 opacity-50 group-hover:opacity-100 transition-opacity\" />\r\n            \r\n            <div className=\"flex-1 min-w-0 pl-2\">\r\n              <div className=\"flex items-center gap-3 mb-2\">\r\n                <span className=\"flex items-center gap-1.5 text-red-500 bg-red-500/10 border border-red-500/20 px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-widest\">\r\n                  <Flag className=\"w-3 h-3\" /> {comment.report_count} {comment.report_count === 1 ? 'Report' : 'Reports'}\r\n                </span>\r\n                <span className=\"text-zinc-500 text-[10px] font-bold tracking-widest uppercase\">\r\n                  {new Date(comment.created_at).toLocaleDateString()}\r\n                </span>\r\n                <span className=\"text-[#fe9a00] text-[10px] font-black uppercase tracking-widest truncate\">\r\n                  Series: {comment.series_slug}\r\n                </span>\r\n              </div>\r\n              \r\n              <p className=\"text-white text-sm bg-zinc-900/50 p-4 rounded-lg border border-zinc-800 break-words whitespace-pre-wrap mb-3\">\r\n                \"{comment.text}\"\r\n              </p>\r\n              \r\n              <div className=\"flex items-center gap-2 text-[10px] font-black uppercase tracking-widest\">\r\n                <span className=\"text-zinc-500\">Posted by:</span>\r\n                <span className=\"text-white\">{comment.user_name}</span>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"flex flex-row md:flex-col gap-3 w-full md:w-auto\">\r\n              <button \r\n                onClick={() => handleDismissComment(comment.id)}\r\n                disabled={isProcessing === comment.id}\r\n                className=\"flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-3 bg-zinc-800 border border-zinc-700 rounded-lg text-[10px] font-black uppercase tracking-widest hover:bg-white hover:text-black hover:border-white transition-all disabled:opacity-50\"\r\n              >\r\n                <CheckCircle className=\"w-4 h-4\" /> Dismiss\r\n              </button>\r\n              \r\n              <button \r\n                onClick={() => handleDeleteComment(comment.id)}\r\n                disabled={isProcessing === comment.id}\r\n                className=\"flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-3 bg-red-900/20 border border-red-900/50 text-red-500 rounded-lg text-[10px] font-black uppercase tracking-widest hover:bg-red-500 hover:text-white transition-all shadow-[0_0_15px_rgba(239,68,68,0.1)] disabled:opacity-50\"\r\n              >\r\n                <Trash2 className=\"w-4 h-4\" /> Delete\r\n              </button>\r\n            </div>\r\n            \r\n            {isProcessing === comment.id && (\r\n              <div className=\"absolute inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-10\">\r\n                <RefreshCw className=\"w-6 h-6 text-[#fe9a00] animate-spin\" />\r\n              </div>\r\n            )}\r\n          </div>\r\n        ))}\r\n\r\n        {/* --- RENDER QUICK REACTS --- */}\r\n        {activeTab === 'reacts' && reportedReacts.map((react) => (\r\n          <div key={react.id} className=\"bg-black border border-zinc-800 rounded-xl p-5 flex flex-col md:flex-row gap-6 items-start md:items-center relative overflow-hidden group hover:border-zinc-700 transition-colors\">\r\n            <div className=\"absolute top-0 left-0 w-1 h-full bg-red-500 opacity-50 group-hover:opacity-100 transition-opacity\" />\r\n            \r\n            <div className=\"flex-1 min-w-0 pl-2\">\r\n              <div className=\"flex items-center gap-3 mb-2\">\r\n                <span className=\"flex items-center gap-1.5 text-red-500 bg-red-500/10 border border-red-500/20 px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-widest\">\r\n                  <Flag className=\"w-3 h-3\" /> {react.flags} {react.flags === 1 ? 'Report' : 'Reports'}\r\n                </span>\r\n                <span className=\"text-zinc-500 text-[10px] font-bold tracking-widest uppercase\">\r\n                  {new Date(react.created_at).toLocaleDateString()}\r\n                </span>\r\n                <span className=\"text-[#fe9a00] text-[10px] font-black uppercase tracking-widest truncate\">\r\n                  Page: {react.page_index + 1}\r\n                </span>\r\n              </div>\r\n              \r\n              <p className=\"text-white text-sm bg-zinc-900/50 p-4 rounded-lg border border-zinc-800 break-words whitespace-pre-wrap mb-3\">\r\n                \"{react.text}\"\r\n              </p>\r\n              \r\n              <div className=\"flex items-center gap-2 text-[10px] font-black uppercase tracking-widest\">\r\n                <span className=\"text-zinc-500\">Dropped by:</span>\r\n                <span className=\"text-white\">{react.user_name}</span>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"flex flex-row md:flex-col gap-3 w-full md:w-auto\">\r\n              <button \r\n                onClick={() => handleDismissReact(react.id)}\r\n                disabled={isProcessing === `react_${react.id}`}\r\n                className=\"flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-3 bg-zinc-800 border border-zinc-700 rounded-lg text-[10px] font-black uppercase tracking-widest hover:bg-white hover:text-black hover:border-white transition-all disabled:opacity-50\"\r\n              >\r\n                <CheckCircle className=\"w-4 h-4\" /> Dismiss\r\n              </button>\r\n              \r\n              <button \r\n                onClick={() => handleDeleteReact(react.id)}\r\n                disabled={isProcessing === `react_