harError } = await supabase\r\n          .from('series_characters')\r\n          .delete()\r\n          .in('id', charIdsToDelete);\r\n        if (deleteCharError) throw deleteCharError;\r\n      }\r\n\r\n      if (formData.characters.length > 0) {\r\n        const existingCharsPayload = formData.characters\r\n          .filter((c: any) => Boolean(c.id))\r\n          .map((c: any) => {\r\n            const { fullbody_url, ...rest } = c;\r\n            return {\r\n              ...rest,\r\n              alt_forms: c.alt_forms || [],\r\n              series_slug: activeSlug,\r\n              created_at: c.created_at || nowIso\r\n            };\r\n          });\r\n\r\n        const newCharsPayload = formData.characters\r\n          .filter((c: any) => !c.id)\r\n          .map((c: any) => {\r\n            const { id, fullbody_url, ...rest } = c;\r\n            return {\r\n              ...rest,\r\n              alt_forms: c.alt_forms || [],\r\n              series_slug: activeSlug,\r\n              created_at: nowIso\r\n            };\r\n          });\r\n\r\n        if (existingCharsPayload.length > 0) {\r\n          const { error: upsertCharError } = await supabase\r\n            .from('series_characters')\r\n            .upsert(existingCharsPayload, { onConflict: 'id' });\r\n          if (upsertCharError) throw upsertCharError;\r\n        }\r\n\r\n        if (newCharsPayload.length > 0) {\r\n          const { error: insertCharError } = await supabase\r\n            .from('series_characters')\r\n            .insert(newCharsPayload);\r\n          if (insertCharError) throw insertCharError;\r\n        }\r\n      }\r\n\r\n      // Sync automated New Series Drop notification if enabled (or if creating a brand-new series) and not hidden\r\n      const notifKey = `series_${activeSlug}`;\r\n      if (formData.isHidden) {\r\n        await supabase.from('app_notifications').delete().eq('source_key', notifKey);\r\n      } else if (formData.autoNotify || targetSeries === 'new' || (formData.oneShotDebut && !wasAlreadyInDebut)) {\r\n        const effectiveReleaseIso = new Date().toISOString();\r\n        await supabase.from('app_notifications').upsert(\r\n          [\r\n            {\r\n              title: formData.oneShotDebut ? '⚡ Special One-Shot Debut (Free for 48H)!' : 'New Series Drop!',\r\n              message: formData.oneShotDebut\r\n                ? `Read \"${formData.seriesTitle}\" FREE for 48 hours before it enters the Saturday AM+ Vault!`\r\n                : `${formData.seriesTitle} is now on Saturday AM! Tap to start reading.`,\r\n              thumbnail_url: formData.bannerUrl || formData.characterUrl || null,\r\n              link_target: activeSlug,\r\n              publish_at: effectiveReleaseIso,\r\n              created_at: effectiveReleaseIso,\r\n              source_key: notifKey\r\n            }\r\n          ],\r\n          { onConflict: 'source_key' }\r\n        );\r\n      }\r\n  \r\n      window.dispatchEvent(new Event('seriesUpdated'));\r\n      window.dispatchEvent(new Event('vaultUpdated'));\r\n      alert(\r\n        formData.oneShotDebut\r\n          ? `SUCCESS! \"${formData.seriesTitle}\" and its chapters are now LIVE & FREE for 48 hours for all users, and added to the One-Shot Wednesday rotation!`\r\n          : `SUCCESS! Series Saved.`\r\n      );\r\n      if (setIsDirty) setIsDirty(false);\r\n    } catch (error: any) { \r\n      console.error(\"Database Save Error:\", error);\r\n      alert(`FAILED TO SAVE! Supabase returned: ${error.message}`); \r\n    } finally { \r\n      setIsSaving(false); \r\n    }\r\n  };\r\n\r\n  const handleDeleteSeries = async () => {\r\n    const challenge = window.prompt('Are you sure you want to permanently delete this series? This cannot be undone.\\n\\nType \"DELETE\" to confirm:');\r\n    if (challenge?.trim().toUpperCase() !== 'DELETE') {\r\n      return;\r\n    }\r\n    \r\n    setIsSaving(true);\r\n    try { \r\n      await supabase.from('app_notifications').delete().eq('source_key', `series_${targetSeries}`);\r\n      const { error: creatorErr } = await supabase.from('series_creators').delete().eq('series_slug', targetSeries);\r\n      if (creatorErr) throw creatorErr;\r\n\r\n      const { error: charErr } = await supabase.from('series_characters').delete().eq('series_slug', targetSeries);\r\n      if (charErr) throw charErr;\r\n\r\n      const { data: deletedData, error: seriesErr } = await supabase\r\n        .from('series')\r\n        .delete()\r\n        .eq('slug', targetSeries)\r\n        .select();\r\n\r\n      if (seriesErr) throw seriesErr;\r\n\r\n      if (!deletedData || deletedData.length === 0) {\r\n        throw new Error(\"Supabase RLS Policy blocked the deletion!\");\r\n      }\r\n\r\n      window.dispatchEvent(new Event('seriesUpdated'));\r\n      alert(\"Series permanently deleted!\"); \r\n      if (setIsDirty) setIsDirty(false);\r\n      window.location.reload(); \r\n    } catch (error: any) { \r\n      alert('Failed to delete series:\\n\\n' + error.message + '\\n\\nNote: If this series has Chapters uploaded, you must delete its Chapters in the Chapter Uploader first!'); \r\n    } finally {\r\n      setIsSaving(false);\r\n    }\r\n  };\r\n\r\n  const activePosition = previewDevice === 'desktop' ? formData.bannerPositionDesktop : formData.bannerPositionMobile;\r\n  const activeScale = previewDevice === 'desktop' ? formData.bannerScaleDesktop : formData.bannerScaleMobile;\r\n\r\n  const handleAutofillCreator = (index: number, selectedName: string) => {\r\n    if (!selectedName) return;\r\n    const found = existingCreators.find(c => c.name === selectedName);\r\n    if (found) {\r\n      const nc = [...formData.creators];\r\n      nc[index] = { ...nc[index], ...found, role: nc[index].role || found.role || 'Creator' };\r\n      handleInputChange('creators', nc);\r\n    }\r\n  };\r\n\r\n  const currentWednesdaySpotlight = getOneShotWednesdaySeries(seriesList);\r\n  const selectedSeriesObj = seriesList.find((s: any) => s.slug === targetSeries);\r\n  const activeDebutRemaining =\r\n    selectedSeriesObj && isInOneShotDebutWindow(selectedSeriesObj, seriesList)\r\n      ? getOneShotFreeCountdown(selectedSeriesObj, seriesList)\r\n      : null;\r\n\r\n  return (\r\n    <div className=\"space-y-6 animate-fade-in-up pb-32 relative\">\r\n      \r\n      {/* 1. Character Headshot Crop Modal */}\r\n      <input \r\n        type=\"file\" \r\n        id=\"headshot-upload\" \r\n        accept=\"image/*\" \r\n        className=\"hidden\" \r\n        onChange={(e) => {\r\n          if (e.target.files && e.target.files[0] && cropTarget !== null) {\r\n            const file = e.target.files[0];\r\n            setCropFile(file);\r\n            setCropImageUrl(URL.createObjectURL(file)); \r\n            e.target.value = ''; \r\n          }\r\n        }} \r\n      />\r\n\r\n      {cropImageUrl && ThumbnailCropperModal && (\r\n        <ThumbnailCropperModal\r\n          imageUrl={cropImageUrl}\r\n          aspect={1}\r\n          title=\"Crop Character Headshot (1:1)\"\r\n          uploadFolder=\"characters/headshots\"\r\n          onCropComplete={(newUrl: any) => {\r\n            if (cropTarget) {\r\n              if (cropTarget.field === 'alt_forms' && cropTarget.altIndex !== undefined) {\r\n                const newChars = [...formData.characters];\r\n                newChars[cropTarget.charIndex].alt_forms[cropTarget.altIndex].url = newUrl;\r\n                handleInputChange('characters', newChars);\r\n              } else {\r\n                handleCharacterChange(cropTarget.charIndex, cropTarget.field, newUrl);\r\n              }\r\n            }\r\n            setCropImageUrl(null);\r\n            setCropTarget(null);\r\n          }}\r\n          onCancel={() => {\r\n            setCropImageUrl(null);\r\n            setCropTarget(null);\r\n          }}\r\n        />\r\n      )}\r\n\r\n      {/* 2. Visual Drag/Zoom Crop Window for Hero Banner (Desktop / Mobile) */}\r\n      {bannerCropper && bannerCropper.isOpen && formData.bannerUrl && ThumbnailCropperModal && (\r\n        <ThumbnailCropperModal\r\n          imageUrl={formData.bannerUrl}\r\n          aspect={bannerCropper.device === 'desktop' ? (21 / 9) : (4 / 5)}\r\n          title={`Crop & Position ${bannerCropper.device === 'desktop' ? 'Desktop Banner (21:9)' : 'Mobile Banner (4:5)'}`}\r\n          onCropAreaComplete={handleBannerCropComplete}\r\n          onCancel={() => setBannerCropper(null)}\r\n        />\r\n      )}\r\n\r\n      {/* 3. Visual Drag/Zoom Crop Window for Character Render (2:3 Cutout) */}\r\n      {charCropperOpen && formData.characterUrl && ThumbnailCropperModal && (\r\n        <ThumbnailCropperModal\r\n          imageUrl={formData.characterUrl}\r\n          aspect={2 / 3}\r\n          title=\"Crop Character Render (2:3 Cutout)\"\r\n          onCropAreaComplete={handleCharCropComplete}\r\n          onCancel={() => setCharCropperOpen(false)}\r\n        />\r\n      )}\r\n\r\n      <div className=\"bg-zinc-900 border border-zinc-800 p-6 rounded-xl flex items-end gap-4\">\r\n        <div className=\"flex-1\">\r\n          <label className=\"block text-[10px] font-bold text-[#fe9a00] uppercase mb-2\">Editor Mode</label>\r\n          <select value={targetSeries} onChange={(e) => setTargetSeries(e.target.value)} className=\"w-full bg-black border border-zinc-700 rounded p-3 text-white text-sm\">\r\n            <option value=\"new\">+ CREATE NEW SERIES</option>\r\n            {seriesList.map((s: any) => <option key={s.id} value={s.slug}>{s.title}</option>)}\r\n          </select>\r\n        </div>\r\n        {targetSeries !== 'new' && (\r\n          <button \r\n            onClick={handleDeleteSeries} \r\n            disabled={isSaving}\r\n            className={`px-6 py-3 border rounded font-bold uppercase text-[10px] tracking-widest transition-colors ${\r\n              isSaving \r\n                ? 'bg-zinc-800 text-zinc-500 border-zinc-700 cursor-not-allowed' \r\n                : 'bg-red-900/20 text-red-500 border-red-900 hover:bg-red-500 hover:text-white'\r\n            }`}\r\n          >\r\n            {isSaving ? 'Deleting...' : 'Delete'}\r\n          </button>\r\n        )}\r\n      </div>\r\n\r\n      <div className=\"bg-zinc-900 border border-zinc-800 p-6 rounded-xl space-y-6\">\r\n        \r\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 border-b border-zinc-800 pb-6\">\r\n          <div className=\"md:col-span-2\">\r\n            <label className=\"block text-[10px] font-bold text-[#fe9a00] uppercase mb-2\">Series Title</label>\r\n            <input type=\"text\" value={formData.seriesTitle} onChange={(e) => handleInputChange('seriesTitle', e.target.value)} className=\"w-full bg-black border border-zinc-700 rounded p-3 text-white text-lg font-bold\" />\r\n          </div>\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase mb-2\">Content Rating</label>\r\n            <select value={formData.contentRating} onChange={(e) => handleInputChange('contentRating', e.target.value)} className=\"w-full bg-black border border-zinc-700 rounded p-3 text-white text-sm focus:border-[#fe9a00] transition-colors\">\r\n              <option value=\"E\">E / All Ages</option>\r\n              <option value=\"Y\">Y / Youth (10+)</option>\r\n              <option value=\"T\">T / Teen (13+)</option>\r\n              <option value=\"OT\">OT / Older Teen (16+)</option>\r\n              <option value=\"M\">M / Mature (18+)</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n\r\n        {/* VISIBILITY, AUTO-NOTIFICATION & RELEASE SCHEDULER HANDOFF */}\r\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\r\n          <div className={`p-4 rounded-xl border transition-colors flex items-center justify-between ${formData.isHidden ? 'bg-red-900/10 border-red-900/50' : 'bg-black border-zinc-800'}`}>\r\n            <div className=\"flex items-center gap-3\">\r\n               <input type=\"checkbox\" checked={formData.isHidden} onChange={(e) => handleInputChange('isHidden', e.target.checked)} className=\"accent-red-500 w-5 h-5 cursor-pointer\" />\r\n               <label className={`text-xs font-black uppercase tracking-widest ${formData.isHidden ? 'text-red-500' : 'text-zinc-400'}`}>Hide Series (Unpublish)</label>\r\n            </div>\r\n            {formData.isHidden && <span className=\"flex items-center gap-1.5 text-[9px] font-bold text-red-500 uppercase tracking-widest\"><EyeOff className=\"w-3 h-3\"/> Hidden</span>}\r\n          </div>\r\n\r\n          <div className=\"bg-black border border-zinc-800 p-4 rounded-xl flex items-center justify-between gap-2\">\r\n            <label className=\"flex items-center gap-2 cursor-pointer\">\r\n              <input\r\n                type=\"checkbox\"\r\n                checked={formData.autoNotify}\r\n                onChange={(e) => handleInputChange('autoNotify', e.target.checked)}\r\n                className=\"accent-[#fe9a00] w-4 h-4\"\r\n              />\r\n              <Bell className=\"w-3.5 h-3.5 text-[#fe9a00]\" />\r\n              <span className=\"text-[10px] font-black text-zinc-300 uppercase tracking-widest\">Notify Fans on Launch</span>\r\n            </label>\r\n\r\n            <button\r\n              type=\"button\"\r\n              onClick={() => document.getElementById('release-scheduler-tab-trigger')?.click()}\r\n              className=\"text-[9px] font-black uppercase tracking-widest bg-zinc-900 text-zinc-300 hover:bg-[#fe9a00] hover:text-black border border-zinc-700 hover:border-[#fe9a00] transition-colors px-3 py-1.5 rounded-lg flex items-center gap-1.5 cursor-pointer shrink-0\"\r\n              title=\"Manage chapter release dates and syndication in Release Scheduler\"\r\n            >\r\n              Release Scheduler <ArrowRight className=\"w-3 h-3\" />\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        {/* COMPLETED RUNS (PLUS VAULT) & ONE-SHOT WEDNESDAY DEBUT (48H FREE UNLOCK) */}\r\n        <div className={`p-4 rounded-xl border transition-colors flex flex-col gap-4 ${\r\n          formData.oneShotDebut\r\n            ? 'bg-gradient-to-r from-[#fe9a00]/15 via-purple-950/25 to-black border-[#fe9a00]/60 shadow-[0_0_25px_rgba(254,154,0,0.12)]'\r\n            : formData.homeSection === 'Completed Runs'\r\n            ? 'bg-purple-950/20 border-purple-500/50'\r\n            : 'bg-black border-zinc-800'\r\n        }`}>\r\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\r\n            <div className=\"flex items-center gap-3\">\r\n              <input\r\n                type=\"checkbox\"\r\n                checked={formData.homeSection === 'Completed Runs' || formData.oneShotDebut}\r\n                onChange={(e) => {\r\n                  const isChecked = e.target.checked;\r\n                  const existingSeriesObj = seriesList.find((s: any) => s.slug === targetSeries);\r\n                  const previousSection =\r\n                    existingSeriesObj?.home_section && existingSeriesObj.home_section !== 'Completed Runs'\r\n                      ? existingSeriesObj.home_section\r\n                      : '';\r\n                  handleInputChange('homeSection', isChecked ? 'Completed Runs' : previousSection);\r\n                  if (!isChecked && formData.oneShotDebut) {\r\n                    handleInputChange('oneShotDebut', false);\r\n                  }\r\n                }}\r\n                className=\"accent-[#fe9a00] w-5 h-5 cursor-pointer shrink-0\"\r\n              />\r\n              <div>\r\n                <span className=\"text-xs font-black uppercase tracking-widest text-white block\">\r\n                  Completed Run (PLUS Vault & One-Shot Wednesdays)\r\n                </span>\r\n                <span className=\"text-[10px] font-bold text-zinc-400 uppercase tracking-widest\">\r\n                  Locks all chapters to PLUS subscribers except when featured on One-Shot Wednesdays\r\n                </span>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"text-left sm:text-right shrink-0\">\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-[#fe9a00] block\">\r\n                Active / Next Wednesday Pick:\r\n              </span>\r\n              <span className=\"text-xs font-black text-white uppercase\">\r\n                {currentWednesdaySpotlight?.title || 'None Assigned'}\r\n              </span>\r\n            </div>\r\n          </div>\r\n\r\n          {/* ONE-SHOT WEDNESDAY DEBUT TOGGLE BUTTON (DEFAULT OFF • 48H FREE WINDOW -> AUTO VAULT + OSW ROTATION) */}\r\n          <div className=\"pt-3 border-t border-zinc-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\r\n            <div className=\"flex items-start sm:items-center gap-2.5\">\r\n              <Zap className={`w-4 h-4 shrink-0 mt-0.5 sm:mt-0 ${formData.oneShotDebut ? 'text-[#fe9a00] fill-[#fe9a00]' : 'text-zinc-500'}`} />\r\n              <div>\r\n                <div className=\"flex items-center gap-2 flex-wrap\">\r\n                  <span className=\"text-[11px] font-black uppercase tracking-wider text-white\">\r\n                    One-Shot Wednesday Debut (2-Day Free Unlock)\r\n                  </span>\r\n                  {activeDebutRemaining && (\r\n                    <span className=\"px-2 py-0.5 rounded bg-[#fe9a00]/20 border border-[#fe9a00]/50 text-[#fe9a00] text-[9px] font-mono font-black uppercase\">\r\n                      ⏳ {activeDebutRemaining} Free Left\r\n                    </span>\r\n                  )}\r\n                </div>\r\n                <p className=\"text-[10px] font-bold text-zinc-400 mt-0.5\">\r\n                  Unlocks this series FREE for 48 hours on launch (any day of the week), then automatically locks it into the PLUS Vault and adds it to the One-Shot Wednesday rotation.\r\n                </p>\r\n              </div>\r\n            </div>\r\n\r\n            <button\r\n              type=\"button\"\r\n              onClick={() => {\r\n                const nextDebutState = !formData.oneShotDebut;\r\n                handleInputChange('oneShotDebut', nextDebutState);\r\n                if (nextDebutState) {\r\n                  handleInputChange('homeSection', 'Completed Runs');\r\n                }\r\n              }}\r\n              className={`px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-2 transition-all cursor-pointer shrink-0 border ${\r\n                formData.oneShotDebut\r\n                  ? 'bg-[#fe9a00] text-black border-[#fe9a00] shadow-[0_0_20px_rgba(254,154,0,0.4)]'\r\n                  : 'bg-zinc-900 text-zinc-400 hover:text-white border-zinc-700'\r\n              }`}\r\n            >\r\n              <Zap className={`w-3.5 h-3.5 ${formData.oneShotDebut ? 'fill-black' : ''}`} />\r\n              {formData.oneShotDebut ? 'OSW Debut: ON (48h Free → Vault)' : 'OSW Debut: OFF'}\r\n            </button>\r\n          </div>\r\n        </div>\r\n        \r\n        {/* HERO BANNER SECTION */}\r\n        <div className=\"border-b border-zinc-800 pb-6\">\r\n           <div className=\"flex items-center justify-between mb-4\">\r\n             <h3 className=\"font-bold text-[#fe9a00] uppercase text-xs\">Series Hero Banner</h3>\r\n             {formData.bannerUrl && (\r\n               <button type=\"button\" onClick={() => { if(window.confirm(\"Remove this Banner?\")) handleInputChange('bannerUrl', '') }} className=\"text-[10px] font-bold text-red-500 hover:text-red-400 uppercase tracking-widest flex items-center gap-1 cursor-pointer\">\r\n                 <Trash2 className=\"w-3 h-3\" /> Remove Banner\r\n               </button>\r\n             )}\r\n           </div>\r\n           \r\n           <Dropzone label={formData.bannerUrl ? \"Replace Banner\" : \"+ Add Banner\"} height=\"p-6\" folderPath=\"series-banners\" onUploadComplete={(url: any) => handleInputChange('bannerUrl', url)} />\r\n           \r\n           {formData.bannerUrl && (\r\n             <div className=\"mt-6 bg-black p-4 sm:p-6 rounded-xl border border-zinc-800 space-y-6\">\r\n               <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-800 pb-4\">\r\n                 <div className=\"flex items-center gap-2\">\r\n                   <Crop className=\"w-4 h-4 text-[#fe9a00]\" />\r\n                   <span className=\"text-[11px] font-black text-white uppercase tracking-wider\">Crop & Position Framing</span>\r\n                 </div>\r\n\r\n                 <div className=\"flex items-center gap-2\">\r\n                   <div className=\"flex items-center gap-1 bg-zinc-900 p-1 rounded border border-zinc-700\">\r\n                     <button onClick={() => setPreviewDevice('desktop')} type=\"button\" className={`flex items-center gap-1.5 px-3 py-1.5 rounded text-[10px] font-black uppercase tracking-widest transition-colors cursor-pointer ${previewDevice === 'desktop' ? 'bg-[#fe9a00] text-black' : 'text-zinc-400 hover:text-white'}`}>\r\n                       <Monitor className=\"w-3 h-3\" /> Desktop\r\n                     </button>\r\n                     <button onClick={() => setPreviewDevice('mobile')} type=\"button\" className={`flex items-center gap-1.5 px-3 py-1.5 rounded text-[10px] font-black uppercase tracking-widest transition-colors cursor-pointer ${previewDevice === 'mobile' ? 'bg-[#fe9a00] text-black' : 'text-zinc-400 hover:text-white'}`}>\r\n                       <Smartphone className=\"w-3 h-3\" /> Mobile\r\n                     </button>\r\n                   </div>\r\n                 </div>\r\n               </div>\r\n\r\n               <div className=\"flex flex-col items-center justify-center bg-zinc-900/60 rounded-xl p-4 sm:p-8 border border-zinc-800\">\r\n                 <div \r\n                   onClick={() => setBannerCropper({ isOpen: true, device: previewDevice })}\r\n                   title=\"Click to open crop window\"\r\n                   className={`relative overflow-hidden bg-black border-2 border-zinc-700 shadow-2xl transition-all duration-300 cursor-pointer group ${previewDevice === 'desktop' ? 'w-full aspect-[21/9] sm:aspect-[3/1] rounded-xl' : 'w-[200px] sm:w-[240px] aspect-[4/5] rounded-3xl'}`}\r\n                 >\r\n                   <img \r\n                     src={formData.bannerUrl} \r\n                     alt=\"Banner Preview\" \r\n                     className=\"w-full h-full object-cover transition-all duration-300 pointer-events-none\"\r\n                     style={{ \r\n                       objectPosition: activePosition,\r\n                       transform: `scale(${activeScale / 100})`,\r\n                       transformOrigin: activePosition\r\n                     }}\r\n                   />\r\n                   <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none\" />\r\n                   \r\n                   <div className=\"absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center gap-2 transition-opacity backdrop-blur-[2px]\">\r\n                     <div className=\"w-12 h-12 rounded-full bg-[#fe9a00] text-black flex items-center justify-center shadow-xl\">\r\n                       <Crop className=\"w-6 h-6\" />\r\n                     </div>\r\n                     <span className=\"bg-black/90 border border-zinc-700 text-white px-4 py-1.5 rounded-full font-black text-[10px] uppercase tracking-widest\">\r\n                       Click to Adjust {previewDevice === 'desktop' ? 'Desktop (21:9)' : 'Mobile (4:5)'} Framing\r\n                     </span>\r\n                   </div>\r\n                 </div>\r\n\r\n                 <button\r\n                   type=\"button\"\r\n                   onClick={() => setBannerCropper({ isOpen: true, device: previewDevice })}\r\n                   className=\"mt-6 flex items-center gap-2 bg-[#fe9a00] hover:bg-white text-black px-6 py-3 rounded-full font-black text-xs uppercase tracking-widest transition-all shadow-[0_0_20px_rgba(254,154,0,0.3)] cursor-pointer\"\r\n                 >\r\n                   <Crop className=\"w-4 h-4\" /> Open {previewDevice === 'desktop' ? 'Desktop' : 'Mobile'} Crop Window\r\n                 </button>\r\n               </div>\r\n             </div>\r\n           )}\r\n        </div>\r\n\r\n        <div className=\"grid grid-cols-2 gap-4 border-b border-zinc-800 pb-6\">\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase mb-2\">Card Background Color</label>\r\n            <div className=\"flex items-center gap-3 bg-zinc-900 border border-zinc-700 rounded p-2\">\r\n              <input \r\n                type=\"color\" \r\n                value={formData.cardColor} \r\n                onChange={(e) => handleInputChange('cardColor', e.target.value)}\r\n                className=\"w-8 h-8 rounded cursor-pointer bg-transparent border-0 p-0\"\r\n              />\r\n              <span className=\"text-xs text-white font-mono uppercase\">{formData.cardColor}</span>\r\n            </div>\r\n            <div className=\"flex flex-wrap gap-2 mt-3\">\r\n              {['#18181b', '#fe9a00', '#dc2626', '#3b82f6', '#16a34a', '#a855f7', '#4f46e5', '#db2777'].map(color => (\r\n                <button \r\n                  key={color} \r\n                  type=\"button\"\r\n                  onClick={() => handleInputChange('cardColor', color)}\r\n                  className=\"w-5 h-5 rounded-full border border-white/20 hover:scale-110 transition-transform shadow-sm cursor-pointer\"\r\n                  style={{ backgroundColor: color }}\r\n                  title={color}\r\n                />\r\n              ))}\r\n            </div>\r\n          </div>\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase mb-2\">Card Pattern</label>\r\n            <select \r\n              value={formData.cardPattern} \r\n              onChange={(e) => handleInputChange('cardPattern', e.target.value)}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs focus:border-[#fe9a00]\"\r\n            >\r\n              <option value=\"none\">Solid Color (None)</option>\r\n              <option value=\"dots\">Micro Dots</option>\r\n              <option value=\"pinstripes\">Subtle Pinstripes</option>\r\n              <option value=\"mesh\">Fine Mesh</option>\r\n              <option value=\"glow\">Top Glow Aura</option>\r\n              <option value=\"cut\">Diagonal Cut</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n        \r\n        {/* LOGO & CHARACTER RENDER SECTION */}\r\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 border-b border-zinc-800 pb-6\">\r\n           <div className=\"flex flex-col gap-4\">\r\n             <div className=\"flex items-center justify-between mb-2\">\r\n               <h3 className=\"font-bold text-[#fe9a00] uppercase text-xs\">Logo</h3>\r\n               {formData.logoUrl && (\r\n                 <button type=\"button\" onClick={() => { if(window.confirm(\"Remove this Logo?\")) handleInputChange('logoUrl', '') }} className=\"text-[10px] font-bold text-red-500 hover:text-red-400 uppercase tracking-widest flex items-center gap-1 cursor-pointer\">\r\n                   <Trash2 className=\"w-3 h-3\" /> Remove Logo\r\n                 </button>\r\n               )}\r\n             </div>\r\n             \r\n             {formData.logoUrl && <img src={formData.logoUrl} className=\"h-16 mb-3 bg-black p-2 rounded object-contain border border-zinc-800\" alt=\"Logo\" />}\r\n             \r\n             <Dropzone label={formData.logoUrl ? \"Replace Logo\" : \"+ Add Logo\"} folderPath=\"series-logos\" onUploadComplete={(url: any) => handleInputChange('logoUrl', url)} />\r\n             \r\n             <div className=\"flex gap-4 w-full mt-2\">\r\n               <div className=\"flex-1\">\r\n                 <label className=\"block text-[10px] font-bold text-zinc-400 uppercase mb-2\">Zoom ({formData.logoScale ?? 100}%)</label>\r\n                 <input type=\"range\" min=\"30\" max=\"200\" value={formData.logoScale ?? 100} onChange={(e) => handleInputChange('logoScale', parseInt(e.target.value))} className=\"w-full accent-[#fe9a00] cursor-pointer\" />\r\n               </div>\r\n               <div className=\"flex-1\">\r\n                 <label className=\"block text-[10px] font-bold text-zinc-400 uppercase mb-2\">Placement ({formData.logoOffset ?? 16}px)</label>\r\n                 <input type=\"range\" min=\"0\" max=\"150\" value={formData.logoOffset ?? 16} onChange={(e) => handleInputChange('logoOffset', parseInt(e.target.value))} className=\"w-full accent-[#fe9a00] cursor-pointer\" />\r\n               </div>\r\n             </div>\r\n           </div>\r\n           \r\n           <div>\r\n             <div className=\"flex justify-between items-center mb-4\">\r\n               <h3 className=\"font-bold text-[#fe9a00] uppercase text-xs\">Character Render</h3>\r\n               <div className=\"flex items-center gap-2\">\r\n                 {formData.characterUrl && (\r\n                   <button \r\n                     type=\"button\" \r\n                     onClick={() => setCharCropperOpen(true)}\r\n                     className=\"text-[9px] font-black uppercase tracking-widest bg-[#fe9a00] text-black px-2.5 py-1 rounded flex items-center gap-1 hover:bg-white transition-colors cursor-pointer\"\r\n                   >\r\n                     <Crop className=\"w-3 h-3\" /> Crop Window\r\n                   </button>\r\n                 )}\r\n                 {formData.characterUrl && (\r\n                   <button type=\"button\" onClick={() => { if(window.confirm(\"Remove this Render?\")) handleInputChange('characterUrl', '') }} className=\"text-[10px] font-bold text-red-500 hover:text-red-400 uppercase tracking-widest flex items-center gap-1 cursor-pointer\">\r\n                     <Trash2 className=\"w-3 h-3\" /> Remove\r\n                   </button>\r\n                 )}\r\n               </div>\r\n             </div>\r\n\r\n             <div className=\"flex gap-4 items-start\">\r\n               <div className=\"flex-1 flex flex-col gap-3\">\r\n                 <Dropzone label={formData.characterUrl ? \"Replace Character\" : \"+ Add Character\"} folderPath=\"series-characters\" onUploadComplete={(url: any) => handleInputChange('characterUrl', url)} />\r\n                 {formData.characterUrl && (\r\n                   <button \r\n                     type=\"button\" \r\n                     onClick={() => setCharCropperOpen(true)}\r\n                     className=\"w-full py-3.5 bg-zinc-800 hover:bg-[#fe9a00] hover:text-black text-white font-black uppercase tracking-widest text-[10px] rounded-lg transition-all flex items-center justify-center gap-2 border border-zinc-700 hover:border-[#fe9a00] cursor-pointer\"\r\n                   >\r\n                     <Crop className=\"w-4 h-4\" /> Open Character Crop Window (2:3)\r\n                   </button>\r\n                 )}\r\n               </div>\r\n\r\n               {formData.characterUrl && (\r\n                 <div className=\"w-28 sm:w-36 flex-shrink-0 flex flex-col items-center\">\r\n                   <span className=\"text-[8px] font-bold text-zinc-500 uppercase tracking-widest mb-1.5 self-start\">Live Card Preview</span>\r\n                   <div \r\n                     onClick={() => setCharCropperOpen(true)}\r\n                     className=\"w-full relative overflow-hidden rounded-lg aspect-[2/3] border border-zinc-800 shadow-xl group/charpreview cursor-pointer\"\r\n                     style={getPatternStyle(formData.cardColor, formData.cardPattern)}\r\n                     title=\"Click to adjust character crop\"\r\n                   >\r\n                     <div className=\"absolute inset-0 bg-gradient-to-br from-transparent to-black/60 z-0\" />\r\n                     \r\n                     <img \r\n                       src={formData.characterUrl} alt=\"Preview\" \r\n                       className={`absolute left-1/2 -translate-x-1/2 max-w-none object-contain z-10 transition-all duration-300 pointer-events-none ${formData.characterAlign === 'top' ? 'top-0' : formData.characterAlign === 'center' ? 'top-1/2 -translate-y-1/2' : 'bottom-0'}`}\r\n                       style={{ width: `${formData.characterScale || 140}%`, height: '120%' }}\r\n                     />\r\n                     <div className=\"absolute inset-x-0 bottom-0 h-[50%] bg-gradient-to-t from-black via-black/80 to-transparent z-20 pointer-events-none\" />\r\n                     \r\n                     {formData.logoUrl && (\r\n                       <div className=\"absolute left-0 right-0 flex justify-center z-30 px-2 transition-all duration-300 pointer-events-none\" style={{ bottom: `${formData.logoOffset ?? 16}px` }}>\r\n                         <img src={formData.logoUrl} alt=\"Logo\" className=\"max-h-24 object-contain drop-shadow-[0_4px_8px_rgba(0,0,0,0.8)]\" style={{ width: `${formData.logoScale ?? 100}%` }} />\r\n                       </div>\r\n                     )}\r\n\r\n                     <div className=\"absolute inset-0 bg-black/70 z-40 opacity-0 group-hover/charpreview:opacity-100 flex flex-col items-center justify-center gap-1.5 transition-opacity backdrop-blur-sm\">\r\n                       <Crop className=\"w-5 h-5 text-[#fe9a00]\" />\r\n                       <span className=\"text-[9px] font-black text-white uppercase tracking-widest text-center px-1\">\r\n                         Adjust Crop\r\n                       </span>\r\n                     </div>\r\n                   </div>\r\n                 </div>\r\n               )}\r\n             </div>\r\n           </div>\r\n        </div>\r\n\r\n        <div>\r\n          <label className=\"block text-[10px] font-bold text-zinc-400 uppercase mb-2\">Synopsis</label>\r\n          <textarea rows={3} value={formData.synopsis} onChange={(e) => handleInputChange('synopsis', e.target.value)} className=\"w-full bg-black border border-zinc-700 rounded p-3 text-white text-sm\" />\r\n        </div>\r\n        \r\n        <div className=\"bg-black p-4 rounded border border-zinc-800 space-y-3\">\r\n          <div className=\"flex items-center gap-2\">\r\n            <input type=\"checkbox\" checked={formData.hasAwards} onChange={(e) => handleInputChange('hasAwards', e.target.checked)} className=\"accent-[#fe9a00] w-4 h-4 cursor-pointer\" />\r\n            <label className=\"text-[10px] font-bold text-white uppercase tracking-widest\">Enable Awards</label>\r\n          </div>\r\n          {formData.hasAwards && (<input type=\"text\" placeholder=\"e.g., 2025 Bronze Award Winner\" value={formData.awards || ''} onChange={(e) => handleInputChange('awards', e.target.value)} className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />)}\r\n        </div>\r\n        \r\n        <div className=\"border-t border-zinc-800 pt-6\">\r\n           <div className=\"flex justify-between items-center mb-4\">\r\n             <h3 className=\"font-bold text-[#fe9a00] uppercase text-xs tracking-widest\">Creators</h3>\r\n             <div className=\"flex items-center gap-2\">\r\n               {formData.creators.length > 1 && (\r\n                 <button type=\"button\" onClick={() => { \r\n                   const nc = [...formData.creators]; \r\n                   const temp = nc[0]; \r\n                   nc[0] = nc[1]; \r\n                   nc[1] = temp; \r\n                   handleInputChange('creators', nc); \r\n                 }} className=\"text-[10px] font-bold tracking-widest uppercase bg-zinc-800 px-3 py-2 rounded hover:bg-[#fe9a00] hover:text-black transition-colors cursor-pointer\">\r\n                   Swap Order\r\n                 </button>\r\n               )}\r\n               <button onClick={() => { \r\n                 if (formData.creators.length > 1 && !window.confirm(\"Are you sure you want to remove this co-creator?\")) return;\r\n                 const nc = formData.creators.length > 1 ? [formData.creators[0]] : [...formData.creators, { id: undefined, created_at: undefined, role: 'Co-creator', name: '', bio: '', flagCode1: '', flagCode2: '', avatar: '', instagram: '', twitter: '', supportLink: '', is_visible: true }]; \r\n                 handleInputChange('creators', nc); \r\n               }} className=\"text-[10px] font-bold tracking-widest uppercase bg-zinc-800 px-3 py-2 rounded hover:bg-[#fe9a00] hover:text-black transition-colors cursor-pointer\">\r\n                 {formData.creators.length > 1 ? '- Remove Co-creator' : '+ Add Co-creator'}\r\n               </button>\r\n             </div>\r\n           </div>\r\n           \r\n           <div className={`grid ${formData.creators.length > 1 ? 'grid-cols-2' : 'grid-cols-1'} gap-6`}>\r\n             {formData.creators.map((c, i) => {\r\n                const isCustomFlag1 = c.flagCode1 && !COUNTRY_CODES.some(cc => cc.code === c.flagCode1);\r\n                const selectValue1 = isCustomFlag1 ? 'OTHER' : c.flagCode1;\r\n\r\n                const isCustomFlag2 = c.flagCode2 && !COUNTRY_CODES.some(cc => cc.code === c.flagCode2);\r\n                const selectValue2 = isCustomFlag2 ? 'OTHER' : c.flagCode2;\r\n\r\n                return (\r\n                  <div key={i} className=\"bg-black p-4 rounded border border-zinc-800 space-y-4 relative\">\r\n                    <div className=\"flex items-center justify-between bg-zinc-900 p-2.5 rounded border border-zinc-700 mb-2\">\r\n                      <div>\r\n                        <span className=\"text-[10px] font-black text-white uppercase tracking-wider block\">Creator Visibility</span>\r\n                        <span className=\"text-[8px] text-zinc-500 font-bold uppercase tracking-widest\">Show in Creators Roster & Bingo</span>\r\n                      </div>\r\n                      <button \r\n                        type=\"button\" \r\n                        onClick={() => { \r\n                          const nc = [...formData.creators]; \r\n                          nc[i].is_visible = nc[i].is_visible === false ? true : false; \r\n                          handleInputChange('creators', nc); \r\n                        }} \r\n                        className={`px-3 py-1.5 text-[9px] font-black uppercase tracking-widest rounded transition-colors flex items-center gap-1.5 cursor-pointer ${\r\n                          c.is_visible !== false \r\n                            ? 'bg-green-900/30 text-green-400 border border-green-800/60 hover:bg-green-900/50' \r\n                            : 'bg-red-900/30 text-red-400 border border-red-800/60 hover:bg-red-900/50'\r\n                        }`}\r\n                      >\r\n                        {c.is_visible !== false ? <><Eye className=\"w-3 h-3\" /> Visible</> : <><EyeOff className=\"w-3 h-3\" /> Hidden</>}\r\n                      </button>\r\n                    </div>\r\n\r\n                    <select \r\n                      className=\"w-full bg-black border border-[#fe9a00]/30 text-[#fe9a00] rounded p-2 text-[10px] font-bold uppercase tracking-widest cursor-pointer\"\r\n                      onChange={(e) => handleAutofillCreator(i, e.target.value)}\r\n                      value=\"\"\r\n                    >\r\n                      <option value=\"\" disabled>-- Quick Fill: Select Existing Creator --</option>\r\n                      {existingCreators.map(ec => (\r\n                        <option key={ec.name} value={ec.name} className=\"text-white bg-zinc-900\">{ec.name}</option>\r\n                      ))}\r\n                    </select>\r\n\r\n                    <div className=\"grid grid-cols-1 md:grid-cols-4 gap-2\">\r\n                      <input type=\"text\" placeholder=\"Role (e.g., Creator)\" value={c.role} onChange={(e) => { const nc = [...formData.creators]; nc[i].role = e.target.value; handleInputChange('creators', nc); }} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      <input type=\"text\" placeholder=\"Full Name\" value={c.name} onChange={(e) => { const nc = [...formData.creators]; nc[i].name = e.target.value; handleInputChange('creators', nc); }} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      \r\n                      <div className=\"flex gap-2\">\r\n                        <select \r\n                          value={selectValue1} \r\n                          onChange={(e) => { \r\n                            const nc = [...formData.creators]; \r\n                            nc[i].flagCode1 = e.target.value === 'OTHER' ? (isCustomFlag1 ? c.flagCode1 : '') : e.target.value; \r\n                            handleInputChange('creators', nc); \r\n                          }} \r\n                          className=\"flex-1 bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs focus:border-[#fe9a00] cursor-pointer\"\r\n                        >\r\n                          <option value=\"\">-- Flag 1 --</option>\r\n                          {COUNTRY_CODES.map(country => (\r\n                            <option key={country.code} value={country.code}>{country.name}</option>\r\n                          ))}\r\n                          <option value=\"OTHER\">Other (Enter Code)</option>\r\n                        </select>\r\n\r\n                        {(isCustomFlag1 || selectValue1 === 'OTHER') && (\r\n                          <input \r\n                            type=\"text\" \r\n                            placeholder=\"Code\" \r\n                            maxLength={2}\r\n                            value={c.flagCode1} \r\n                            onChange={(e) => { \r\n                              const nc = [...formData.creators]; \r\n                              nc[i].flagCode1 = e.target.value.toUpperCase(); \r\n                              handleInputChange('creators', nc); \r\n                            }} \r\n                            className=\"w-12 text-center bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs font-black focus:border-[#fe9a00]\"\r\n                          />\r\n                        )}\r\n                      </div>\r\n\r\n                      <div className=\"flex gap-2\">\r\n                        <select \r\n                          value={selectValue2} \r\n                          onChange={(e) => { \r\n                            const nc = [...formData.creators]; \r\n                            nc[i].flagCode2 = e.target.value === 'OTHER' ? (isCustomFlag2 ? c.flagCode2 : '') : e.target.value; \r\n                            handleInputChange('creators', nc); \r\n                          }} \r\n                          className=\"flex-1 bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs focus:border-[#fe9a00] cursor-pointer\"\r\n                        >\r\n                          <option value=\"\">-- Flag 2 (Opt) --</option>\r\n                          {COUNTRY_CODES.map(country => (\r\n                            <option key={country.code} value={country.code}>{country.name}</option>\r\n                          ))}\r\n                          <option value=\"OTHER\">Other (Enter Code)</option>\r\n                        </select>\r\n\r\n                        {(isCustomFlag2 || selectValue2 === 'OTHER') && (\r\n                          <input \r\n                            type=\"text\" \r\n                            placeholder=\"Code\" \r\n                            maxLength={2}\r\n                            value={c.flagCode2} \r\n                            onChange={(e) => { \r\n                              const nc = [...formData.creators]; \r\n                              nc[i].flagCode2 = e.target.value.toUpperCase(); \r\n                              handleInputChange('creators', nc); \r\n                            }} \r\n                            className=\"w-12 text-center bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs font-black focus:border-[#fe9a00]\"\r\n                          />\r\n                        )}\r\n                      </div>\r\n\r\n                    </div>\r\n                    \r\n                    <div className=\"flex gap-4 items-center\">\r\n                      {c.avatar ? (\r\n                        <div className=\"relative group/avatar w-16 h-16 flex-shrink-0 cursor-pointer\">\r\n                          <img src={c.avatar} className=\"w-16 h-16 rounded-full object-cover border border-zinc-700\" alt=\"Avatar\" />\r\n                          <button type=\"button\" onClick={() => { if(window.confirm(\"Remove this Avatar?\")) { const nc = [...formData.creators]; nc[i].avatar = ''; handleInputChange('creators', nc); } }} className=\"absolute inset-0 bg-black/70 flex items-center justify-center rounded-full opacity-0 group-hover/avatar:opacity-100 transition-opacity\"><X className=\"w-6 h-6 text-red-500\" /></button>\r\n                        </div>\r\n                      ) : (\r\n                        <div className=\"w-24 flex-shrink-0\"><Dropzone label=\"+ Avatar\" folderPath=\"avatars\" onUploadComplete={(url: any) => { const nc = [...formData.creators]; nc[i].avatar = url; handleInputChange('creators', nc); }} /></div>\r\n                      )}\r\n                      <textarea placeholder=\"Creator Bio...\" value={c.bio} onChange={(e) => { const nc = [...formData.creators]; nc[i].bio = e.target.value; handleInputChange('creators', nc); }} className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs h-20\" />\r\n                    </div>\r\n\r\n                    <div className=\"grid grid-cols-3 gap-2\">\r\n                      <input type=\"text\" placeholder=\"Twitter URL\" value={c.twitter} onChange={(e) => { const nc = [...formData.creators]; nc[i].twitter = e.target.value; handleInputChange('creators', nc); }} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      <input type=\"text\" placeholder=\"Instagram URL\" value={c.instagram} onChange={(e) => { const nc = [...formData.creators]; nc[i].instagram = e.target.value; handleInputChange('creators', nc); }} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      <input type=\"text\" placeholder=\"Support URL\" value={c.supportLink} onChange={(e) => { const nc = [...formData.creators]; nc[i].supportLink = e.target.value; handleInputChange('creators', nc); }} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                    </div>\r\n                  </div>\r\n                );\r\n             })}\r\n           </div>\r\n        </div>\r\n\r\n        <div className=\"border-t border-zinc-800 pt-8 mt-8\">\r\n          <div className=\"flex justify-between items-center mb-6\">\r\n            <div>\r\n              <h3 className=\"font-black text-xl italic text-[#fe9a00] uppercase tracking-tighter\">Character Roster</h3>\r\n              <p className=\"text-[10px] text-zinc-500 font-bold uppercase tracking-widest mt-1\">Build the Wiki Database</p>\r\n            </div>\r\n            <button onClick={handleAddCharacter} className=\"bg-zinc-800 hover:bg-[#fe9a00] hover:text-black text-white px-4 py-2 rounded text-[10px] font-black uppercase tracking-widest transition-colors flex items-center gap-2 cursor-pointer\">\r\n              <Plus className=\"w-4 h-4\" /> Add Character\r\n            </button>\r\n          </div>\r\n\r\n          <div className=\"space-y-4\">\r\n            {formData.characters.map((char, i) => {\r\n              const isCustomHeight = char.height && !HEIGHT_PRESETS.includes(char.height);\r\n              \r\n              return (\r\n              <div key={char.id || i} className=\"bg-black border border-zinc-800 rounded-xl overflow-hidden\">\r\n                <div \r\n                  onClick={() => setExpandedCharIndex(expandedCharIndex === i ? null : i)}\r\n                  className=\"flex items-center justify-between p-4 bg-zinc-900/50 cursor-pointer hover:bg-zinc-900 transition-colors\"\r\n                >\r\n                  <div className=\"flex items-center gap-4\">\r\n                    <div className=\"flex items-center gap-2 mr-2\">\r\n                      <button onClick={(e) => moveCharacter(i, 'up', e)} className=\"p-1 hover:bg-zinc-800 rounded text-zinc-500 hover:text-white transition-colors cursor-pointer\" disabled={i === 0}>\r\n                        <ArrowUp className=\"w-4 h-4\" />\r\n                      </button>\r\n                      <button onClick={(e) => moveCharacter(i, 'down', e)} className=\"p-1 hover:bg-zinc-800 rounded text-zinc-500 hover:text-white transition-colors cursor-pointer\" disabled={i === formData.characters.length - 1}>\r\n                        <ArrowDown className=\"w-4 h-4\" />\r\n                      </button>\r\n                    </div>\r\n\r\n                    <div className=\"w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 overflow-hidden shrink-0 flex items-center justify-center relative\">\r\n                      <User className=\"w-5 h-5 text-zinc-600 absolute\" />\r\n                      {char.headshot_url && (\r\n                        <img \r\n                          key={char.headshot_url}\r\n                          src={char.headshot_url} \r\n                          className=\"w-full h-full object-cover relative z-10\" \r\n                          alt={char.name || 'Character'}\r\n                          onError={(e) => { e.currentTarget.style.display = 'none'; }}\r\n                        />\r\n                      )}\r\n                    </div>\r\n                    <div>\r\n                      <h4 className=\"font-black uppercase text-white tracking-widest text-sm\">{char.name || 'Unnamed Character'}</h4>\r\n                      <span className=\"text-[9px] font-bold text-[#fe9a00] uppercase tracking-widest\">{char.role_type} {char.is_mc && '• MAIN CHARACTER'}</span>\r\n                    </div>\r\n                  </div>\r\n                  \r\n                  <div className=\"flex items-center gap-3\">\r\n                    <button \r\n                      type=\"button\"\r\n                      onClick={(e) => { e.stopPropagation(); handleCharacterChange(i, 'is_hidden', !char.is_hidden); }}\r\n                      className={`px-3 py-1 rounded text-[9px] font-black uppercase tracking-widest border transition-colors cursor-pointer ${\r\n                        char.is_hidden \r\n                          ? 'bg-red-950 border-red-900 text-red-500 hover:bg-red-900' \r\n                          : 'bg-green-950 border-green-900 text-green-500 hover:bg-green-900'\r\n                      }`}\r\n                    >\r\n                      {char.is_hidden ? 'Hidden' : 'Visible'}\r\n                    </button>\r\n                    {expandedCharIndex === i ? <ChevronUp className=\"w-5 h-5 text-zinc-500\" /> : <ChevronDown className=\"w-5 h-5 text-zinc-500\" />}\r\n                  </div>\r\n                </div>\r\n\r\n                {expandedCharIndex === i && (\r\n                  <div className=\"p-6 border-t border-zinc-800 space-y-6 animate-fade-in\">\r\n                    \r\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\r\n                      <input type=\"text\" placeholder=\"Character Name\" value={char.name} onChange={(e) => handleCharacterChange(i, 'name', e.target.value)} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      <div className=\"flex gap-4\">\r\n                        <select value={char.role_type} onChange={(e) => handleCharacterChange(i, 'role_type', e.target.value)} className=\"w-1/2 bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs cursor-pointer\">\r\n                          <option value=\"Hero\">Hero</option><option value=\"Villain\">Villain</option><option value=\"Neutral\">Neutral</option>\r\n                        </select>\r\n                        <div className=\"flex-1 flex items-center gap-2 bg-zinc-900 border border-zinc-700 rounded p-3\">\r\n                          <input type=\"checkbox\" checked={char.is_mc} onChange={(e) => handleCharacterChange(i, 'is_mc', e.target.checked)} className=\"w-4 h-4 accent-[#fe9a00] cursor-pointer\" />\r\n                          <label className=\"text-[10px] font-black uppercase text-white tracking-widest\">Is Main Character?</label>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n\r\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-zinc-800 pt-6\">\r\n                      \r\n                      <div>\r\n                        <label className=\"block text-[9px] font-bold text-zinc-500 uppercase tracking-widest mb-2\">Affiliation</label>\r\n                        <div className=\"flex gap-2\">\r\n                          <select \r\n                            value={['AM', 'PM', 'Pilot Manga'].includes(char.element) ? char.element : (char.element ? 'Custom' : 'AM')} \r\n                            onChange={(e) => {\r\n                              if (e.target.value === 'Custom') handleCharacterChange(i, 'element', 'Custom Entry');\r\n                              else handleCharacterChange(i, 'element', e.target.value);\r\n                            }}\r\n                            className={`${['AM', 'PM', 'Pilot Manga'].includes(char.element) || !char.element ? 'w-full' : 'w-1/2'} bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs cursor-pointer`}\r\n                          >\r\n                            <option value=\"AM\">AM</option>\r\n                            <option value=\"PM\">PM</option>\r\n                            <option value=\"Pilot Manga\">Pilot Manga</option>\r\n                            <option value=\"Custom\">Custom...</option>\r\n                          </select>\r\n                          {(!['AM', 'PM', 'Pilot Manga'].includes(char.element) && char.element) && (\r\n                            <input \r\n                              type=\"text\" \r\n                              placeholder=\"Custom Affiliation...\" \r\n                              value={char.element === 'Custom Entry' ? '' : char.element} \r\n                              onChange={(e) => handleCharacterChange(i, 'element', e.target.value)} \r\n                              className=\"w-1/2 bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" \r\n                            />\r\n                          )}\r\n                        </div>\r\n                      </div>\r\n\r\n                      <div>\r\n                        <label className=\"block text-[9px] font-bold text-zinc-500 uppercase tracking-widest mb-2\">Power Type / Class</label>\r\n                        <input type=\"text\" placeholder=\"e.g. Fire, Magic, Tech\" value={char.weapon} onChange={(e) => handleCharacterChange(i, 'weapon', e.target.value)} className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      </div>\r\n                    </div>\r\n\r\n                    <div className=\"grid grid-cols-2 md:grid-cols-6 gap-4 border-t border-zinc-800 pt-6\">\r\n                      <input type=\"text\" placeholder=\"Age\" value={char.age} onChange={(e) => handleCharacterChange(i, 'age', e.target.value)} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      \r\n                      <div className=\"flex gap-2\">\r\n                        <select \r\n                          value={isCustomHeight ? 'Custom' : (char.height || '')} \r\n                          onChange={(e) => {\r\n                            if (e.target.value === 'Custom') handleCharacterChange(i, 'height', 'Custom Entry');\r\n                            else handleCharacterChange(i, 'height', e.target.value);\r\n                          }}\r\n                          className={`${isCustomHeight ? 'w-[45%] px-1' : 'w-full'} bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs focus:border-[#fe9a00] cursor-pointer`}\r\n                        >\r\n                          <option value=\"\">Height</option>\r\n                          {HEIGHT_PRESETS.map(h => (\r\n                            <option key={h} value={h}>{h}</option>\r\n                          ))}\r\n                          <option value=\"Custom\">Custom</option>\r\n                        </select>\r\n                        {isCustomHeight && (\r\n                          <input \r\n                            type=\"text\" \r\n                            placeholder=\"e.g. 5'10&quot;\" \r\n                            value={char.height === 'Custom Entry' ? '' : char.height} \r\n                            onChange={(e) => handleCharacterChange(i, 'height', e.target.value)} \r\n                            className=\"w-[55%] bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs px-2 focus:border-[#fe9a00]\" \r\n                          />\r\n                        )}\r\n                      </div>\r\n                      \r\n                      <input type=\"text\" placeholder=\"Ethnicity\" value={char.ethnicity} onChange={(e) => handleCharacterChange(i, 'ethnicity', e.target.value)} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      <input type=\"text\" placeholder=\"In-World Location\" value={char.location} onChange={(e) => handleCharacterChange(i, 'location', e.target.value)} className=\"bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" />\r\n                      \r\n                      <div className=\"col-span-2 flex gap-2\">\r\n                        <select \r\n                          value={(char.first_appearance && !seriesChapters.some(ch => `Chapter ${ch.chapter_number}` === char.first_appearance)) ? 'Custom' : (char.first_appearance || '')} \r\n                          onChange={(e) => {\r\n                            if (e.target.value === 'Custom') handleCharacterChange(i, 'first_appearance', 'Custom Entry');\r\n                            else handleCharacterChange(i, 'first_appearance', e.target.value);\r\n                          }}\r\n                          className={`${(char.first_appearance && !seriesChapters.some(ch => `Chapter ${ch.chapter_number}` === char.first_appearance)) ? 'w-1/2' : 'w-full'} bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs cursor-pointer`}\r\n                        >\r\n                          <option value=\"\">-- 1st Appearance --</option>\r\n                          {seriesChapters.map(ch => (\r\n                            <option key={ch.id} value={`Chapter ${ch.chapter_number}`}>Ch. {ch.chapter_number}</option>\r\n                          ))}\r\n                          <option value=\"Custom\">Custom...</option>\r\n                        </select>\r\n                        {(char.first_appearance && !seriesChapters.some(ch => `Chapter ${ch.chapter_number}` === char.first_appearance)) && (\r\n                          <input \r\n                            type=\"text\" \r\n                            placeholder=\"Type appearance...\" \r\n                            value={char.first_appearance === 'Custom Entry' ? '' : char.first_appearance} \r\n                            onChange={(e) => handleCharacterChange(i, 'first_appearance', e.target.value)} \r\n                            className=\"w-1/2 bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs\" \r\n                          />\r\n                        )}\r\n                      </div>\r\n                    </div>\r\n\r\n                    <div className=\"space-y-4 border-t border-zinc-800 pt-6\">\r\n                      <textarea placeholder=\"Origin Story...\" value={char.origin} onChange={(e) => handleCharacterChange(i, 'origin', e.target.value)} className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs h-20 resize-none\" />\r\n                      <textarea placeholder=\"Powers & Abilities...\" value={char.powers} onChange={(e) => handleCharacterChange(i, 'powers', e.target.value)} className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs h-16 resize-none\" />\r\n                      <textarea placeholder=\"Weaknesses...\" value={char.weakness} onChange={(e) => handleCharacterChange(i, 'weakness', e.target.value)} className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-3 text-white text-xs h-16 resize-none\" />\r\n                    </div>\r\n\r\n                    <div className=\"flex flex-col sm:flex-row gap-6 border-t border-zinc-800 pt-6\">\r\n                      \r\n                      <div className=\"w-full sm:w-1/2 flex flex-col items-center\">\r\n                        <label className=\"block text-[9px] font-bold text-zinc-500 uppercase tracking-widest mb-2 text-center\">Character Thumbnail (1:1)</label>\r\n                        <button \r\n                          type=\"button\"\r\n                          onClick={() => {\r\n                             setCropTarget({ charIndex: i, field: 'headshot_url' });\r\n                             document.getElementById('headshot-upload')?.click();\r\n                          }}\r\n                          className=\"w-full max-w-[200px] mx-auto mb-3 py-4 border-2 border-dashed border-zinc-700 rounded-xl text-zinc-500 font-black uppercase tracking-widest text-[10px] hover:border-[#fe9a00] hover:text-[#fe9a00] transition-colors bg-black flex flex-col items-center justify-center gap-2 cursor-pointer\"\r\n                        >\r\n                          {char.headshot_url ? 'Replace Headshot' : '+ Add Headshot'}\r\n                        </button>\r\n                        <div className=\"relative w-24 h-24 mx-auto rounded-full bg-zinc-800 border-2 border-zinc-700 overflow-hidden flex items-center justify-center\">\r\n                          <User className=\"w-10 h-10 text-zinc-600 absolute\" />\r\n                          {char.headshot_url && <img src={char.headshot_url} className=\"w-full h-full object-cover relative z-10 bg-zinc-900\" alt=\"Headshot\" onError={(e) => { e.currentTarget.style.display = 'none'; }}/>}\r\n                        </div>\r\n                      </div>\r\n\r\n                      <div className=\"w-full sm:w-1/2 border-t sm:border-t-0 sm:border-l border-zinc-800 pt-4 sm:pt-0 sm:pl-6 flex flex-col items-center\">\r\n                        <label className=\"block text-[9px] font-bold text-zinc-500 uppercase tracking-widest mb-2 text-center\">Alternate Form 1 (Optional)</label>\r\n                        \r\n                        <input \r\n                          type=\"text\" \r\n                          placeholder=\"Alt Form Name (e.g. Arodihs)\" \r\n                          value={char.alt_form_name || ''} \r\n                          onChange={(e) => handleCharacterChange(i, 'alt_form_name', e.target.value)} \r\n                          className=\"w-full max-w-[200px] bg-zinc-900 border border-zinc-700 rounded p-2 text-white text-[10px] mb-3 text-center\" \r\n                        />\r\n\r\n                        <button \r\n                          type=\"button\"\r\n                          onClick={() => {\r\n                             setCropTarget({ charIndex: i, field: 'alt_headshot_url' });\r\n                             document.getElementById('headshot-upload')?.click();\r\n                          }}\r\n                          className=\"w-full max-w-[200px] mx-auto mb-3 py-4 border-2 border-dashed border-zinc-700 rounded-xl text-zinc-500 font-black uppercase tracking-widest text-[10px] hover:border-[#fe9a00] hover:text-[#fe9a00] transition-colors bg-black flex flex-col items-center justify-center gap-2 cursor-pointer\"\r\n                        >\r\n                          {char.alt_headshot_url ? 'Replace Alt Form 1' : '+ Add Alt Form 1'}\r\n                        </button>\r\n                        <div className=\"relative w-24 h-24 mx-auto rounded-full bg-zinc-800 border-2 border-zinc-700 overflow-hidden flex items-center justify-center\">\r\n                          <User className=\"w-10 h-10 text-zinc-600 absolute\" />\r\n                          {char.alt_headshot_url && <img src={char.alt_headshot_url} className=\"w-full h-full object-cover relative z-10 bg-zinc-900\" alt=\"Alt Form\" onError={(e) => { e.currentTarget.style.display = 'none'; }}/>}\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n\r\n                    <div className=\"w-full border-t border-zinc-800 pt-6 mt-6\">\r\n                      <div className=\"flex justify-between items-center mb-4\">\r\n                         <label className=\"block text-[9px] font-bold text-zinc-500 uppercase tracking-widest\">Additional Alternate Forms</label>\r\n                         <button type=\"button\" onClick={() => handleAddAltForm(i)} className=\"text-[10px] font-black text-[#fe9a00] hover:text-white uppercase tracking-widest bg-zinc-900 px-3 py-1.5 rounded-lg border border-zinc-700 cursor-pointer\">\r\n                           + Add Form\r\n                         </button>\r\n                      </div>\r\n                      \r\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\r\n                        {(char.alt_forms || []).map((alt: any, altIdx: number) => (\r\n                           <div key={altIdx} className=\"flex flex-col items-center bg-black p-4 rounded-xl border border-zinc-800 relative\">\r\n                             <button type=\"button\" onClick={() => handleRemoveAltForm(i, altIdx)} className=\"absolute top-2 right-2 text-zinc-500 hover:text-red-500 cursor-pointer\"><X className=\"w-4 h-4\" /></button>\r\n                             <input type=\"text\" placeholder=\"Form Name\" value={alt.name} onChange={(e) => handleAltFormChange(i, altIdx, 'name', e.target.value)} className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-2 text-white text-[10px] mb-3 text-center\" />\r\n                             \r\n                             <button \r\n                               type=\"button\" \r\n                               onClick={() => { \r\n                                 setCropTarget({ charIndex: i, field: 'alt_forms', altIndex: altIdx }); \r\n                                 document.getElementById('headshot-upload')?.click(); \r\n                               }} \r\n                               className=\"w-full mx-auto mb-3 py-3 border-2 border-dashed border-zinc-700 rounded-xl text-zinc-500 font-black uppercase tracking-widest text-[10px] hover:border-[#fe9a00] hover:text-[#fe9a00] transition-colors bg-black flex justify-center cursor-pointer\"\r\n                             >\r\n                                {alt.url ? 'Replace Image' : '+ Image (1:1)'}\r\n                             </button>\r\n                             \r\n                             <div className=\"relative w-16 h-16 rounded-full bg-zinc-800 border-2 border-zinc-700 overflow-hidden flex items-center justify-center\">\r\n                                {alt.url ? <img src={alt.url} className=\"w-full h-full object-cover relative z-10 bg-zinc-900\" alt={alt.name || 'Alt Form'} onError={(e) => { e.currentTarget.style.display = 'none'; }} /> : <User className=\"w-6 h-6 text-zinc-600 absolute\" />}\r\n                             </div>\r\n                           </div>\r\n                        ))}\r\n                      </div>\r\n                    </div>\r\n\r\n                    <button onClick={() => { if(window.confirm(\"Remove character?\")) { const nc = [...formData.characters]; nc.splice(i,1); handleInputChange('characters', nc); } }} className=\"w-full mt-4 py-3 bg-red-900/20 text-red-500 border border-red-900 rounded font-black uppercase text-[10px] tracking-widest hover:bg-red-500 hover:text-white transition-colors cursor-pointer\">\r\n                      Remove Character\r\n                    </button>\r\n                  </div>\r\n                )}\r\n              </div>\r\n            );\r\n            })}\r\n          </div>\r\n        </div>\r\n\r\n        <button onClick={handleSaveSeries} disabled={isSaving} className=\"w-full bg-[#fe9a00] text-black font-black uppercase tracking-widest py-4 rounded mt-4 hover:bg-white transition-colors cursor-pointer\">\r\n          {isSaving ? 'SAVING...' : 'Save Series & Roster'}\r\n        </button>\r\n      </div>\r\n    </div>\r\n  );\r\n};",
    "src/AmCommandCenter/AdminDashboard.tsx": "import React, { useState, useEffect, useMemo, useCallback } from 'react';\r\nimport { AnalyticsDashboard } from './AnalyticsDashboard';\r\nimport { HomeEditor } from './HomeEditor';\r\nimport { SeriesEditor } from './SeriesEditor';\r\nimport { ChapterUploader } from './ChapterUploader';\r\nimport { ReleaseScheduler } from './ReleaseScheduler';\r\nimport { HouseAdBuilder } from './HouseAdBuilder';\r\nimport { AvatarMaker } from './AvatarMaker';\r\nimport { StickerMaker } from './StickerMaker';\r\nimport { CardSkinMaker } from './CardSkinMaker';\r\nimport { FrameMaker } from './FrameMaker'; \r\nimport { ModerationDashboard } from './ModerationDashboard';\r\nimport { UserManager } from './UserManager';\r\nimport { CreatorPayoutTracker } from './CreatorPayoutTracker';\r\nimport { supabase } from '../supabase';\r\nimport { Bell, Send, BookOpen, Star, Sparkles, Newspaper, Key, Trash2, Mic, PenTool, XCircle, Link as LinkIcon, LineChart, CreditCard, Flame, Gift, Settings2, Users, ShieldAlert, Download, Loader2, Eye, EyeOff, Search, Tag, ArrowUpDown, Mail, MapPin, Phone, Calendar } from 'lucide-react';\r\nimport { useSeriesData } from '../userSeriesData';\r\n\r\nconst useUnsavedWarning = (hasUnsavedChanges: boolean) => {\r\n  useEffect(() => {\r\n    const handleBeforeUnload = (e: BeforeUnloadEvent) => {\r\n      if (hasUnsavedChanges) {\r\n        e.preventDefault();\r\n        e.returnValue = ''; \r\n      }\r\n    };\r\n    window.addEventListener('beforeunload', handleBeforeUnload);\r\n    return () => window.removeEventListener('beforeunload', handleBeforeUnload);\r\n  }, [hasUnsavedChanges]);\r\n};\r\n\r\n// --- GLOBAL CREATOR VISIBILITY MANAGER ---\r\nconst CreatorVisibilityManager = () => {\r\n  const [creators, setCreators] = useState<any[]>([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [search, setSearch] = useState('');\r\n  const [updatingName, setUpdatingName] = useState<string | null>(null);\r\n\r\n  const fetchCreators = async () => {\r\n    setLoading(true);\r\n    try {\r\n      const { data } = await supabase\r\n        .from('series_creators')\r\n        .select('*')\r\n        .order('name', { ascending: true });\r\n\r\n      if (data) {\r\n        const unique = new Map<string, any>();\r\n        data.forEach((row: any) => {\r\n          if (!row.name) return;\r\n          const key = row.name.trim();\r\n          if (!unique.has(key)) {\r\n            unique.set(key, {\r\n              name: key,\r\n              role: row.role || 'Creator',\r\n              avatar_url: row.avatar_url,\r\n              is_visible: row.is_visible !== false,\r\n              series_slugs: [row.series_slug]\r\n            });\r\n          } else {\r\n            const existing = unique.get(key)!;\r\n            if (row.is_visible === false) existing.is_visible = false;\r\n            if (!existing.series_slugs.includes(row.series_slug)) {\r\n              existing.series_slugs.push(row.series_slug);\r\n            }\r\n          }\r\n        });\r\n        setCreators(Array.from(unique.values()));\r\n      }\r\n    } catch (err) {\r\n      console.error(err);\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchCreators();\r\n  }, []);\r\n\r\n  const handleToggle = async (creator: any) => {\r\n    const nextState = !creator.is_visible;\r\n    setUpdatingName(creator.name);\r\n\r\n    try {\r\n      const { error } = await supabase\r\n        .from('series_creators')\r\n        .update({ is_visible: nextState })\r\n        .ilike('name', creator.name.trim());\r\n\r\n      if (error) throw error;\r\n      setCreators(prev => prev.map(c => c.name === creator.name ? { ...c, is_visible: nextState } : c));\r\n    } catch (err: any) {\r\n      alert(\"Failed to update visibility: \" + err.message);\r\n    } finally {\r\n      setUpdatingName(null);\r\n    }\r\n  };\r\n\r\n  const filtered = useMemo(() => {\r\n    const q = search.toLowerCase().trim();\r\n    if (!q) return creators;\r\n    return creators.filter(c => c.name.toLowerCase().includes(q) || c.role.toLowerCase().includes(q));\r\n  }, [creators, search]);\r\n\r\n  return (\r\n    <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-lg max-w-4xl animate-fade-in\">\r\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 border-b border-zinc-800 pb-4\">\r\n        <div className=\"flex items-center gap-3\">\r\n          <Users className=\"w-6 h-6 text-[#fe9a00]\" />\r\n          <div>\r\n            <h2 className=\"text-xl font-black uppercase italic tracking-widest text-[#fe9a00]\">Creator Directory</h2>\r\n            <p className=\"text-[10px] text-zinc-400 font-bold uppercase tracking-widest\">Toggle creator visibility across the app & Bingo Book</p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"relative w-full sm:w-64\">\r\n          <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\r\n          <input\r\n            type=\"text\"\r\n            placeholder=\"Search creator...\"\r\n            value={search}\r\n            onChange={(e) => setSearch(e.target.value)}\r\n            className=\"w-full bg-black border border-zinc-700 text-white pl-9 pr-3 py-2 rounded-lg text-xs font-bold focus:outline-none focus:border-[#fe9a00]\"\r\n          />\r\n        </div>\r\n      </div>\r\n\r\n      {loading ? (\r\n        <div className=\"py-12 flex justify-center items-center text-zinc-500 text-xs font-bold uppercase tracking-widest\">\r\n          <Loader2 className=\"w-6 h-6 animate-spin text-[#fe9a00] mr-2\" /> Loading Creators...\r\n        </div>\r\n      ) : filtered.length === 0 ? (\r\n        <p className=\"text-zinc-500 text-sm font-bold italic py-8 text-center\">No creators found.</p>\r\n      ) : (\r\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[550px] overflow-y-auto custom-scrollbar pr-2\">\r\n          {filtered.map((c) => {\r\n            const isUpdating = updatingName === c.name;\r\n\r\n            return (\r\n              <div \r\n                key={c.name}\r\n                className={`p-4 rounded-xl border flex items-center justify-between gap-3 transition-colors ${\r\n                  c.is_visible \r\n                    ? 'bg-black border-zinc-800' \r\n                    : 'bg-red-950/20 border-red-900/40'\r\n                }`}\r\n              >\r\n                <div className=\"flex items-center gap-3 min-w-0\">\r\n                  <div className=\"w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 overflow-hidden shrink-0\">\r\n                    <img \r\n                      src={c.avatar_url || 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/assets/creator-avatar.jpg'} \r\n                      alt={c.name} \r\n                      className=\"w-full h-full object-cover\"\r\n                      onError={(e) => { e.currentTarget.src = 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/assets/creator-avatar.jpg'; }}\r\n                    />\r\n                  </div>\r\n                  <div className=\"min-w-0\">\r\n                    <h4 className=\"font-black text-xs uppercase tracking-wider text-white truncate\">{c.name}</h4>\r\n                    <span className=\"text-[9px] text-[#fe9a00] font-bold uppercase tracking-widest block truncate\">{c.role}</span>\r\n                  </div>\r\n                </div>\r\n\r\n                <button\r\n                  type=\"button\"\r\n                  onClick={() => handleToggle(c)}\r\n                  disabled={isUpdating}\r\n                  className={`px-3 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest flex items-center gap-1.5 transition-all shrink-0 ${\r\n                    c.is_visible\r\n                      ? 'bg-green-950/40 border border-green-800 text-green-400 hover:bg-green-900/60'\r\n                      : 'bg-red-900/30 border border-red-800 text-red-400 hover:bg-red-900/50'\r\n                  }`}\r\n                >\r\n                  {isUpdating ? (\r\n                    <Loader2 className=\"w-3 h-3 animate-spin\" />\r\n                  ) : c.is_visible ? (\r\n                    <><Eye className=\"w-3 h-3\" /> Visible</>\r\n                  ) : (\r\n                    <><EyeOff className=\"w-3 h-3\" /> Hidden</>\r\n                  )}\r\n                </button>\r\n              </div>\r\n            );\r\n          })}\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\n// --- HYPE ECONOMY MANAGER ---\r\nconst HypeManager = ({ setIsDirty }: any) => {\r\n  const [settings, setSettings] = useState({\r\n    free_allowance: 1,\r\n    premium_allowance: 3,\r\n    refill_period: 'weekly',\r\n    shop_multiplier: 10,\r\n  });\r\n  \r\n  const [airdrop, setAirdrop] = useState({ amount: 0, target: 'specific', username: '' });\r\n  const [isSaving, setIsSaving] = useState(false);\r\n  const [isBlasting, setIsBlasting] = useState(false);\r\n\r\n  const [leaderboardResetConfirm, setLeaderboardResetConfirm] = useState('');\r\n  const [isResettingLeaderboards, setIsResettingLeaderboards] = useState(false);\r\n\r\n  useEffect(() => {\r\n    const fetchSettings = async () => {\r\n      const { data } = await supabase.from('app_settings').select('*').eq('id', 1).maybeSingle();\r\n      if (data) {\r\n        setSettings({\r\n          free_allowance: data.free_hype_allowance ?? data.free_tier_hypes ?? 1,\r\n          premium_allowance: data.premium_hype_allowance ?? data.premium_tier_hypes ?? 3,\r\n          refill_period: data.hype_refill_period || 'weekly',\r\n          shop_multiplier: data.shop_hype_multiplier ?? 10,\r\n        });\r\n      }\r\n    };\r\n    fetchSettings();\r\n  }, []);\r\n\r\n  const handleChange = (field: string, value: any) => {\r\n    setSettings(prev => ({ ...prev, [field]: value }));\r\n    setIsDirty(true);\r\n  };\r\n\r\n  const handleSaveSettings = async (forceSyncNow: boolean) => {\r\n    if (forceSyncNow && !window.confirm(`This will instantly overwrite everyone's current hype balance to ${settings.free_allowance} (Standard) and ${settings.premium_allowance} (Pro). Proceed?`)) return;\r\n\r\n    setIsSaving(true);\r\n    \r\n    const { error: settingsError } = await supabase.from('app_settings').upsert({ \r\n      id: 1, \r\n      free_hype_allowance: settings.free_allowance,\r\n      premium_hype_allowance: settings.premium_allowance,\r\n      free_tier_hypes: settings.free_allowance,\r\n      premium_tier_hypes: settings.premium_allowance,\r\n      hype_refill_period: settings.refill_period,\r\n      shop_hype_multiplier: settings.shop_multiplier\r\n    });\r\n    \r\n    if (settingsError) {\r\n      alert(\"Error saving Hype settings: \" + settingsError.message);\r\n      setIsSaving(false);\r\n      return;\r\n    }\r\n\r\n    if (forceSyncNow) {\r\n      try {\r\n        await supabase.from('profiles').update({ hypes_remaining: settings.free_allowance }).eq('is_premium', false);\r\n        await supabase.from('profiles').update({ hypes_remaining: settings.premium_allowance }).eq('is_premium', true);\r\n        alert(`SUCCESS! Rules saved and all user wallets synced to ${settings.free_allowance} (Free) / ${settings.premium_allowance} (Pro).`);\r\n      } catch (err: any) {\r\n        alert(\"Error syncing user balances: \" + err.message);\r\n      }\r\n    } else {\r\n      alert(\"Hype Rules Updated! They will apply automatically on the next scheduled refill.\");\r\n    }\r\n    \r\n    setIsDirty(false);\r\n    setIsSaving(false);\r\n  };\r\n\r\n  const handleAirdrop = async (e: React.FormEvent) => {\r\n    e.preventDefault();\r\n    if (airdrop.amount <= 0) return alert(\"Amount must be greater than zero.\");\r\n    if (!window.confirm(`Are you sure you want to blast ${airdrop.amount} Hypes to ${airdrop.target === 'all' ? 'EVERYONE' : airdrop.username}?`)) return;\r\n    \r\n    setIsBlasting(true);\r\n    try {\r\n      if (airdrop.target === 'all') {\r\n        const { error } = await supabase.rpc('airdrop_hypes_global', { hype_amount: airdrop.amount });\r\n        if (error) throw error;\r\n      } else {\r\n        const { data: user, error: fetchErr } = await supabase.from('profiles').select('id, hypes_remaining').ilike('username', airdrop.username.trim()).maybeSingle();\r\n        if (fetchErr || !user) throw new Error(\"User not found!\");\r\n        \r\n        const { error: updateErr } = await supabase.from('profiles').update({ hypes_remaining: (user.hypes_remaining || 0) + airdrop.amount }).eq('id', user.id);\r\n        if (updateErr) throw updateErr;\r\n      }\r\n      alert(\"Hypes Airdropped Successfully!\");\r\n      setAirdrop({ amount: 0, target: 'specific', username: '' });\r\n    } catch (err: any) {\r\n      alert(\"Error dropping hypes: \" + err.message);\r\n    }\r\n    setIsBlasting(false);\r\n  };\r\n\r\n  const handleLeaderboardReset = async () => {\r\n    if (leaderboardResetConfirm !== 'RESET LEADERBOARDS') return;\r\n    if (!window.confirm(\"WARNING: You are about to wipe all current weekly leaderboard progress. This cannot be undone. Are you absolutely sure?\")) return;\r\n    \r\n    setIsResettingLeaderboards(true);\r\n    try {\r\n      const { error } = await supabase.rpc('reset_leaderboards');\r\n      if (error) throw error;\r\n      alert(\"SUCCESS: All leaderboards have been wiped clean.\");\r\n      setLeaderboardResetConfirm('');\r\n    } catch (err: any) {\r\n      alert(\"Leaderboard Reset Failed: \" + err.message);\r\n    }\r\n    setIsResettingLeaderboards(false);\r\n  };\r\n\r\n  return (\r\n    <div className=\"bg-zinc-900 border border-zinc-800 p-6 rounded-2xl shadow-lg animate-fade-in-up max-w-4xl\">\r\n      <div className=\"flex items-center gap-3 mb-6 border-b border-zinc-800 pb-4\">\r\n        <Flame className=\"w-6 h-6 text-[#fe9a00]\" />\r\n        <h2 className=\"text-xl font-black uppercase italic tracking-widest text-[#fe9a00]\">Hype Economy</h2>\r\n      </div>\r\n\r\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-6\">\r\n        <div className=\"bg-black p-6 rounded-xl border border-zinc-800 space-y-6\">\r\n          <h3 className=\"text-sm font-black text-white uppercase tracking-widest flex items-center gap-2 border-b border-zinc-800 pb-3\">\r\n            <Settings2 className=\"w-4 h-4 text-[#fe9a00]\" /> Allowance Rules\r\n          </h3>\r\n          \r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Standard Refill Amount (Weekly)</label>\r\n            <input \r\n              type=\"number\" min=\"0\" \r\n              value={settings.free_allowance} \r\n              onChange={(e) => handleChange('free_allowance', Number(e.target.value))}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Pro Refill Amount (Weekly)</label>\r\n            <input \r\n              type=\"number\" min=\"0\" \r\n              value={settings.premium_allowance} \r\n              onChange={(e) => handleChange('premium_allowance', Number(e.target.value))}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Refill Schedule</label>\r\n            <select \r\n              value={settings.refill_period} \r\n              onChange={(e) => handleChange('refill_period', e.target.value)}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors cursor-pointer\"\r\n            >\r\n              <option value=\"weekly\">Every Saturday (Weekly)</option>\r\n              <option value=\"monthly\">1st of the Month (Monthly)</option>\r\n              <option value=\"never\">Manual Only (Events)</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"bg-black p-6 rounded-xl border border-zinc-800 space-y-6\">\r\n          <h3 className=\"text-sm font-black text-white uppercase tracking-widest flex items-center gap-2 border-b border-zinc-800 pb-3\">\r\n            <CreditCard className=\"w-4 h-4 text-[#fe9a00]\" /> Commerce Multipliers\r\n          </h3>\r\n          <p className=\"text-[10px] font-bold text-zinc-500 uppercase tracking-widest leading-relaxed\">\r\n            Set the reward ratio for Shopify merch purchases. (Requires active Shopify Webhook).\r\n          </p>\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Bonus Hypes per $1 Spent</label>\r\n            <div className=\"flex items-center gap-3\">\r\n              <input \r\n                type=\"number\" min=\"0\" \r\n                value={settings.shop_multiplier} \r\n                onChange={(e) => handleChange('shop_multiplier', Number(e.target.value))}\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-[#fe9a00] text-xl font-black focus:border-[#fe9a00] outline-none transition-colors\"\r\n              />\r\n              <span className=\"text-zinc-500 font-black uppercase tracking-widest text-xs\">Hypes</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"flex flex-col sm:flex-row gap-4 mb-8\">\r\n        <button onClick={() => handleSaveSettings(false)} disabled={isSaving} className=\"flex-1 bg-zinc-800 text-white hover:text-black border border-zinc-700 font-black uppercase tracking-widest py-4 rounded-xl hover:bg-[#fe9a00] transition-colors shadow-lg\">\r\n          {isSaving ? 'UPDATING...' : 'Save Rules (Future)'}\r\n        </button>\r\n        <button onClick={() => handleSaveSettings(true)} disabled={isSaving} className=\"flex-1 bg-[#fe9a00] text-black border border-[#fe9a00] font-black uppercase tracking-widest py-4 rounded-xl hover:bg-white transition-colors shadow-[0_0_20px_rgba(254,154,0,0.3)]\">\r\n          {isSaving ? 'UPDATING...' : 'Save & Sync All Instantly'}\r\n        </button>\r\n      </div>\r\n\r\n      <form onSubmit={handleAirdrop} className=\"bg-black p-6 rounded-xl border border-[#fe9a00]/30 shadow-[0_0_30px_rgba(254,154,0,0.1)] mb-8\">\r\n        <h3 className=\"text-sm font-black text-[#fe9a00] uppercase tracking-widest flex items-center gap-2 border-b border-zinc-800 pb-3 mb-6\">\r\n          <Gift className=\"w-4 h-4\" /> Live Event & Prize Airdrop\r\n        </h3>\r\n        \r\n        <div className=\"flex flex-col md:flex-row gap-6 mb-6\">\r\n          <div className=\"flex-1\">\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Hype Amount</label>\r\n            <input \r\n              type=\"number\" min=\"1\" required\r\n              value={airdrop.amount} \r\n              onChange={(e) => setAirdrop(prev => ({ ...prev, amount: Number(e.target.value) }))}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-[#fe9a00] text-xl font-black focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n\r\n          <div className=\"flex-1\">\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Target Audience</label>\r\n            <select \r\n              value={airdrop.target} \r\n              onChange={(e) => setAirdrop(prev => ({ ...prev, target: e.target.value }))}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-4 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors cursor-pointer\"\r\n            >\r\n              <option value=\"specific\">Specific User (Prize Winner)</option>\r\n              <option value=\"all\">Global (All Registered Users)</option>\r\n            </select>\r\n          </div>\r\n\r\n          {airdrop.target === 'specific' && (\r\n            <div className=\"flex-1 animate-fade-in\">\r\n              <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Winner Username</label>\r\n              <input \r\n                type=\"text\" required\r\n                value={airdrop.username} \r\n                onChange={(e) => setAirdrop(prev => ({ ...prev, username: e.target.value }))}\r\n                placeholder=\"Enter exact username...\"\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-4 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n              />\r\n            </div>\r\n          )}\r\n        </div>\r\n\r\n        <button type=\"submit\" disabled={isBlasting} className=\"w-full flex items-center justify-center gap-3 bg-gradient-to-r from-[#fe9a00] to-yellow-500 hover:from-white hover:to-white text-black font-black uppercase tracking-widest text-sm py-4 rounded-xl transition-all shadow-[0_0_20px_rgba(254,154,0,0.3)] disabled:opacity-50\">\r\n          <Send className=\"w-5 h-5\" />{isBlasting ? 'Blasting...' : 'Blast Hypes Now'}\r\n        </button>\r\n      </form>\r\n\r\n      {/* Leaderboards Kill Switch */}\r\n      <div className=\"bg-red-950/20 border border-red-900/50 p-6 rounded-xl relative overflow-hidden flex flex-col md:flex-row items-center gap-6\">\r\n        <div className=\"flex-1 relative z-10\">\r\n          <h3 className=\"text-sm font-black text-red-500 uppercase tracking-widest flex items-center gap-2 border-b border-red-900/50 pb-3 mb-3\">\r\n            <XCircle className=\"w-4 h-4\" /> Reset Leaderboards\r\n          </h3>\r\n          <p className=\"text-[10px] font-bold text-red-400/80 uppercase tracking-widest leading-relaxed\">\r\n            This wipes all aggregated hype tracking across Series, Creators, Chapters, and Characters for the current cycle.\r\n          </p>\r\n        </div>\r\n        <div className=\"flex flex-col gap-3 relative z-10 w-full md:w-auto min-w-[250px]\">\r\n          <input \r\n            type=\"text\" \r\n            placeholder=\"Type 'RESET LEADERBOARDS'\"\r\n            value={leaderboardResetConfirm}\r\n            onChange={(e) => setLeaderboardResetConfirm(e.target.value)}\r\n            className=\"w-full bg-black border border-red-900/50 rounded-lg p-4 text-red-500 text-[10px] font-black tracking-widest focus:border-red-500 outline-none text-center transition-colors placeholder:text-red-900/40\"\r\n          />\r\n          <button \r\n            onClick={handleLeaderboardReset}\r\n            disabled={leaderboardResetConfirm !== 'RESET LEADERBOARDS' || isResettingLeaderboards}\r\n            className=\"w-full py-3 bg-red-600 text-white font-black uppercase tracking-widest rounded-lg hover:bg-red-500 transition-colors shadow-[0_0_20px_rgba(220,38,38,0.3)] disabled:opacity-50 flex items-center justify-center text-xs\"\r\n          >\r\n            {isResettingLeaderboards ? 'WIPING...' : 'WIPE LEADERBOARDS'}\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\n// --- THIRD-PARTY INTEGRATIONS EDITOR ---\r\nconst IntegrationsManager = ({ setIsDirty }: any) => {\r\n  const [settings, setSettings] = useState({\r\n    stripe_public_key: '',\r\n    shopify_domain: '',\r\n    admob_id: '',\r\n    applixr_id: '',\r\n    google_analytics_id: '',\r\n    meta_pixel_id: '',\r\n    tiktok_pixel_id: '',\r\n    openai_api_key: '',\r\n    resend_api_key: '',\r\n    moderator_emails: '',\r\n    moderator_email_mode: 'flagged_only'\r\n  });\r\n  const [isSaving, setIsSaving] = useState(false);\r\n\r\n  useEffect(() => {\r\n    const fetchSettings = async () => {\r\n      const { data } = await supabase.from('app_settings').select('*').eq('id', 1).maybeSingle();\r\n      if (data) {\r\n        setSettings({\r\n          stripe_public_key: data.stripe_public_key || '',\r\n          shopify_domain: data.shopify_domain || '',\r\n          admob_id: data.admob_id || '',\r\n          applixr_id: data.applixr_id || '',\r\n          google_analytics_id: data.google_analytics_id || '',\r\n          meta_pixel_id: data.meta_pixel_id || '',\r\n          tiktok_pixel_id: data.tiktok_pixel_id || '',\r\n          openai_api_key: data.openai_api_key || '',\r\n          resend_api_key: data.resend_api_key || '',\r\n          moderator_emails: data.moderator_emails ? data.moderator_emails.join(', ') : '',\r\n          moderator_email_mode: data.moderator_email_mode || 'flagged_only'\r\n        });\r\n      }\r\n    };\r\n    fetchSettings();\r\n  }, []);\r\n\r\n  const handleChange = (field: string, value: string) => {\r\n    setSettings(prev => ({ ...prev, [field]: value }));\r\n    setIsDirty(true);\r\n  };\r\n\r\n  const handleSave = async () => {\r\n    setIsSaving(true);\r\n    \r\n    const emailsArray = settings.moderator_emails\r\n      .split(',')\r\n      .map(e => e.trim())\r\n      .filter(e => e.length > 0);\r\n\r\n    const payloadToSave = { \r\n      id: 1, \r\n      ...settings,\r\n      moderator_emails: emailsArray \r\n    };\r\n\r\n    const { error } = await supabase.from('app_settings').upsert(payloadToSave);\r\n    setIsSaving(false);\r\n    if (error) alert(\"Error saving integrations: \" + error.message);\r\n    else { alert(\"Integrations Updated Successfully!\"); setIsDirty(false); }\r\n  };\r\n\r\n  return (\r\n    <div className=\"bg-zinc-900 border border-zinc-800 p-6 rounded-2xl shadow-lg animate-fade-in-up max-w-4xl\">\r\n      <div className=\"flex items-center gap-3 mb-6 border-b border-zinc-800 pb-4\">\r\n        <LinkIcon className=\"w-6 h-6 text-[#fe9a00]\" />\r\n        <h2 className=\"text-xl font-black uppercase italic tracking-widest text-[#fe9a00]\">Third-Party Integrations</h2>\r\n      </div>\r\n\r\n      <div className=\"bg-[#fe9a00]/10 p-6 rounded-xl border border-[#fe9a00]/30 mb-8 space-y-6\">\r\n        <h3 className=\"text-sm font-black text-[#fe9a00] uppercase tracking-widest flex items-center gap-2 border-b border-[#fe9a00]/30 pb-3\">\r\n          <ShieldAlert className=\"w-4 h-4\" /> AI Moderation & Email Alerts\r\n        </h3>\r\n\r\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Moderator Emails (Comma Separated)</label>\r\n            <input \r\n              type=\"text\" \r\n              placeholder=\"admin@saturdayam.com, mod2@saturdayam.com\" \r\n              value={settings.moderator_emails} \r\n              onChange={(e) => handleChange('moderator_emails', e.target.value)}\r\n              className=\"w-full bg-black border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Email Dispatch Mode</label>\r\n            <select \r\n              value={settings.moderator_email_mode} \r\n              onChange={(e) => handleChange('moderator_email_mode', e.target.value)}\r\n              className=\"w-full bg-black border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors cursor-pointer\"\r\n            >\r\n              <option value=\"flagged_only\">Flagged Comments Only (Recommended)</option>\r\n              <option value=\"all\">All Comments (Flagged & Clean)</option>\r\n              <option value=\"clean_only\">Non-Flagged Comments Only</option>\r\n              <option value=\"off\">Muted (Off)</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">OpenAI API Key (Context Moderation)</label>\r\n            <input \r\n              type=\"password\" \r\n              placeholder=\"sk-...\" \r\n              value={settings.openai_api_key} \r\n              onChange={(e) => handleChange('openai_api_key', e.target.value)}\r\n              className=\"w-full bg-black border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Resend API Key (Email Alerts)</label>\r\n            <input \r\n              type=\"password\" \r\n              placeholder=\"re_...\" \r\n              value={settings.resend_api_key} \r\n              onChange={(e) => handleChange('resend_api_key', e.target.value)}\r\n              className=\"w-full bg-black border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"bg-black p-6 rounded-xl border border-zinc-800 mb-8 space-y-6\">\r\n        <h3 className=\"text-sm font-black text-white uppercase tracking-widest flex items-center gap-2 border-b border-zinc-800 pb-3\">\r\n          <CreditCard className=\"w-4 h-4 text-[#fe9a00]\" /> E-Commerce & Ads\r\n        </h3>\r\n        \r\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Stripe Publishable Key</label>\r\n            <input \r\n              type=\"text\" \r\n              placeholder=\"pk_live_...\" \r\n              value={settings.stripe_public_key} \r\n              onChange={(e) => handleChange('stripe_public_key', e.target.value)}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Shopify Store URL (Live Feed)</label>\r\n            <input \r\n              type=\"text\" \r\n              placeholder=\"shopsaturdayam.com\" \r\n              value={settings.shopify_domain} \r\n              onChange={(e) => handleChange('shopify_domain', e.target.value)}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n\r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">AdMob App ID</label>\r\n            <input \r\n              type=\"text\" \r\n              placeholder=\"ca-app-pub-...\" \r\n              value={settings.admob_id} \r\n              onChange={(e) => handleChange('admob_id', e.target.value)}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n          \r\n          <div>\r\n            <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Applixr Tag ID</label>\r\n            <input \r\n              type=\"text\" \r\n              placeholder=\"Enter Applixr ID...\" \r\n              value={settings.applixr_id} \r\n              onChange={(e) => handleChange('applixr_id', e.target.value)}\r\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"bg-black p-6 rounded-xl border border-zinc-800 mb-8 space-y-6\">\r\n        <h3 className=\"text-sm font-black text-white uppercase tracking-widest flex items-center gap-2 border-b border-zinc-800 pb-3\">\r\n          <LineChart className=\"w-4 h-4 text-[#fe9a00]\" /> Analytics & Pixels\r\n        </h3>\r\n\r\n        <div>\r\n          <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Google Analytics (G-Tag / GAM ID)</label>\r\n          <input \r\n            type=\"text\" \r\n            placeholder=\"G-XXXXXXXXXX\" \r\n            value={settings.google_analytics_id} \r\n            onChange={(e) => handleChange('google_analytics_id', e.target.value)}\r\n            className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n          />\r\n        </div>\r\n\r\n        <div>\r\n          <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">Meta (Facebook) Pixel ID</label>\r\n          <input \r\n            type=\"text\" \r\n            placeholder=\"Enter your Meta Pixel ID...\" \r\n            value={settings.meta_pixel_id} \r\n            onChange={(e) => handleChange('meta_pixel_id', e.target.value)}\r\n            className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n          />\r\n        </div>\r\n\r\n        <div>\r\n          <label className=\"block text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-2\">TikTok Pixel ID</label>\r\n          <input \r\n            type=\"text\" \r\n            placeholder=\"Enter your TikTok Pixel ID...\" \r\n            value={settings.tiktok_pixel_id} \r\n            onChange={(e) => handleChange('tiktok_pixel_id', e.target.value)}\r\n            className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-3 text-white text-sm font-bold focus:border-[#fe9a00] outline-none transition-colors\"\r\n          />\r\n        </div>\r\n      </div>\r\n\r\n      <button onClick={handleSave} disabled={isSaving} className=\"w-full bg-[#fe9a00] text-black font-black uppercase tracking-widest py-4 rounded-xl hover:bg-white transition-colors shadow-[0_0_20px_rgba(254,154,0,0.3)]\">\r\n        {isSaving ? 'UPDATING...' : 'Save Integrations'}\r\n      </button>\r\n    </div>\r\n  );\r\n};\r\n\r\ntype LedgerSortOption =\r\n  | 'date_desc'\r\n  | 'date_asc'\r\n  | 'name_asc'\r\n  | 'name_desc'\r\n  | 'email_asc'\r\n  | 'email_desc'\r\n  | 'code_asc'\r\n  | 'code_desc';\r\n\r\n// --- CONSOLIDATED 1-YEAR ANNUAL PRO CODE MANAGER (BATCH + CUSTOM BRANDED + SHOPIFY) ---\r\nconst PromoCodeManager = () => {\r\n  const [batchCodes, setBatchCodes] = useState<any[]>([]);\r\n  const [brandedCodes, setBrandedCodes] = useState<any[]>([]);\r\n\r\n  // 1. Batch Generator State\r\n  const [batchSize, setBatchSize] = useState<number | ''>('');\r\n  const [batchLoading, setBatchLoading] = useState(false);\r\n  const [batchMessage, setBatchMessage] = useState('');\r\n\r\n  // 2. Custom-Branded Annual Code State\r\n  const [customCode, setCustomCode] = useState('');\r\n  const [maxUses, setMaxUses] = useState(1);\r\n  const [expireDays, setExpireDays] = useState(365);\r\n  const [isCreatingCustom, setIsCreatingCustom] = useState(false);\r\n\r\n  // 3. Unified Ledger Filter, Sort & Distribution State (Default: Newest Purchase First)\r\n  const [ledgerFilter, setLedgerFilter] = useState<'all' | 'batch' | 'branded'>('all');\r\n  const [ledgerSearch, setLedgerSearch] = useState('');\r\n  const [ledgerSort, setLedgerSort] = useState<LedgerSortOption>('date_desc');\r\n  const [pendingSold, setPendingSold] = useState<Record<string, boolean>>({});\r\n  const [isSavingLedger, setIsSavingLedger] = useState(false);\r\n\r\n  const fetchAllAnnualCodes = async () => {\r\n    const { data: pData } = await supabase.rpc('fetch_premium_ledger');\r\n    if (pData) setBatchCodes(pData);\r\n\r\n    const { data: cData } = await supabase\r\n      .from('promo_codes')\r\n      .select('*')\r\n      .order('created_at', { ascending: false });\r\n    if (cData) setBrandedCodes(cData);\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchAllAnnualCodes();\r\n  }, []);\r\n\r\n  // --- BATCH CSV GENERATION ---\r\n  const downloadCSV = (codes: { generated_code: string }[]) => {\r\n    const csvContent = \"data:text/csv;charset=utf-8,\"\r\n      + \"Premium Code\\n\"\r\n      + codes.map(c => c.generated_code).join(\"\\n\");\r\n\r\n    const encodedUri = encodeURI(csvContent);\r\n    const link = document.createElement(\"a\");\r\n    link.setAttribute(\"href\", encodedUri);\r\n    link.setAttribute(\"download\", `Premium_Codes_${new Date().toISOString().split('T')[0]}.csv`);\r\n    document.body.appendChild(link);\r\n    link.click();\r\n    document.body.removeChild(link);\r\n  };\r\n\r\n  const handleBatchGenerate = async () => {\r\n    if (!batchSize || batchSize <= 0) return;\r\n    setBatchLoading(true);\r\n    setBatchMessage('');\r\n\r\n    const { data, error } = await supabase.rpc('generate_premium_codes', {\r\n      batch_size: Number(batchSize)\r\n    });\r\n\r\n    if (error) {\r\n      console.error(error);\r\n      setBatchMessage(`Error: ${error.message}`);\r\n      setBatchLoading(false);\r\n      return;\r\n    }\r\n\r\n    if (data && data.length > 0) {\r\n      downloadCSV(data);\r\n      setBatchMessage(`Successfully generated ${data.length} codes! CSV downloaded.`);\r\n      setBatchSize('');\r\n      fetchAllAnnualCodes();\r\n    }\r\n    setBatchLoading(false);\r\n  };\r\n\r\n  // --- CUSTOM-BRANDED 1-YEAR CODE CREATION ---\r\n  const generateBrandedSuggestion = () => {\r\n    const suffix = Math.random().toString(36).substring(2, 6).toUpperCase();\r\n    setCustomCode(`SATAM-PRO-${suffix}`);\r\n  };\r\n\r\n  const handleCreateCustomAnnual = async (e: React.FormEvent) => {\r\n    e.preventDefault();\r\n    const clean = customCode.trim().toUpperCase().replace(/\\s+/g, '-');\r\n    if (!clean) return alert(\"Please enter a custom-branded code.\");\r\n\r\n    setIsCreatingCustom(true);\r\n\r\n    const expiresAt = new Date();\r\n    expiresAt.setDate(expiresAt.getDate() + Number(expireDays || 365));\r\n\r\n    const { error } = await supabase.from('promo_codes').insert([{\r\n      code: clean,\r\n      tier: 'premium',\r\n      max_uses: Number(maxUses) || 1,\r\n      expires_at: expiresAt.toISOString()\r\n    }]);\r\n\r\n    setIsCreatingCustom(false);\r\n\r\n    if (error) {\r\n      alert(\"Error creating custom annual code: \" + error.message);\r\n    } else {\r\n      alert(`Custom 1-Year Pro Code \"${clean}\" created!`);\r\n      setCustomCode('');\r\n      setMaxUses(1);\r\n      setExpireDays(365);\r\n      fetchAllAnnualCodes();\r\n    }\r\n  };\r\n\r\n  const handleDeleteBranded = async (id: string, codeName: string) => {\r\n    if (!window.confirm(`Permanently delete custom code \"${codeName}\"?`)) return;\r\n    const { error } = await supabase.from('promo_codes').delete().eq('id', id);\r\n    if (!error) fetchAllAnnualCodes();\r\n  };\r\n\r\n  const handleSaveLedger = async () => {\r\n    const changes = Object.entries(pendingSold);\r\n    if (changes.length === 0) return;\r\n\r\n    setIsSavingLedger(true);\r\n    for (const [code, is_sold] of changes) {\r\n      await supabase.rpc('update_premium_code_sold', { p_code: code, p_is_sold: is_sold });\r\n    }\r\n    setPendingSold({});\r\n    await fetchAllAnnualCodes();\r\n    setIsSavingLedger(false);\r\n  };\r\n\r\n  const hasPendingChanges = Object.keys(pendingSold).length > 0;\r\n\r\n  const filteredBatchCodes = useMemo(() => {\r\n    const q = ledgerSearch.trim().toUpperCase();\r\n    const base = !q\r\n      ? batchCodes\r\n      : batchCodes.filter(c => String(c.code || '').toUpperCase().includes(q));\r\n\r\n    return [...base].sort((a, b) => {\r\n      const timeA = a.created_at ? new Date(a.created_at).getTime() : (a.redeemed_at ? new Date(a.redeemed_at).getTime() : 0);\r\n      const timeB = b.created_at ? new Date(b.created_at).getTime() : (b.redeemed_at ? new Date(b.redeemed_at).getTime() : 0);\r\n      switch (ledgerSort) {\r\n        case 'date_asc':\r\n          return timeA - timeB;\r\n        case 'code_asc':\r\n          return String(a.code || '').localeCompare(String(b.code || ''));\r\n        case 'code_desc':\r\n          return String(b.code || '').localeCompare(String(a.code || ''));\r\n        default:\r\n          return timeB - timeA;\r\n      }\r\n    });\r\n  }, [batchCodes, ledgerSearch, ledgerSort]);\r\n\r\n  const filteredBrandedCodes = useMemo(() => {\r\n    const q = ledgerSearch.trim().toUpperCase();\r\n    const base = !q\r\n      ? brandedCodes\r\n      : brandedCodes.filter(c =>\r\n          String(c.code || '').toUpperCase().includes(q) ||\r\n          String(c.buyer_name || '').toUpperCase().includes(q) ||\r\n          String(c.buyer_email || '').toUpperCase().includes(q) ||\r\n          String(c.buyer_phone || '').toUpperCase().includes(q) ||\r\n          String(c.buyer_address || '').toUpperCase().includes(q) ||\r\n          String(c.order_number || '').toUpperCase().includes(q)\r\n        );\r\n\r\n    const getName = (c: any) => String(c.buyer_name || c.code || 'zzzz').trim().toLowerCase();\r\n    const getEmail = (c: any) => String(c.buyer_email || c.code || 'zzzz').trim().toLowerCase();\r\n    const getTime = (c: any) => (c.created_at ? new Date(c.created_at).getTime() : 0);\r\n\r\n    return [...base].sort((a, b) => {\r\n      switch (ledgerSort) {\r\n        case 'date_desc':\r\n          return getTime(b) - getTime(a);\r\n        case 'date_asc':\r\n          return getTime(a) - getTime(b);\r\n        case 'name_asc':\r\n          return getName(a).localeCompare(getName(b));\r\n        case 'name_desc':\r\n          return getName(b).localeCompare(getName(a));\r\n        case 'email_asc':\r\n          return getEmail(a).localeCompare(getEmail(b));\r\n        case 'email_desc':\r\n          return getEmail(b).localeCompare(getEmail(a));\r\n        case 'code_asc':\r\n          return String(a.code || '').localeCompare(String(b.code || ''));\r\n        case 'code_desc':\r\n          return String(b.code || '').localeCompare(String(a.code || ''));\r\n        default:\r\n          return getTime(b) - getTime(a);\r\n      }\r\n    });\r\n  }, [brandedCodes, ledgerSearch, ledgerSort]);\r\n\r\n  return (\r\n    <div className=\"bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-lg max-w-5xl animate-fade-in\">\r\n      <div className=\"flex items-center justify-between gap-3 mb-6 border-b border-zinc-800 pb-4\">\r\n        <div className=\"flex items-center gap-3\">\r\n          <Key className=\"w-6 h-6 text-[#fe9a00]\" />\r\n          <div>\r\n            <h2 className=\"text-xl font-black uppercase italic tracking-widest text-[#fe9a00]\">\r\n              1-Year Annual Pro Codes\r\n            </h2>\r\n            <p className=\"text-[10px] text-zinc-400 font-bold uppercase tracking-widest\">\r\n              Generate store batch codes or custom-branded annual subscription keys\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* TOP GENERATORS GRID: CUSTOM BRANDED + BATCH CSV */}\r\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8\">\r\n        \r\n        {/* 1. CREATE CUSTOM-BRANDED 1-YEAR CODE */}\r\n        <form onSubmit={handleCreateCustomAnnual} className=\"bg-black border border-[#fe9a00]/40 shadow-[0_0_30px_rgba(254,154,0,0.08)] p-6 rounded-xl flex flex-col justify-between\">\r\n          <div>\r\n            <h3 className=\"text-sm font-black text-[#fe9a00] uppercase tracking-widest flex items-center gap-2 border-b border-zinc-800 pb-3 mb-4\">\r\n              <Tag className=\"w-4 h-4\" /> Custom-Branded Annual Code\r\n            </h3>\r\n            <p className=\"text-zinc-400 text-xs font-bold mb-5 leading-relaxed\">\r\n              Create a memorable, custom-branded 1-Year Pro code for partners, conventions, or VIPs (e.g., <span className=\"text-white\">APPLEBLACK-VIP</span> or <span className=\"text-white\">NYCC-2026</span>).\r\n            </p>\r\n\r\n            <div className=\"space-y-4\">\r\n              <div>\r\n                <label className=\"block text-zinc-500 font-bold uppercase tracking-widest text-[10px] mb-1.5\">\r\n                  Branded Code Name\r\n                </label>\r\n                <div className=\"flex gap-2\">\r\n                  <input\r\n                    type=\"text\"\r\n                    value={customCode}\r\n                    onChange={e => setCustomCode(e.target.value.toUpperCase())}\r\n                    required\r\n                    placeholder=\"e.g. SATAM-VIP-2026\"\r\n                    className=\"flex-1 bg-zinc-900 border border-zinc-700 rounded-xl text-[#fe9a00] px-4 py-3 font-black tracking-widest text-sm focus:outline-none focus:border-[#fe9a00]\"\r\n                  />\r\n                  <button\r\n                    type=\"button\"\r\n                    onClick={generateBrandedSuggestion}\r\n                    className=\"bg-zinc-800 text-zinc-300 hover:text-white px-4 rounded-xl font-black text-[10px] uppercase tracking-widest hover:bg-zinc-700 transition-colors cursor-pointer\"\r\n                  >\r\n                    Suggest\r\n                  </button>\r\n                </div>\r\n              </div>\r\n\r\n              <div className=\"grid grid-cols-2 gap-3\">\r\n                <div>\r\n                  <label className=\"block text-zinc-500 font-bold uppercase tracking-widest text-[10px] mb-1.5\">\r\n                    Max Redemptions\r\n                  </label>\r\n                  <input\r\n                    type=\"number\"\r\n                    min=\"1\"\r\n                    max=\"10000\"\r\n                    value={maxUses}\r\n                    onChange={e => setMaxUses(Number(e.target.value))}\r\n                    required\r\n                    className=\"w-full bg-zinc-900 border border-zinc-700 rounded-xl text-white px-4 py-3 font-bold text-sm focus:outline-none focus:border-[#fe9a00]\"\r\n                  />\r\n                </div>\r\n                <div>\r\n                  <label className=\"block text-zinc-500 font-bold uppercase tracking-widest text-[10px] mb-1.5\">\r\n                    Valid For (Days)\r\n                  </label>\r\n                  <input\r\n                    type=\"number\"\r\n                    min=\"1\"\r\n                    max=\"3650\"\r\n                    value={expireDays}\r\n                    onChange={e => setExpireDays(Number(e.target.value))}\r\n                    required\r\n                    className=\"w-full bg-zinc-900 border border-zinc-700 rounded-xl text-white px-4 py-3 font-bold text-sm focus:outline-none focus:border-[#fe9a00]\"\r\n                  />\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <button\r\n            type=\"submit\"\r\n            disabled={isCreatingCustom || !customCode.trim()}\r\n            className=\"mt-6 w-full flex items-center justify-center gap-2 bg-[#fe9a00] hover:bg-white text-black font-black uppercase tracking-widest text-xs py-4 rounded-xl transition-all shadow-[0_0_20px_rgba(254,154,0,0.25)] disabled:opacity-50 cursor-pointer\"\r\n          >\r\n            {isCreatingCustom ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <Key className=\"w-4 h-4\" />}\r\n            {isCreatingCustom ? 'Creating...' : 'Create Branded 1-Year Code'}\r\n          </button>\r\n        </form>\r\n\r\n        {/* 2. BATCH GENERATE RANDOM STORE CODES */}\r\n        <div className=\"bg-black border border-zinc-800 p-6 rounded-xl flex flex-col justify-between\">\r\n          <div>\r\n            <h3 className=\"text-sm font-black text-white uppercase tracking-widest flex items-center gap-2 border-b border-zinc-800 pb-3 mb-4\">\r\n              <Download className=\"w-4 h-4 text-[#fe9a00]\" /> Batch Generate Store Codes (CSV)\r\n            </h3>\r\n            <p className=\"text-zinc-400 text-xs font-bold mb-5 leading-relaxed\">\r\n              Generate single-use 12-character 1-Year Pro codes (<span className=\"text-zinc-300 font-mono\">XXXX-XXXX-XXXX</span>) in bulk for Shopify fulfillment. Downloads a ready-to-import CSV automatically.\r\n            </p>\r\n\r\n            <div>\r\n              <label className=\"block text-zinc-500 font-bold uppercase tracking-widest text-[10px] mb-1.5\">\r\n                Number of Single-Use Codes to Generate\r\n              </label>\r\n              <input\r\n                type=\"number\"\r\n                min=\"1\"\r\n                max=\"1000\"\r\n                placeholder=\"Quantity (e.g. 50)\"\r\n                value={batchSize}\r\n                onChange={(e) => setBatchSize(e.target.value ? Number(e.target.value) : '')}\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 p-3.5 rounded-xl text-white text-sm font-bold focus:outline-none focus:border-[#fe9a00] transition-colors\"\r\n              />\r\n            </div>\r\n\r\n            {batchMessage && (\r\n              <p className={`mt-4 text-xs font-bold ${batchMessage.includes('Error') ? 'text-red-500' : 'text-emerald-400'}`}>\r\n                {batchMessage}\r\n              </p>\r\n            )}\r\n          </div>\r\n\r\n          <button\r\n            type=\"button\"\r\n            onClick={handleBatchGenerate}\r\n            disabled={batchLoading || !batchSize}\r\n            className=\"mt-6 w-full bg-zinc-800 hover:bg-[#fe9a00] text-white hover:text-black py-4 rounded-xl font-black uppercase tracking-widest text-xs transition-all disabled:opacity-50 flex items-center justify-center gap-2 cursor-pointer\"\r\n          >\r\n            {batchLoading ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <Download className=\"w-4 h-4\" />}\r\n            {batchLoading ? 'Generating Batch...' : 'Generate & Export CSV'}\r\n          </button>\r\n        </div>\r\n\r\n      </div>\r\n\r\n      {/* UNIFIED MASTER LEDGER */}\r\n      <div className=\"bg-black p-6 rounded-xl border border-zinc-800\">\r\n        <div className=\"flex flex-col gap-4 border-b border-zinc-800 pb-4 mb-5\">\r\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\r\n            <div>\r\n              <div className=\"flex items-center gap-3\">\r\n                <h3 className=\"text-sm font-black uppercase tracking-widest text-[#fe9a00]\">\r\n                  Master Annual Codes Ledger\r\n                </h3>\r\n                {hasPendingChanges && (\r\n                  <button\r\n                    onClick={handleSaveLedger}\r\n                    disabled={isSavingLedger}\r\n                    className=\"bg-[#fe9a00] text-black text-[9px] font-black uppercase tracking-widest px-3 py-1 rounded flex items-center gap-1 transition-all shadow-[0_0_10px_rgba(254,154,0,0.4)] cursor-pointer\"\r\n                  >\r\n                    {isSavingLedger ? <Loader2 className=\"w-3 h-3 animate-spin\" /> : 'Save Distributed Marks'}\r\n                  </button>\r\n                )}\r\n              </div>\r\n              <div className=\"flex flex-wrap items-center gap-4 mt-2 text-[10px] font-bold text-zinc-500 uppercase tracking-widest\">\r\n                <span>Shopify & Branded: <strong className=\"text-white\">{brandedCodes.length}</strong></span>\r\n                <span>Batch Codes: <strong className=\"text-white\">{batchCodes.length}</strong></span>\r\n                <span>Redeemed Batch: <strong className=\"text-emerald-400\">{batchCodes.filter(c => c.is_used).length}</strong></span>\r\n                <span>Distributed: <strong className=\"text-[#fe9a00]\">{batchCodes.filter(c => c.is_sold).length}</strong></span>\r\n              </div>\r\n            </div>\r\n\r\n            {/* Filter Pills */}\r\n            <div className=\"flex bg-zinc-900 p-1 rounded-lg border border-zinc-800 self-start md:self-auto\">\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => setLedgerFilter('all')}\r\n                className={`px-3 py-1.5 rounded text-[9px] font-black uppercase tracking-widest transition-colors cursor-pointer ${ledgerFilter === 'all' ? 'bg-[#fe9a00] text-black' : 'text-zinc-400 hover:text-white'}`}\r\n              >\r\n                All ({batchCodes.length + brandedCodes.length})\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => setLedgerFilter('branded')}\r\n                className={`px-3 py-1.5 rounded text-[9px] font-black uppercase tracking-widest transition-colors cursor-pointer ${ledgerFilter === 'branded' ? 'bg-[#fe9a00] text-black' : 'text-zinc-400 hover:text-white'}`}\r\n              >\r\n                Shopify & Branded ({brandedCodes.length})\r\n              </button>\r\n              <button\r\n                type=\"button\"\r\n                onClick={() => setLedgerFilter('batch')}\r\n                className={`px-3 py-1.5 rounded text-[9px] font-black uppercase tracking-widest transition-colors cursor-pointer ${ledgerFilter === 'batch' ? 'bg-[#fe9a00] text-black' : 'text-zinc-400 hover:text-white'}`}\r\n              >\r\n                Batch ({batchCodes.length})\r\n              </button>\r\n            </div>\r\n          </div>\r\n\r\n          {/* Search & Sort Controls */}\r\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\">\r\n            <div className=\"relative flex-1\">\r\n              <Search className=\"w-3.5 h-3.5 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\r\n              <input\r\n                type=\"text\"\r\n                placeholder=\"Search code, purchaser name, email, order #, address...\"\r\n                value={ledgerSearch}\r\n                onChange={(e) => setLedgerSearch(e.target.value)}\r\n                className=\"w-full bg-zinc-900 border border-zinc-700 text-white pl-8 pr-3 py-2 rounded-lg text-xs font-bold focus:outline-none focus:border-[#fe9a00]\"\r\n              />\r\n            </div>\r\n\r\n            <div className=\"relative\">\r\n              <ArrowUpDown className=\"w-3.5 h-3.5 text-[#fe9a00] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\r\n              <select\r\n                value={ledgerSort}\r\n                onChange={(e) => setLedgerSort(e.target.value as LedgerSortOption)}\r\n                className=\"w-full sm:w-auto bg-zinc-900 border border-zinc-700 text-white pl-8 pr-4 py-2 rounded-lg text-xs font-bold focus:outline-none focus:border-[#fe9a00] cursor-pointer\"\r\n                title=\"Sort Access Keys & Purchases\"\r\n              >\r\n                <option value=\"date_desc\">Sort: Newest Purchase First (Default)</option>\r\n                <option value=\"date_asc\">Sort: Oldest Purchase First</option>\r\n                <option value=\"name_asc\">Sort: Purchaser Name (A → Z)</option>\r\n                <option value=\"name_desc\">Sort: Purchaser Name (Z → A)</option>\r\n                <option value=\"email_asc\">Sort: Email Address (A → Z)</option>\r\n                <option value=\"email_desc\">Sort: Email Address (Z → A)</option>\r\n                <option value=\"code_asc\">Sort: Code (A → Z)</option>\r\n                <option value=\"code_desc\">Sort: Code (Z → A)</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"space-y-3 max-h-[520px] overflow-y-auto pr-2 custom-scrollbar\">\r\n          {/* SHOPIFY & CUSTOM-BRANDED ANNUAL CODES */}\r\n          {(ledgerFilter === 'all' || ledgerFilter === 'branded') && filteredBrandedCodes.map((c) => {\r\n            const isExpired = c.expires_at && new Date() > new Date(c.expires_at);\r\n            const isDepleted = c.max_uses && c.times_used >= c.max_uses;\r\n            const isInactive = isExpired || isDepleted;\r\n            const isShopifyOrder = Boolean(c.buyer_email || c.buyer_name || c.order_number);\r\n\r\n            return (\r\n              <div\r\n                key={`branded-${c.id}`}\r\n                className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center bg-zinc-950 border border-[#fe9a00]/40 p-4 rounded-xl gap-4\"\r\n              >\r\n                <div className=\"space-y-1.5\">\r\n                  <div className=\"flex items-center gap-2.5 flex-wrap\">\r\n                    <span className=\"bg-[#fe9a00]/20 text-[#fe9a00] border border-[#fe9a00]/40 text-[8px] font-black uppercase tracking-widest px-2 py-0.5 rounded\">\r\n                      {isShopifyOrder ? `Shopify Order ${c.order_number || ''}` : 'Custom Branded • 1-Year Pro'}\r\n                    </span>\r\n                    <h4 className={`font-black tracking-widest text-sm sm:text-base ${isInactive ? 'text-zinc-600 line-through' : 'text-white'}`}>\r\n                      {c.code}\r\n                    </h4>\r\n                    {c.created_at && (\r\n                      <span className=\"text-[10px] font-mono text-zinc-400 flex items-center gap-1\">\r\n                        <Calendar className=\"w-3 h-3 te