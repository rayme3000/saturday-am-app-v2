          <span className=\"text-white font-black\">\r\n                  {globalStats.free_users} Free • {globalStats.premium_users} PLUS ({conversionRate}\r\n                  %)\r\n                </span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* ===================================================================== */}\r\n      {/* TAB 2: FEATURE ENGAGEMENT (WITH BINGO BOOK, LOADOUT & HYPE CARD)      */}\r\n      {/* ===================================================================== */}\r\n      {activeTab === 'engagement' && (\r\n        <div className=\"space-y-6 animate-fade-in\">\r\n          {/* ROW 1: CORE READING & CONTENT INTERACTION PILLARS */}\r\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5\">\r\n            <div className=\"bg-black border border-zinc-800 p-4 rounded-2xl\">\r\n              <div className=\"flex items-center gap-2 text-[#fe9a00] mb-2\">\r\n                <BookOpen className=\"w-4 h-4\" />\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest\">\r\n                  Chapters Opened\r\n                </span>\r\n              </div>\r\n              <p className=\"text-2xl font-black text-white\">\r\n                {engagementBreakdown.chapterReads.toLocaleString()}\r\n              </p>\r\n              <p className=\"text-[9px] text-emerald-400 font-bold mt-1\">\r\n                {engagementBreakdown.completedChapters.toLocaleString()} finished 100%\r\n              </p>\r\n            </div>\r\n\r\n            <div className=\"bg-black border border-[#fe9a00]/40 p-4 rounded-2xl\">\r\n              <div className=\"flex items-center gap-2 text-[#fe9a00] mb-2\">\r\n                <Flame className=\"w-4 h-4\" />\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest\">\r\n                  Total Hypes\r\n                </span>\r\n              </div>\r\n              <p className=\"text-2xl font-black text-white\">\r\n                {engagementBreakdown.totalHypes.toLocaleString()}\r\n              </p>\r\n              <p className=\"text-[9px] text-zinc-400 font-bold mt-1\">\r\n                Ser:{engagementBreakdown.hypesByTarget.series} • Ch:\r\n                {engagementBreakdown.hypesByTarget.chapter} • Chr:\r\n                {engagementBreakdown.hypesByTarget.character} • Cr:\r\n                {engagementBreakdown.hypesByTarget.creator}\r\n              </p>\r\n            </div>\r\n\r\n            <div className=\"bg-black border border-zinc-800 p-4 rounded-2xl\">\r\n              <div className=\"flex items-center gap-2 text-red-400 mb-2\">\r\n                <Heart className=\"w-4 h-4\" />\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest\">Total Likes</span>\r\n              </div>\r\n              <p className=\"text-2xl font-black text-white\">\r\n                {engagementBreakdown.totalLikes.toLocaleString()}\r\n              </p>\r\n              <p className=\"text-[9px] text-zinc-500 font-bold mt-1\">\r\n                Ser:{engagementBreakdown.seriesLikes} • Ch:{engagementBreakdown.chapterLikes} • Chr:\r\n                {engagementBreakdown.characterLikes} • Cr:{engagementBreakdown.creatorLikes}\r\n              </p>\r\n            </div>\r\n\r\n            <div className=\"bg-black border border-zinc-800 p-4 rounded-2xl\">\r\n              <div className=\"flex items-center gap-2 text-cyan-400 mb-2\">\r\n                <Zap className=\"w-4 h-4\" />\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest\">\r\n                  Smart Comments\r\n                </span>\r\n              </div>\r\n              <p className=\"text-2xl font-black text-white\">\r\n                {engagementBreakdown.quickReacts.toLocaleString()}\r\n              </p>\r\n              <p className=\"text-[9px] text-zinc-500 font-bold mt-1\">In-reader page reactions</p>\r\n            </div>\r\n\r\n            <div className=\"bg-black border border-zinc-800 p-4 rounded-2xl\">\r\n              <div className=\"flex items-center gap-2 text-blue-400 mb-2\">\r\n                <MessageSquare className=\"w-4 h-4\" />\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest\">\r\n                  Series Comments\r\n                </span>\r\n              </div>\r\n              <p className=\"text-2xl font-black text-white\">\r\n                {engagementBreakdown.comments.toLocaleString()}\r\n              </p>\r\n              <p className=\"text-[9px] text-zinc-500 font-bold mt-1\">Community discussions</p>\r\n            </div>\r\n\r\n            <div className=\"bg-black border border-emerald-500/30 p-4 rounded-2xl\">\r\n              <div className=\"flex items-center gap-2 text-emerald-400 mb-2\">\r\n                <DollarSign className=\"w-4 h-4\" />\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest\">\r\n                  Creator Tips\r\n                </span>\r\n              </div>\r\n              <p className=\"text-2xl font-black text-emerald-400\">\r\n                ${engagementBreakdown.creatorTipsDollars.toLocaleString()}\r\n              </p>\r\n              <p className=\"text-[9px] text-zinc-500 font-bold mt-1\">\r\n                {engagementBreakdown.creatorTipsCount} direct fan tips\r\n              </p>\r\n            </div>\r\n          </div>\r\n\r\n          {/* ROW 2: VIRTUAL PROFILE LOADOUT, HYPE CARD FLEX & BINGO BOOK ANALYTICS */}\r\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\r\n            <div className=\"bg-gradient-to-br from-black via-zinc-950 to-purple-950/25 border border-purple-500/30 p-4 rounded-2xl flex items-center justify-between\">\r\n              <div>\r\n                <div className=\"flex items-center gap-2 text-purple-400 mb-1\">\r\n                  <Sliders className=\"w-4 h-4\" />\r\n                  <span className=\"text-[9px] font-black uppercase tracking-widest\">\r\n                    Profile Loadout Customizations\r\n                  </span>\r\n                </div>\r\n                <p className=\"text-2xl font-black text-white\">\r\n                  {engagementBreakdown.profileLoadoutCustomizations.toLocaleString()}\r\n                </p>\r\n                <p className=\"text-[9px] text-zinc-400 font-bold mt-1\">\r\n                  Top 5: {engagementBreakdown.profilesWithTopFive} • Avatars:{' '}\r\n                  {engagementBreakdown.profilesWithAvatar} • Frames:{' '}\r\n                  {engagementBreakdown.profilesWithFrame} • Skins:{' '}\r\n                  {engagementBreakdown.profilesWithCardSkin}\r\n                </p>\r\n              </div>\r\n              <span className=\"px-2.5 py-1 rounded-full bg-purple-500/15 border border-purple-500/30 text-purple-300 text-[9px] font-black uppercase tracking-wider shrink-0\">\r\n                {engagementBreakdown.profilesWithAnyLoadout} Fans\r\n              </span>\r\n            </div>\r\n\r\n            <div className=\"bg-gradient-to-br from-black via-zinc-950 to-amber-950/25 border border-[#fe9a00]/30 p-4 rounded-2xl flex items-center justify-between\">\r\n              <div>\r\n                <div className=\"flex items-center gap-2 text-[#fe9a00] mb-1\">\r\n                  <CreditCard className=\"w-4 h-4\" />\r\n                  <span className=\"text-[9px] font-black uppercase tracking-widest\">\r\n                    Hype Card Opens & Equips\r\n                  </span>\r\n                </div>\r\n                <p className=\"text-2xl font-black text-white\">\r\n                  {engagementBreakdown.hypeCardOpens.toLocaleString()}\r\n                </p>\r\n                <p className=\"text-[9px] text-zinc-400 font-bold mt-1\">\r\n                  Custom Card Skins Equipped: {engagementBreakdown.profilesWithCardSkin}\r\n                </p>\r\n              </div>\r\n              <span className=\"px-2.5 py-1 rounded-full bg-[#fe9a00]/15 border border-[#fe9a00]/30 text-[#fe9a00] text-[9px] font-black uppercase tracking-wider shrink-0\">\r\n                Flex Pass\r\n              </span>\r\n            </div>\r\n\r\n            <div className=\"bg-gradient-to-br from-black via-zinc-950 to-emerald-950/25 border border-emerald-500/30 p-4 rounded-2xl flex items-center justify-between\">\r\n              <div>\r\n                <div className=\"flex items-center gap-2 text-emerald-400 mb-1\">\r\n                  <Stamp className=\"w-4 h-4\" />\r\n                  <span className=\"text-[9px] font-black uppercase tracking-widest\">\r\n                    Bingo Book Hunts & Opens\r\n                  </span>\r\n                </div>\r\n                <p className=\"text-2xl font-black text-white\">\r\n                  {engagementBreakdown.bingoBookInteractions.toLocaleString()}\r\n                </p>\r\n                <p className=\"text-[9px] text-zinc-400 font-bold mt-1\">\r\n                  Active Event PINs in Vault: {engagementBreakdown.activeBingoCodesCount}\r\n                </p>\r\n              </div>\r\n              <span className=\"px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-[9px] font-black uppercase tracking-wider shrink-0\">\r\n                Autographs\r\n              </span>\r\n            </div>\r\n          </div>\r\n\r\n          {/* INTERACTION DISTRIBUTION + LIVE COMMUNITY ACTIVITY FEED */}\r\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\r\n            {/* Left: Visual Feature Share */}\r\n            <div className=\"lg:col-span-6 bg-black/80 border border-zinc-800 rounded-2xl p-6 space-y-4\">\r\n              <div>\r\n                <h3 className=\"text-xs font-black uppercase tracking-widest text-[#fe9a00]\">\r\n                  How Fans Interact With Content & Features\r\n                </h3>\r\n                <p className=\"text-[11px] text-zinc-400 font-medium mt-0.5\">\r\n                  De-duplicated breakdown of community actions across reading, profile loadouts,\r\n                  Hype Cards, and Bingo Book.\r\n                </p>\r\n              </div>\r\n\r\n              {(() => {\r\n                const items = [\r\n                  {\r\n                    label: 'Total Heart Likes (Series, Chapters, Characters, Creators)',\r\n                    count: engagementBreakdown.totalLikes,\r\n                    color: 'bg-red-500'\r\n                  },\r\n                  {\r\n                    label: 'Total Hypes (Series, Chapters, Characters, Creators)',\r\n                    count: engagementBreakdown.totalHypes,\r\n                    color: 'bg-[#fe9a00]'\r\n                  },\r\n                  {\r\n                    label: 'Profile Loadout Customizations (Top 5, Avatars, Frames, Skins)',\r\n                    count: engagementBreakdown.profileLoadoutCustomizations,\r\n                    color: 'bg-purple-500'\r\n                  },\r\n                  {\r\n                    label: 'Hype Card Opens & Custom Pass Equips',\r\n                    count: engagementBreakdown.hypeCardOpens,\r\n                    color: 'bg-amber-400'\r\n                  },\r\n                  {\r\n                    label: 'Bingo Book Opens & Autograph Hunts',\r\n                    count: engagementBreakdown.bingoBookInteractions,\r\n                    color: 'bg-emerald-400'\r\n                  },\r\n                  {\r\n                    label: 'In-Reader Smart Comments (Page Quick Reacts)',\r\n                    count: engagementBreakdown.quickReacts,\r\n                    color: 'bg-cyan-400'\r\n                  },\r\n                  {\r\n                    label: 'Series Discussion Comments',\r\n                    count: engagementBreakdown.comments,\r\n                    color: 'bg-blue-400'\r\n                  },\r\n                  {\r\n                    label: 'Direct Creator Tips & Fanmail',\r\n                    count: engagementBreakdown.creatorTipsCount,\r\n                    color: 'bg-teal-400'\r\n                  }\r\n                ];\r\n                const totalActions = Math.max(\r\n                  1,\r\n                  items.reduce((acc, i) => acc + i.count, 0)\r\n                );\r\n\r\n                return (\r\n                  <div className=\"space-y-3 pt-1\">\r\n                    {items.map(item => {\r\n                      const pct = Math.round((item.count / totalActions) * 100);\r\n                      return (\r\n                        <div key={item.label} className=\"space-y-1\">\r\n                          <div className=\"flex justify-between text-xs font-bold\">\r\n                            <span className=\"text-zinc-300\">{item.label}</span>\r\n                            <span className=\"text-white font-black\">\r\n                              {item.count.toLocaleString()}{' '}\r\n                              <span className=\"text-zinc-500 text-[10px]\">({pct}%)</span>\r\n                            </span>\r\n                          </div>\r\n                          <div className=\"w-full h-2 bg-zinc-900 rounded-full overflow-hidden\">\r\n                            <div\r\n                              className={`h-full ${item.color} rounded-full transition-all duration-500`}\r\n                              style={{ width: `${Math.max(item.count > 0 ? 4 : 0, pct)}%` }}\r\n                            />\r\n                          </div>\r\n                        </div>\r\n                      );\r\n                    })}\r\n                  </div>\r\n                );\r\n              })()}\r\n            </div>\r\n\r\n            {/* Right: Live Community Pulse */}\r\n            <div className=\"lg:col-span-6 bg-black/80 border border-zinc-800 rounded-2xl p-6 flex flex-col\">\r\n              <div className=\"flex items-center justify-between border-b border-zinc-800 pb-3 mb-4\">\r\n                <div className=\"flex items-center gap-2\">\r\n                  <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\r\n                  <h3 className=\"text-xs font-black uppercase tracking-widest text-white\">\r\n                    Recent Community Activity Pulse\r\n                  </h3>\r\n                </div>\r\n                <span className=\"text-[9px] text-zinc-500 font-black uppercase tracking-widest\">\r\n                  {audienceMode === 'fans_only' ? 'Pure Fans Stream' : 'Live Stream'}\r\n                </span>\r\n              </div>\r\n\r\n              <div className=\"space-y-2.5 max-h-[380px] overflow-y-auto pr-1 custom-scrollbar\">\r\n                {recentActivityFeed.length === 0 ? (\r\n                  <p className=\"text-xs text-zinc-500 font-bold py-8 text-center\">\r\n                    No recent activity events recorded for this filter.\r\n                  </p>\r\n                ) : (\r\n                  recentActivityFeed.map((ev: any, i: number) => (\r\n                    <div\r\n                      key={i}\r\n                      className=\"bg-zinc-950 border border-zinc-800/80 rounded-xl p-3 flex items-start justify-between gap-3\"\r\n                    >\r\n                      <div className=\"flex items-start gap-2.5 min-w-0\">\r\n                        <div\r\n                          className={`p-1.5 rounded-lg shrink-0 mt-0.5 ${\r\n                            ev.type === 'tip'\r\n                              ? 'bg-emerald-500/20 text-emerald-400'\r\n                              : ev.type === 'hype'\r\n                              ? 'bg-[#fe9a00]/20 text-[#fe9a00]'\r\n                              : ev.type === 'feature'\r\n                              ? 'bg-purple-500/20 text-purple-400'\r\n                              : ev.type === 'comment'\r\n                              ? 'bg-blue-500/20 text-blue-400'\r\n                              : 'bg-zinc-800 text-zinc-300'\r\n                          }`}\r\n                        >\r\n                          {ev.type === 'tip' ? (\r\n                            <DollarSign className=\"w-3.5 h-3.5\" />\r\n                          ) : ev.type === 'hype' ? (\r\n                            <Flame className=\"w-3.5 h-3.5\" />\r\n                          ) : ev.type === 'feature' ? (\r\n                            <Sparkles className=\"w-3.5 h-3.5\" />\r\n                          ) : ev.type === 'comment' ? (\r\n                            <MessageSquare className=\"w-3.5 h-3.5\" />\r\n                          ) : (\r\n                            <BookOpen className=\"w-3.5 h-3.5\" />\r\n                          )}\r\n                        </div>\r\n                        <div className=\"min-w-0\">\r\n                          <p className=\"text-xs font-bold text-white leading-snug\">{ev.label}</p>\r\n                          {ev.sub && (\r\n                            <p className=\"text-[10px] text-zinc-400 italic truncate mt-0.5\">\r\n                              {ev.sub}\r\n                            </p>\r\n                          )}\r\n                        </div>\r\n                      </div>\r\n                      <span className=\"text-[9px] text-zinc-500 font-bold whitespace-nowrap shrink-0\">\r\n                        {new Date(ev.timestamp).toLocaleDateString('en-US', {\r\n                          month: 'short',\r\n                          day: 'numeric'\r\n                        })}\r\n                      </span>\r\n                    </div>\r\n                  ))\r\n                )}\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* ===================================================================== */}\r\n      {/* TAB 3: SERIES PERFORMANCE & ENGAGEMENT RANKINGS                       */}\r\n      {/* ===================================================================== */}\r\n      {activeTab === 'series' && (\r\n        <div className=\"space-y-6 animate-fade-in\">\r\n          {/* TOP 3 ENGAGED SERIES PODIUM */}\r\n          {sortedAndFilteredSeries.length >= 3 && (\r\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\r\n              {sortedAndFilteredSeries.slice(0, 3).map((topSeries: any, idx: number) => (\r\n                <div\r\n                  key={topSeries.series_slug}\r\n                  className={`p-4 rounded-2xl border flex items-center gap-4 relative overflow-hidden ${\r\n                    idx === 0\r\n                      ? 'bg-gradient-to-br from-amber-950/40 via-black to-zinc-950 border-[#fe9a00]'\r\n                      : 'bg-black/80 border-zinc-800'\r\n                  }`}\r\n                >\r\n                  <img\r\n                    src={\r\n                      topSeries.cover_url || `${CLOUDFLARE_BASE_URL}/assets/placeholder-thumb.jpg`\r\n                    }\r\n                    alt={topSeries.title}\r\n                    className=\"w-14 h-20 rounded-xl object-cover border border-zinc-700 shrink-0\"\r\n                  />\r\n                  <div className=\"min-w-0 flex-1\">\r\n                    <span\r\n                      className={`inline-block px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-widest mb-1 ${\r\n                        idx === 0\r\n                          ? 'bg-[#fe9a00] text-black'\r\n                          : idx === 1\r\n                          ? 'bg-zinc-300 text-black'\r\n                          : 'bg-amber-700 text-white'\r\n                      }`}\r\n                    >\r\n                      #{idx + 1} Most Engaged\r\n                    </span>\r\n                    <h4 className=\"text-sm font-black uppercase italic text-white truncate\">\r\n                      {topSeries.title}\r\n                    </h4>\r\n                    <div className=\"flex flex-wrap items-center gap-2 mt-1.5 text-[10px] font-bold text-zinc-400\">\r\n                      <span className=\"text-[#fe9a00]\">\r\n                        {topSeries.total_reads.toLocaleString()} Reads\r\n                      </span>\r\n                      <span>•</span>\r\n                      <span>{topSeries.total_hypes.toLocaleString()} Hypes</span>\r\n                      <span>•</span>\r\n                      <span className=\"text-red-400\">\r\n                        {topSeries.total_likes.toLocaleString()} Likes\r\n                      </span>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          )}\r\n\r\n          {/* SEARCH & SORT CONTROLS */}\r\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-black/80 border border-zinc-800 p-4 rounded-2xl\">\r\n            <div className=\"relative flex-1 max-w-sm\">\r\n              <Search className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\r\n              <input\r\n                type=\"text\"\r\n                placeholder=\"Search series title or creator...\"\r\n                value={seriesSearch}\r\n                onChange={e => setSeriesSearch(e.target.value)}\r\n                className=\"w-full bg-zinc-950 border border-zinc-800 rounded-xl pl-9 pr-3 py-2 text-xs text-white font-bold focus:outline-none focus:border-[#fe9a00]\"\r\n              />\r\n            </div>\r\n\r\n            <div className=\"flex flex-wrap items-center gap-1.5\">\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-500 mr-1\">\r\n                Sort By:\r\n              </span>\r\n              {[\r\n                { key: 'score', label: 'Overall Score' },\r\n                { key: 'reads', label: 'Opened Reads' },\r\n                { key: 'completed', label: '100% Finished' },\r\n                { key: 'hypes', label: 'Hypes' },\r\n                { key: 'likes', label: 'Likes' },\r\n                { key: 'ctr', label: 'CTR %' },\r\n                { key: 'comments', label: 'Comments' },\r\n                { key: 'trend', label: 'MoM Trend' }\r\n              ].map(opt => (\r\n                <button\r\n                  key={opt.key}\r\n                  type=\"button\"\r\n                  onClick={() => setSeriesSortKey(opt.key as any)}\r\n                  className={`px-2.5 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest cursor-pointer transition-colors border ${\r\n                    seriesSortKey === opt.key\r\n                      ? 'bg-[#fe9a00] text-black border-[#fe9a00]'\r\n                      : 'bg-zinc-950 text-zinc-400 border-zinc-800 hover:text-white'\r\n                  }`}\r\n                >\r\n                  {opt.label}\r\n                </button>\r\n              ))}\r\n            </div>\r\n          </div>\r\n\r\n          {/* SERIES PERFORMANCE TABLE */}\r\n          <div className=\"bg-black border border-zinc-800 rounded-2xl overflow-hidden shadow-xl\">\r\n            <div className=\"overflow-x-auto\">\r\n              <table className=\"w-full text-left border-collapse min-w-[1050px]\">\r\n                <thead>\r\n                  <tr className=\"bg-zinc-950 border-b border-zinc-800\">\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-zinc-500 w-12 text-center\">\r\n                      #\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-zinc-500\">\r\n                      Series & Engagement Share\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-zinc-500 text-center\">\r\n                      Trend <span className=\"lowercase font-bold\">(MoM)</span>\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-zinc-500 text-right\">\r\n                      <Eye className=\"w-3 h-3 inline mb-0.5\" /> Visits\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-[#fe9a00] text-right\">\r\n                      Opened Reads\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-emerald-400 text-right\">\r\n                      100% Finished\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-blue-400 text-right\">\r\n                      <Filter className=\"w-3 h-3 inline mb-0.5\" /> Reader CTR\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-zinc-500 text-right\">\r\n                      <Flame className=\"w-3 h-3 inline mb-0.5 text-[#fe9a00]\" /> Total Hypes\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-red-400 text-right\">\r\n                      <Heart className=\"w-3 h-3 inline mb-0.5\" /> Likes\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-zinc-500 text-right\">\r\n                      Smart Reacts\r\n                    </th>\r\n                    <th className=\"p-4 text-[9px] font-black uppercase tracking-widest text-zinc-500 text-right\">\r\n                      <MessageSquare className=\"w-3 h-3 inline mb-0.5\" /> Comments\r\n                    </th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody className=\"divide-y divide-zinc-800/70\">\r\n                  {sortedAndFilteredSeries.map((series: any, index: number) => {\r\n                    const barPct = Math.max(\r\n                      4,\r\n                      Math.round(((series.engagement_score || 0) / maxEngagementScore) * 100)\r\n                    );\r\n                    return (\r\n                      <tr\r\n                        key={series.series_slug || index}\r\n                        className=\"hover:bg-zinc-900/60 transition-colors group\"\r\n                      >\r\n                        <td className=\"p-4 text-center font-black italic text-zinc-500 group-hover:text-white\">\r\n                          {index + 1}\r\n                        </td>\r\n                        <td className=\"p-4 min-w-[230px]\">\r\n                          <div className=\"flex items-center gap-3\">\r\n                            <img\r\n                              src={\r\n                                series.cover_url ||\r\n                                `${CLOUDFLARE_BASE_URL}/assets/placeholder-thumb.jpg`\r\n                              }\r\n                              className=\"w-9 h-12 rounded-lg object-cover border border-zinc-700 shrink-0\"\r\n                              alt=\"Cover\"\r\n                            />\r\n                            <div className=\"flex-1 min-w-0\">\r\n                              <span className=\"font-black text-sm text-white block truncate\">\r\n                                {series.title || 'Unknown Series'}\r\n                              </span>\r\n                              <div className=\"w-full max-w-[170px] h-1.5 bg-zinc-900 rounded-full overflow-hidden mt-1.5\">\r\n                                <div\r\n                                  className=\"h-full bg-gradient-to-r from-[#fe9a00] to-amber-400 rounded-full\"\r\n                                  style={{ width: `${barPct}%` }}\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </td>\r\n                        <td className=\"p-4 text-center\">\r\n                          <SqlTrendBadge pct={series.trend_percentage || 0} />\r\n                        </td>\r\n                        <td className=\"p-4 text-right font-bold text-zinc-300\">\r\n                          {(Number(series.page_visits) || 0).toLocaleString()}\r\n                        </td>\r\n                        <td className=\"p-4 text-right font-black tracking-wider text-[#fe9a00] text-sm\">\r\n                          {(Number(series.total_reads) || 0).toLocaleString()}\r\n                        </td>\r\n                        <td className=\"p-4 text-right font-bold text-emerald-400\">\r\n                          {(Number(series.completed_reads) || 0).toLocaleString()}\r\n                        </td>\r\n                        <td className=\"p-4 text-right font-bold text-blue-400 bg-blue-950/15\">\r\n                          {(Number(series.ctr_percentage) || 0).toFixed(1)}%\r\n                        </td>\r\n                        <td className=\"p-4 text-right font-bold text-zinc-200\">\r\n                          {(Number(series.total_hypes) || 0).toLocaleString()}\r\n                        </td>\r\n                        <td className=\"p-4 text-right font-bold text-red-400\">\r\n                          {(Number(series.total_likes) || 0).toLocaleString()}\r\n                        </td>\r\n                        <td className=\"p-4 text-right font-bold text-zinc-400\">\r\n                          {(Number(series.total_reacts) || 0).toLocaleString()}\r\n                        </td>\r\n                        <td className=\"p-4 text-right font-bold text-zinc-400\">\r\n                          {(Number(series.total_comments) || 0).toLocaleString()}\r\n                        </td>\r\n                      </tr>\r\n                    );\r\n                  })}\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n            {sortedAndFilteredSeries.length === 0 && !dbError && (\r\n              <div className=\"p-10 text-center text-zinc-500 font-bold text-xs tracking-widest uppercase\">\r\n                No matching series found.\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* ===================================================================== */}\r\n      {/* TAB 4: LEADERBOARD ARCHIVE                                            */}\r\n      {/* ===================================================================== */}\r\n      {activeTab === 'leaderboards' && <AdminLeaderboardHistory />}\r\n    </div>\r\n  );\r\n};",
    "src/MainViews/CreatorsPage.tsx": "import { useState, useEffect, useMemo } from 'react';\r\nimport { supabase } from '../supabase';\r\nimport { HypeButton } from '../Components/HypeButton';\r\nimport { Search, Heart, PenTool, X, CheckCircle2, ArrowUpDown } from 'lucide-react';\r\nimport { HypeLoader } from '../Components/HypeLoader';\r\n\r\nconst CLOUDFLARE_BASE_URL = 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev';\r\n\r\n// Built-in Stripe Connect account map + fallback resolver\r\nexport const CREATOR_STRIPE_CONNECT_MAP: Record<string, string> = {\r\n  'raymond brown': 'acct_1US3pv2d62PnIfST',\r\n  'rayme3000': 'acct_1US3pv2d62PnIfST',\r\n  'rayme3000@gmail.com': 'acct_1US3pv2d62PnIfST',\r\n  'oscar fong': 'acct_1USWwtGzA2Qad5v8',\r\n  'odunze oguguo': 'acct_1USiRECvtW3bYdhU',\r\n  'whyt manga': 'acct_1USiRECvtW3bYdhU',\r\n  'odunze oguguo (whyt manga)': 'acct_1USiRECvtW3bYdhU',\r\n  'erick pedrucci': 'acct_1USUE8GnNL3tCg0x',\r\n  'eric pedrucci': 'acct_1USUE8GnNL3tCg0x',\r\n  'erick perducci': 'acct_1USUE8GnNL3tCg0x',\r\n  'eric perducci': 'acct_1USUE8GnNL3tCg0x',\r\n  'stefano romano': 'acct_1USU8mKGryTzf1Ck',\r\n  'dropkickanimation': 'acct_1USU8mKGryTzf1Ck',\r\n  'dropkickanimation@gmail.com': 'acct_1USU8mKGryTzf1Ck',\r\n  'jeyodin': 'acct_1USMJFGv39K92CFY',\r\n  'frank simmonds': 'acct_1USDbD1EcQ1S1MjY',\r\n  'effessart': 'acct_1USDbD1EcQ1S1MjY',\r\n  'fsimmonds4@gmail.com': 'acct_1USDbD1EcQ1S1MjY',\r\n  'austin harvey-younis': 'acct_1UT6TNK9op8GbFK7',\r\n  'austin harvey younis': 'acct_1UT6TNK9op8GbFK7',\r\n  'saturday.editorial@gmail.com': 'acct_1UT6TNK9op8GbFK7',\r\n  'frederick l. jones': '',\r\n  'vee': ''\r\n};\r\n\r\nexport const normalizeCreatorKey = (rawName?: string): string => {\r\n  const clean = String(rawName || '').trim().replace(/\\s+/g, ' ').toLowerCase();\r\n  if (\r\n    clean === 'eric pedrucci' ||\r\n    clean === 'erick perducci' ||\r\n    clean === 'eric perducci' ||\r\n    clean === 'erick pedrucci'\r\n  ) {\r\n    return 'erick pedrucci';\r\n  }\r\n  return clean;\r\n};\r\n\r\nexport const resolveCreatorStripeAccountId = (creatorName?: string, dbStripeId?: string): string => {\r\n  const lower = normalizeCreatorKey(creatorName);\r\n\r\n  if (lower && lower in CREATOR_STRIPE_CONNECT_MAP && CREATOR_STRIPE_CONNECT_MAP[lower] === '') {\r\n    return '';\r\n  }\r\n\r\n  const cleanDb = String(dbStripeId || '').trim();\r\n  if (cleanDb.startsWith('acct_')) return cleanDb;\r\n\r\n  if (!lower) return '';\r\n\r\n  if (lower in CREATOR_STRIPE_CONNECT_MAP) {\r\n    return CREATOR_STRIPE_CONNECT_MAP[lower];\r\n  }\r\n\r\n  for (const [key, acctId] of Object.entries(CREATOR_STRIPE_CONNECT_MAP)) {\r\n    if (acctId && key.length > 4 && (lower.includes(key) || key.includes(lower))) {\r\n      return acctId;\r\n    }\r\n  }\r\n\r\n  return '';\r\n};\r\n\r\ninterface CreatorProfile {\r\n  name: string;\r\n  role: string;\r\n  bio: string;\r\n  avatar_url: string;\r\n  flag_codes: string[];\r\n  twitter_url?: string;\r\n  instagram_url?: string;\r\n  support_url?: string;\r\n  stripe_account_id?: string;\r\n  works: any[];\r\n}\r\n\r\nexport const CreatorsPage = ({ currentUser, onNavigate, onLoginClick }: any) => {\r\n  const [creators, setCreators] = useState<CreatorProfile[]>([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [searchQuery, setSearchQuery] = useState('');\r\n  const [sortBy, setSortBy] = useState<'name-asc' | 'name-desc' | 'works-desc' | 'role-asc'>('name-asc');\r\n\r\n  // Deep-link highlight state when arriving from a \"Meet the Creator\" notification\r\n  const [highlightedCreator, setHighlightedCreator] = useState<string | null>(null);\r\n\r\n  // Donation State\r\n  const [donationCreator, setDonationCreator] = useState<CreatorProfile | null>(null);\r\n  const [donationAmount, setDonationAmount] = useState<number>(5);\r\n  const [fanmailText, setFanmailText] = useState('');\r\n  const [donationStep, setDonationStep] = useState<'input' | 'processing' | 'success'>('input');\r\n  const [expandedBios, setExpandedBios] = useState<Record<string, boolean>>({});\r\n\r\n  // Check if returning from a successful Stripe Donation Checkout\r\n  useEffect(() => {\r\n    const params = new URLSearchParams(window.location.search);\r\n    if (params.get('donation_status') === 'success') {\r\n      const returnedCreator = params.get('creator') || 'the Creator';\r\n      const returnedAmount = Number(params.get('amount') || 5);\r\n      setDonationCreator({\r\n        name: returnedCreator,\r\n        role: 'Creator',\r\n        bio: '',\r\n        avatar_url: '',\r\n        flag_codes: [],\r\n        works: []\r\n      });\r\n      setDonationAmount(returnedAmount);\r\n      setDonationStep('success');\r\n      window.dispatchEvent(new Event('profileUpdated'));\r\n      window.history.replaceState({}, '', window.location.pathname);\r\n    } else if (params.get('donation_status') === 'cancelled') {\r\n      window.history.replaceState({}, '', window.location.pathname);\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    const fetchCatalog = async () => {\r\n      setLoading(true);\r\n      try {\r\n        const [{ data: seriesData }, { data: creatorRows }] = await Promise.all([\r\n          supabase.from('series').select('*').eq('is_hidden', false),\r\n          supabase.from('series_creators').select('*').order('id', { ascending: true })\r\n        ]);\r\n\r\n        const seriesMap = new Map<string, any>();\r\n        (seriesData || []).forEach(s => seriesMap.set(s.slug, s));\r\n\r\n        const visibilityMap = new Map<string, boolean>();\r\n        (creatorRows || []).forEach((row: any) => {\r\n          if (!row.name) return;\r\n          const key = normalizeCreatorKey(row.name);\r\n          const rowVisible = row.is_visible !== false;\r\n          if (!visibilityMap.has(key)) {\r\n            visibilityMap.set(key, rowVisible);\r\n          } else if (rowVisible) {\r\n            visibilityMap.set(key, true);\r\n          }\r\n        });\r\n\r\n        const creatorMap = new Map<string, CreatorProfile>();\r\n\r\n        (creatorRows || []).forEach((row: any) => {\r\n          if (!row.name) return;\r\n          const key = normalizeCreatorKey(row.name);\r\n          if (visibilityMap.get(key) === false) return;\r\n\r\n          const displayName = key === 'erick pedrucci' ? 'Erick Pedrucci' : row.name.trim().replace(/\\s+/g, ' ');\r\n          const matchedSeries = seriesMap.get(row.series_slug);\r\n          const resolvedStripeId = resolveCreatorStripeAccountId(\r\n            displayName,\r\n            row.stripe_account_id || matchedSeries?.creator_stripe_account_id\r\n          );\r\n\r\n          if (!creatorMap.has(key)) {\r\n            const rawFlags = (row.flag_code || matchedSeries?.flag_code || '')\r\n              .split(',')\r\n              .map((f: string) => f.trim())\r\n              .filter(Boolean);\r\n\r\n            creatorMap.set(key, {\r\n              name: displayName,\r\n              role: row.role || 'Creator',\r\n              bio: row.bio || matchedSeries?.creator_bio || '',\r\n              avatar_url: row.avatar_url || matchedSeries?.creator_avatar || '',\r\n              flag_codes: Array.from(new Set(rawFlags)),\r\n              twitter_url: row.twitter_url || matchedSeries?.creator_twitter || '',\r\n              instagram_url: row.instagram_url || matchedSeries?.creator_instagram || '',\r\n              support_url: row.support_url || matchedSeries?.creator_support_link || '',\r\n              stripe_account_id: resolvedStripeId,\r\n              works: matchedSeries ? [matchedSeries] : []\r\n            });\r\n          } else {\r\n            const existing = creatorMap.get(key)!;\r\n            if (matchedSeries && !existing.works.some(w => w.slug === matchedSeries.slug)) {\r\n              existing.works.push(matchedSeries);\r\n            }\r\n            if (!existing.bio && row.bio) existing.bio = row.bio;\r\n            if (!existing.avatar_url && row.avatar_url) existing.avatar_url = row.avatar_url;\r\n            if (!existing.twitter_url && row.twitter_url) existing.twitter_url = row.twitter_url;\r\n            if (!existing.instagram_url && row.instagram_url) existing.instagram_url = row.instagram_url;\r\n            if (!existing.stripe_account_id && resolvedStripeId) existing.stripe_account_id = resolvedStripeId;\r\n          }\r\n        });\r\n\r\n        (seriesData || []).forEach((s: any) => {\r\n          if (!s.creator_name) return;\r\n          const key = normalizeCreatorKey(s.creator_name);\r\n          if (visibilityMap.get(key) === false || creatorMap.has(key)) return;\r\n\r\n          const displayName = key === 'erick pedrucci' ? 'Erick Pedrucci' : s.creator_name.trim().replace(/\\s+/g, ' ');\r\n          const rawFlags = (s.flag_code || '').split(',').map((f: string) => f.trim()).filter(Boolean);\r\n          creatorMap.set(key, {\r\n            name: displayName,\r\n            role: 'Creator',\r\n            bio: s.creator_bio || '',\r\n            avatar_url: s.creator_avatar || '',\r\n            flag_codes: rawFlags,\r\n            twitter_url: s.creator_twitter || '',\r\n            instagram_url: s.creator_instagram || '',\r\n            support_url: s.creator_support_link || '',\r\n            stripe_account_id: resolveCreatorStripeAccountId(displayName, s.creator_stripe_account_id),\r\n            works: [s]\r\n          });\r\n        });\r\n\r\n        setCreators(Array.from(creatorMap.values()));\r\n      } catch (err) {\r\n        console.error(\"Failed to load creators:\", err);\r\n      } finally {\r\n        setLoading(false);\r\n      }\r\n    };\r\n\r\n    fetchCatalog();\r\n  }, []);\r\n\r\n  // Auto-jump to creator when arriving from a \"Meet the Creator\" notification\r\n  useEffect(() => {\r\n    if (loading || creators.length === 0) return;\r\n    const targetName = sessionStorage.getItem('am_target_creator');\r\n    if (!targetName) return;\r\n\r\n    sessionStorage.removeItem('am_target_creator');\r\n    const cleanTarget = normalizeCreatorKey(targetName);\r\n    const matched = creators.find(\r\n      c =>\r\n        normalizeCreatorKey(c.name) === cleanTarget ||\r\n        normalizeCreatorKey(c.name).includes(cleanTarget) ||\r\n        cleanTarget.includes(normalizeCreatorKey(c.name))\r\n    );\r\n\r\n    if (matched) {\r\n      setExpandedBios(prev => ({ ...prev, [matched.name]: true }));\r\n      setHighlightedCreator(matched.name);\r\n      setTimeout(() => {\r\n        const el = document.getElementById(`creator-card-${normalizeCreatorKey(matched.name)}`);\r\n        if (el) {\r\n          el.scrollIntoView({ behavior: 'smooth', block: 'center' });\r\n        }\r\n      }, 150);\r\n    }\r\n  }, [loading, creators]);\r\n\r\n  const processedCreators = useMemo(() => {\r\n    const q = searchQuery.toLowerCase().trim();\r\n    const result = creators.filter(c =>\r\n      !q ||\r\n      c.name.toLowerCase().includes(q) ||\r\n      c.role.toLowerCase().includes(q) ||\r\n      c.works.some(w => w.title?.toLowerCase().includes(q))\r\n    );\r\n\r\n    return result.sort((a, b) => {\r\n      if (sortBy === 'name-asc') return a.name.localeCompare(b.name);\r\n      if (sortBy === 'name-desc') return b.name.localeCompare(a.name);\r\n      if (sortBy === 'works-desc') return b.works.length - a.works.length;\r\n      if (sortBy === 'role-asc') return (a.role || '').localeCompare(b.role || '');\r\n      return 0;\r\n    });\r\n  }, [creators, searchQuery, sortBy]);\r\n\r\n  const handleProcessDonation = async () => {\r\n    const { data: { user } } = await supabase.auth.getUser();\r\n    const activeUserId = currentUser?.id || user?.id;\r\n\r\n    if (!activeUserId) {\r\n      if (onLoginClick) onLoginClick();\r\n      setDonationCreator(null);\r\n      return;\r\n    }\r\n\r\n    if (!donationCreator) return;\r\n\r\n    setDonationStep('processing');\r\n\r\n    const targetStripeAccountId = resolveCreatorStripeAccountId(\r\n      donationCreator.name,\r\n      donationCreator.stripe_account_id\r\n    );\r\n\r\n    try {\r\n      const { data, error } = await supabase.functions.invoke('create-checkout-session', {\r\n        body: {\r\n          type: 'donation',\r\n          userId: activeUserId,\r\n          userEmail: user?.email || currentUser?.email,\r\n          returnUrl: window.location.origin,\r\n          creatorName: donationCreator.name,\r\n          stripeAccountId: targetStripeAccountId,\r\n          amountDollars: donationAmount,\r\n          fanmail: fanmailText.trim(),\r\n          seriesSlug: donationCreator.works?.[0]?.slug || ''\r\n        }\r\n      });\r\n\r\n      if (error) throw error;\r\n      if (data?.error) throw new Error(data.error);\r\n\r\n      if (data?.url) {\r\n        window.location.href = data.url;\r\n      } else {\r\n        throw new Error(\"No checkout URL returned from Stripe.\");\r\n      }\r\n    } catch (err: any) {\r\n      alert(\"Unable to start Stripe Tip Checkout: \" + err.message);\r\n      setDonationStep('input');\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-transparent text-white pb-32 pt-6 px-4 max-w-5xl mx-auto\">\r\n      \r\n      {/* Sticky Header with Title, Search, and Sort */}\r\n      <div className=\"sticky top-0 z-40 bg-black/85 backdrop-blur-xl pb-4 pt-2 mb-6 border-b border-zinc-800 rounded-b-2xl px-2\">\r\n        <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-4 pr-16 sm:pr-20\">\r\n          <div>\r\n            <div className=\"flex items-center gap-2 mb-1\">\r\n              <PenTool className=\"w-4 h-4 text-[#fe9a00]\" />\r\n              <span className=\"text-[10px] font-black uppercase tracking-widest text-[#fe9a00]\">Spotlight</span>\r\n            </div>\r\n            <h1 className=\"text-3xl font-black italic uppercase tracking-tighter text-white\">\r\n              Creators Roster\r\n            </h1>\r\n          </div>\r\n          <span className=\"text-zinc-500 font-bold text-xs uppercase tracking-widest\">\r\n            {processedCreators.length} Visionaries\r\n          </span>\r\n        </div>\r\n\r\n        <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3\">\r\n          <div className=\"relative flex-1\">\r\n            <Search className=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500\" />\r\n            <input\r\n              type=\"text\"\r\n              placeholder=\"Search by creator name or manga...\"\r\n              value={searchQuery}\r\n              onChange={(e) => setSearchQuery(e.target.value)}\r\n              className=\"w-full bg-zinc-900/90 backdrop-blur-sm border border-zinc-800 text-white pl-10 pr-4 py-2.5 rounded-xl text-sm focus:outline-none focus:border-[#fe9a00] transition-colors\"\r\n            />\r\n          </div>\r\n\r\n          <div className=\"flex items-center gap-2 bg-zinc-900/90 border border-zinc-800 px-3 py-1 rounded-xl\">\r\n            <ArrowUpDown className=\"w-4 h-4 text-[#fe9a00] shrink-0\" />\r\n            <select\r\n              value={sortBy}\r\n              onChange={(e) => setSortBy(e.target.value as any)}\r\n              aria-label=\"Sort creators\"\r\n              className=\"bg-transparent text-white text-xs font-black uppercase tracking-wider py-1.5 focus:outline-none cursor-pointer\"\r\n            >\r\n              <option value=\"name-asc\" className=\"bg-zinc-950 text-white\">Name: A-Z</option>\r\n              <option value=\"name-desc\" className=\"bg-zinc-950 text-white\">Name: Z-A</option>\r\n              <option value=\"works-desc\" className=\"bg-zinc-950 text-white\">Most Titles</option>\r\n              <option value=\"role-asc\" className=\"bg-zinc-950 text-white\">Role</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Unified Large Hype Flame Loader */}\r\n      {loading ? (\r\n        <HypeLoader text=\"Loading Talent...\" />\r\n      ) : processedCreators.length === 0 ? (\r\n        <div className=\"text-center text-zinc-500 py-16 font-bold uppercase tracking-widest text-xs border-2 border-dashed border-zinc-800 rounded-2xl bg-black/40\">\r\n          No creators found matching \"{searchQuery}\".\r\n        </div>\r\n      ) : (\r\n        <div className=\"flex flex-col gap-4\">\r\n          {processedCreators.map((creator) => {\r\n            const isBioExpanded = !!expandedBios[creator.name];\r\n            const isHighlighted = highlightedCreator === creator.name;\r\n            const bioText = creator.bio || 'Official creator for Saturday AM titles.';\r\n\r\n            return (\r\n              <div \r\n                key={creator.name}\r\n                id={`creator-card-${normalizeCreatorKey(creator.name)}`}\r\n                onClick={() => {\r\n                  if (isHighlighted) setHighlightedCreator(null);\r\n                }}\r\n                className={`bg-zinc-950/70 border rounded-xl p-4 sm:p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 sm:gap-6 shadow-lg transition-all backdrop-blur-sm ${\r\n                  isHighlighted\r\n                    ? 'border-[#fe9a00] ring-2 ring-[#fe9a00]/50 shadow-[0_0_35px_rgba(254,154,0,0.4)]'\r\n                    : 'border-zinc-800/80 hover:border-zinc-700'\r\n                }`}\r\n              >\r\n                {/* Left Section: Avatar & Creator Details */}\r\n                <div className=\"flex items-start gap-4 flex-1 min-w-0 md:max-w-[400px] lg:max-w-[440px]\">\r\n                  <div className=\"relative w-14 h-14 sm:w-16 sm:h-16 rounded-full border-2 border-[#fe9a00] overflow-hidden flex-shrink-0 bg-zinc-900 shadow-[0_0_12px_rgba(254,154,0,0.25)]\">\r\n                    <img\r\n                      src={creator.avatar_url || `${CLOUDFLARE_BASE_URL}/assets/creator-avatar.jpg`}\r\n                      alt={creator.name}\r\n                      className=\"w-full h-full obje