    "src/supabase.ts": "import { createClient } from '@supabase/supabase-js';\r\n\r\nconst supabaseUrl = import.meta.env.VITE_SUPABASE_URL;\r\nconst supabaseKey = import.meta.env.VITE_SUPABASE_ANON_KEY;\r\n\r\nconsole.log(\"🔍 URL Check:\", supabaseUrl);\r\nconsole.log(\"🔑 Key Check:\", supabaseKey ? \"Key is loaded!\" : \"KEY IS UNDEFINED!\");\r\n\r\nexport const supabase = createClient(supabaseUrl, supabaseKey);\r\n\r\n// --- GLOBAL TELEMETRY TRACKER ---\r\nexport const trackTelemetry = async (eventType: string, metadata: any = {}) => {\r\n  try {\r\n    const { data: sessionData } = await supabase.auth.getSession();\r\n    const userId = sessionData?.session?.user?.id || null;\r\n    \r\n    // Create a temporary session ID so anonymous users are still counted uniquely per visit\r\n    let sessionId = sessionStorage.getItem('am_session_id');\r\n    if (!sessionId) {\r\n      sessionId = crypto.randomUUID();\r\n      sessionStorage.setItem('am_session_id', sessionId);\r\n    }\r\n\r\n    await supabase.from('telemetry_events').insert([{\r\n      event_type: eventType,\r\n      user_id: userId,\r\n      session_id: sessionId,\r\n      metadata: metadata\r\n    }]);\r\n  } catch (err) {\r\n    console.error(\"Telemetry failed silently:\", err);\r\n  }\r\n};",
    "src/userSeriesData.tsx": "import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';\r\nimport { supabase } from './supabase';\r\n\r\nconst SeriesContext = createContext<any>(null);\r\n\r\nexport const SeriesProvider = ({ children }: { children: React.ReactNode }) => {\r\n  const [seriesList, setSeriesList] = useState<any[]>([]);\r\n  const [magazines, setMagazines] = useState<any[]>([]);\r\n  const [vaultAvatars, setVaultAvatars] = useState<any[]>([]);\r\n  const [cardSkins, setCardSkins] = useState<any[]>([]);\r\n  const [vaultFrames, setVaultFrames] = useState<any[]>([]);\r\n  const [isLoading, setIsLoading] = useState(true);\r\n\r\n  const fetchAllGlobalData = useCallback(async () => {\r\n    try {\r\n      const [\r\n        seriesRes,\r\n        magazinesRes,\r\n        avatarsRes,\r\n        skinsRes,\r\n        framesRes\r\n      ] = await Promise.all([\r\n        supabase.from('series').select('*, creators:series_creators(*)').order('display_order', { ascending: true }),\r\n        supabase.from('magazines').select('*').order('publish_date', { ascending: false }),\r\n        supabase.from('avatars').select('*').eq('is_active', true).order('created_at', { ascending: false }),\r\n        supabase.from('card_skins').select('*').eq('is_active', true).order('created_at', { ascending: false }),\r\n        supabase.from('avatar_frames').select('*').eq('is_active', true).order('created_at', { ascending: false })\r\n      ]);\r\n\r\n      if (seriesRes.error) throw seriesRes.error;\r\n\r\n      if (seriesRes.data) setSeriesList(seriesRes.data);\r\n      if (magazinesRes.data) setMagazines(magazinesRes.data);\r\n      if (avatarsRes.data) setVaultAvatars(avatarsRes.data);\r\n      if (skinsRes.data) setCardSkins(skinsRes.data);\r\n      if (framesRes.data) setVaultFrames(framesRes.data);\r\n    } catch (error) {\r\n      console.error(\"Global cache fetch error:\", error);\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  }, []);\r\n\r\n  const refreshSeriesData = useCallback(async () => {\r\n    try {\r\n      const { data, error } = await supabase\r\n        .from('series')\r\n        .select('*, creators:series_creators(*)')\r\n        .order('display_order', { ascending: true });\r\n      if (!error && data) {\r\n        setSeriesList(data);\r\n      }\r\n    } catch (err) {\r\n      console.error(\"Failed to refresh series cache:\", err);\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    fetchAllGlobalData();\r\n    window.addEventListener('seriesUpdated', refreshSeriesData);\r\n    return () => window.removeEventListener('seriesUpdated', refreshSeriesData);\r\n  }, [fetchAllGlobalData, refreshSeriesData]);\r\n\r\n  return (\r\n    <SeriesContext.Provider value={{ \r\n      seriesList, \r\n      magazines, \r\n      vaultAvatars, \r\n      cardSkins, \r\n      vaultFrames, \r\n      isLoading,\r\n      refreshSeriesData \r\n    }}>\r\n      {children}\r\n    </SeriesContext.Provider>\r\n  );\r\n};\r\n\r\nexport const useSeriesData = () => useContext(SeriesContext);",
    "src/main.tsx": "import React from 'react';\r\nimport ReactDOM from 'react-dom/client';\r\nimport App from './App.tsx';\r\nimport './index.css';\r\nimport { registerSW } from 'virtual:pwa-register';\r\nimport { SeriesProvider } from './userSeriesData.tsx';\r\n\r\nlet isReaderCurrentlyOpen = false;\r\nlet pendingSwUpdate = false;\r\n\r\nwindow.addEventListener('readerToggled', (e: any) => {\r\n  isReaderCurrentlyOpen = Boolean(e?.detail?.isOpen);\r\n  // If an update arrived while the fan was reading a chapter, apply it the moment they close the reader!\r\n  if (!isReaderCurrentlyOpen && pendingSwUpdate) {\r\n    pendingSwUpdate = false;\r\n    updateSW(true);\r\n  }\r\n});\r\n\r\n// Initializes the service worker with automatic background update polling & instant activation\r\nconst updateSW = registerSW({\r\n  immediate: true,\r\n  onNeedRefresh() {\r\n    // If the user is actively inside the MangaReader, wait until they close the chapter\r\n    if (isReaderCurrentlyOpen) {\r\n      pendingSwUpdate = true;\r\n      return;\r\n    }\r\n    // Otherwise, immediately activate the new Service Worker and reload into the fresh build\r\n    updateSW(true);\r\n  },\r\n  onOfflineReady() {\r\n    console.log('App is ready to work offline!');\r\n  },\r\n  onRegisteredSW(_swUrl, registration) {\r\n    if (!registration) return;\r\n\r\n    // 1. Check for updates every time the user brings the app/tab back to the foreground\r\n    document.addEventListener('visibilitychange', () => {\r\n      if (document.visibilityState === 'visible') {\r\n        registration.update().catch(() => {});\r\n      }\r\n    });\r\n\r\n    // 2. Also poll for new deployments every 15 minutes for long sessions\r\n    setInterval(() => {\r\n      if (navigator.onLine) {\r\n        registration.update().catch(() => {});\r\n      }\r\n    }, 15 * 60 * 1000);\r\n  }\r\n});\r\n\r\n// 3. Catch Vite chunk load errors (when a user clicks a lazy route after a new deploy) and auto-reload cleanly\r\nwindow.addEventListener('vite:preloadError', () => {\r\n  if (!isReaderCurrentlyOpen) {\r\n    window.location.reload();\r\n  }\r\n});\r\n\r\nReactDOM.createRoot(document.getElementById('root')!).render(\r\n  <React.StrictMode>\r\n    <SeriesProvider>\r\n      <App />\r\n    </SeriesProvider>\r\n  </React.StrictMode>\r\n);",
    "vite.config.ts": "import { defineConfig } from 'vite';\r\nimport react from '@vitejs/plugin-react';\r\nimport { VitePWA } from 'vite-plugin-pwa';\r\n\r\nexport default defineConfig({\r\n  plugins: [\r\n    react(),\r\n    VitePWA({\r\n      registerType: 'autoUpdate',\r\n      injectRegister: 'auto',\r\n      workbox: {\r\n        globPatterns: ['**/*.{js,css,html,ico,png,svg,webp}'],\r\n        cleanupOutdatedCaches: true,\r\n        clientsClaim: true,\r\n        skipWaiting: true,\r\n        navigateFallbackDenylist: [/^\\/share/, /^\\/api/]\r\n      },\r\n      manifest: {\r\n        name: 'Saturday AM - Manga Hype',\r\n        short_name: 'Saturday AM',\r\n        description: 'Read original diverse manga online with Saturday AM.',\r\n        theme_color: '#000000',\r\n        background_color: '#000000',\r\n        display: 'standalone',\r\n        orientation: 'portrait',\r\n        start_url: '/',\r\n        icons: [\r\n          {\r\n            src: 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/pwa-512x512-v4.png?v=4',\r\n            sizes: '192x192',\r\n            type: 'image/png',\r\n            purpose: 'any'\r\n          },\r\n          {\r\n            src: 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/pwa-512x512-v4.png?v=4',\r\n            sizes: '512x512',\r\n            type: 'image/png',\r\n            purpose: 'any maskable'\r\n          }\r\n        ]\r\n      }\r\n    })\r\n  ]\r\n});",
    "src/HypeEconomyContext.tsx": "import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';\r\nimport { supabase } from './supabase';\r\n\r\nexport const FREE_ROLLOVER_CAP = 5;\r\nexport const PREMIUM_ROLLOVER_CAP = 10;\r\n\r\ninterface HypeEconomyContextType {\r\n  hypesRemaining: number; // Active Weekly Hypes (Orange - Capped at 5 Free / 10 PLUS)\r\n  vaultedHypes: number;   // Purchased / Bundle Hypes (Metallic Gold - Uncapped & Never Expire)\r\n  totalAvailableHypes: number; // hypesRemaining + vaultedHypes\r\n  rolloverCap: number;    // 5 for Free, 10 for PLUS\r\n  isLoading: boolean;\r\n  isPremium: boolean;\r\n  spendHype: (\r\n    targetType: 'chapter' | 'character' | 'creator' | 'series',\r\n    targetId: string | number,\r\n    seriesSlug?: string\r\n  ) => Promise<boolean>;\r\n  spendSuperHype: (seriesSlug: string) => Promise<boolean>;\r\n  refreshEconomy: () => Promise<void>;\r\n}\r\n\r\nconst HypeEconomyContext = createContext<HypeEconomyContextType | undefined>(undefined);\r\n\r\n// Helper: Get most recent Saturday at 00:00:00 UTC\r\nconst getLastSaturdayUTC = (): Date => {\r\n  const now = new Date();\r\n  const lastSat = new Date(\r\n    Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 0, 0, 0, 0)\r\n  );\r\n  const daysSinceSaturday = (now.getUTCDay() + 1) % 7;\r\n  lastSat.setUTCDate(lastSat.getUTCDate() - daysSinceSaturday);\r\n  return lastSat;\r\n};\r\n\r\nexport const HypeEconomyProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\r\n  const [hypesRemaining, setHypesRemaining] = useState<number>(0);\r\n  const [vaultedHypes, setVaultedHypes] = useState<number>(0);\r\n  const [isLoading, setIsLoading] = useState<boolean>(true);\r\n  const [isPremium, setIsPremium] = useState<boolean>(false);\r\n  const [userId, setUserId] = useState<string | null>(null);\r\n\r\n  const syncEconomy = useCallback(async (currentUserId: string) => {\r\n    try {\r\n      const [{ data: profile, error }, { data: settings }] = await Promise.all([\r\n        supabase\r\n          .from('profiles')\r\n          .select('super_hypes_left, hypes_remaining, vaulted_hypes, is_premium, last_hype_reset')\r\n          .eq('id', currentUserId)\r\n          .maybeSingle(),\r\n        supabase\r\n          .from('app_settings')\r\n          .select(\r\n            'free_hype_allowance, premium_hype_allowance, free_tier_hypes, premium_tier_hypes, hype_refill_period'\r\n          )\r\n          .eq('id', 1)\r\n          .maybeSingle()\r\n      ]);\r\n\r\n      if (error) throw error;\r\n      if (!profile) return;\r\n\r\n      const premiumStatus = Boolean(profile.is_premium);\r\n      setIsPremium(premiumStatus);\r\n\r\n      const freeAllowance = Number(\r\n        settings?.free_hype_allowance ?? settings?.free_tier_hypes ?? 1\r\n      );\r\n      const proAllowance = Number(\r\n        settings?.premium_hype_allowance ?? settings?.premium_tier_hypes ?? 3\r\n      );\r\n      const refillPeriod = settings?.hype_refill_period || 'weekly';\r\n      const tierAllowance = premiumStatus ? proAllowance : freeAllowance;\r\n      const tierRolloverCap = premiumStatus ? PREMIUM_ROLLOVER_CAP : FREE_ROLLOVER_CAP;\r\n\r\n      // Canonical Active & Vaulted balances\r\n      const rawActive =\r\n        profile.hypes_remaining !== null && profile.hypes_remaining !== undefined\r\n          ? Number(profile.hypes_remaining)\r\n          : profile.super_hypes_left !== null && profile.super_hypes_left !== undefined\r\n          ? Number(profile.super_hypes_left)\r\n          : tierAllowance;\r\n      const currentActive = Math.max(0, rawActive);\r\n      const currentVaulted = Math.max(0, Number(profile.vaulted_hypes || 0));\r\n\r\n      setVaultedHypes(currentVaulted);\r\n\r\n      const lastSaturday = getLastSaturdayUTC();\r\n      const lastResetDate = profile.last_hype_reset ? new Date(profile.last_hype_reset) : null;\r\n\r\n      let needsRefill = false;\r\n      if (refillPeriod === 'weekly') {\r\n        if (!lastResetDate || lastResetDate < lastSaturday) {\r\n          needsRefill = true;\r\n        }\r\n      } else if (refillPeriod === 'monthly') {\r\n        const now = new Date();\r\n        const firstOfMonth = new Date(\r\n          Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1, 0, 0, 0, 0)\r\n        );\r\n        if (!lastResetDate || lastResetDate < firstOfMonth) {\r\n          needsRefill = true;\r\n        }\r\n      }\r\n\r\n      if (needsRefill) {\r\n        const nowIso = new Date().toISOString();\r\n        // Rollover unspent Active Hypes up to the tier cap (5 Free / 10 PLUS).\r\n        // If a user already has more than the cap from an older airdrop, never reduce their balance.\r\n        const rolledOverActive =\r\n          currentActive >= tierRolloverCap\r\n            ? currentActive\r\n            : Math.min(tierRolloverCap, currentActive + tierAllowance);\r\n\r\n        await supabase\r\n          .from('profiles')\r\n          .update({\r\n            hypes_remaining: rolledOverActive,\r\n            super_hypes_left: rolledOverActive,\r\n            last_hype_reset: nowIso\r\n          })\r\n          .eq('id', currentUserId);\r\n\r\n        setHypesRemaining(rolledOverActive);\r\n      } else {\r\n        // Keep super_hypes_left and hypes_remaining strictly identical\r\n        if (profile.super_hypes_left !== currentActive) {\r\n          await supabase\r\n            .from('profiles')\r\n            .update({\r\n              hypes_remaining: currentActive,\r\n              super_hypes_left: currentActive\r\n            })\r\n            .eq('id', currentUserId);\r\n        }\r\n        setHypesRemaining(currentActive);\r\n      }\r\n    } catch (err) {\r\n      console.error('Failed to sync economy:', err);\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  }, []);\r\n\r\n  const refreshEconomy = useCallback(async () => {\r\n    try {\r\n      const {\r\n        data: { session },\r\n 