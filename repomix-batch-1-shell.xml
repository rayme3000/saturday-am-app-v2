          }}\r\n        />\r\n      )}\r\n    </>\r\n  );\r\n};\r\n\r\nexport const FloatingPillNav = memo(\r\n  ({ currentView, onNavigate, currentUser, onOpenFlexCard, userTier, onUpsell }: any) => {\r\n    const { vaultFrames = [] } = useSeriesData();\r\n    const [isExpanded, setIsExpanded] = useState(false);\r\n    const [activeStoreIds, setActiveStoreIds] = useState<string[]>([]);\r\n    const [unseenShopCount, setUnseenShopCount] = useState<number>(0);\r\n\r\n    const navAvatar = currentUser?.avatar_url || '';\r\n    const navFrame = currentUser?.avatar_frame_id || currentUser?.frame_id || '';\r\n\r\n    const dynamicFrame = vaultFrames.find((f: any) => f.id === navFrame);\r\n    const dynBorder = dynamicFrame ? `2px solid ${dynamicFrame.border_color}` : 'none';\r\n    const dynShadow =\r\n      dynamicFrame?.glow_color && dynamicFrame.glow_color !== 'transparent'\r\n        ? `0 0 10px ${dynamicFrame.glow_color}`\r\n        : 'none';\r\n    const dynAnim = dynamicFrame ? dynamicFrame.animation_style : 'none';\r\n\r\n    const markAllStoreDropsSeen = useCallback((idsToMark: string[]) => {\r\n      try {\r\n        const raw = localStorage.getItem(SEEN_STORE_PRODUCTS_KEY);\r\n        const existing: string[] = raw ? JSON.parse(raw) : [];\r\n        const merged = Array.from(new Set([...existing, ...idsToMark]));\r\n        localStorage.setItem(SEEN_STORE_PRODUCTS_KEY, JSON.stringify(merged));\r\n      } catch {\r\n        // ignore storage errors\r\n      }\r\n      setUnseenShopCount(0);\r\n    }, []);\r\n\r\n    const checkUnseenStoreDrops = useCallback(async () => {\r\n      try {\r\n        const { data: prodRows } = await supabase\r\n          .from('in_app_store_products')\r\n          .select('id, is_active, available_from, available_until')\r\n          .eq('is_active', true);\r\n\r\n        const liveIds = (prodRows || [])\r\n          .filter(isStoreItemLiveNow)\r\n          .map((p: any) => String(p.id));\r\n\r\n        setActiveStoreIds(liveIds);\r\n\r\n        if (currentView === 'shop') {\r\n          markAllStoreDropsSeen(liveIds);\r\n          return;\r\n        }\r\n\r\n        let seenIds: string[] = [];\r\n        try {\r\n          const raw = localStorage.getItem(SEEN_STORE_PRODUCTS_KEY);\r\n          seenIds = raw ? JSON.parse(raw) : [];\r\n        } catch {\r\n          seenIds = [];\r\n        }\r\n\r\n        const unseen = liveIds.filter(id => !seenIds.includes(id));\r\n        setUnseenShopCount(unseen.length);\r\n      } catch {\r\n        // ignore network errors\r\n      }\r\n    }, [currentView, markAllStoreDropsSeen]);\r\n\r\n    useEffect(() => {\r\n      checkUnseenStoreDrops();\r\n      const handleStoreUpdated = () => checkUnseenStoreDrops();\r\n      window.addEventListener('storeCatalogUpdated', handleStoreUpdated);\r\n      window.addEventListener('focus', handleStoreUpdated);\r\n      return () => {\r\n        window.removeEventListener('storeCatalogUpdated', handleStoreUpdated);\r\n        window.removeEventListener('focus', handleStoreUpdated);\r\n      };\r\n    }, [checkUnseenStoreDrops]);\r\n\r\n    useEffect(() => {\r\n      if (currentView === 'shop' && activeStoreIds.length > 0) {\r\n        markAllStoreDropsSeen(activeStoreIds);\r\n      }\r\n    }, [currentView, activeStoreIds, markAllStoreDropsSeen]);\r\n\r\n    const handleNav = (action: string) => {\r\n      if (action === 'shop' && activeStoreIds.length > 0) {\r\n        markAllStoreDropsSeen(activeStoreIds);\r\n      }\r\n      onNavigate({ action });\r\n      setIsExpanded(false);\r\n    };\r\n\r\n    return (\r\n      <div className=\"fixed bottom-4 sm:bottom-8 left-0 w-full z-[150] pb-[max(0.75rem,env(safe-area-inset-bottom))] flex flex-col items-center pointer-events-none\">\r\n        {/* EXPANDABLE GRID */}\r\n        <div\r\n          className={`mb-4 bg-zinc-900/95 backdrop-blur-xl border border-zinc-700 rounded-3xl p-4 shadow-2xl transition-all duration-300 origin-bottom pointer-events-auto ${\r\n            isExpanded\r\n              ? 'scale-100 opacity-100 translate-y-0'\r\n              : 'scale-95 opacity-0 translate-y-8 pointer-events-none'\r\n          }`}\r\n        >\r\n          <div className=\"grid grid-cols-4 sm:grid-cols-7 gap-4 sm:gap-6 justify-center\">\r\n            <button\r\n              onClick={() => handleNav('leaderboard')}\r\n              className=\"flex flex-col items-center gap-2 group cursor-pointer\"\r\n            >\r\n              <div className=\"p-3 sm:p-4 bg-zinc-800 rounded-2xl group-hover:bg-[#fe9a00] transition-colors\">\r\n                <Trophy className=\"w-5 h-5 sm:w-6 sm:h-6 text-white group-hover:text-black\" />\r\n              </div>\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-400 group-hover:text-white\">\r\n                Rankings\r\n              </span>\r\n            </button>\r\n\r\n            <button\r\n              onClick={() => handleNav('creators')}\r\n              className=\"flex flex-col items-center gap-2 group cursor-pointer\"\r\n            >\r\n              <div className=\"p-3 sm:p-4 bg-zinc-800 rounded-2xl group-hover:bg-[#fe9a00] transition-colors\">\r\n                <PenTool className=\"w-5 h-5 sm:w-6 sm:h-6 text-white group-hover:text-black\" />\r\n              </div>\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-400 group-hover:text-white\">\r\n                Creators\r\n              </span>\r\n            </button>\r\n\r\n            <button\r\n              onClick={() => handleNav('characters')}\r\n              className=\"flex flex-col items-center gap-2 group cursor-pointer\"\r\n            >\r\n              <div className=\"p-3 sm:p-4 bg-zinc-800 rounded-2xl group-hover:bg-[#fe9a00] transition-colors\">\r\n                <Users className=\"w-5 h-5 sm:w-6 sm:h-6 text-white group-hover:text-black\" />\r\n              </div>\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-400 group-hover:text-white\">\r\n                Characters\r\n              </span>\r\n            </button>\r\n\r\n            <button\r\n              onClick={() => handleNav('bingobook')}\r\n              className=\"flex flex-col items-center gap-2 group cursor-pointer\"\r\n            >\r\n              <div className=\"p-3 sm:p-4 bg-zinc-800 rounded-2xl group-hover:bg-[#fe9a00] transition-colors\">\r\n                <Target className=\"w-5 h-5 sm:w-6 sm:h-6 text-white group-hover:text-black\" />\r\n              </div>\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-400 group-hover:text-white whitespace-nowrap\">\r\n                Bingo Book\r\n              </span>\r\n            </button>\r\n\r\n            <button\r\n              onClick={() => handleNav('news')}\r\n              className=\"flex flex-col items-center gap-2 group cursor-pointer\"\r\n            >\r\n              <div className=\"p-3 sm:p-4 bg-zinc-800 rounded-2xl group-hover:bg-[#fe9a00] transition-colors\">\r\n                <Newspaper className=\"w-5 h-5 sm:w-6 sm:h-6 text-white group-hover:text-black\" />\r\n              </div>\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-400 group-hover:text-white whitespace-nowrap\">\r\n                AM News\r\n              </span>\r\n            </button>\r\n\r\n            {/* HYPE CARD: UNLOCKED FOR ALL FREE & PLUS ACCOUNT HOLDERS */}\r\n            <button\r\n              onClick={() => {\r\n                setIsExpanded(false);\r\n                const isVisitor = !currentUser || userTier === 'visitor';\r\n                if (isVisitor) {\r\n                  if (onUpsell) {\r\n                    onUpsell({\r\n                      title: 'Create Free Account',\r\n                      message:\r\n                        'Create a free Saturday AM account to unlock your Virtual Hype Card, customize your card skin, and flex your stats!',\r\n                      target: 'signup',\r\n                      buttonText: 'Create Free Account'\r\n                    });\r\n                  } else {\r\n                    onNavigate({ action: 'signup' });\r\n                  }\r\n                } else if (onOpenFlexCard) {\r\n                  onOpenFlexCard();\r\n                } else {\r\n                  onNavigate({ action: 'profile' });\r\n                }\r\n              }}\r\n              className=\"flex flex-col items-center gap-2 group cursor-pointer\"\r\n            >\r\n              <div className=\"p-3 sm:p-4 bg-zinc-800 rounded-2xl group-hover:bg-[#fe9a00] transition-colors\">\r\n                <CreditCard className=\"w-5 h-5 sm:w-6 sm:h-6 text-white group-hover:text-black\" />\r\n              </div>\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-400 group-hover:text-white whitespace-nowrap\">\r\n                Hype Card\r\n              </span>\r\n            </button>\r\n\r\n            <button\r\n              onClick={() => handleNav('settings')}\r\n              className=\"flex flex-col items-center gap-2 group cursor-pointer\"\r\n            >\r\n              <div\r\n                className={`p-3 sm:p-4 rounded-2xl transition-colors ${\r\n                  currentView === 'settings'\r\n                    ? 'bg-[#fe9a00] text-black'\r\n                    : 'bg-zinc-800 text-white group-hover:bg-[#fe9a00] group-hover:text-black'\r\n                }`}\r\n              >\r\n                <Settings className=\"w-5 h-5 sm:w-6 sm:h-6 transition-transform duration-300 group-hover:rotate-90\" />\r\n              </div>\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-400 group-hover:text-white whitespace-nowrap\">\r\n                Settings\r\n              </span>\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        {/* NAV CONTAINER */}\r\n        <div className=\"flex items-center justify-center gap-2 sm:gap-3 w-[94%] sm:w-auto max-w-[500px]\">\r\n          {/* MAIN PILL */}\r\n          <nav className=\"relative flex-1 sm:min-w-[400px] h-14 sm:h-16 bg-black/80 backdrop-blur-md border border-[#fe9a00] rounded-full flex items-center shadow-[0_10px_40px_rgba(0,0,0,0.8)] pointer-events-auto\">\r\n            {/* LEFT ICONS */}\r\n            <div className=\"flex-1 flex justify-evenly items-center h-full pr-8 sm:pr-10\">\r\n              <button\r\n                onClick={() => handleNav('home')}\r\n                className=\"p-2 transition-transform hover:scale-110 cursor-pointer\"\r\n                title=\"Home\"\r\n              >\r\n                <Home\r\n                  className={`w-5 h-5 sm:w-6 sm:h-6 ${\r\n                    currentView === 'home' ? 'text-[#fe9a00]' : 'text-zinc-500 hover:text-zinc-300'\r\n                  }`}\r\n                />\r\n              </button>\r\n\r\n              <button\r\n                onClick={() => handleNav('faves')}\r\n                className=\"p-2 transition-transform hover:scale-110 cursor-pointer\"\r\n                title=\"My Bookshelf\"\r\n              >\r\n                <Library\r\n                  className={`w-5 h-5 sm:w-6 sm:h-6 ${\r\n                    currentView === 'faves'\r\n                      ? 'text-[#fe9a00]'\r\n                      : 'text-zinc-500 hover:text-zinc-300'\r\n                  }`}\r\n                />\r\n              </button>\r\n            </div>\r\n\r\n            {/* PROMINENT BREAKOUT AVATAR */}\r\n            <button\r\n              onClick={() => handleNav('profile')}\r\n              className=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center w-20 h-20 sm:w-24 sm:h-24 transition-transform hover:scale-105 z-20 cursor-pointer\"\r\n              title=\"Profile\"\r\n            >\r\n              <div\r\n                className={`w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden bg-zinc-800 flex items-center justify-center z-10 transition-all shadow-2xl ${\r\n                  !dynamicFrame ? 'border-[3px] border-[#fe9a00]' : ''\r\n                }`}\r\n                style={dynamicFrame ? { border: dynBorder, boxShadow: dynShadow } : {}}\r\n              >\r\n                {navAvatar && navAvatar.trim() !== '' ? (\r\n                  <img src={navAvatar} alt=\"Profile\" className=\"w-full h-full object-cover\" />\r\n                ) : (\r\n                  <User\r\n                    className={`w-6 h-6 sm:w-8 sm:h-8 ${\r\n                      currentView === 'profile' ? 'text-[#fe9a00]' : 'text-zinc-400'\r\n                    }`}\r\n                  />\r\n                )}\r\n              </div>\r\n\r\n              {dynamicFrame && (\r\n                <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none scale-[1.35] sm:scale-[1.6]\">\r\n                  <RenderPillAnimations anim={dynAnim} color={dynamicFrame.border_color} />\r\n                </div>\r\n              )}\r\n            </button>\r\n\r\n            {/* RIGHT ICONS */}\r\n            <div className=\"flex-1 flex justify-evenly items-center h-full pl-8 sm:pl-10\">\r\n              <button\r\n                onClick={() => handleNav('browse')}\r\n                className=\"p-2 transition-transform hover:scale-110 cursor-pointer\"\r\n                title=\"Browse\"\r\n              >\r\n                <Search\r\n                  className={`w-5 h-5 sm:w-6 sm:h-6 ${\r\n                    currentView === 'browse'\r\n                      ? 'text-[#fe9a00]'\r\n                      : 'text-zinc-500 hover:text-zinc-300'\r\n                  }`}\r\n                />\r\n              </button>\r\n\r\n              {/* SHOPPING CART ICON WITH NEW STORE DROP NOTIFICATION BUG */}\r\n              <button\r\n                onClick={() => handleNav('shop')}\r\n                className=\"relative p-2 transition-transform hover:scale-110 cursor-pointer\"\r\n                title={\r\n                  unseenShopCount > 0\r\n                    ? `AM Shop (${unseenShopCount} New Drop${unseenShopCount > 1 ? 's' : ''}!)`\r\n                    : 'AM Shop'\r\n                }\r\n              >\r\n                <ShoppingCart\r\n                  className={`w-5 h-5 sm:w-6 sm:h-6 ${\r\n                    currentView === 'shop'\r\n                      ? 'text-[#fe9a00]'\r\n                      : unseenShopCount > 0\r\n                      ? 'text-white'\r\n                      : 'text-zinc-500 hover:text-zinc-300'\r\n                  }`}\r\n                />\r\n\r\n                {unseenShopCount > 0 && currentView !== 'shop' && (\r\n                  <span className=\"absolute top-0.5 right-0.5 flex h-4 min-w-[16px] items-center justify-center\">\r\n                    <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#fe9a00] opacity-75\" />\r\n                    <span className=\"relative inline-flex items-center justify-center rounded-full h-4 min-w-[16px] px-1 bg-[#fe9a00] border border-black text-black text-[9px] font-black leading-none shadow-[0_0_10px_rgba(254,154,0,0.8)]\">\r\n                      {unseenShopCount > 9 ? '9+' : unseenShopCount}\r\n                    </span>\r\n                  </span>\r\n                )}\r\n              </button>\r\n            </div>\r\n          </nav>\r\n\r\n          {/* OUTSIDE PLUS BUTTON */}\r\n          <button\r\n            onClick={() => setIsExpanded(!isExpanded)}\r\n            className={`shrink-0 flex items-center justify-center w-[52px] h-[52px] sm:w-[60px] sm:h-[60px] rounded-full backdrop-blur-md border shadow-[0_10px_40px_rgba(0,0,0,0.8)] pointer-events-auto transition-all duration-300 cursor-pointer ${\r\n              isExpanded\r\n                ? 'rotate-45 bg-zinc-800 border-zinc-700'\r\n                : 'rotate-0 bg-black/80 border-[#fe9a00] hover:scale-105'\r\n            }`}\r\n            title=\"Expand Console\"\r\n          >\r\n            <Plus className={`w-6 h-6 sm:w-7 sm:h-7 ${isExpanded ? 'text-red-500' : 'text-white'}`} />\r\n          </button>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n);",
    "index.html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"UTF-8\" />\r\n    \r\n    <!-- Standard Favicon -->\r\n    <link rel=\"icon\" type=\"image/png\" href=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/pwa-512x512-v4.png?v=4\" />\r\n    \r\n    <!-- Apple Touch Icon (iOS Home Screen) -->\r\n    <link rel=\"apple-touch-icon\" href=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/pwa-512x512-v4.png?v=4\" />\r\n    \r\n    <!-- iOS PWA Standalone Support -->\r\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\r\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\r\n    <meta name=\"apple-mobile-web-app-title\" content=\"Saturday AM\" />\r\n\r\n    <!-- Canonical URL -->\r\n    <link rel=\"canonical\" href=\"https://www.mangahype.com/\" />\r\n    \r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" />\r\n    <meta name=\"theme-color\" content=\"#000000\" />\r\n    <title>Saturday AM App - Read Diverse Manga Online</title>\r\n    \r\n    <!-- Comprehensive Meta Description for Search Engine Indexing -->\r\n    <meta name=\"description\" content=\"Read original diverse manga online with Saturday AM. Explore Apple Black, Clock Striker, Hammer, Underground, Gun+Bone, Orisha, Oblivion Rouge, and more by global creators.\" />\r\n    \r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap\" rel=\"stylesheet\">\r\n\r\n    <!-- Preload the Hype Flame Loader Image so it renders instantaneously -->\r\n    <link rel=\"preload\" as=\"image\" href=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/Hype%20flame.png\" />\r\n\r\n    <!-- OpenGraph & Social Preview Meta Tags -->\r\n    <meta property=\"og:title\" content=\"Saturday AM - Manga Hype\" />\r\n    <meta property=\"og:description\" content=\"Read original diverse manga online with Saturday AM. Discover Apple Black, Clock Striker, Hammer, Underground, and over 20+ flagship series from global creators.\" />\r\n    <meta property=\"og:image\" content=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20load%20screen.jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"630\" />\r\n    <meta property=\"og:url\" content=\"https://www.mangahype.com/\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:image\" content=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20load%20screen.jpg\" />\r\n\r\n    <!-- Early Global Event Listener for PWA Installation -->\r\n    <script>\r\n      window.deferredPrompt = null;\r\n\r\n      window.addEventListener('beforeinstallprompt', (e) => {\r\n        e.preventDefault();\r\n        window.deferredPrompt = e;\r\n        localStorage.removeItem('am_pwa_installed');\r\n        window.dispatchEvent(new Event('pwa-install-ready'));\r\n      });\r\n\r\n      window.addEventListener('appinstalled', () => {\r\n        window.deferredPrompt = null;\r\n        localStorage.setItem('am_pwa_installed', 'true');\r\n      });\r\n    </script>\r\n\r\n    <!-- Schema.org JSON-LD Structured Data for Full Catalog & Creators -->\r\n    <script type=\"application/ld+json\">\r\n    {\r\n      \"@context\": \"https://schema.org\",\r\n      \"@type\": \"WebApplication\",\r\n      \"name\": \"Saturday AM - Manga Hype\",\r\n      \"url\": \"https://www.mangahype.com/\",\r\n      \"applicationCategory\": \"EntertainmentApplication\",\r\n      \"operatingSystem\": \"All\",\r\n      \"descriptio