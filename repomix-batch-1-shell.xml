    "src/Components/HamburgerMenu.tsx": "import { memo, useState, useEffect } from 'react';\r\nimport {\r\n  X,\r\n  CreditCard,\r\n  ShieldAlert,\r\n  ExternalLink,\r\n  Download,\r\n  User,\r\n  LogOut,\r\n  Crown,\r\n  HelpCircle,\r\n  Share2,\r\n  ChevronDown,\r\n  ChevronUp,\r\n  Sparkles\r\n} from 'lucide-react';\r\nimport { supabase } from '../supabase';\r\n\r\nconst KNOWN_CREATOR_EMAILS = new Set([\r\n  'rayme3000@gmail.com',\r\n  'publisher@saturday-am.com',\r\n  'fsimmonds4@gmail.com',\r\n  'dropkickanimation@gmail.com',\r\n  'saturday.editorial@gmail.com',\r\n  'odunze.oguguo@yahoo.com',\r\n  'oscar.edfong@gmail.com',\r\n  'erickpedrucciandre@yahoo.com',\r\n  'jeyodin@gmail.com',\r\n  'demetrene.billups@gmail.com',\r\n  'saturdayam.writer@gmail.com'\r\n]);\r\n\r\nconst KNOWN_CREATOR_USERNAMES = new Set([\r\n  'rayme3000',\r\n  'effessart',\r\n  'jeyodin',\r\n  'whytmanga',\r\n  'whyt manga',\r\n  'dropkickanimation'\r\n]);\r\n\r\nexport const HamburgerMenu = memo(\r\n  ({\r\n    isOpen,\r\n    onClose,\r\n    onNavigate,\r\n    onOpenFlexCard,\r\n    userTier,\r\n    currentUser,\r\n    canInstall,\r\n    onInstall,\r\n    onLoginClick,\r\n    onShareClick\r\n  }: any) => {\r\n    const [showHelpModal, setShowHelpModal] = useState(false);\r\n    const [showMore, setShowMore] = useState(false);\r\n\r\n    // Dispatch event to completely hide underlying pulsing elements (solves blur lag and overlaps)\r\n    useEffect(() => {\r\n      if (!isOpen) return;\r\n      window.dispatchEvent(new CustomEvent('appOverlayActive', { detail: true }));\r\n      return () => {\r\n        window.dispatchEvent(new CustomEvent('appOverlayActive', { detail: false }));\r\n      };\r\n    }, [isOpen]);\r\n\r\n    if (!isOpen) return null;\r\n\r\n    const handleLogout = async () => {\r\n      await supabase.auth.signOut();\r\n      onClose();\r\n    };\r\n\r\n    const cleanEmail = String(currentUser?.email || '').trim().toLowerCase();\r\n    const cleanUsername = String(currentUser?.username || '').trim().toLowerCase();\r\n    const cleanRole = String(currentUser?.role || '').trim().toLowerCase();\r\n    const isRevokedCreator = cleanRole === 'revoked_creator';\r\n\r\n    const hasCreatorStudioAccess = Boolean(\r\n      currentUser?.is_admin ||\r\n        (!isRevokedCreator &&\r\n          (Boolean(currentUser?.linked_creator_name) ||\r\n            ['creator', 'core_creator', 'staff', 'influencer'].includes(cleanRole) ||\r\n            KNOWN_CREATOR_EMAILS.has(cleanEmail) ||\r\n            KNOWN_CREATOR_USERNAMES.has(cleanUsername)))\r\n    );\r\n\r\n    const isRegisteredUser = Boolean(currentUser && userTier !== 'visitor');\r\n\r\n    const menuItems = [\r\n      { name: 'AM Shop', action: 'shop', prefetch: () => import('../MainViews/Shop').then(mod => mod.Shop) },\r\n      { name: 'Browse Library', action: 'browse', prefetch: () => import('../MainViews/Browse.tsx') },\r\n      {\r\n        name: 'Creators Roster',\r\n        action: 'creators',\r\n        prefetch: () => import('../MainViews/CreatorsPage').then(mod => ({ default: mod.CreatorsPage }))\r\n      },\r\n      {\r\n        name: 'Profile',\r\n        action: 'profile',\r\n        prefetch: () => import('../VirtualProfile/UserProfile').then(mod => mod.UserProfile)\r\n      },\r\n      { name: 'My Bookshelf', action: 'faves', prefetch: () => import('../MainViews/MyFaves.tsx') },\r\n      { name: 'Subscription', action: 'sub', prefetch: null },\r\n      // --- Hidden behind \"See More\" ---\r\n      { name: 'Bingo Book', action: 'bingobook', prefetch: () => import('../VirtualProfile/BingoBook') },\r\n      { name: 'AM News', action: 'news', prefetch: () => import('../MainViews/AMNewsPage').then(mod => mod.AMNewsPage) },\r\n      { name: 'Leaderboards', action: 'leaderboard', prefetch: () => import('../MainViews/Leaderboard.tsx') },\r\n      { name: 'Characters', action: 'characters', prefetch: null },\r\n      { name: 'Settings', action: 'settings', prefetch: () => import('../MainViews/Settings.tsx') },\r\n      {\r\n        name: 'Legal & Privacy',\r\n        action: 'legal',\r\n        prefetch: () => import('../MainViews/LegalPages').then(mod => mod.LegalPages)\r\n      }\r\n    ];\r\n\r\n    const visibleItems = showMore ? menuItems : menuItems.slice(0, 6);\r\n\r\n    return (\r\n      <div className=\"fixed inset-0 z-[200] bg-black animate-fade-in flex flex-col\">\r\n        <div className=\"p-6 flex justify-between items-center border-b border-zinc-900 shrink-0\">\r\n          <span className=\"text-[#fe9a00] font-black uppercase tracking-widest text-xs\">Menu</span>\r\n          <button onClick={onClose} className=\"p-2 text-white hover:text-[#fe9a00] cursor-pointer\">\r\n            <X className=\"w-8 h-8\" />\r\n          </button>\r\n        </div>\r\n\r\n        <div className=\"flex-1 flex flex-col justify-start px-8 sm:px-12 pt-8 pb-8 overflow-y-auto no-scrollbar\">\r\n          <div className=\"flex flex-wrap items-center gap-3 sm:gap-4 mb-8\">\r\n            {!currentUser ? (\r\n              <button\r\n                onClick={() => {\r\n                  onClose();\r\n                  if (onLoginClick) onLoginClick();\r\n                }}\r\n                className=\"flex items-center gap-4 bg-[#fe9a00] text-black px-6 py-4 rounded-2xl font-black uppercase tracking-widest hover:bg-white hover:scale-105 transition-all shadow-[0_0_20px_rgba(254,154,0,0.4)] cursor-pointer\"\r\n              >\r\n                <User className=\"w-6 h-6\" /> Log In / Sign Up\r\n              </button>\r\n            ) : (\r\n              <>\r\n                <button\r\n                  onClick={handleLogout}\r\n                  className=\"flex items-center gap-4 bg-zinc-900 text-white border border-zinc-700 px-6 py-4 rounded-2xl font-black uppercase tracking-widest hover:bg-red-600 hover:border-red-600 hover:scale-105 transition-all shadow-lg cursor-pointer\"\r\n                >\r\n                  <LogOut className=\"w-6 h-6\" /> Log Out\r\n                </button>\r\n                {userTier === 'free' && (\r\n                  <button\r\n                    onClick={() => {\r\n                      onClose();\r\n                      onNavigate({ action: 'sub' });\r\n                    }}\r\n                    className=\"flex items-center gap-4 bg-gradient-to-r from-[#fe9a00] to-yellow-500 text-black px-6 py-4 rounded-2xl font-black uppercase tracking-widest hover:from-white hover:to-white hover:scale-105 transition-all shadow-[0_0_20px_rgba(254,154,0,0.4)] cursor-pointer\"\r\n                  >\r\n                    <Crown className=\"w-6 h-6\" /> Upgrade to Pro\r\n                  </button>\r\n                )}\r\n              </>\r\n            )}\r\n\r\n            <button\r\n              onClick={() => {\r\n                onClose();\r\n                if (onShareClick) onShareClick();\r\n              }}\r\n              className=\"flex items-center justify-center p-4 bg-zinc-900 border border-zinc-700 rounded-2xl hover:bg-[#fe9a00] hover:border-[#fe9a00] transition-all shadow-lg group cursor-pointer\"\r\n              title=\"Share App\"\r\n            >\r\n              <Share2 className=\"w-6 h-6 text-zinc-400 group-hover:text-black transition-colors\" />\r\n            </button>\r\n\r\n            <button\r\n              onClick={() => setShowHelpModal(true)}\r\n              className=\"flex items-center justify-center p-4 bg-zinc-900 border border-zinc-700 rounded-2xl hover:bg-[#fe9a00] hover:border-[#fe9a00] transition-all shadow-lg group cursor-pointer\"\r\n              title=\"Feature Guide\"\r\n            >\r\n              <HelpCircle className=\"w-6 h-6 text-zinc-400 group-hover:text-black transition-colors\" />\r\n            </button>\r\n          </div>\r\n\r\n          {canInstall && (\r\n            <button\r\n              onClick={() => {\r\n                onClose();\r\n                onInstall();\r\n              }}\r\n              className=\"flex items-center gap-4 bg-white text-black px-6 py-4 rounded-2xl font-black uppercase tracking-widest hover:bg-[#fe9a00] hover:scale-105 transition-all mb-8 shadow-[0_0_20px_rgba(255,255,255,0.2)] w-max cursor-pointer\"\r\n            >\r\n              <Download className=\"w-6 h-6\" /> Install App\r\n            </button>\r\n          )}\r\n\r\n          <div className=\"flex flex-wrap items-center gap-4 mb-8\">\r\n            {/* HYPE CARD: UNLOCKED FOR ALL FREE & PLUS ACCOUNT HOLDERS */}\r\n            {isRegisteredUser && (\r\n              <button\r\n                onClick={() => {\r\n                  onClose();\r\n                  if (onOpenFlexCard) onOpenFlexCard();\r\n                }}\r\n                className=\"flex items-center gap-4 bg-[#fe9a00] text-black px-6 py-4 rounded-2xl font-black uppercase tracking-widest hover:bg-white hover:scale-105 transition-all shadow-[0_0_20px_rgba(254,154,0,0.4)] w-max cursor-pointer\"\r\n              >\r\n                <CreditCard className=\"w-6 h-6\" /> Flex Hype Card\r\n              </button>\r\n            )}\r\n\r\n            {hasCreatorStudioAccess && (\r\n              <button\r\n                onClick={() => {\r\n                  onClose();\r\n                  onNavigate({ action: 'creator-studio' });\r\n                }}\r\n                onMouseEnter={() => import('../MainViews/CreatorStudio').then(mod => mod.CreatorStudio)}\r\n                className=\"flex items-center gap-3 bg-zinc-900 border-2 border-[#fe9a00] text-[#fe9a00] px-6 py-4 rounded-2xl font-black uppercase tracking-widest hover:bg-[#fe9a00] hover:text-black hover:scale-105 transition-all shadow-[0_0_25px_rgba(254,154,0,0.25)] w-max cursor-pointer\"\r\n              >\r\n                <Sparkles className=\"w-6 h-6\" /> Creator Studio\r\n              </button>\r\n            )}\r\n          </div>\r\n\r\n          <div className=\"flex flex-col gap-5 flex-1\">\r\n            {visibleItems.map(item => (\r\n              <button\r\n                key={item.action}\r\n                onClick={() => {\r\n                  onNavigate({ action: item.action });\r\n                  onClose();\r\n                }}\r\n                onMouseEnter={item.prefetch ? () => item.prefetch!() : undefined}\r\n                className=\"text-3xl sm:text-4xl font-black uppercase italic tracking-tighter text-white hover:text-[#fe9a00] text-left transition-colors py-1 cursor-pointer\"\r\n              >\r\n                {item.name}\r\n              </button>\r\n            ))}\r\n\r\n            <button\r\n              onClick={() => setShowMore(!showMore)}\r\n              className=\"flex items-center gap-2 text-xl sm:text-2xl font-black uppercase italic tracking-tighter text-zinc-500 hover:text-white text-left transition-colors py-1 mt-2 cursor-pointer\"\r\n            >\r\n              {showMore ? (\r\n                <>\r\n                  <ChevronUp className=\"w-6 h-6\" /> Show Less\r\n                </>\r\n              ) : (\r\n                <>\r\n                  <ChevronDown className=\"w-6 h-6\" /> See More\r\n                </>\r\n              )}\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"p-6 sm:px-12 border-t border-zinc-900 shrink-0 bg-black\">\r\n          <a\r\n            href=\"https://www.saturday-am.com/\"\r\n            target=\"_blank\"\r\n            rel=\"noopener noreferrer\"\r\n            className=\"flex items-center gap-4 text-2xl sm:text-3xl font-black uppercase italic tracking-tighter text-zinc-500 hover:text-white text-left transition-colors cursor-pointer\"\r\n          >\r\n            Official Website <ExternalLink className=\"w-5 h-5 sm:w-6 sm:h-6\" />\r\n          </a>\r\n          {currentUser?.is_admin && (\r\n            <button\r\n              onClick={() => {\r\n                onNavigate({ action: 'admin' });\r\n                onClose();\r\n              }}\r\n              className=\"flex items-center gap-4 text-2xl sm:text-3xl font-black uppercase italic tracking-tighter text-red-600 hover:text-red-400 text-left transition-colors mt-6 cursor-pointer\"\r\n            >\r\n              Command Center <ShieldAlert className=\"w-5 h-5 sm:w-6 sm:h-6\" />\r\n            </button>\r\n          )}\r\n        </div>\r\n\r\n        {showHelpModal && (\r\n          <div\r\n            className=\"fixed inset-0 z-[6000] bg-black/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 animate-fade-in\"\r\n            onClick={() => setShowHelpModal(false)}\r\n          >\r\n            <div\r\n              className=\"bg-zinc-950 border border-zinc-800 rounded-2xl w-full max-w-lg shadow-2xl relative flex flex-col max-h-[90vh]\"\r\n              onClick={e => e.stopPropagation()}\r\n            >\r\n              <div className=\"flex justify-between items-center p-6 border-b border-zinc-800 bg-zinc-900 rounded-t-2xl\">\r\n                <h2 className=\"text-xl font-black italic uppercase tracking-wider text-[#fe9a00]\">\r\n                  Feature Guide\r\n                </h2>\r\n                <button\r\n                  onClick={() => setShowHelpModal(false)}\r\n                  className=\"text-zinc-500 hover:text-white transition-colors cursor-pointer\"\r\n                >\r\n                  <X className=\"w-6 h-6\" />\r\n                </button>\r\n              </div>\r\n              <div className=\"p-6 overflow-y-auto no-scrollbar space-y-4 bg-black rounded-b-2xl text-xs text-zinc-400\">\r\n                <p>\r\n                  Explore titles in the Vault, collect creator signatures in your Bingo Book, and\r\n                  support creators with hypes.\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        )}\r\n      </div>\r\n    );\r\n  }\r\n);",
    "src/App.tsx": "import React, { useState, useEffect, useCallback, Suspense, lazy, useRef } from 'react';\r\nimport { ArrowUp, X, Lock, Share, Menu, Download, Info, CheckCircle2, AlertTriangle, ShieldAlert } from 'lucide-react'; \r\nimport { supabase } from './supabase';\r\nimport { Dropzone, ThumbnailCropperModal } from './Components/UploadTools';\r\n\r\n// --- IMPORT OUR COMPONENTS ---\r\nimport { FloatingPillNav } from './Components/FloatingPillNav';\r\nimport { HamburgerMenu } from './Components/HamburgerMenu';\r\nimport { ShareModal } from './Components/ShareModal';\r\nimport { SplashIntro } from './Components/SplashIntro'; \r\nimport { GlobalHypeTracker } from './Components/GlobalHypeTracker';\r\nimport { HypeEconomyProvider } from './HypeEconomyContext';\r\nimport { useIntegrations } from \"./Components/useIntegrations\";\r\n\r\n// 1. Keep core UI and Modals loaded instantly\r\nimport LoginModal from './Auth/LoginModal.tsx';\r\nimport { GlobalFlexCard } from './Components/GlobalFlexCard';\r\nimport { CreatorOnboardingModal, hasAcceptedCreatorTerms } from './Components/CreatorOnboardingModal';\r\n\r\nconst resolveLazyModule = (mod: any, preferredName?: string) => {\r\n  if (!mod) return { default: () => null };\r\n  if (preferredName && typeof mod[preferredName] === 'function') return { default: mod[preferredName] };\r\n  if (typeof mod.default === 'function') return { default: mod.default };\r\n  if (typeof mod.Subscription === 'function') return { default: mod.Subscription };\r\n  if (typeof mod.SubscriptionPage === 'function') return { default: mod.SubscriptionPage };\r\n  const firstExport = Object.values(mod).find(v => typeof v === 'function');\r\n  return { default: (firstExport as React.ComponentType<any>) || (() => null) };\r\n};\r\n\r\n// 2. Lazy Load the views safely\r\nconst HomePage = lazy<React.ComponentType<any>>(() => import('./MainViews/HomePage').then(mod => resolveLazyModule(mod, 'HomePage')));\r\nconst SeriesDetailPage = lazy<React.ComponentType<any>>(() => import('./MainViews/SeriesDetailPage').then(mod => resolveLazyModule(mod, 'SeriesDetailPage')));\r\nconst AdminDashboard = lazy<React.ComponentType<any>>(() => import('./AmCommandCenter/AdminDashboard').then(mod => resolveLazyModule(mod, 'AdminDashboard')));\r\nconst UserProfile = lazy<React.ComponentType<any>>(() => import('./VirtualProfile/UserProfile').then(mod => resolveLazyModule(mod, 'UserProfile')));\r\nconst SubscriptionPage = lazy<React.ComponentType<any>>(() => import('./MainViews/Subscription.tsx').then(mod => resolveLazyModule(mod)));\r\nconst AMNewsPage = lazy<React.ComponentType<any>>(() => import('./MainViews/AMNewsPage').then(mod => resolveLazyModule(mod, 'AMNewsPage')));\r\nconst Shop = lazy<React.ComponentType<any>>(() => import('./MainViews/Shop').then(mod => resolveLazyModule(mod, 'Shop'))); \r\nconst LegalPages = lazy<React.ComponentType<any>>(() => import('./MainViews/LegalPages').then(mod => resolveLazyModule(mod, 'LegalPages'))); \r\nconst CharacterRoster = lazy<React.ComponentType<any>>(() => import('./MainViews/CharacterRoster').then(mod => resolveLazyModule(mod, 'CharacterRoster')));\r\nconst CreatorsPage = lazy<React.ComponentType<any>>(() => import('./MainViews/CreatorsPage').then(mod => resolveLazyModule(mod, 'CreatorsPage')));\r\nconst CreatorStudio = lazy<React.ComponentType<any>>(() => import('./MainViews/CreatorStudio').then(mod => resolveLazyModule(mod, 'CreatorStudio')));\r\n\r\n// 3. Lazy Load the views that use Default Exports\r\nconst SettingsPage = lazy<React.ComponentType<any>>(() => import('./MainViews/Settings.tsx').then(mod => resolveLazyModule(mod)));\r\nconst BingoBook = lazy<React.ComponentType<any>>(() => import('./VirtualProfile/BingoBook').then(mod => resolveLazyModule(mod)));\r\nconst Favorites = lazy<React.ComponentType<any>>(() => import('./MainViews/MyFaves.tsx').then(mod => resolveLazyModule(mod)));\r\nconst Browse = lazy<React.ComponentType<any>>(() => import('./MainViews/Browse.tsx').then(mod => resolveLazyModule(mod)));\r\nconst Leaderboard = lazy<React.ComponentType<any>>(() => import('./MainViews/Leaderboard.tsx').then(mod => resolveLazyModule(mod)));\r\n\r\n// Authorized Saturday AM Admin Emails\r\nexport const ADMIN_EMAILS = [\r\n  'odunze.oguguo@yahoo.com',\r\n  'saturday.editorial@gmail.com',\r\n  'demetrene.billups@gmail.com',\r\n  'publisher@saturday-am.com',\r\n  'rayme3000@gmail.com'\r\n];\r\n\r\nexport const checkIsAdminUser = (userOrProfile: any, sessionEmail?: string): boolean => {\r\n  if (!userOrProfile && !sessionEmail) return false;\r\n  if (userOrProfile?.is_admin === true) return true;\r\n  const email = String(userOrProfile?.email || sessionEmail || '').trim().toLowerCase();\r\n  return ADMIN_EMAILS.includes(email);\r\n};\r\n\r\nexport const getOrCreateVisitorId = (): string => {\r\n  try {\r\n    let vid = localStorage.getItem('am_visitor_id');\r\n    if (!vid) {\r\n      vid =\r\n        typeof crypto !== 'undefined' && crypto.randomUUID\r\n          ? `vis_${crypto.randomUUID()}`\r\n          : `vis_${Date.now()}_${Math.random().toString(36).substring(2, 10)}`;\r\n      localStorage.setItem('am_visitor_id', vid);\r\n    }\r\n    return vid;\r\n  } catch {\r\n    return `vis_anon_${Date.now()}`;\r\n  }\r\n};\r\n\r\nclass AppErrorBoundary extends React.Component<any, any> {\r\n  constructor(props: any) {\r\n    super(props);\r\n    this.state = { hasError: false, error: null };\r\n  }\r\n  static getDerivedStateFromError(error: any) {\r\n    try {\r\n      sessionStorage.setItem('currentView', 'home');\r\n      sessionStorage.removeItem('selectedSeries');\r\n    } catch {\r\n      // Ignore storage errors\r\n    }\r\n    return { hasError: true, error };\r\n  }\r\n  render() {\r\n    if (this.state.hasError) {\r\n      return (\r\n        <div className=\"min-h-screen bg-black text-white flex flex-col items-center justify-center p-6 text-center z-[9999] relative\">\r\n          <h2 className=\"text-[#fe9a00] font-black text-3xl italic uppercase tracking-tighter mb-4\">\r\n            System Glitch\r\n          </h2>\r\n          <p className=\"text-zinc-400 font-bold mb-8 max-w-md\">\r\n            {this.state.error?.message || 'An unexpected error occurred.'}\r\n          </p>\r\n          <button\r\n            onClick={() => {\r\n              try {\r\n                sessionStorage.clear();\r\n              } catch {\r\n                // Ignore\r\n              }\r\n              window.location.replace('/');\r\n            }}\r\n            className=\"bg-[#fe9a00] text-black px-8 py-3 rounded-full font-black uppercase tracking-widest hover:bg-white transition-colors cursor-pointer\"\r\n          >\r\n            Return to Home Page\r\n          </button>\r\n        </div>\r\n      );\r\n    }\r\n    return this.props.children;\r\n  }\r\n}\r\n\r\nconst ScrollToTopButton = () => {\r\n  const [isVisible, setIsVisible] = useState(false);\r\n\r\n  useEffect(() => {\r\n    const toggleVisibility = () => {\r\n      if (window.scrollY > 300) { setIsVisible(true); } \r\n      else { setIsVisible(false); }\r\n    };\r\n\r\n    window.addEventListener('scroll', toggleVisibility);\r\n    return () => window.removeEventListener('scroll', toggleVisibility);\r\n  }, []);\r\n\r\n  const scrollToTop = () => { window.scrollTo({ top: 0, behavior: 'smooth' }); };\r\n\r\n  if (!isVisible) return null;\r\n\r\n  return (\r\n    <button \r\n      onClick={scrollToTop} \r\n      className=\"fixed right-6 z-50 p-3 bg-[#fe9a00] text-black rounded-full shadow-[0_0_15px_rgba(254,154,0,0.4)] hover:bg-white hover:scale-110 transition-all duration-300 group pb-[max(0.75rem,env(safe-area-inset-bottom))] bottom-[calc(6rem+env(safe-area-inset-bottom))] cursor-pointer\" \r\n      aria-label=\"Back to top\"\r\n    >\r\n      <ArrowUp className=\"w-6 h-6 group-hover:-translate-y-1 transition-transform\" />\r\n    </button>\r\n  );\r\n};\r\n\r\nexport default function App() {\r\n  useIntegrations();\r\n\r\n  useEffect(() => {\r\n    if (!('serviceWorker' in navigator)) return;\r\n\r\n    const checkForUpdates = async () => {\r\n      try {\r\n        const registrations = await navigator.serviceWorker.getRegistrations();\r\n        for (const reg of registrations) {\r\n          await reg.update();\r\n          if (reg.waiting) {\r\n            reg.waiting.postMessage({ type: 'SKIP_WAITING' });\r\n          }\r\n        }\r\n      } catch {\r\n        // Ignore SW update check errors\r\n      }\r\n    };\r\n\r\n    checkForUpdates();\r\n\r\n    let refreshing = false;\r\n    const handleControllerChange = () => {\r\n      if (refreshing) return;\r\n      refreshing = true;\r\n      window.location.reload();\r\n    };\r\n\r\n    navigator.serviceWorker.addEventListener('controllerchange', handleControllerChange);\r\n    const handleFocus = () => {\r\n      if (document.visibilityState === 'visible') checkForUpdates();\r\n    };\r\n    document.addEventListener('visibilitychange', handleFocus);\r\n\r\n    return () => {\r\n      navigator.serviceWorker.removeEventListener('controllerchange', handleControllerChange);\r\n      document.removeEventListener('visibilitychange', handleFocus);\r\n    };\r\n  }, []);\r\n\r\n  const [currentView, setCurrentView] = useState(() => {\r\n    const params = new URLSearchParams(window.location.search);\r\n    const urlView = params.get('view');\r\n    if (urlView) return urlView.toLowerCase();\r\n    const saved = sessionStorage.getItem('currentView');\r\n    if (saved === 'sub' && !urlView) return 'home';\r\n    return saved || 'home';\r\n  });\r\n\r\n  const [selectedSeries, setSelectedSeries] = useState(() => {\r\n    const saved = sessionStorage.getItem('selectedSeries');\r\n    return saved ? JSON.parse(saved) : null;\r\n  });\r\n\r\n  const [showIntro, setShowIntro] = useState(() => {\r\n    const params = new URLSearchParams(window.location.search);\r\n    if (\r\n      params.has('series') ||\r\n      params.has('creator') ||\r\n      window.location.pathname.startsWith('/series/') ||\r\n      /bot|googlebot|crawler|spider|robot|crawling/i.test(navigator.userAgent)\r\n    ) {\r\n      return false;\r\n    }\r\n    return !localStorage.getItem('am_has_seen_intro');\r\n  });\r\n\r\n  const [showLogin, setShowLogin] = useState(false);\r\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\r\n  const [isFlexCardOpen, setIsFlexCardOpen] = useState(false);\r\n  const [upsellConfig, setUpsellConfig] = useState<{ title: string; message: string; target?: 'signup' | 'sub'; buttonText?: string } | null>(null);\r\n  const [showGlobalShareModal, setShowGlobalShareModal] = useState(false);\r\n\r\n  const [pendingCreatorInvite, setPendingCreatorInvite] = useState<string | null>(() => {\r\n    return localStorage.getItem('am_pending_creator_invite') || null;\r\n  });\r\n\r\n  const [stripeConnectNotice, setStripeConnectNotice] = useState<{\r\n    status: 'success' | 'error';\r\n    accountId?: string;\r\n    message?: string;\r\n  } | null>(null);\r\n\r\n  const [showPasswordReset, setShowPasswordReset] = useState(false);\r\n  const [newPassword, setNewPassword] = useState('');\r\n\r\n  const [currentUser, setCurrentUser] = useState<any>(null);\r\n  const [userTier, setUserTier] = useState<'visitor' | 'free' | 'premium'>('visitor');\r\n  const [authResolved, setAuthResolved] = useState(false);\r\n\r\n  const [deferredPrompt, setDeferredPrompt] = useState<any>(() => (window as any).deferredPrompt || null);\r\n  const [isAppInstalled, setIsAppInstalled] = useState<boolean>(() => {\r\n    return (\r\n      localStorage.getItem('am_pwa_installed') === 'true' ||\r\n      window.matchMedia('(display-mode: standalone)').matches ||\r\n      ('standalone' in navigator && Boolean((navigator as any).standalone)) ||\r\n      document.referrer.includes('android-app://')\r\n    );\r\n  });\r\n  const [showInstallPrompt, setShowInstallPrompt] = useState(false);\r\n  const [showIosPrompt, setShowIosPrompt] = useState(false); \r\n  const [isIOSDevice, setIsIOSDevice] = useState(false);\r\n  const [desktopShowHelp, setDesktopShowHelp] = useState(false);\r\n\r\n  const isPopState = useRef(false);\r\n  const isFetchingProfile = useRef(false);\r\n  const presenceChannelRef = useRef<any>(null);\r\n\r\n  const isUserAdmin = checkIsAdminUser(currentUser);\r\n\r\n  // --- DYNAMIC SEO ENGINE ---\r\n  useEffect(() => {\r\n    const setMetaContent = (selector: string, content: string) => {\r\n      const el = document.querySelector(selector);\r\n      if (el) el.setAttribute('content', content);\r\n    };\r\n\r\n    const setCanonicalHref = (href: string) => {\r\n      let link = document.querySelector('link[rel=\"canonical\"]') as HTMLLinkElement | null;\r\n      if (!link) {\r\n        link = document.createElement('link');\r\n        link.rel = 'canonical';\r\n        document.head.appendChild(link);\r\n      }\r\n      link.href = href;\r\n    };\r\n\r\n    const setDynamicJsonLd = (schemaObj: Record<string, any> | null) => {\r\n      let scriptEl = document.getElementById('dynamic-seo-jsonld') as HTMLScriptElement | null;\r\n      if (!schemaObj) {\r\n        if (scriptEl) scriptEl.remove();\r\n        return;\r\n      }\r\n      if (!scriptEl) {\r\n        scriptEl = document.createElement('script');\r\n        scriptEl.id = 'dynamic-seo-jsonld';\r\n        scriptEl.type = 'application/ld+json';\r\n        document.head.appendChild(scriptEl);\r\n      }\r\n      scriptEl.textContent = JSON.stringify(schemaObj);\r\n    };\r\n\r\n    if (currentView === 'series' && selectedSeries?.slug) {\r\n      const sTitle = selectedSeries.title || selectedSeries.slug;\r\n      const sCreator = selectedSeries.creator_name || 'Saturday AM';\r\n      const sGenre = selectedSeries.genre || 'Shonen Manga';\r\n      const sSynopsis =\r\n        selectedSeries.synopsis ||\r\n        selectedSeries.description ||\r\n        `Read ${sTitle} by ${sCreator} online on Saturday AM Manga Hype. Discover original diverse ${sGenre} manga chapters, characters, and creator updates.`;\r\n      const sImage =\r\n        selectedSeries.cover_url ||\r\n        selectedSeries.character_url ||\r\n        'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20load%20screen.jpg';\r\n      const canonicalUrl = `https://www.mangahype.com/?series=${encodeURIComponent(selectedSeries.slug)}`;\r\n\r\n      const fullTitle = `${sTitle} Manga by ${sCreator} | Read Online on Saturday AM`;\r\n      document.title = fullTitle;\r\n      setMetaContent('meta[name=\"description\"]', sSynopsis.slice(0, 160));\r\n      setMetaContent('meta[property=\"og:title\"]', fullTitle);\r\n      setMetaContent('meta[property=\"og:description\"]', sSynopsis.slice(0, 200));\r\n      setMetaContent('meta[property=\"og:image\"]', sImage);\r\n      setMetaContent('meta[property=\"og:url\"]', canonicalUrl);\r\n      setMetaContent('meta[name=\"twitter:image\"]', sImage);\r\n      setCanonicalHref(canonicalUrl);\r\n\r\n      setDynamicJsonLd({\r\n        '@context': 'https://schema.org',\r\n        '@type': 'ComicSeries',\r\n        name: sTitle,\r\n        url: canonicalUrl,\r\n        image: sImage,\r\n        genre: sGenre,\r\n        description: sSynopsis,\r\n        publisher: {\r\n          '@type': 'Organization',\r\n          name: 'Saturday AM'\r\n        },\r\n        author: {\r\n          '@type': 'Person',\r\n          name: sCreator\r\n        }\r\n      });\r\n      return;\r\n    }\r\n\r\n    const viewMetaMap: Record<string, { title: string; desc: string; query: string }> = {\r\n      creators: {\r\n        title: 'Manga Creators Roster | Saturday AM Manga Hype',\r\n        desc: 'Meet the global manga creators behind Apple Black, Clock Striker, Bully Eater, Hammer, Orisha, Oblivion Rouge, and more on Saturday AM.',\r\n        query: '?view=creators'\r\n      },\r\n      browse: {\r\n        title: 'Browse Diverse Manga Series & One-Shots | Saturday AM',\r\n        desc: 'Browse th