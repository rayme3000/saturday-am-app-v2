    "src/MainViews/Shop.tsx": "import { useState, useEffect } from 'react';\r\nimport { ArrowLeft, ShoppingBag, ExternalLink, PackageX, Sparkles } from 'lucide-react';\r\nimport { supabase, trackTelemetry } from '../supabase';\r\nimport { InAppStoreSection } from './InAppStoreSection';\r\n\r\nconst HYPE_FLAME_URL = \"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/other%20icons/Hype%20flame.png\";\r\nconst DEFAULT_SHOPIFY_DOMAIN = \"shopsaturdayam.com\";\r\n\r\nexport const Shop = ({ onBack, onLoginClick, onNavigate }: any) => {\r\n  const [products, setProducts] = useState<any[]>([]);\r\n  const [loading, setLoading] = useState(true);\r\n  const [shopDomain, setShopDomain] = useState<string>(DEFAULT_SHOPIFY_DOMAIN);\r\n\r\n  useEffect(() => {\r\n    window.scrollTo(0, 0);\r\n    trackTelemetry('shop_visit', {});\r\n\r\n    const initShop = async () => {\r\n      try {\r\n        const { data } = await supabase\r\n          .from('app_settings')\r\n          .select('shopify_domain')\r\n          .eq('id', 1)\r\n          .maybeSingle();\r\n\r\n        const rawDomain = data?.shopify_domain || DEFAULT_SHOPIFY_DOMAIN;\r\n        const cleanDomain = rawDomain.replace(/^https?:\\/\\//, '').replace(/\\/+$/, '');\r\n        setShopDomain(cleanDomain);\r\n\r\n        const res = await fetch(`https://${cleanDomain}/products.json?limit=24`);\r\n        if (!res.ok) throw new Error('Failed to fetch store feed');\r\n\r\n        const storeData = await res.json();\r\n        setProducts(Array.isArray(storeData?.products) ? storeData.products : []);\r\n      } catch (err) {\r\n        console.error(\"Error fetching shop products:\", err);\r\n      } finally {\r\n        setLoading(false);\r\n      }\r\n    };\r\n\r\n    initShop();\r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-transparent text-white relative pb-48 sm:pb-52 font-sans\">\r\n      {/* HEADER */}\r\n      <div className=\"sticky top-0 z-40 bg-black/90 backdrop-blur-xl px-4 sm:px-6 pt-6 pb-4 border-b border-zinc-800 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 shadow-xl\">\r\n        <div>\r\n          <button\r\n            onClick={onBack}\r\n            className=\"mb-4 flex items-center gap-2 text-zinc-400 hover:text-white transition-colors cursor-pointer\"\r\n          >\r\n            <ArrowLeft className=\"w-5 h-5\" />\r\n            <span className=\"text-[10px] font-black uppercase tracking-widest\">Back</span>\r\n          </button>\r\n          <h1 className=\"text-3xl font-black italic uppercase tracking-tighter text-[#fe9a00] drop-shadow-md flex items-center gap-3\">\r\n            <ShoppingBag className=\"w-8 h-8 text-[#fe9a00]\" />\r\n            AM Shop & Digital Store\r\n          </h1>\r\n        </div>\r\n\r\n        {shopDomain && (\r\n          <a\r\n            href={`https://${shopDomain}?utm_source=saturday_am_app&utm_medium=in_app_shop`}\r\n            target=\"_blank\"\r\n            rel=\"noopener noreferrer\"\r\n            className=\"text-[10px] text-white hover:text-[#fe9a00] font-black uppercase tracking-widest flex items-center justify-center gap-2 transition-colors bg-zinc-900 border border-zinc-700 px-5 py-3 rounded-full hover:border-[#fe9a00] shadow-lg mb-1 w-full sm:w-auto\"\r\n          >\r\n            View Physical Merch Store <ExternalLink className=\"w-4 h-4\" />\r\n          </a>\r\n        )}\r\n      </div>\r\n\r\n      <div className=\"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-8\">\r\n        {/* ===================================================================\r\n            STANDALONE IN-APP DIGITAL STORE (BOOSTERS, CARD SKINS & BUNDLES)\r\n        =================================================================== */}\r\n        <InAppStoreSection onLoginClick={onLoginClick} onNavigate={onNavigate} />\r\n\r\n        {/* ===================================================================\r\n            PHYSICAL MERCHANDISE FEED (SATURDAY AM SHOPIFY)\r\n        =================================================================== */}\r\n        <div className=\"border-t border-zinc-800 pt-10 mt-6\">\r\n          <div className=\"flex items-center justify-between mb-6\">\r\n            <div>\r\n              <span className=\"inline-flex items-center gap-1.5 text-[9px] font-black uppercase tracking-widest text-[#fe9a00] mb-1\">\r\n                <Sparkles className=\"w-3.5 h-3.5\" /> Official Physical Books & Apparel\r\n              </span>\r\n              <h2 className=\"text-2xl font-black italic uppercase tracking-tight text-white\">\r\n                Saturday AM <span className=\"text-[#fe9a00]\">Merchandise</span>\r\n              </h2>\r\n            </div>\r\n          </div>\r\n\r\n          {loading ? (\r\n            <div className=\"flex flex-col items-center justify-center py-28 sm:py-36 gap-5 bg-zinc-950/80 rounded-3xl border border-zinc-800\">\r\n              <div className=\"relative flex items-center justify-center animate-hype-glow\">\r\n                <img\r\n                  src={HYPE_FLAME_URL}\r\n                  alt=\"Saturday AM Loading\"\r\n                  className=\"w-24 h-24 sm:w-28 sm:h-28 object-contain\"\r\n                  style={{ filter: 'url(#hype-flame-color)' }}\r\n                />\r\n              </div>\r\n              <span className=\"text-zinc-500 font-black tracking-widest text-xs uppercase animate-pulse\">\r\n                Loading Inventory...\r\n              </span>\r\n            </div>\r\n          ) : products.length === 0 ? (\r\n            <div className=\"flex flex-col items-center justify-center py-28 gap-6 bg-zinc-950/80 rounded-3xl border border-zinc-800 text-center px-4\">\r\n              <div className=\"w-20 h-20 bg-zinc-900 rounded-full flex items-center justify-center border-2 border-zinc-800 shadow-[0_0_30px_rgba(254,154,0,0.1)]\">\r\n                <PackageX className=\"w-10 h-10 text-zinc-600\" />\r\n              </div>\r\n              <div>\r\n                <h2 className=\"text-2xl font-black italic uppercase tracking-tighter text-white mb-2\">\r\n                  Visit Official Store\r\n                </h2>\r\n                <p className=\"text-zinc-400 text-xs font-bold tracking-widest uppercase max-w-sm mx-auto mb-6\">\r\n                  Browse official Saturday AM graphic novels, apparel, and collectibles directly on our store!\r\n                </p>\r\n                <a\r\n                  href={`https://${shopDomain}?utm_source=saturday_am_app&utm_medium=in_app_shop`}\r\n                  target=\"_blank\"\r\n                  rel=\"noopener noreferrer\"\r\n                  className=\"inline-flex items-center gap-2 bg-[#fe9a00] hover:bg-white text-black font-black uppercase tracking-widest text-xs px-8 py-4 rounded-full transition-colors shadow-[0_0_20px_rgba(254,154,0,0.3)]\"\r\n                >\r\n                  Open Saturday AM Shop <ExternalLink className=\"w-4 h-4\" />\r\n                </a>\r\n              </div>\r\n            </div>\r\n          ) : (\r\n            <div className=\"grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6\">\r\n              {products.map(product => {\r\n                const imageUrl =\r\n                  product.images?.[0]?.src ||\r\n                  'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/assets/placeholder-thumb.jpg';\r\n                const price = product.variants?.[0]?.price || '0.00';\r\n                const category = product.product_type || 'Merch';\r\n\r\n                return (\r\n                  <a\r\n                    key={product.id}\r\n                    href={`https://${shopDomain}/products/${product.handle}?utm_source=saturday_am_app&utm_medium=in_app_shop`}\r\n                    target=\"_blank\"\r\n                    rel=\"noopener noreferrer\"\r\n                    className=\"bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden group cursor-pointer hover:border-[#fe9a00] transition-all shadow-lg flex flex-col\"\r\n                  >\r\n                    <div className=\"aspect-square bg-white relative p-4 flex items-center justify-center overflow-hidden\">\r\n                      <img\r\n                        src={imageUrl}\r\n                        alt={product.title}\r\n                        loading=\"lazy\"\r\n                        decoding=\"async\"\r\n                        className=\"w-full h-full object-contain transform group-hover:scale-110 transition-transform duration-500 drop-shadow-xl\"\r\n                      />\r\n                      <div className=\"absolute inset-0 bg-black/55 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center\">\r\n                        <span className=\"bg-[#fe9a00] text-black font-black uppercase tracking-widest text-[10px] px-6 py-3 rounded-full shadow-xl flex items-center gap-2\">\r\n                          Buy Now <ExternalLink className=\"w-3 h-3\" />\r\n                        </span>\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"p-4 flex flex-col flex-1 bg-zinc-950\">\r\n                      <p className=\"text-[9px] font-black uppercase tracking-widest text-zinc-500 mb-1\">\r\n                        {category}\r\n                      </p>\r\n                      <h3 className=\"text-sm font-bold text-white mb-4 leading-snug line-clamp-2 group-hover:text-[#fe9a00] transition-colors\">\r\n                        {product.title}\r\n                      </h3>\r\n                      <div className=\"mt-auto flex items-center justify-between border-t border-zinc-800 pt-3\">\r\n                        <span className=\"text-lg font-black italic text-[#fe9a00]\">${price}</span>\r\n                      </div>\r\n                    </div>\r\n                  </a>\r\n                );\r\n              })}\r\n            </div>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Shop;",
    "src/VirtualProfile/BingoBook.tsx": "import React, { useState, useEffect, useMemo, useCallback } from 'react';\r\nimport {\r\n  ArrowLeft,\r\n  Target,\r\n  Lock,\r\n  X,\r\n  Sparkles,\r\n  KeyRound,\r\n  User,\r\n  BookOpen,\r\n  CheckCircle2,\r\n  RefreshCw\r\n} from 'lucide-react';\r\nimport { useSeriesData } from '../userSeriesData';\r\nimport { supabase } from '../supabase';\r\nimport { FeatureTutorialModal, TutorialHelpButton } from '../Components/FeatureTutorialModal';\r\n\r\nconst CLOUDFLARE_BASE_URL = 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev';\r\n\r\nconst bingoTutorialSlide = [\r\n  {\r\n    id: 'bingo-1',\r\n    title: 'The Bingo Book',\r\n    description:\r\n      'Hunt down Saturday AM creators at live conventions or virtual events to collect their exclusive digital signatures.',\r\n    mediaUrl:\r\n      'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/Tutorial%20Images/S1%20bingo%20book%20page.png'\r\n  },\r\n  {\r\n    id: 'bingo-2',\r\n    title: 'Unlock Autographs',\r\n    description:\r\n      \"Unlock an autograph using a creator's secret 5-digit PIN. Each collected signature earns you a +25 pt boost to your Fandom Score!\",\r\n    mediaUrl:\r\n      'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/Tutorial%20Images/S2%20autographs.png'\r\n  },\r\n  {\r\n    id: 'bingo-3',\r\n    title: 'Premium Display',\r\n    description:\r\n      \"Once unlocked, the creator's signature will be permanently displayed in glowing gold foil on all of their series pages.\",\r\n    mediaUrl:\r\n      'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/Tutorial%20Images/S3%20seriespage.png'\r\n  }\r\n];\r\n\r\nexport const CREATOR_SIGNATURE_ALIAS_GROUPS: string[][] = [\r\n  ['odunze oguguo', 'whyt manga', 'whyt', 'odunze oguguo (whyt manga)'],\r\n  ['jeyodin', 'jey odin'],\r\n  ['raymond brown', 'rayme3000'],\r\n  ['frank simmonds', 'effessart'],\r\n  ['stefano romano', 'dropkickanimation'],\r\n  ['erick pedrucci', 'eric pedrucci', 'erick perducci', 'eric perducci'],\r\n  ['huzayfa umar', 'zayf', 'huzayfa umar (zayf)'],\r\n  ['yvan soudy', 'staark', 'yvan soudy (staark)'],\r\n  ['frederick l. jones', 'frederick jones', 'fred jones'],\r\n  ['oscar fong', 'oscar ed fong'],\r\n  ['jr de bard', 'j.r. de bard', 'jr debard'],\r\n  ['morganne walker'],\r\n  ['tony dawkins'],\r\n  ['pap souleye fall'],\r\n  ['issaka galadima'],\r\n  ['austin harvey-younis', 'austin harvey younis'],\r\n  ['stephanie williams', 'steffany williams']\r\n];\r\n\r\nexport const getCreatorMatchTokens = (rawName?: string): string[] => {\r\n  if (!rawName) return [];\r\n  const clean = String(rawName).trim().toLowerCase().replace(/\\s+/g, ' ');\r\n  if (!clean) return [];\r\n\r\n  const tokens = new Set<string>([clean]);\r\n\r\n  const parenMatch = clean.match(/^(.+?)\\s*\\((.+?)\\)$/);\r\n  if (parenMatch) {\r\n    tokens.add(parenMatch[1].trim());\r\n    tokens.add(parenMatch[2].trim());\r\n  }\r\n\r\n  for (const group of CREATOR_SIGNATURE_ALIAS_GROUPS) {\r\n    if (group.some(alias => tokens.has(alias) || clean.includes(alias) || alias.includes(clean))) {\r\n      group.forEach(alias => tokens.add(alias));\r\n    }\r\n  }\r\n\r\n  return Array.from(tokens).filter(Boolean);\r\n};\r\n\r\nexport const doCreatorNamesMatch = (nameA?: string, nameB?: string): boolean => {\r\n  const tokensA = getCreatorMatchTokens(nameA);\r\n  const tokensB = getCreatorMatchTokens(nameB);\r\n  if (tokensA.length === 0 || tokensB.length === 0) return false;\r\n\r\n  return tokensA.some(a =>\r\n    tokensB.some(\r\n      b => a === b || (a.length >= 4 && b.length >= 4 && (a.includes(b) || b.includes(a)))\r\n    )\r\n  );\r\n};\r\n\r\nexport const BingoBook = ({ onBack, userTier, onNavigate }: any) => {\r\n  const { seriesList = [] } = useSeriesData();\r\n  const [forceTutorial, setForceTutorial] = useState(false);\r\n  const [isRefreshing, setIsRefreshing] = useState(false);\r\n\r\n  const [dbCreatorRows, setDbCreatorRows] = useState<any[]>([]);\r\n  const [masterSignatures, setMasterSignatures] = useState<Record<string, string>>({});\r\n  const [unlockedCreators, setUnlockedCreators] = useState<string[]>([]);\r\n  const [signatures, setSignatures] = useState<Record<string, string>>({});\r\n\r\n  const [selectedTarget, setSelectedTarget] = useState<any | null>(null);\r\n  const [viewingAutograph, setViewingAutograph] = useState<{\r\n    name: string;\r\n    url: string;\r\n    seriesObjs: any[];\r\n  } | null>(null);\r\n\r\n  const [pinInput, setPinInput] = useState('');\r\n  const [isUnlocked, setIsUnlocked] = useState(false);\r\n  const [alertConfig, setAlertConfig] = useState<{ title: string; message: string } | null>(null);\r\n  const [upsellConfig, setUpsellConfig] = useState<{ title: string; message: string } | null>(null);\r\n  const [isProcessing, setIsProcessing] = useState(false);\r\n\r\n  const fetchCreatorsAndMasterSigs = useCallback(async () => {\r\n    setIsRefreshing(true);\r\n    try {\r\n      const [{ data: creatorData }, { data: sigData }] = await Promise.all([\r\n        supabase.from('series_creators').select('*').order('id', { ascending: true }),\r\n        supabase.from('creator_signatures').select('creator_name, signature_url')\r\n      ]);\r\n\r\n      if (creatorData) setDbCreatorRows(creatorData);\r\n\r\n      if (sigData) {\r\n        const sigMap: Record<string, string> = {};\r\n        sigData.forEach((row: any) => {\r\n          if (row.creator_name && row.signature_url) {\r\n            sigMap[row.creator_name.trim()] = row.signature_url;\r\n          }\r\n        });\r\n        setMasterSignatures(sigMap);\r\n      }\r\n    } catch (err) {\r\n      console.error('Failed to load Bingo Book catalog:', err);\r\n    } finally {\r\n      setIsRefreshing(false);\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    fetchCreatorsAndMasterSigs();\r\n    const handleRefresh = () => fetchCreatorsAndMasterSigs();\r\n    window.addEventListener('creatorVisibilityUpdated', handleRefresh);\r\n    window.addEventListener('focus', handleRefresh);\r\n    return () => {\r\n      window.removeEventListener('creatorVisibilityUpdated', handleRefresh);\r\n      window.removeEventListener('focus', handleRefresh);\r\n    };\r\n  }, [fetchCreatorsAndMasterSigs]);\r\n\r\n  const findSignatureUrlForCreator = useCallback(\r\n    (creatorName: string, fallbackMap: Record<string, string> = {}): string => {\r\n      const combined = { ...fallbackMap, ...masterSignatures };\r\n      for (const [sigCreatorName, sigUrl] of Object.entries(combined)) {\r\n        if (sigUrl && doCreatorNamesMatch(creatorName, sigCreatorName)) {\r\n          return sigUrl;\r\n        }\r\n      }\r\n      return '';\r\n    },\r\n    [masterSignatures]\r\n  );\r\n\r\n  const CREATOR_TARGETS = useMemo(() => {\r\n    const uniqueCreatorsMap = new Map<\r\n      string,\r\n      { id: string; name: string; avatar: string; series: string[]; seriesObjs: any[] }\r\n    >();\r\n\r\n    // 1. Build a strict blocklist of any creator marked Hidden (is_visible === false or is_hidden === true) in series_creators\r\n    const hiddenCreatorNames: string[] = [];\r\n    const explicitlyVisibleCreatorNames: string[] = [];\r\n\r\n    dbCreatorRows.forEach((row: any) => {\r\n      const rawName = String(row.name || row.creator_name || '').trim();\r\n      if (!rawName) return;\r\n      const isHiddenRow =\r\n        row.is_visible === false ||\r\n        row.is_hidden === true ||\r\n        String(row.status || '').toLowerCase() === 'hidden';\r\n      if (isHiddenRow) {\r\n        hiddenCreatorNames.push(rawName);\r\n      } else {\r\n        explicitlyVisibleCreatorNames.push(rawName);\r\n      }\r\n    });\r\n\r\n    const isCreatorHidden = (candidateName: string): boolean => {\r\n      if (!candidateName) return true;\r\n      // If a creator has ANY row marked hidden and NO row explicitly marked visible, hide them from Bingo Book\r\n      const matchesHidden = hiddenCreatorNames.some(hName =>\r\n        doCreatorNamesMatch(candidateName, hName)\r\n      );\r\n      if (!matchesHidden) return false;\r\n      const matchesVisible = explicitlyVisibleCreatorNames.some(vName =>\r\n        doCreatorNamesMatch(candidateName, vName)\r\n      );\r\n      return !matchesVisible;\r\n    };\r\n\r\n    const seriesBySlug = new Map<string, any>();\r\n    seriesList.forEach((s: any) => {\r\n      if (s.slug && !s.is_hidden) seriesBySlug.set(s.slug, s);\r\n    });\r\n\r\n    const addOrMergeCreator = (\r\n      rawName: string,\r\n      avatarUrl: string | null,\r\n      matchedSeries: any | null\r\n    ) => {\r\n      if (!rawName) return;\r\n      const cleanName = rawName\r\n        .replace(/^(written by|art by|created by|story by|illustrated by)[:\\s]+/i, '')\r\n        .trim()\r\n        .replace(/\\s+/g, ' ');\r\n      if (cleanName.length < 2) return;\r\n\r\n      // Strictly block hidden creators (e.g. Stephanie Williams, Pap Souleye Fall) from appearing!\r\n      if (isCreatorHidden(cleanName)) return;\r\n\r\n      let matchedKey: string | null = null;\r\n      for (const [k, existing] of uniqueCreatorsMap.entries()) {\r\n        if (doCreatorNamesMatch(cleanName, existing.name)) {\r\n          matchedKey = k;\r\n          break;\r\n        }\r\n      }\r\n\r\n      const key = matchedKey || cleanName.toLowerCase();\r\n      const sTitle = matchedSeries?.title || '';\r\n\r\n      if (!uniqueCreatorsMap.has(key)) {\r\n        uniqueCreatorsMap.set(key, {\r\n          id: cleanName,\r\n          name: cleanName,\r\n          avatar:\r\n            avatarUrl ||\r\n            `https://ui-avatars.com/api/?name=${encodeURIComponent(\r\n              cleanName\r\n            )}&background=18181b&color=fe9a00&bold=true`,\r\n          series: sTitle ? [sTitle] : [],\r\n          seriesObjs: matchedSeries ? [matchedSeries] : []\r\n        });\r\n      } else {\r\n        const existing = uniqueCreatorsMap.get(key)!;\r\n        if (cleanName.includes('(') && !existing.name.includes('(')) {\r\n          existing.name = cleanName;\r\n          existing.id = cleanName;\r\n        }\r\n        if (avatarUrl && existing.avatar.includes('ui-avatars')) {\r\n          existing.avatar = avatarUrl;\r\n        }\r\n        if (sTitle && !existing.series.includes(sTitle)) {\r\n          existing.series.push(sTitle);\r\n        }\r\n        if (matchedSeries && !existing.seriesObjs.some(so => so.slug === matchedSeries.slug)) {\r\n          existing.seriesObjs.push(matchedSeries);\r\n        }\r\n      }\r\n    };\r\n\r\n    // 2. Add visible creators from series_creators table\r\n    dbCreatorRows.forEach((row: any) => {\r\n      const rName = String(row.name || row.creator_name || '').trim();\r\n      if (row.is_visible === false || row.is_hidden === true || !rName) return;\r\n      const matchedSeries = seriesBySlug.get(row.series_slug) || null;\r\n      addOrMergeCreator(\r\n        rName,\r\n        row.avatar_url || matchedSeries?.creator_avatar || null,\r\n        matchedSeries\r\n      );\r\n    });\r\n\r\n    // 3. Merge series titles/links from seriesList (only if the creator is NOT hidden)\r\n    seriesList.forEach((series: any) => {\r\n      if (series.is_hidden) return;\r\n      const rawCreator = series.creator_name || series.creator || '';\r\n      if (!rawCreator) return;\r\n      const parts = String(rawCreator).split(/,|\\s+&\\s+|\\s+and\\s+|\\s*\\/\\s*/i);\r\n      parts.forEach(part => {\r\n        // If dbCreatorRows has already loaded, only allow creators who aren't hidden\r\n        if (isCreatorHidden(part)) return;\r\n        addOrMergeCreator(part, series.creator_avatar || null, series);\r\n      });\r\n    });\r\n\r\n    return Array.from(uniqueCreatorsMap.values()).sort((a, b) => a.name.localeCompare(b.name));\r\n  }, [seriesList, dbCreatorRows]);\r\n\r\n  const isTargetUnlocked = useCallback(\r\n    (targetName: string): boolean => {\r\n      return unlockedCreators.some(huntedName => doCreatorNamesMatch(targetName, huntedName));\r\n    },\r\n    [unlockedCreators]\r\n  );\r\n\r\n  const unlockedTargetsCount = useMemo(() => {\r\n    return CREATOR_TARGETS.filter(t => isTargetUnlocked(t.name)).length;\r\n  }, [CREATOR_TARGETS, isTargetUnlocked]);\r\n\r\n  const progressPercentage =\r\n    CREATOR_TARGETS.length > 0\r\n      ? Math.min(100, (unlockedTargetsCount / CREATOR_TARGETS.length) * 100)\r\n      : 0;\r\n\r\n  useEffect(() => {\r\n    if (CREATOR_TARGETS.length > 0) {\r\n      localStorage.setItem('am_bingo_total', CREATOR_TARGETS.length.toString());\r\n    }\r\n  }, [CREATOR_TARGETS]);\r\n\r\n  useEffect(() => {\r\n    if (userTier === 'visitor') return;\r\n\r\n    const syncUserSignatures = async () => {\r\n      const {\r\n        data: { user }\r\n      } = await supabase.auth.getUser();\r\n\r\n      let knownHunts: string[] = [];\r\n      let knownSigs: Record<string, string> = {};\r\n      try {\r\n        knownHunts = JSON.parse(localStorage.getItem('am_bingo_hunts') || '[]');\r\n        knownSigs = JSON.parse(localStorage.getItem('am_bingo_sigs') || '{}');\r\n      } catch {\r\n        knownHunts = [];\r\n        knownSigs = {};\r\n      }\r\n\r\n      if (user) {\r\n        const [{ data: logs, error }, { data: prof }] = await Promise.all([\r\n          supabase.from('bingo_signatures_log').select('creator_name').eq('user_id', user.id),\r\n          supabase.from('profiles').select('unlocked_autographs').eq('id', user.id).maybeSingle()\r\n        ]);\r\n\r\n        const profAutographs: string[] = Array.isArray(prof?.unlocked_autographs)\r\n          ? prof.unlocked_autographs.map((a: any) => String(a || '').trim()).filter(Boolean)\r\n          : [];\r\n\r\n        if (!error && Array.isArray(logs)) {\r\n          const dbHunts = logs\r\n            .map((log: any) => String(log.creator_name || '').trim())\r\n            .filter(Boolean);\r\n\r\n          const unsavedLocalHunts = knownHunts.filter(\r\n            (localName: string) =>\r\n              localName && !dbHunts.some((dbName: string) => doCreatorNamesMatch(localName, dbName))\r\n          );\r\n\r\n          if (unsavedLocalHunts.length > 0) {\r\n            const backups = unsavedLocalHunts.map((name: string) => ({\r\n              user_id: user.id,\r\n              creator_name: name,\r\n              event_name: 'Local Cache Auto-Sync',\r\n              signature_type: 'Standard'\r\n            }));\r\n            await supabase.from('bingo_signatures_log').insert(backups);\r\n          }\r\n\r\n          knownHunts = Array.from(new Set([...knownHunts, ...dbHunts, ...profAutographs]));\r\n        } else if (profAutographs.length > 0) {\r\n          knownHunts = Array.from(new Set([...knownHunts, ...profAutographs]));\r\n        }\r\n      }\r\n\r\n      const { data: allSigsData } = await supabase\r\n        .from('creator_signatures')\r\n        .select('creator_name, signature_url');\r\n\r\n      const allMasterMap: Record<string, string> = { ...masterSignatures };\r\n      if (Array.isArray(allSigsData)) {\r\n        allSigsData.forEach((row: any) => {\r\n          if (row.creator_name && row.signature_url) {\r\n            allMasterMap[row.creator_name.trim()] = row.signature_url;\r\n          }\r\n        });\r\n      }\r\n\r\n      const resolvedUserSigs: Record<string, string> = { ...knownSigs };\r\n\r\n      knownHunts.forEach((huntedName: string) => {\r\n        for (const [sigCreator, sigUrl] of Object.entries(allMasterMap)) {\r\n          if (sigUrl && doCreatorNamesMatch(huntedName, sigCreator)) {\r\n            resolvedUserSigs[huntedName] = sigUrl;\r\n            resolvedUserSigs[sigCreator] = sigUrl;\r\n          }\r\n        }\r\n      });\r\n\r\n      CREATOR_TARGETS.forEach(target => {\r\n        if (knownHunts.some(h => doCreatorNamesMatch(target.name, h))) {\r\n          if (!knownHunts.includes(target.name)) {\r\n            knownHunts.push(target.name);\r\n          }\r\n          for (const [sigCreator, sigUrl] of Object.entries(allMasterMap)) {\r\n            if (sigUrl && doCreatorNamesMatch(target.name, sigCreator)) {\r\n              resolvedUserSigs[target.name] = sigUrl;\r\n              resolvedUserSigs[target.id] = sigUrl;\r\n            }\r\n          }\r\n        }\r\n      });\r\n\r\n      setUnlockedCreators(knownHunts);\r\n      setSignatures(resolvedUserSigs);\r\n      localStorage.setItem('am_bingo_hunts', JSON.stringify(knownHunts));\r\n      localStorage.setItem('am_bingo_sigs', JSON.stringify(resolvedUserSigs));\r\n    };\r\n\r\n    syncUserSignatures();\r\n  }, [userTier, CREATOR_TARGETS, masterSignatures]);\r\n\r\n  const claimSignature = async (\r\n    creatorName: string,\r\n    creatorId: string,\r\n    codeCreatorName?: string\r\n  ) => {\r\n    const { data: allSigs } = await supabase\r\n      .from('creator_signatures')\r\n      .select('creator_name, signature_url');\r\n\r\n    let matchedSigUrl = '';\r\n    let matchedSigCreatorName = creatorName;\r\n\r\n    if (Array.isArray(allSigs)) {\r\n      const found = allSigs.find(\r\n        (row: any) =>\r\n          row.signature_url &&\r\n          (doCreatorNamesMatch(creatorName, row.creator_name) ||\r\n            (codeCreatorName && doCreatorNamesMatch(codeCreatorName, row.creator_name)))\r\n      );\r\n      if (found) {\r\n        matchedSigUrl = found.signature_url;\r\n        matchedSigCreatorName = found.creator_name;\r\n      }\r\n    }\r\n\r\n    if (!matchedSigUrl) {\r\n      matchedSigUrl = findSignatureUrlForCreator(creatorName, signatures);\r\n    }\r\n\r\n    if (!matchedSigUrl) {\r\n      setAlertConfig({\r\n        title: 'No Signature Found',\r\n        message: `${creatorName} hasn't uploaded their master signature/sketch to the vault yet!`\r\n      });\r\n      return false;\r\n    }\r\n\r\n    const {\r\n      data: { user }\r\n    } = await supabase.auth.getUser();\r\n    const alreadyHadCreator = isTargetUnlocked(creatorName);\r\n\r\n    if (user && !alreadyHadCreator) {\r\n      await supabase.from('bingo_signatures_log').insert([\r\n        {\r\n          user_id: user.id,\r\n          creator_name: creatorName,\r\n          event_name: 'Bingo Code Redemption',\r\n          signature_type: 'Standard'\r\n        }\r\n      ]);\r\n\r\n      const { data: prof } = await supabase\r\n        .from('profiles')\r\n        .select('fandom_score')\r\n        .eq('id', user.id)\r\n        .maybeSingle();\r\n      if (prof) {\r\n        await supabase\r\n          .from('profiles')\r\n          .update({ fandom_score: (Number(prof.fandom_score) || 0) + 25 })\r\n          .eq('id', user.id);\r\n        window.dispatchEvent(new Event('profileUpdated'));\r\n      }\r\n    }\r\n\r\n    const newSigs = {\r\n      ...signatures,\r\n      [creatorId]: matchedSigUrl,\r\n      [creatorName]: matchedSigUrl,\r\n      [matchedSigCreatorName]: matchedSigUrl\r\n    };\r\n    setSignatures(newSigs);\r\n    localStorage.setItem('am_bingo_sigs', JSON.stringify(newSigs));\r\n\r\n    const nextHunts = Array.from(\r\n      new Set([...unlockedCreators, creatorId, creatorName, matchedSigCreatorName])\r\n    );\r\n    setUnlockedCreators(nextHunts);\r\n    localStorage.setItem('am_bingo_hunts', JSON.stringify(nextHunts));\r\n    window.dispatchEvent(new Event('bingoUpdated'));\r\n\r\n    return true;\r\n  };\r\n\r\n  const handlePinSubmit = async (e: React.FormEvent) => {\r\n    e.preventDefault();\r\n    const code = pinInput.trim();\r\n    if (!code || !selectedTarget) return;\r\n    setIsProcessing(true);\r\n\r\n    try {\r\n      const { data: codesData, error } = await supabase\r\n        .from('bingo_codes')\r\n        .select('*')\r\n        .eq('code', code)\r\n        .maybeSingle();\r\n\r\n      if (error || !codesData) {\r\n        setAlertConfig({\r\n          title: 'Invalid PIN',\r\n          message: 'This 5-digit PIN does not exist or was entered incorrectly.'\r\n        });\r\n        setIsProcessing(false);\r\n        return;\r\n      }\r\n\r\n      if (!doCreatorNamesMatch(codesData.creator_name, selectedTarget.name)) {\r\n        setAlertConfig({\r\n          title: 'Creator Mismatch',\r\n          message: `This PIN belongs to ${codesData.creator_name}, not ${selectedTarget.name}.`\r\n        });\r\n        setIsProcessing(false);\r\n        return;\r\n      }\r\n\r\n      if (codesData.expires_at && new Date() > new Date(codesData.expires_at)) {\r\n        setAlertConfig({ title: 'PIN Expired', message: 'This PIN has expired.' });\r\n        setIsProcessing(false);\r\n        return;\r\n      }\r\n\r\n      const timesUsed = Number(codesData.times_used || 0);\r\n      const maxUses = Number(codesData.max_uses || 999999);\r\n      if (maxUses > 0 && timesUsed >= maxUses) {\r\n        setAlertConfig({\r\n          title: 'PIN Already Claimed',\r\n          message:\r\n            maxUses === 1\r\n              ? 'This 1-Time Fan Gift PIN has already been redeemed!'\r\n              : 'This PIN has reached its maximum number of redemptions.'\r\n        });\r\n        setIsProcessing(false);\r\n        return;\r\n      }\r\n\r\n      const success = await claimSignature(\r\n        selectedTarget.name,\r\n        selectedTarget.id,\r\n        codesData.creator_name\r\n      );\r\n      if (success) {\r\n        await supabase\r\n          .from('bingo_codes')\r\n          .update({ times_used: timesUsed + 1 })\r\n          .eq('id', codesData.id);\r\n        setIsUnlocked(true);\r\n      }\r\n    } catch (err) {\r\n      console.error(err);\r\n      setAlertConfig({ title: 'Error', message: 'A network error occurred. Try again.' });\r\n    }\r\n    setPinInput('');\r\n    setIsProcessing(false);\r\n  };\r\n\r\n  const closeTargetModal = () => {\r\n    setSelectedTarget(null);\r\n    setIsUnlocked(false);\r\n    setPinInput('');\r\n  };\r\n\r\n  if (userTier === 'visitor') {\r\n    return (\r\n      <div className=\"min-h-screen bg-transparent text-white relative flex flex-col anima