    "src/Components/CreatorOnboardingModal.tsx": "import React, { useState } from 'react';\r\nimport { ShieldCheck, CheckCircle2, FileText, Lock, AlertTriangle, Sparkles, Loader2 } from 'lucide-react';\r\nimport { supabase } from '../supabase';\r\n\r\nexport const CREATOR_TERMS_VERSION = '2026.1';\r\n\r\nexport const CREATOR_TERMS_CLAUSES = [\r\n  {\r\n    number: '1',\r\n    title: 'Good-Faith Monetization, Eligibility & At-Will Termination',\r\n    body: 'Participation in the Saturday AM Creator Studio, including access to fan donations (\"Tips\"), referral bonuses, and any other revenue-sharing or monetization features, is offered by Saturday AM / MyFutprint Entertainment LLC in good faith as a discretionary privilege, not an entitlement. Being granted access to the platform or Creator Studio does not guarantee approval for monetization. Saturday AM reserves the absolute right, in its sole discretion, to deny entry into, withhold, modify, suspend, or terminate access to any monetization feature, referral program, or this agreement for any creator at any time, for any reason, with or without prior notice.'\r\n  },\r\n  {\r\n    number: '2',\r\n    title: 'Independent Contractor & Tax Responsibility',\r\n    body: 'You acknowledge that you are an independent creator and not an employee, partner, or agent of Saturday AM. You are solely and exclusively responsible for reporting, filing, and paying all applicable federal, state, local, or international income taxes, self-employment taxes, and any other duties or fees assessed on funds you receive through donations, tips, or referrals.'\r\n  },\r\n  {\r\n    number: '3',\r\n    title: 'Limitation of Liability on Payouts',\r\n    body: 'All fan donations and payouts are processed via third-party payment processors (such as Stripe). Saturday AM makes no guarantees regarding minimum earnings and shall not be held liable for delayed, failed, reversed, disputed, or chargeback transactions, payment processor holds or outages, or third-party processing fees.'\r\n  },\r\n  {\r\n    number: '4',\r\n    title: 'Intellectual Property Rights, Third-Party Claims & Platform Hosting',\r\n    body: 'Uploading or hosting your series, characters, or artwork on the Saturday AM platform does not transfer or forfeit your intellectual property ownership rights to Saturday AM / MyFutprint Entertainment LLC, unless a separate written publishing or licensing agreement has already been executed between you and Saturday AM. By participating, you represent and warrant that you are the rightful owner of (or hold all necessary rights to publish) any property associated with your account. If the rights to any uploaded property belong to another person or entity, you are solely and exclusively liable for any resulting copyright infringement, breach of contract, or legal claims, and you agree to fully indemnify and hold Saturday AM harmless from any damages, costs, or disputes. Both you and Saturday AM retain the right to remove or unpublish your series or terminate your Creator Studio access at any time without penalty or liability.'\r\n  }\r\n];\r\n\r\nexport const hasAcceptedCreatorTerms = (user: any): boolean => {\r\n  if (!user) return false;\r\n  if (user.is_admin) return true;\r\n  if (user.creator_terms_accepted_at) return true;\r\n  try {\r\n    const localTs = localStorage.getItem(`am_creator_tos_accepted_${user.id}`);\r\n    return Boolean(localTs);\r\n  } catch {\r\n    return false;\r\n  }\r\n};\r\n\r\ninterface CreatorOnboardingModalProps {\r\n  isOpen: boolean;\r\n  currentUser: any;\r\n  inviteCode?: string | null;\r\n  onSuccess: (updatedProfile: any) => void;\r\n  onCancel?: () => void;\r\n  onRequireLogin: () => void;\r\n}\r\n\r\nexport const CreatorOnboardingModal: React.FC<CreatorOnboardingModalProps> = ({\r\n  isOpen,\r\n  currentUser,\r\n  inviteCode,\r\n  onSuccess,\r\n  onCancel,\r\n  onRequireLogin\r\n}) => {\r\n  const [agreed, setAgreed] = useState(false);\r\n  const [signatureName, setSignatureName] = useState('');\r\n  const [submitting, setSubmitting] = useState(false);\r\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\r\n\r\n  if (!isOpen) return null;\r\n\r\n  const cleanCode = String(inviteCode || '').trim().toUpperCase();\r\n\r\n  const handleAcceptAndActivate = async (e: React.FormEvent) => {\r\n    e.preventDefault();\r\n    if (!currentUser?.id) {\r\n      onRequireLogin();\r\n      return;\r\n    }\r\n    if (!agreed) {\r\n      setErrorMsg('You must check the box to agree to the Creator Studio Terms & Conditions.');\r\n      return;\r\n    }\r\n    if (!signatureName.trim()) {\r\n      setErrorMsg('Please type your full legal or creator name to sign this agreement.');\r\n      return;\r\n    }\r\n\r\n    setSubmitting(true);\r\n    setErrorMsg(null);\r\n\r\n    try {\r\n      let targetCreatorName = currentUser.linked_creator_name || '';\r\n      let targetRole =\r\n        currentUser.role && currentUser.role !== 'reader' ? currentUser.role : 'creator';\r\n\r\n      // 1. If redeeming a one-time Creator Invite Code, validate & consume it\r\n      if (cleanCode) {\r\n        const { data: codeRow, error: codeErr } = await supabase\r\n          .from('promo_codes')\r\n          .select('*')\r\n          .eq('code', cleanCode)\r\n          .maybeSingle();\r\n\r\n        if (codeErr || !codeRow) {\r\n          throw new Error('This Creator Invite link/code is invalid or has been removed.');\r\n        }\r\n\r\n        const isExpired = codeRow.expires_at && new Date() > new Date(codeRow.expires_at);\r\n        const isDepleted =\r\n          codeRow.max_uses && Number(codeRow.times_used || 0) >= Number(codeRow.max_uses);\r\n\r\n        if (isExpired || isDepleted) {\r\n          throw new Error(\r\n            'This one-time Creator Invite link has already been redeemed or has expired.'\r\n          );\r\n        }\r\n\r\n        const rawTier = String(codeRow.tier || '');\r\n        if (rawTier.startsWith('creator_invite:')) {\r\n          const parts = rawTier.split(':');\r\n          targetCreatorName = parts[1] || targetCreatorName;\r\n          targetRole = parts[2] || 'creator';\r\n        }\r\n\r\n        // Mark one-time invite code as used immediately so it cannot be reused\r\n        const { error: markUsedErr } = await supabase\r\n          .from('promo_codes')\r\n          .update({\r\n            times_used: Number(codeRow.times_used || 0) + 1,\r\n            buyer_email: currentUser.email || null,\r\n            buyer_name: signatureName.trim()\r\n          })\r\n          .eq('id', codeRow.id);\r\n\r\n        if (markUsedErr) throw markUsedErr;\r\n      }\r\n\r\n      const acceptedIso = new Date().toISOString();\r\n\r\n      // 2. Upgrade user profile to PLUS + Creator Studio role\r\n      const baseUpdatePayload: Record<string, any> = {\r\n        is_premium: true,\r\n        role: targetRole,\r\n        linked_creator_name: targetCreatorName || signatureName.trim(),\r\n        super_hypes_left: 3,\r\n        hypes_remaining: 3,\r\n        updated_at: acceptedIso\r\n      };\r\n\r\n      // Try saving with creator_terms_accepted_at column first; fallback gracefully if column not added yet\r\n      const { error: fullUpdateErr } = await supabase\r\n        .from('profiles')\r\n        .update({\r\n          ...baseUpdatePayload,\r\n          creator_terms_accepted_at: acceptedIso\r\n        })\r\n        .eq('id', currentUser.id);\r\n\r\n      if (fullUpdateErr) {\r\n        const { error: fallbackErr } = await supabase\r\n          .from('profiles')\r\n          .update(baseUpdatePayload)\r\n          .eq('id', currentUser.id);\r\n        if (fallbackErr) throw fallbackErr;\r\n      }\r\n\r\n      // 3. Persist local acceptance proof & telemetry audit record\r\n      localStorage.setItem(`am_creator_tos_accepted_${currentUser.id}`, acceptedIso);\r\n      localStorage.removeItem('am_pending_creator_invite');\r\n\r\n      try {\r\n        await supabase.from('telemetry_events').insert([\r\n          {\r\n            user_id: currentUser.id,\r\n            event_type: 'creator_terms_accepted',\r\n            metadata: {\r\n              signed_name: signatureName.trim(),\r\n              linked_creator_name: targetCreatorName || signatureName.trim(),\r\n              invite_code: cleanCode || 'direct_studio_gate',\r\n              terms_version: CREATOR_TERMS_VERSION,\r\n              accepted_at: acceptedIso\r\n            }\r\n          }\r\n        ]);\r\n      } catch {\r\n        // Non-blocking audit log\r\n      }\r\n\r\n      onSuccess({\r\n        ...currentUser,\r\n        ...baseUpdatePayload,\r\n        creator_terms_accepted_at: acceptedIso\r\n      });\r\n    } catch (err: any) {\r\n      setErrorMsg(err.message || 'Failed to activate Creator Studio access.');\r\n    } finally {\r\n      setSubmitting(false);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className=\"fixed inset-0 z-[8500] bg-black/95 backdrop-blur-xl flex items-center justify-center p-4 sm:p-6 animate-fade-in\">\r\n      <div className=\"bg-zinc-950 border-2 border-[#fe9a00] rounded-3xl w-full max-w-2xl max-h-[92vh] flex flex-col shadow-[0_0_60px_rgba(254,154,0,0.25)] overflow-hidden\">\r\n        {/* Header */}\r\n        <div className=\"p-6 border-b border-zinc-800 bg-gradient-to-r from-zinc-950 via-amber-950/20 to-zinc-950 flex items-center justify-between gap-4 shrink-0\">\r\n          <div className=\"flex items-center gap-3.5\">\r\n            <div className=\"w-12 h-12 rounded-2xl bg-[#fe9a00]/15 border border-[#fe9a00]/50 flex items-center justify-center shrink-0\">\r\n              <ShieldCheck className=\"w-6 h-6 text-[#fe9a00]\" />\r\n            </div>\r\n            <div>\r\n              <div className=\"flex items-center gap-2\">\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest bg-[#fe9a00] text-black px-2 py-0.5 rounded\">\r\n                  Mandatory Creator Onboarding\r\n                </span>\r\n                {cleanCode && (\r\n                  <span className=\"text-[9px] font-mono font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded\">\r\n                    Invite: {cleanCode}\r\n                  </span>\r\n                )}\r\n              </div>\r\n              <h2 className=\"text-lg sm:text-xl font-black italic uppercase tracking-tight text-white mt-1\">\r\n                Creator Studio & Monetization Terms\r\n              </h2>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        {/* Body */}\r\n        <div className=\"p-6 overflow-y-auto space-y-5 custom-scrollbar flex-1\">\r\n          {!currentUser?.id ? (\r\n            <div className=\"bg-zinc-900 border border-[#fe9a00]/50 rounded-2xl p-6 text-center space-y-4\">\r\n              <Lock className=\"w-10 h-10 text-[#fe9a00] mx-auto\" />\r\n              <h3 className=\"text-base font-black uppercase text-white\">\r\n                Sign In or Create Your Account First\r\n              </h3>\r\n              <p className=\"text-xs text-zinc-300 font-bold leading-relaxed max-w-md mx-auto\">\r\n                Your one-time Creator Onboarding Invite (<span className=\"text-[#fe9a00] font-mono\">{cleanCode}</span>) is saved and ready! Log in or create an account to review the Creator Terms and unlock <span className=\"text-white\">Saturday AM+ PLUS</span> and <span className=\"text-white\">Creator Studio</span>.\r\n              </p>\r\n              <button\r\n                type=\"button\"\r\n                onClick={onRequireLogin}\r\n                className=\"w-full max-w-xs mx-auto py-3.5 bg-[#fe9a00] hover:bg-white text-black font-black uppercase tracking-widest text-xs rounded-xl transition-colors cursor-pointer shadow-[0_0_20px_rgba(254,154,0,0.3)] block\"\r\n              >\r\n                Log In / Sign Up to Redeem\r\n              </button>\r\n            </div>\r\n          ) : (\r\n            <form id=\"creator-onboarding-form\" onSubmit={handleAcceptAndActivate} className=\"space-y-5\">\r\n              <div className=\"bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 flex items-start gap-3\">\r\n                <Sparkles className=\"w-5 h-5 text-[#fe9a00] shrink-0 mt-0.5\" />\r\n                <p className=\"text-xs text-zinc-300 font-bold leading-relaxed\">\r\n                  Welcome to Saturday AM! Before accessing the <span className=\"text-white\">Creator Studio</span> and complimentary <span className=\"text-[#fe9a00]\">Saturday AM+ PLUS</span> privileges, please review and accept the Creator Studio & Monetization Terms of Participation below.\r\n                </p>\r\n              </div>\r\n\r\n              {/* Scrollable Legal Clauses */}\r\n              <div className=\"bg-black border border-zinc-800 rounded-2xl p-5 space-y-4 max-h-72 overflow-y-auto custom-scrollbar\">\r\n                <div className=\"flex items-center justify-between border-b border-zinc-800 pb-2.5\">\r\n                  <span className=\"text-[10px] font-black uppercase tracking-widest text-[#fe9a00] flex items-center gap-1.5\">\r\n                    <FileText className=\"w-3.5 h-3.5\" /> Terms of Participation (v{CREATOR_TERMS_VERSION})\r\n                  </span>\r\n                  <span className=\"text-[9px] font-bold text-zinc-500 uppercase tracking-widest\">\r\n                    MyFutprint Entertainment LLC / Saturday AM\r\n                  </span>\r\n                </div>\r\n\r\n                {CREATOR_TERMS_CLAUSES.map(clause => (\r\n                  <div key={clause.number} className=\"space-y-1\">\r\n                    <h4 className=\"text-xs font-black uppercase tracking-wider text-white\">\r\n                      {clause.number}. {clause.title}\r\n                    </h4>\r\n                    <p className=\"text-[11px] text-zinc-300 font-medium leading-relaxed\">\r\n                      {clause.body}\r\n                    </p>\r\n                  </div>\r\n                ))}\r\n              </div>\r\n\r\n              {/* Electronic Signature & Checkbox */}\r\n              <div className=\"bg-zinc-900/80 border border-zinc-800 rounded-2xl p-4 space-y-4\">\r\n                <div>\r\n                  <label className=\"block text-[10px] font-black uppercase tracking-widest text-zinc-400 mb-1.5\">\r\n                    Electronic Signature (Type Your Full Name) *\r\n                  </label>\r\n                  <input\r\n                    type=\"text\"\r\n                    required\r\n                    placeholder=\"e.g. Raymond Brown\"\r\n                    value={signatureName}\r\n                    onChange={e => setSignatureName(e.target.value)}\r\n                    className=\"w-full bg-black border border-zinc-700 rounded-xl px-4 py-3 text-xs font-bold text-white focus:outline-none focus:border-[#fe9a00]\"\r\n                  />\r\n                </div>\r\n\r\n                <label className=\"flex items-start gap-3 cursor-pointer select-none\">\r\n                  <input\r\n                    type=\"checkbox\"\r\n                    checked={agreed}\r\n                    onChange={e => setAgreed(e.target.checked)}\r\n                    className=\"mt-0.5 w-4 h-4 accent-[#fe9a00] rounded cursor-pointer shrink-0\"\r\n                  />\r\n                  <span className=\"text-[11px] font-bold text-zinc-200 leading-relaxed\">\r\n                    I have read, understand, and agree to the <strong className=\"text-[#fe9a00]\">Saturday AM Creator Studio & Monetization Terms of Participation</strong>, including the discretionary nature of monetization, my sole responsibility for taxes, third-party payment processor limitations, and intellectual property representations.\r\n                  </span>\r\n                </label>\r\n              </div>\r\n\r\n              {errorMsg && (\r\n                <div className=\"bg-red-950/50 border border-red-500/50 rounded-xl p-3 flex items-center gap-2.5 text-xs font-bold text-red-300\">\r\n                  <AlertTriangle className=\"w-4 h-4 text-red-400 shrink-0\" />\r\n                  <span>{errorMsg}</span>\r\n                </div>\r\n              )}\r\n            </form>\r\n          )}\r\n        </div>\r\n\r\n        {/* Footer */}\r\n        <div className=\"p-5 border-t border-zinc-800 bg-black flex flex-col sm:flex-row items-center justify-end gap-3 shrink-0\">\r\n          {onCancel && (\r\n            <button\r\n              type=\"button\"\r\n              onClick={onCancel}\r\n              className=\"w-full sm:w-auto px-5 py-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white text-[10px] font-black uppercase tracking-widest transition-colors cursor-pointer\"\r\n            >\r\n              Exit for Now\r\n            </button>\r\n          )}\r\n          {currentUser?.id && (\r\n            <button\r\n              type=\"submit\"\r\n              form=\"creator-onboarding-form\"\r\n              disabled={submitting || !agreed || !signatureName.trim()}\r\n              className=\"w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#fe9a00] hover:bg-white text-black text-xs font-black uppercase tracking-widest transition-all shadow-[0_0_25px_rgba(254,154,0,0.35)] disabled:opacity-40 flex items-center justify-center gap-2 cursor-pointer\"\r\n            >\r\n              {submitting ? (\r\n                <>\r\n                  <Loader2 className=\"w-4 h-4 animate-spin\" /> Activating Studio...\r\n                </>\r\n              ) : (\r\n                <>\r\n                  <CheckCircle2 className=\"w-4 h-4\" /> Agree & Enter Creator Studio\r\n                </>\r\n              )}\r\n            </button>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};",
    "src/MainViews/CreatorStudio.tsx": "import React, { useState, useEffect, useCallback, useMemo } from 'react';\r\nimport { supabase } from '../supabase';\r\nimport {\r\n  ArrowLeft, DollarSign, Sparkles, Flame, BookOpen, KeyRound, Copy, Check,\r\n  ExternalLink, Heart, RefreshCw, Award, Eye, QrCode, Download, X\r\n} from 'lucide-react';\r\nimport { resolveCreatorStripeAccountId, normalizeCreatorKey } from './CreatorsPage';\r\n\r\ninterface CreatorStudioProps {\r\n  currentUser: any;\r\n  onBack: () => void;\r\n  onNavigate: (data: any) => void;\r\n}\r\n\r\nconst STAFF_CREATOR_EMAILS = [\r\n  'demetrene.billups@gmail.com',\r\n  'saturdayam.writer@gmail.com',\r\n  'saturday.editorial@gmail.com'\r\n];\r\n\r\n// Direct email/username -> canonical Creator Name lookup so creators with custom handles always match\r\nconst CREATOR_IDENTITY_ALIAS_MAP: Record<string, string> = {\r\n  'rayme3000': 'Raymond Brown',\r\n  'rayme3000@gmail.com': 'Raymond Brown',\r\n  'effessart': 'Frank Simmonds',\r\n  'fsimmonds4@gmail.com': 'Frank Simmonds',\r\n  'dropkickanimation': 'Stefano Romano',\r\n  'dropkickanimation@gmail.com': 'Stefano Romano',\r\n  'saturday.editorial@gmail.com': 'Austin Harvey-Younis',\r\n  'odunze.oguguo@yahoo.com': 'Odunze Oguguo (Whyt Manga)',\r\n  'whytmanga': 'Odunze Oguguo (Whyt Manga)',\r\n  'whyt manga': 'Odunze Oguguo (Whyt Manga)',\r\n  'oscar.edfong@gmail.com': 'Oscar Fong',\r\n  'erickpedrucciandre@yahoo.com': 'Erick Pedrucci',\r\n  'jeyodin@gmail.com': 'JeyOdin',\r\n  'jeyodin': 'JeyOdin',\r\n  'publisher@saturday-am.com': 'Frederick L. Jones'\r\n};\r\n\r\n// Built-in Saturday AM catalog mapping so every creator always syncs with their series & one-shots\r\nconst CREATOR_SERIES_CATALOG_MAP: Record<string, string[]> = {\r\n  'raymond brown': ['bully eater'],\r\n  'rayme3000': ['bully eater'],\r\n  'odunze oguguo': ['apple black'],\r\n  'whyt manga': ['apple black'],\r\n  'odunze oguguo (whyt manga)': ['apple black'],\r\n  'frederick l. jones': ['clock striker', 'fan-x-boy', 'saturday wars', 'massively multiplayer world of ghosts', 'mmwog', 'yellow stringer'],\r\n  'issaka galadima': ['clock striker'],\r\n  'mike saharat srimuang': ['clock striker'],\r\n  'frank simmonds': ['fan-x-boy'],\r\n  'effessart': ['fan-x-boy'],\r\n  'kristina andabak': ['grimmheim'],\r\n  'erick pedrucci': ['gun+bone', 'gun', 'hammer'],\r\n  'fred tornager': ['gunhild'],\r\n  'jeyodin': ['hammer'],\r\n  'bon idle': ['henshin'],\r\n  'stefano romano': ['maximo'],\r\n  'pap souleye fall': ['oblivion rouge'],\r\n  'huzayfa umar': ['orisha'],\r\n  'zayf': ['orisha'],\r\n  'huzayfa umar (zayf)': ['orisha'],\r\n  'yvan soudy': ['redskin'],\r\n  'staark': ['redskin'],\r\n  'yvan soudy (staark)': ['redskin'],\r\n  'eddy frye': ['saturday wars'],\r\n  'morganne walker': ['soul beat'],\r\n  'oscar fong': ['massively multiplayer world of ghosts', 'mmwog'],\r\n  'tony dawkins': ['titan king'],\r\n  'jr de bard': ['underground'],\r\n  'goeffrey jean-louis': ['yellow stringer'],\r\n  'angélica rosales': ['yellow stringer'],\r\n  'angelica rosales': ['yellow stringer'],\r\n  'austin harvey-younis': ['zarqa'],\r\n  'vee': ['zarqa'],\r\n  'staniel russell': ['zephyr'],\r\n  'kiba fabio augusto': ['apple black'],\r\n  'stephanie williams': ['apple black']\r\n};\r\n\r\nexport const CreatorStudio: React.FC<CreatorStudioProps> = ({ currentUser, onBack, onNavigate }) => {\r\n  const [loading, setLoading] = useState(true);\r\n  const [uniqueCreatorNames, setUniqueCreatorNames] = useState<string[]>([]);\r\n  const [selectedCreatorName, setSelectedCreatorName] = useState<string>('');\r\n  const [creatorProfile, setCreatorProfile] = useState<any>(null);\r\n  const [tips, setTips] = useState<any[]>([]);\r\n  const [referredAnnualCount, setReferredAnnualCount] = useState<number>(0);\r\n  const [bingoPin, setBingoPin] = useState<string>('');\r\n  const [seriesList, setSeriesList] = useState<any[]>([]);\r\n  const [chaptersList, setChaptersList] = useState<any[]>([]);\r\n  const [chapterStatsMap, setChapterStatsMap] = useState<Record<string, { hypes: number; reacts: number }>>({});\r\n  const [copiedKey, setCopiedKey] = useState<string | null>(null);\r\n  const [generatingPin, setGeneratingPin] = useState(false);\r\n  const [showQrModal, setShowQrModal] = useState(false);\r\n\r\n  const isAdmin = Boolean(currentUser?.is_admin);\r\n  const userEmail = String(currentUser?.email || '').trim().toLowerCase();\r\n  const rawRole = String(currentUser?.role || (isAdmin ? 'staff' : 'creator')).toLowerCase();\r\n\r\n  const effectiveRole = useMemo(() => {\r\n    if (STAFF_CREATOR_EMAILS.includes(userEmail) || rawRole === 'staff') return 'staff';\r\n    if (rawRole === 'influencer') return 'influencer';\r\n    return 'creator';\r\n  }, [userEmail, rawRole]);\r\n\r\n  const commissionPerSale = effectiveRole === 'influencer' ? 2 : 5;\r\n\r\n  const copyToClipboard = (text: string, label: string) => {\r\n    navigator.clipboard.writeText(text);\r\n    setCopiedKey(label);\r\n    setTimeout(() => setCopiedKey(null), 2000);\r\n  };\r\n\r\n  useEffect(() => {\r\n    const initCreators = async () => {\r\n      const { data: creatorsData } = await supabase\r\n        .from('series_creators')\r\n        .select('*')\r\n        .order('name', { ascending: true });\r\n\r\n      const rows = creatorsData || [];\r\n\r\n      const dedupedMap = new Map<string, string>();\r\n      rows.forEach((r: any) => {\r\n        const raw = String(r.name || r.creator_name || '').trim().replace(/\\s+/g, ' ');\r\n        if (!raw) return;\r\n        const key = normalizeCreatorKey(raw);\r\n        const displayName = key === 'erick pedrucci' ? 'Erick Pedrucci' : raw;\r\n        if (!dedupedMap.has(key)) {\r\n          dedupedMap.set(key, displayName);\r\n        }\r\n      });\r\n\r\n      const uniqueNames = Array.from(dedupedMap.values()).sort((a, b) => a.localeCompare(b));\r\n      setUniqueCreatorNames(uniqueNames);\r\n\r\n      const linked = String(currentUser?.linked_creator_name || '').trim();\r\n      if (linked) {\r\n        const normLinked = normalizeCreatorKey(linked);\r\n        setSelectedCreatorName(dedupedMap.get(normLinked) || linked);\r\n        return;\r\n      }\r\n\r\n      const uEmail = String(currentUser?.email || '').trim().toLowerCase();\r\n      const userName = String(currentUser?.username || '').trim().toLowerCase();\r\n      const fullName = `${currentUser?.first_name || ''} ${currentUser?.last_name || ''}`.trim().toLowerCase();\r\n\r\n      const aliasMatch = CREATOR_IDENTITY_ALIAS_MAP[uEmail] || CREATOR_IDENTITY_ALIAS_MAP[userName];\r\n      if (aliasMatch) {\r\n        const normAlias = normalizeCreatorKey(aliasMatch);\r\n        setSelectedCreatorName(dedupedMap.get(normAlias) || aliasMatch);\r\n        return;\r\n      }\r\n\r\n      const matchedRow = rows.find((c: any) => {\r\n        const cName = String(c.name || c.creator_name || '').trim().toLowerCase();\r\n        const cEmail = String(c.email || '').trim().toLowerCase();\r\n        if (uEmail && cEmail && cEmail === uEmail) return true;\r\n        if (fullName && cName && (cName.includes(fullName) || fullName.includes(cName))) return true;\r\n        if (userName && cName && (cName.includes(userName) || userName.includes(cName))) return true;\r\n        return false;\r\n      });\r\n\r\n      if (matchedRow) {\r\n        const key = normalizeCreatorKey(matchedRow.name || matchedRow.creator_name);\r\n        setSelectedCreatorName(dedupedMap.get(key) || String(matchedRow.name || matchedRow.creator_name).trim());\r\n      } else if (currentUser?.username) {\r\n        setSelectedCreatorName(currentUser.username);\r\n      } else if (uniqueNames.length > 0) {\r\n        setSelectedCreatorName(uniqueNames[0]);\r\n      }\r\n    };\r\n\r\n    initCreators();\r\n  }, [currentUser]);\r\n\r\n  const referralSlug = useMemo(() => {\r\n    const base = selectedCreatorName || currentUser?.username || 'creator';\r\n    return base.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\r\n  }, [selectedCreatorName, currentUser?.username]);\r\n\r\n  const referralCode = useMemo(() => {\r\n    const clean = (selectedCreatorName || currentUser?.username || 'AM')\r\n      .toUpperCase()\r\n      .replace(/[^A-Z0-9]/g, '')\r\n      .slice(0, 10);\r\n    return `VIP-${clean}`;\r\n  }, [selectedCreatorName, currentUser?.username]);\r\n\r\n  const vipReferralLink = `https://www.mangahype.com/?ref=${encodeURIComponent(referralCode)}&vip=${referralSlug}`;\r\n  const qrCodeImageUrl = `https://api.qrserver.com/v1/create-qr-code/?size=500x500&margin=16&color=000000&bgcolor=fe9a00&data=${encodeURIComponent(vipReferralLink)}`;\r\n\r\n  const handleDownloadQrCode = async () => {\r\n    try {\r\n      const response = await fetch(qrCodeImageUrl);\r\n      const blob = await response.blob();\r\n      const blobUrl = URL.createObjectURL(blob);\r\n      const link = document.createElement('a');\r\n      link.href = blobUrl;\r\n      link.download = `SaturdayAM_${referralCode}_QR.png`;\r\n      document.body.appendChild(link);\r\n      link.click();\r\n      document.body.removeChild(link);\r\n      URL.revokeObjectURL(blobUrl);\r\n    } catch {\r\n      window.open(qrCodeImageUrl, '_blank');\r\n    }\r\n  };\r\n\r\n  const fetchCreatorStudioData = useCallback(async (targetName: string) => {\r\n    if (!targetName) {\r\n      setLoading(false);\r\n      return;\r\n    }\r\n    setLoading(true);\r\n    try {\r\n      const cleanName = targetName.trim();\r\n      const normKey = normalizeCreatorKey(cleanName);\r\n\r\n      const parenMatch = cleanName.match(/^(.+?)\\s*\\((.+?)\\)$/);\r\n      const nameParts = parenMatch\r\n        ? [normKey, parenMatch[1].trim().toLowerCase(), parenMatch[2].trim().toLowerCase()]\r\n        : [normKey];\r\n\r\n      const { data: allCreatorRows } = await supabase\r\n        .from('series_creators')\r\n        .select('*');\r\n\r\n      const cRows = (allCreatorRows || []).filter((r: any) => {\r\n        const rKey = normalizeCreatorKey(r.name || r.creator_name);\r\n        return nameParts.some(part => part && (rKey === part || rKey.includes(part) || part.includes(rKey)));\r\n      });\r\n\r\n      const dbStripe = cRows.find((r: any) => r.stripe_account_id)?.stripe_account_id || '';\r\n      const resolvedStripeId = resolveCreatorStripeAccountId(cleanName, dbStripe);\r\n\r\n      setCreatorProfile({\r\n        ...(cRows[0] || { name: cleanName }),\r\n        name: cleanName,\r\n        stripe_account_id: resolvedStripeId\r\n      });\r\n\r\n      const { data: allTipsData } = await supabase\r\n        .from('creator_tips')\r\n        .select('*')\r\n        .order('created_at', { ascending: false });\r\n\r\n      const myTips = (allTipsData || []).filter((t: any) => {\r\n        const tCreator = normalizeCreatorKey(t.creator_name);\r\n        return nameParts.some(part => part && tCreator && (tCreator === part || tCreator.includes(part) || part.includes(tCreator)));\r\n      });\r\n      setTips(myTips);\r\n\r\n      const cleanCodeBase = cleanName.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 10);\r\n      const vipCode = `VIP-${cleanCodeBase}`;\r\n      const { data: refSubs } = await supabase\r\n        .from('profiles')\r\n        .select('id, referred_by_code')\r\n        .eq('is_premium', true)\r\n        .not('referred_by_code', 'is', null);\r\n\r\n      const matchedRefCount = (refSubs || []).filter((r: any) => {\r\n        const codeUsed = String(r.referred_by_code || '').trim().toUpperCase();\r\n        return codeUsed === vipCode || codeUsed === cleanCodeBase;\r\n      }).length;\r\n      setReferredAnnualCount(matchedRefCount);\r\n\r\n      const { data: pinData } = await supabase\r\n        .from('bingo_codes')\r\n        .select('*')\r\n        .ilike('creator_name', `%${parenMatch ? parenMatch[1].trim() : cleanName}%`)\r\n        .order('created_at', { ascending: false })\r\n        .limit(1);\r\n\r\n      const latestPinRow = Array.isArray(pinData) && pinData.length > 0 ? pinData[0] : null;\r\n      setBingoPin(latestPinRow?.code || latestPinRow?.pin || '');\r\n\r\n      const { data: allSeries } = await supabase\r\n        .from('series')\r\n        .select('*');\r\n\r\n      const linkedSeriesSlugs = new Set<string>();\r\n      cRows.forEach((row: any) => {\r\n        if (row.series_slug) linkedSeriesSlugs.add(String(row.series_slug).trim().toLowerCase());\r\n      });\r\n\r\n      const catalogKeywords: string[] = [];\r\n      nameParts.forEach(part => {\r\n        if (CREATOR_SERIES_CATALOG_MAP[part]) {\r\n          catalogKeywords.push(...CREATOR_SERIES_CATALOG_MAP[part]);\r\n        }\r\n      });\r\n\r\n      const mySeries = (allSeries || []).filter((s: any) => {\r\n        const sSlug = String(s.slug || '').trim().toLowerCase();\r\n        const sTitle = String(s.title || '').trim().toLowerCase();\r\n        const sCreator = String(s.creator_name || s.author || '').trim().toLowerCase();\r\n\r\n        if (sSlug && linkedSeriesSlugs.has(sSlug)) return true;\r\n\r\n        if (sCreator && nameParts.some(part => part.length > 2 && sCreator.includes(part))) {\r\n          return true;\r\n        }\r\n\r\n        if (catalogKeywords.some(kw => sTitle.includes(kw) || sSlug.includes(kw.replace(/\\s+/g, '-')))) {\r\n          return true;\r\n        }\r\n\r\n        return false;\r\n      });\r\n\r\n      setSeriesList(mySeries);\r\n\r\n      if (mySeries.length > 0) {\r\n        const mySlugs = mySeries.map((s: any) => s.slug).filter(Boolean);\r\n\r\n        const { data: chData } = await supabase\r\n          .from('chapters')\r\n          .select('*')\r\n          .in('series_slug', mySlugs)\r\n          .eq('is_published', true)\r\n          .order('chapter_number', { ascending: true });\r\n\r\n        setChaptersList(chData || []);\r\n\r\n        const statsAccumulator: Record<string, { hypes: number; reacts: number }> = {};\r\n        await Promise.all(\r\n          mySlugs.map(async (slug: string) => {\r\n            try {\r\n              const { data: rpcStats } = await supabase.rpc('get_series_chapter_stats', { p_series_slug: slug });\r\n              if (Array.isArray(rpcStats)) {\r\n                rpcStats.forEach((st: any) => {\r\n                  statsAccumulator[String(st.chapter_id)] = {\r\n                    hypes: Number(st.total_hypes || 0),\r\n                    reacts: Number(st.total_reacts || 0)\r\n                  };\r\n                });\r\n              }\r\n            } catch {\r\n              // Ignore RPC errors on individual series\r\n            }\r\n          })\r\n        );\r\n        setChapterStatsMap(statsAccumulator);\r\n      } else {\r\n        setChaptersList([]);\r\n        setChapterStatsMap({});\r\n      }\r\n    } catch (err) {\r\n      console.error('Error loading Creator Studio:', err);\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (selectedCreatorName) {\r\n      fetchCreatorStudioData(selectedCreatorName);\r\n    } else {\r\n      setLoading(false);\r\n    }\r\n  }, [selectedCreatorName, fetchCreatorStudioData]);\r\n\r\n  const handleGeneratePin = async () => {\r\n    if (!selectedCreatorName) return;\r\n    setGeneratingPin(true);\r\n    try {\r\n      const newPin = Math.floor(10000 + Math.random() * 90000).toString();\r\n      const expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();\r\n\r\n      const { error } = await supabase.from('bingo_codes').insert([{\r\n        code: newPin,\r\n        creator_name: selectedCreatorName.trim(),\r\n        event_name: 'Creator Studio PIN',\r\n        max_uses: 999999,\r\n        expires_at: expiresAt\r\n      }]);\r\n\r\n      if (error) throw error;\r\n      setBingoPin(newPin);\r\n    } catch (err: any) {\r\n      alert('Could not generate PIN: ' + err.message);\r\n    } finally {\r\n      setGeneratingPin(false);\r\n    }\r\n  };\r\n\r\n  const totalTipDollars = useMemo(() => {\r\n    return tips.reduce((acc, row) => {\r\n      const amt = Number(\r\n        row.amount_dollars ?? (row.amount_cents ? row.amount_cents / 100 : row.amount || 0)\r\n      );\r\n      return acc + (isNaN(amt) ? 0 : amt);\r\n    }, 0);\r\n  }, [tips]);\r\n\r\n  const getChapterHypes = useCallback((ch: any) => {\r\n    const rpcHypes = chapterStatsMap[String(ch.id)]?.hypes || 0;\r\n    return Number(ch.hype_count || ch.total_hypes || 0) + rpcHypes;\r\n  }, [chapterStatsMap]);\r\n\r\n  const getSeriesTotalHypes = useCallback((series: any) => {\r\n    const sChapters = chaptersList.filter((c: any) => c.series_slug === series.slug);\r\n    const subHypes = sChapters.reduce((sum, ch) => sum + getChapterHypes(ch), 0);\r\n    return Number(series.hype_count || series.total_hypes || 0) + subHypes;\r\n  }, [chaptersList, getChapterHypes]);\r\n\r\n  const totalSeriesHypes = useMemo(() => {\r\n    return seriesList.reduce((acc, s) => acc + getSeriesTotalHypes(s), 0);\r\n  }, [seriesList, getSeriesTotalHypes]);\r\n\r\n  // --- ACCESS GUARD: LOCKS OUT USERS IF STUDIO ACCESS WAS REVOKED ---\r\n  const hasStudioPermission =\r\n    isAdmin ||\r\n    STAFF_CREATOR_EMAILS.includes(userEmail) ||\r\n    ['creator', 'core_creator', 'staff', 'influencer'].includes(\r\n      String(currentUser?.role || '').toLowerCase()\r\n    );\r\n\r\n  if (!hasStudioPermission) {\r\n    return (\r\n      <div className=\"min-h-screen bg-black/95 text-white flex flex-col items-center justify-center p-6 text-center animate-fade-in\">\r\n        <h2 className=\"text-2xl font-black italic uppercase tracking-tighter text-[#fe9a00] mb-2\">\r\n          Creator Studio Access Required\r\n        </h2>\r\n        <p className=\"text-xs text-zinc-400 font-bold max-w-sm mb-6 leading-relaxed\">\r\n          Your account does not currently have active Creator Studio privileges. Please use a valid Saturday AM Creator Onboarding link or contact editorial support.\r\n        </p>\r\n        <button\r\n          onClick={onBack}\r\n          className=\"px-6 py-3 bg-[#fe9a00] text-black font-black uppercase tracking-widest text-xs rounded-xl hover:bg-white transition-colors cursor-pointer\"\r\n        >\r\n          Return Home\r\n        </button>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-black/90 text-white pb-36 pt-6 px-4 sm:px-8 max-w-6xl mx-auto animate-fade-in\">\r\n      {/* Top Navigation & Role Header */}\r\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-8 border-b border-zinc-800 pr-14 sm:pr-16\">\r\n        <div className=\"flex items-center gap-4\">\r\n          <button\r\n            onClick={onBack}\r\n            className=\"p-2.5 bg-zinc-900 border border-zinc-800 rounded-xl text-zinc-400 hover:text-white hover:border-[#fe9a00] transition-colors cursor-pointer\"\r\n          >\r\n            <ArrowLeft className=\"w-5 h-5\" />\r\n          </button>\r\n          <div>\r\n            <div className=\"flex flex-wrap items-center gap-2\">\r\n              <h1 className=\"text-2xl sm:text-3xl font-black italic uppercase tracking-tighter text-white\">\r\n                Creator <span className=\"text-[#fe9a00]\">Studio</span>\r\n              </h1>\r\n              <span className={`px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-widest border ${\r\n                effectiveRole === 'staff'\r\n                  ? 'bg-[#fe9a00]/20 text-[#fe9a00] border-[#fe9a00]/50'\r\n                  : effectiveRole === 'influencer'\r\n                  ? 'bg-purple-500/20 text-purple-400 border-purple-500/40'\r\n                  : 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40'\r\n              }`}>\r\n                {effectiveRole === 'staff'\r\n                  ? 'Staff / Creator ($5 Annual Ref + 3d Trial)'\r\n                  : effectiveRole === 'influencer'\r\n                  ? 'Influencer Partner ($2 Annual Ref + 3d Trial)'\r\n                  : 'Official Creator ($5 Annual Ref + 3d Trial)'}\r\n              </span>\r\n            </div>\r\n            <p className=\"text-xs text-zinc-400 font-bold mt-1\">\r\n              Real-time series stats, 100% pass-through fan tips, autograph PINs, QR codes & annual trial referral links\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"flex items-center gap-2.5\">\r\n          {isAdmin && uniqueCreatorNames.length > 0 && (\r\n            <div className=\"flex items-center gap-2 bg-zinc-900 border border-[#fe9a00]/50 rounded-xl px-3 py-2\" title=\"Admin Peek Mode: View any creator's studio\">\r\n              <Eye className=\"w-4 h-4 text-[#fe9a00] shrink-0\" />\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-[#fe9a00] hidden sm:inline\">\r\n                Admin Peek:\r\n              </span>\r\n              <select\r\n                value={selectedCreatorName}\r\n                onChange={(e) => setSelectedCreatorName(e.target.value)}\r\n                className=\"bg-transparent text-xs font-bold text-white focus:outline-none cursor-pointer\"\r\n              >\r\n                {uniqueCreatorNames.map((cName) => (\r\n                  <option key={cName} value={cName} className=\"bg-zinc-950 text-white\">\r\n                    {cName}\r\n                  </option>\r\n                ))}\r\n              </select>\r\n            </div>\r\n          )}\r\n\r\n          <button\r\n            onClick={() => fetchCreatorStudioData(selectedCreatorName)}\r\n            className=\"p-2.5 bg-zinc-900 border border-zinc-800 rounded-xl text-zinc-400 hover:text-[#fe9a00] hover:border-[#fe9a00] transition-colors cursor-pointer\"\r\n            title=\"Refresh Stats\"\r\n          >\r\n            <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin text-[#fe9a00]' : ''}`} />\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Top KPI Cards */}\r\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">\r\n        <div className=\"bg-zinc-950/90 border border-zinc-800 rounded-2xl p-5 flex flex-col justify-between shadow-lg\">\r\n          <div className=\"flex items-center justify-between mb-3\">\r\n            <span className=\"text-[10px] font-black uppercase tracking-widest text-zinc-400\">Direct Fan Tips (100%)</span>\r\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center\">\r\n              <DollarSign className=\"w-4 h-4 text-emerald-400\" />\r\n            </div>\r\n          </div>\r\n          <div>\r\n            <div className=\"text-3xl font-black italic text-white\">${totalTipDollars.toFixed(2)}</div>\r\n            <div className=\"flex items-center justify-between mt-2\">\r\n              <span className=\"text-[10px] font-bold text-zinc-500\">{tips.length} Fan Tip{tips.length === 1 ? '' : 's'}</span>\r\n              {creatorProfile?.stripe_account_id ? (\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/30\">\r\n                  Payments: Direct\r\n                </span>\r\n              ) : (\r\n                <span className=\"text-[9px] font-black uppercase tracking-widest text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/30\">\r\n                  Payments: Saturday AM\r\n                </span>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"bg-zinc-950/90 border border-[#fe9a00]/40 rounded-2xl p-5 flex flex-col justify-between shadow-[0_0_25px_rgba(254,154,0,0.08)]\">\r\n          <div className=\"flex items-center justify-between mb-3\">\r\n            <span className=\"text-[10px] font-black uppercase tracking-widest text-[#fe9a00]\">Annual Sub Referral</span>\r\n            <div className=\"w-8 h-8 rounded-lg bg-[#fe9a00]/10 border border-[#fe9a00]/30 flex items-center justify-center\">\r\n              <Award className=\"w-4 h-4 text-[#fe9a00]\" />\r\n            </div>\r\n          </div>\r\n          <div>\r\n            <div className=\"text-3xl font-black italic text-white\">\r\n              ${commissionPerSale}.00 <span className=\"text-xs font-bold text-zinc-400 not-italic\">/ Annual Sub</span>\r\n            </div>\r\n            <p className=\"text-[10px] font-bold text-zinc-400 mt-2\">\r\n              {referredAnnualCount > 0\r\n                ? `${referredAnnualCount} Referred Subs ($${(referredAnnualCount * commissionPerSale).toFixed(2)} Earned)`\r\n                : 'Unlocks 3-Day Free Trial on Annual ($20/yr)'}\r\n            </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"bg-zinc-950/90 border border-zinc-800 rounded-2xl p-5 flex flex-col justify-between shadow-lg\">\r\n          <div className=\"flex items-center justify-between mb-3\">\r\n            <span className=\"text-[10px] font-black uppercase tracking-widest text-zinc-400\">Total Series Hypes</span>\r\n            <div className=\"w-8 h-8 rounded-lg bg-[#fe9a00]/10 border border-[#fe9a00]/30 flex items-center justify-center\">\r\n              <Flame className=\"w-4 h-4 text-[#fe9a00]\" />\r\n            </div>\r\n          </div>\r\n          <div>\r\n            <div className=\"text-3xl font-black italic text-white\">{totalSeriesHypes.toLocaleString()}</div>\r\n            <span className=\"text-[10px] font-bold text-zinc-500 mt-2 block\">\r\n              Across {seriesList.length} linked series ({chaptersList.length} chapters)\r\n            </span>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"bg-zinc-950/90 border border-zinc-800 rounded-2xl p-5 flex flex-col justify-between shadow-lg\">\r\n          <div className=\"flex items-center justify-between mb-3\">\r\n            <span className=\"text-[10px] font-black uppercase tracking-widest text-zinc-400\">Autograph Event PIN</span>\r\n            <div className=\"w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/30 flex items-center justify-center\">\r\n              <KeyRound className=\"w-4 h-4 text-purple-400\" />\r\n            </div>\r\n          </div>\r\n          <div>\r\n            <div className=\"flex items-center justify-between gap-2\">\r\n              <span className=\"text-2xl font-mono font-black tracking-widest text-[#fe9a00]\">\r\n                {bingoPin || '-----'}\r\n              </span>\r\n              <button\r\n                onClick={handleGeneratePin}\r\n                disabled={generatingPin}\r\n                className=\"px-2.5 py-1.5 bg-zinc-900 hover:bg-[#fe9a00] hover:text-black text-zinc-300 border border-zinc-700 rounded-lg text-[9px] font-black uppercase tracking-widest transition-colors cursor-pointer\"\r\n              >\r\n                {generatingPin ? '...' : bingoPin ? 'New PIN' : 'Create PIN'}\r\n              </button>\r\n            </div>\r\n            <span className=\"text-[10px] font-bold text-zinc-500 mt-2 block\">\r\n              Share with fans at cons to unlock your signature\r\n            </span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* VIP Referral Link, Code & QR Code Sharing Hub */}\r\n      <div className=\"bg-gradient-to-r from-zinc-950 via-zinc-900 to-zinc-950 border border-[#fe9a00]/50 rounded-2xl p-6 mb-8 shadow-xl\">\r\n        <div className=\"flex flex-col gap-5\">\r\n          <div className=\"space-y-1.5 w-full\">\r\n            <div className=\"inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-[#fe9a00]\">\r\n              <Sparkles className=\"w-3.5 h-3.5\" /> Annual Referral Code, QR Code & 3-Day Free Trial Bundle\r\n            </div>\r\n            <h2 className=\"text-lg sm:text-2xl font-black italic uppercase tracking-tight text-white\">\r\n              Earn ${commissionPerSale} Per Annual Subscriber + Give Fans a 3-Day Free Trial\r\n            </h2>\r\n            <p className=\"text-xs sm:text-sm text-zinc-400 font-bold leading-relaxed\">\r\n              Every fan who scans your QR code or uses your link/code on the Annual Plan ($20/yr, <span className=\"line-through text-zinc-500\">$35.99/yr</span> normal price) gets a <span className=\"text-white\">3-Day Free Trial</span> (card required), unlocks your exclusive Hype Card Skin & Bingo Book signature, and earns you <span className=\"text-[#fe9a00]\">${commissionPerSale}.00 commission</span>!\r\n            </p>\r\n          </div>\r\n\r\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full pt-3 border-t border-zinc-800/80\">\r\n            {/* Scannable QR Code Thumbnail + Expand Button */}\r\n            <div\r\n              onClick={() => setShowQrModal(true)}\r\n              className=\"bg-black border border-[#fe9a00]/60 hover:border-[#fe9a00] rounded-xl p-2.5 flex items-center gap-3 cursor-pointer group transition-all shadow-[0_0_20px_rgba(254,154,0,0.12)] sm:shrink-0\"\r\n              title=\"Click to enlarge or download QR Code\"\r\n            >\r\n              <img\r\n                src={qrCodeImageUrl}\r\n                alt={`QR Code for ${referralCode}`}\r\n                className=\"w-12 h-12 rounded-lg border border-[#fe9a00]/40 shrink-0 group-hover:scale-105 transition-transform\"\r\n              />\r\n              <div className=\"pr-2\">\r\n                <span className=\"text-[8px] font-black uppercase tracking-widest text-[#fe9a00] flex items-center gap-1\">\r\n                  <QrCode className=\"w-3 h-3\" /> Trial QR Code\r\n                </span>\r\n                <span className=\"text-[11px] font-black uppercase text-white block mt-0.5 group-hover:text-[#fe9a00] transition-colors\">\r\n                  View / Download\r\n                </span>\r\n              </div>\r\n            </div>\r\n\r\n            {/* Referral Code Box */}\r\n            <div className=\"bg-black border border-zinc-800 rounded-xl px-4 py-2.5 flex items-center justify-between gap-3 sm:shrink-0\">\r\n              <div>\r\n                <span className=\"text-[8px] font-black uppercase tracking-widest text-zinc-500 block\">Annual Referral Code</span>\r\n                <span className=\"text-sm font-mono font-black text-white\">{referralCode}</span>\r\n              </div>\r\n              <button\r\n                onClick={() => copyToClipboard(referralCode, 'code')}\r\n                className=\"p-2 bg-zinc-900 hover:bg-[#fe9a00] hover:text-black text-zinc-300 rounded-lg transition-colors cursor-pointer\"\r\n                title=\"Copy Referral Code\"\r\n              >\r\n                {copiedKey === 'code' ? <Check className=\"w-4 h-4 text-emerald-400\" /> : <Copy className=\"w-4 h-4\" />}\r\n              </button>\r\n            </div>\r\n\r\n            {/* Referral Link Box (Expands to fill remaining width on desktop) */}\r\n            <div className=\"bg-black border border-zinc-800 rounded-xl px-4 py-2.5 flex items-center justify-between gap-3 sm:flex-1 min-w-0\">\r\n              <div className=\"min-w-0 flex-1 truncate\">\r\n                <span className=\"text-[8px] font-black uppercase tracking-widest text-zinc-500 block\">Direct 3-Day Trial Link</span>\r\n                <span className=\"text-xs font-mono font-bold text-[#fe9a00] truncate block\">{vipReferralLink}</span>\r\n              </div>\r\n              <button\r\n                onClick={() => copyToClipboard(vipReferralLink, 'link')}\r\n                className=\"px-4 py-2.5 bg-[#fe9a00] hover:bg-white text-black font-black uppercase tracking-widest text-[10px] rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer shrink-0\"\r\n              >\r\n                {copiedKey === 'link' ? <><Check className=\"w-3.5 h-3.5\" /> Copied</> : <><Copy className=\"w-3.5 h-3.5\" /> Copy Link</>}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Main Grid: My Series & Chapter Stats + Fan Mail Wall */}\r\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\r\n        <div className=\"lg:col-span-2 space-y-6\">\r\n          <div className=\"bg-zinc-950 border border-zinc-800 rounded-2xl p-6\">\r\n            <div className=\"flex items-center justify-between mb-4 pb-3 border-b border-zinc-800\">\r\n              <div className=\"flex items-center gap-2.5\">\r\n                <BookOpen className=\"w-5 h-5 text-[#fe9a00]\" />\r\n                <h3 className=\"text-base font-black italic uppercase tracking-wider text-white\">\r\n                  My Series & Chapter Stats\r\n                </h3>\r\n              </div>\r\n              <span className=\"text-[10px] font-black uppercase tracking-widest text-zinc-500\">\r\n                {seriesList.length} Linked Series\r\n              </span>\r\n            </div>\r\n\r\n            {seriesList.length === 0 ? (\r\n              <div className=\"py-12 text-center text-zinc-500 font-bold text-xs\">\r\n                No series linked to \"{selectedCreatorName}\" yet.\r\n              </div>\r\n            ) : (\r\n              <div className=\"space-y-4\">\r\n                {seriesList.map((series: any) => {\r\n                  const sChapters = chaptersList.filter((c: any) => c.series_slug === series.slug);\r\n                  const displaySeriesHypes = getSeriesTotalHypes(series);\r\n\r\n                  return (\r\n                    <div key={series.id || series.slug} className=\"bg-zinc-900/70 border border-zinc-800 rounded-xl p-4\">\r\n                      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 mb-3 border-b border-zinc-800/80\">\r\n                        <div className=\"flex items-center gap-3\">\r\n                          {(series.cover_url || series.character_url) && (\r\n                            <img\r\n                              src={series.cover_url || series.character_url}\r\n                              alt={series.title}\r\n                              className=\"w-12 h-16 object-cover rounded-lg border border-zinc-700 shrink-0\"\r\n                            />\r\n                          )}\r\n                          <div>\r\n                            <h4 className=\"text-sm font-black italic uppercase text-white\">{series.title}</h4>\r\n                            <p className=\"text-[10px] font-bold text-zinc-400\">\r\n                              {sChapters.length} Published Chapter{sChapters.length === 1 ? '' : 's'} • {series.genre || 'Manga'}\r\n                            </p>\r\n                          </div>\r\n                        </div>\r\n\r\n                        <div className=\"flex items-center gap-3\">\r\n                          <div className=\"bg-black border border-zinc-800 px-3 py-1.5 rounded-lg text-center\">\r\n                            <span className=\"text-[8px] font-black uppercase tracking-widest text-zinc-500 block\">Total Hypes</span>\r\n                            <span className=\"text-xs font-black text-[#fe9a00] flex items-center justify-center gap-1\">\r\n                              <Flame className=\"w-3 h-3\" /> {displaySeriesHypes.toLocaleString()}\r\n                            </span>\r\n                          </div>\r\n                          <button\r\n                            onClick={() => onNavigate(series)}\r\n                            className=\"p-2 bg-zinc-800 hover:bg-[#fe9a00] hover:text-black text-zinc-300 rounded-lg transition-colors cursor-pointer\"\r\n                            title=\"Open Series Page\"\r\n                          >\r\n                            <ExternalLink className=\"w-4 h-4\" />\r\n                          </button>\r\n                        </div>\r\n                      </div>\r\n\r\n                      {sChapters.length > 0 && (\r\n                        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\r\n                          {sChapters.map((ch: any) => {\r\n                            const chHypes = getChapterHypes(ch);\r\n                            const chReacts = (ch.react_count || 0) + (chapterStatsMap[String(ch.id)]?.reacts || 0);\r\n                            return (\r\n                              <div\r\n                                key={ch.id}\r\n                                className=\"bg-black/60 border border-zinc-800/80 rounded-lg px-3 py-2 flex items-center justify-between text-xs\"\r\n                              >\r\n                                <span className=\"font-bold text-zinc-200 truncate\">\r\n                                  Ch. {ch.chapter_number}: {ch.title || `Chapter ${ch.chapter_number}`}\r\n                                </span>\r\n                                <div className=\"flex items-center gap-2.5 shrink-0 ml-2\">\r\n                                  <span className=\"text-[10px] font-black text-[#fe9a00] flex items-center gap-1\" title=\"Chapter Hypes\">\r\n                                    <Flame className=\"w-3 h-3\" /> {chHypes}\r\n                                  </span>\r\n                                  <span className=\"text-[10px] font-bold text-red-400 flex items-center gap-1\" title=\"Chapter Likes\">\r\n                                    <Heart className=\"w-3 h-3 fill-red-500 text-red-500\" /> {chReacts}\r\n                                  </span>\r\n                                </div>\r\n                              </div>\r\n                            );\r\n                          })}\r\n                        </div>\r\n                      )}\r\n                    </div>\r\n                  );\r\n                })}\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n\r\n        {/* Right Column: Fan Mail & Direct Tips Wall */}\r\n        <div className=\"bg-zinc-950 border border-zinc-800 rounded-2xl p-6 flex flex-col max-h-[600px]\">\r\n          <div className=\"flex items-center justify-between mb-4 pb-3 border-b border-zinc-800 shrink-0\">\r\n            <div className=\"flex items-center gap-2\">\r\n              <Heart className=\"w-5 h-5 text-[#fe9a00]\" />\r\n              <h3 className=\"text-base font-black italic uppercase tracking-wider text-white\">\r\n                Fan Mail & Tips\r\n              </h3>\r\n            </div>\r\n            <span className=\"text-[10px] font-black uppercase tracking-widest text-[#fe9a00]\">\r\n              {tips.length} Total\r\n            </span>\r\n          </div>\r\n\r\n          <div className=\"flex-1 overflow-y-auto no-scrollbar space-y-3\">\r\n            {tips.length === 0 ? (\r\n              <div className=\"py-12 text-center text-zinc-500 font-bold text-xs\">\r\n                When fans send you a tip or fan mail on your series page, their messages and support amounts will appear right here!\r\n              </div>\r\n            ) : (\r\n              tips.map((t: any, idx: number) => {\r\n                const amount = Number(\r\n                  t.amount_dollars ?? (t.amount_cents ? t.amount_cents / 100 : t.amount || 0)\r\n                );\r\n                const fanDisplayName = t.donor_name || t.fan_username || t.sender_name || 'Saturday AM Fan';\r\n                const fanMessageText = t.fan_message || t.message || '';\r\n\r\n                return (\r\n                  <div key={t.id || idx} className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-3.5 space-y-1.5\">\r\n                    <div className=\"flex items-center justify-between\">\r\n                      <span className=\"text-xs font-black text-white\">\r\n                        {fanDisplayName}\r\n                      </span>\r\n                      <span className=\"text-xs font-black text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-2 py-0.5 rounded-full\">\r\n                        +${amount.toFixed(2)}\r\n                      </span>\r\n                    </div>\r\n                    {fanMessageText && (\r\n                      <p className=\"text-xs text-zinc-300 font-medium leading-relaxed bg-black/50 p-2.5 rounded-lg border border-zinc-800/80\">\r\n                        \"{fanMessageText}\"\r\n                      </p>\r\n                    )}\r\n                    <span className=\"text-[9px] font-mono text-zinc-500 block\">\r\n                      {t.created_at ? new Date(t.created_at).toLocaleDateString() : ''}\r\n                    </span>\r\n                  </div>\r\n                );\r\n              })\r\n            )}\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Full-Screen Convention & Stream QR Code Modal */}\r\n      {showQrModal && (\r\n        <div\r\n          className=\"fixed inset-0 z-[7000] bg-black/90 backdrop-blur-xl flex items-center justify-center p-4 animate-fade-in\"\r\n          onClick={() => setShowQrModal(false)}\r\n        >\r\n          <div\r\n            className=\"bg-zinc-950 border-2 border-[#fe9a00] rounded-3xl p-6 sm:p-8 max-w-sm w-full flex flex-col items-center text-center shadow-[0_0_50px_rgba(254,154,0,0.25)] relative\"\r\n            onClick={(e) => e.stopPropagation()}\r\n          >\r\n            <button\r\n              onClick={() => setShowQrModal(false)}\r\n              className=\"absolute top-4 right-4 text-zinc-400 hover:text-white transition-colors cursor-pointer\"\r\n            >\r\n              <X className=\"w-6 h-6\" />\r\n            </button>\r\n\r\n            <div className=\"inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest text-[#fe9a00] mb-2\">\r\n              <QrCode className=\"w-4 h-4\" /> Official Partner QR Code\r\n            </div>\r\n            <h3 className=\"text-xl font-black italic uppercase text-white mb-1\">\r\n              {selectedCreatorName || currentUser?.username || 'Saturday AM Partner'}\r\n            </h3>\r\n            <p className=\"text-[11px] font-bold text-zinc-400 mb-5\">\r\n              Scan to unlock a <span className=\"text-[#fe9a00]\">3-Day Free Trial</span> on the Saturday AM+ Annual Plan!\r\n            </p>\r\n\r\n            <div className=\"bg-[#fe9a00] p-3 rounded-2xl shadow-[0_0_30px_rgba(254,154,0,0.4)] mb-5\">\r\n              <img\r\n                src={qrCodeImageUrl}\r\n                alt={`QR Code for ${referralCode}`}\r\n                className=\"w-56 h-56 rounded-xl object-contain\"\r\n              />\r\n            </div>\r\n\r\n            <div className=\"bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2 mb-5 w-full\">\r\n              <span className=\"text-[9px] font-black uppercase tracking-widest text-zinc-500 block\">\r\n                Referral Code\r\n              </span>\r\n              <span className=\"text-lg font-mono font-black text-[#fe9a00] tracking-widest\">\r\n                {referralCode}\r\n              </span>\r\n            </div>\r\n\r\n            <div className=\"flex gap-3 w-full\">\r\n              <button\r\n                onClick={handleDownloadQrCode}\r\n                className=\"flex-1 py-3.5 bg-[#fe9a00] hover:bg-white text-black font-black uppercase tracking-widest text-[10px] rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer\"\r\n              >\r\n                <Download className=\"w-4 h-4\" /> Download PNG\r\n              </button>\r\n              <button\r\n                onClick={() => copyToClipboard(vipReferralLink, 'qr-link')}\r\n                className=\"flex-1 py-3.5 bg-zinc-800 hover:bg-zinc-700 text-white font-black uppercase tracking-widest text-[10px] rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer\"\r\n              >\r\n                {copiedKey === 'qr-link' ? <Check className=\"w-4 h-4 text-emerald-400\" /> : <Copy className=\"w-4 h-4\" />}\r\n                {copiedKey === 'qr-link' ? 'Copied' : 'Copy Link'}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};",
    "src/VirtualProfile/BingoBook.tsx": "import { useState, useEffect, useMemo } from 'react';\r\nimport { ArrowLeft, Target, Lock, X, Sparkles, KeyRound, User } from 'lucide-react';\r\nimport { useSeriesData } from '../userSeriesData';\r\nimport { supabase } from '../supabase';\r\nimport { FeatureTutorialModal, TutorialHelpButton } from '../Components/FeatureTutorialModal';\r\n\r\nconst bingoTutorialSlide = [\r\n  {\r\n    id: 'bingo-1',\r\n    title: 'The Bingo Book',\r\n    description: 'Hunt down Saturday AM creators at live conventions or virtual events to collect their exclusive digital signatures.',\r\n    mediaUrl: 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/Tutorial%20Images/S1%20bingo%20book%20page.png'\r\n  },\r\n  {\r\n    id: 'bingo-2',\r\n    title: 'Unlock Autographs',\r\n    description: 'Unlock an autograph using a creator\\'s secret 5-digit PIN. Each collected signature earns you a massive boost to your Fandom Score!',\r\n    mediaUrl: 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/Tutorial%20Images/S2%20autographs.png'\r\n  },\r\n  {\r\n    id: 'bingo-3',\r\n    title: 'Premium Display',\r\n    description: 'Once unlocked, the creator\\'s premium signature will be permanently displayed in glowing gold foil on all of their series pages.',\r\n    mediaUrl: 'https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/Tutorial%20Images/S3%20seriespage.png'\r\n  }\r\n];\r\n\r\nconst BingoBook = ({ onBack, userTier, onNavigate }: any) => {\r\n  const { seriesList = [] } = useSeriesData();\r\n  const [forceTutorial, setForceTutorial] = useState(false);\r\n\r\n  const CREATOR_TARGETS = useMemo(() => {\r\n    const uniqueCreatorsMap = new Map();\r\n\r\n    const processName = (nameInput: any, defaultAvatar: any, sTitle: string) => {\r\n      if (!nameInput) return;\r\n      const namesArray = Array.isArray(nameInput) ? nameInput.flat(Infinity) : [nameInput];\r\n\r\n      namesArray.forEach((nameObj: any) => {\r\n        let nameStr = nameObj;\r\n        let avatarToUse = defaultAvatar;\r\n\r\n        if (typeof nameObj === 'object' && nameObj !== null) {\r\n          if (nameObj.is_visible === false) return; \r\n          nameStr = nameObj.name || nameObj.fullName || nameObj.value || nameObj.text || Object.values(nameObj)[0];\r\n          avatarToUse = nameObj.avatar_url || nameObj.avatar || defaultAvatar; \r\n        }\r\n\r\n        if (typeof nameStr !== 'string') return;\r\n        nameStr = nameStr.replace(/^(written by|art by|created by|story by|illustrated by)[:\\s]+/i, '');\r\n        const splitNames = nameStr.split(/,|\\s+&\\s+|\\s+and\\s+|\\s*\\/\\s*/i);\r\n\r\n        splitNames.forEach(rawName => {\r\n          const cName = rawName.trim();\r\n          if (cName.length < 2) return; \r\n\r\n          const mapKey = cName.toLowerCase();\r\n          if (!uniqueCreatorsMap.has(mapKey)) {\r\n            uniqueCreatorsMap.set(mapKey, {\r\n              name: cName, \r\n              avatar: avatarToUse || `https://ui-avatars.com/api/?name=${encodeURIComponent(cName)}&background=18181b&color=fe9a00&bold=true`,\r\n              series: sTitle ? [sTitle] : []\r\n            });\r\n          } else if (sTitle) {\r\n            const existingProfile = uniqueCreatorsMap.get(mapKey);\r\n            if (!existingProfile.series.includes(sTitle)) existingProfile.series.push(sTitle);\r\n            if (avatarToUse && existingProfile.avatar.includes('ui-avatars')) existingProfile.avatar = avatarToUse;\r\n          }\r\n        });\r\n      });\r\n    };\r\n\r\n    seriesList.forEach((series: any) => {\r\n      const sTitle = series.title || series.name;\r\n      if (series.creators && Array.isArray(series.creators) && series.creators.length > 0) {\r\n        processName(series.creators, null, sTitle);\r\n      } else {\r\n        processName(series.creator_name || series.creator, series.creator_avatar || series.creator_image, sTitle);\r\n        processName(series.writer_name || series.writer || series.author_name, series.writer_avatar || series.writer_image, sTitle);\r\n        processName(series.artist_name || series.artist || series.illustrator, series.artist_avatar || series.artist_image, sTitle);\r\n        processName(series.co_creator_name || series.co_creator, series.co_creator_avatar || series.co_creator_image, sTitle);\r\n      }\r\n    });\r\n\r\n    return Array.from(uniqueCreatorsMap.values())\r\n      .sort((a: any, b: any) => a.name.localeCompare(b.name))\r\n      .map((creator: any) => ({ id: creator.name, ...creator })); \r\n  }, [seriesList]);\r\n\r\n  const [unlockedCreators, setUnlockedCreators] = useState<string[]>([]);\r\n  const [selectedTarget, setSelectedTarget] = useState<any | null>(null);\r\n  const [signatures, setSignatures] = useState<Record<string, string>>({});\r\n  const [viewingAutograph, setViewingAutograph] = useState<string | null>(null);\r\n  \r\n  const [pinInput, setPinInput] = useState('');\r\n  const [isUnlocked, setIsUnlocked] = useState(false);\r\n  const [alertConfig, setAlertConfig] = useState<{ title: string, message: string } | null>(null);\r\n  const [upsellConfig, setUpsellConfig] = useState<{ title: string, message: string } | null>(null);\r\n  const [isProcessing, setIsProcessing] = useState(false);\r\n\r\n  const progressPercentage = CREATOR_TARGETS.length > 0 ? (unlockedCreators.length / CREATOR_TARGETS.length) * 100 : 0;\r\n  \r\n  useEffect(() => {\r\n    if (CREATOR_TARGETS.length > 0) {\r\n      localStorage.setItem('am_bingo_total', CREATOR_TARGETS.length.toString());\r\n    }\r\n  }, [CREATOR_TARGETS]);\r\n\r\n  useEffect(() => {\r\n    if (userTier === 'visitor') return; // Skip DB fetch if visitor\r\n\r\n    const syncSignatures = async () => {\r\n      const { data: { user } } = await supabase.auth.getUser();\r\n      \r\n      let knownHunts = JSON.parse(localStorage.getItem('am_bingo_hunts') || '[]');\r\n      let knownSigs = JSON.parse(localStorage.getItem('am_bingo_sigs') || '{}');\r\n\r\n      if (user) {\r\n        const { data: logs, error } = await supabase\r\n          .from('bingo_signatures_log')\r\n          .select('creator_name')\r\n          .eq('user_id', user.id);\r\n\r\n        if (!error && logs) {\r\n          const dbHunts = logs.map((log: any) => log.creator_name);\r\n          \r\n          const unsavedLocalHunts = knownHunts.filter((name: string) => !dbHunts.includes(name));\r\n          \r\n          if (unsavedLocalHunts.length > 0) {\r\n            const backups = unsavedLocalHunts.map((name: string) => ({\r\n              user_id: user.id,\r\n              creator_name: name,\r\n              event_name: 'Local Cache Auto-Sync',\r\n              signature_type: 'Standard'\r\n            }));\r\n            await supabase.from('bingo_signatures_log').insert(backups);\r\n          }\r\n\r\n          knownHunts = Array.from(new Set([...knownHunts, ...dbHunts]));\r\n          localStorage.setItem('am_bingo_hunts', JSON.stringify(knownHunts));\r\n        }\r\n      }\r\n      \r\n      setUnlockedCreators(knownHunts);\r\n      \r\n      if (knownHunts.length > 0) {\r\n        const { data } = await supabase\r\n          .from('creator_signatures')\r\n          .select('creator_name, signature_url')\r\n          .in('creator_name', knownHunts);\r\n          \r\n        if (data && data.length > 0) {\r\n          const freshSigs: Record<string, string> = { ...knownSigs };\r\n          data.forEach((row: any) => { freshSigs[row.creator_name] = row.signature_url; });\r\n          setSignatures(freshSigs);\r\n          localStorage.setItem('am_bingo_sigs', JSON.stringify(freshSigs));\r\n        } else {\r\n          setSignatures(knownSigs);\r\n        }\r\n      } else {\r\n        setSignatures(knownSigs);\r\n      }\r\n    };\r\n    \r\n    syncSignatures();\r\n  }, [userTier]);\r\n\r\n  const claimSignature = async (creatorName: string, creatorId: string) => {\r\n    const { data: sigData } = await supabase.from('creator_signatures').select('signature_url').eq('creator_name', creatorName).maybeSingle();\r\n    \r\n    if (!sigData || !sigData.signature_url) {\r\n      setAlertConfig({ title: \"No Signature Found\", message: `${creatorName} hasn't uploaded their master signature/sketch to the vault yet!` });\r\n      return false;\r\n    }\r\n\r\n    const { data: { user } } = await supabase.auth.getUser();\r\n    if (user) {\r\n      await supabase.from('bingo_signatures_log').insert([{\r\n        user_id: user.id,\r\n        creator_name: creatorName,\r\n        event_name: 'Bingo Code Redemption',\r\n        signature_type: 'Standard'\r\n      }]);\r\n    }\r\n\r\n    const newSigs = { ...signatures, [creatorId]: sigData.signature_url };\r\n    setSignatures(newSigs);\r\n    localStorage.setItem('am_bingo_sigs', JSON.stringify(newSigs));\r\n\r\n    if (!unlockedCreators.includes(creatorId)) {\r\n      const newHunts = [...unlockedCreators, creatorId];\r\n      setUnlockedCreators(newHunts);\r\n      localStorage.setItem('am_bingo_hunts', JSON.stringify(newHunts));\r\n    }\r\n    \r\n    return true;\r\n  };\r\n\r\n  const handlePinSubmit = async (e: React.FormEvent) => {\r\n    e.preventDefault();\r\n    const code = pinInput.trim();\r\n    if (!code) return;\r\n    setIsProcessing(true);\r\n\r\n    try {\r\n      const { data: codesData, error } = await supabase.from('bingo_codes').select('*').eq('code', code).maybeSingle();\r\n      \r\n      if (error || !codesData) {\r\n        setAlertConfig({ title: \"Invalid PIN\", message: \"This 5-digit PIN does not exist or was entered incorrectly.\" });\r\n        setIsProcessing(false);\r\n        return;\r\n      }\r\n\r\n      if (codesData.creator_name !== selectedTarget.name) {\r\n        setAlertConfig({ title: \"Creator Mismatch\", message: `This PIN belongs to ${codesData.creator_name}, not ${selectedTarget.name}.` });\r\n        setIsProcessing(false);\r\n        return;\r\n      }\r\n\r\n      if (new Date() > new Date(codesData.expires_at)) {\r\n        setAlertConfig({ title: \"PIN Expired\", message: \"This PIN has expired.\" });\r\n        setIsProcessing(false);\r\n        return;\r\n      }\r\n\r\n      const success = await claimSignature(selectedTarget.name, selectedTarget.id);\r\n      if (success) {\r\n        await supabase.from('bingo_codes').update({ times_used: codesData.times_used + 1 }).eq('id', codesData.id);\r\n        setIsUnlocked(true);\r\n      }\r\n    } catch (err) {\r\n      console.error(err);\r\n      setAlertConfig({ title: \"Error\", message: \"A network error occurred. Try again.\" });\r\n    }\r\n    setPinInput('');\r\n    setIsProcessing(false);\r\n  };\r\n\r\n  const closeTargetModal = () => {\r\n    setSelectedTarget(null);\r\n    setIsUnlocked(false);\r\n    setPinInput('');\r\n  };\r\n\r\n  // --- NEW: VISITOR LOCKOUT SCREEN ---\r\n  if (userTier === 'visitor') {\r\n    return (\r\n      <div className=\"min-h-screen bg-transparent text-white relative flex flex-col animate-fade-in\">\r\n        <div className=\"fixed inset-0 z-[-1] bg-black\">\r\n          <img src=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20Backdrop%20narrow.png\" alt=\"Manga Collage\" className=\"w-full h-full object-cover md:hidden\" />\r\n          <img src=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20Backdrop%20wide.png\" alt=\"Manga Collage\" className=\"hidden md:block w-full h-full object-cover\" />\r\n          <div className=\"absolute inset-x-0 top-0 h-48 sm:h-64 bg-gradient-to-b from-black via-black/50 to-transparent pointer-events-none\" />\r\n          <div className=\"absolute inset-x-0 bottom-0 h-48 sm:h-64 bg-gradient-to-t from-black via-black/80 to-transparent pointer-events-none\" />\r\n        </div>\r\n        \r\n        <div className=\"absolute top-6 left-6 z-40\">\r\n          <button onClick={onBack} className=\"p-3 bg-zinc-900 hover:bg-zinc-800 rounded-full transition-colors shadow-lg\">\r\n            <ArrowLeft className=\"w-5 h-5 text-white\" />\r\n          </button>\r\n        </div>\r\n        \r\n        <div className=\"flex-1 flex flex-col items-center justify-center p-6 text-center\">\r\n          <div className=\"w-24 h-24 bg-zinc-900 rounded-full flex items-center justify-center mb-6 border border-zinc-800 shadow-[0_0_30px_rgba(254,154,0,0.2)]\">\r\n            <User className=\"w-10 h-10 text-[#fe9a00]\" />\r\n          </div>\r\n          <h1 className=\"text-3xl md:text-4xl font-black uppercase italic tracking-widest text-white mb-4\">\r\n            Bingo <span className=\"text-red-600\">Book</span>\r\n          </h1>\r\n          <p className=\"text-zinc-400 font-bold max-w-md mb-8 leading-relaxed bg-black/40 p-4 rounded-xl backdrop-blur-sm border border-zinc-800\">\r\n            The Bingo Book hunt requires a free profile so we can securely save your digital autographs to the cloud! Create an account today to start collecting.\r\n          </p>\r\n          <button \r\n            onClick={() => onNavigate({ action: 'settings' })} \r\n            className=\"bg-[#fe9a00] text-black px-8 py-4 rounded-full font-black uppercase tracking-widest hover:bg-white hover:scale-105 transition-all shadow-[0_0_20px_rgba(254,154,0,0.4)]\"\r\n          >\r\n            Create Free Account\r\n          </button>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-transparent text-white pb-24 animate-fade-in relative\">\r\n      <FeatureTutorialModal \r\n        tutorialId=\"bingo_book_page\" \r\n        slides={bingoTutorialSlide} \r\n        forceOpen={forceTutorial}\r\n        onClose={() => setForceTutorial(false)}\r\n      />\r\n\r\n      <div className=\"fixed inset-0 z-[-1] bg-black\">\r\n        <img src=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20Backdrop%20narrow.png\" alt=\"Manga Collage\" className=\"w-full h-full object-cover md:hidden\" />\r\n        <img src=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/AM%20App%20Backdrop%20wide.png\" alt=\"Manga Collage\" className=\"hidden md:block w-full h-full object-cover\" />\r\n        <div className=\"absolute inset-x-0 top-0 h-48 sm:h-64 bg-gradient-to-b from-black via-black/50 to-transparent pointer-events-none\" />\r\n        <div className=\"absolute inset-x-0 bottom-0 h-48 sm:h-64 bg-gradient-to-t from-black via-black/80 to-transparent pointer-events-none\" />\r\n      </div>\r\n\r\n      <div className=\"sticky top-0 z-40 bg-black/95 backdrop-blur-xl border-b border-zinc-900 p-6 flex items-center justify-between pr-16 sm:pr-20\">\r\n        <div className=\"flex items-center gap-4\">\r\n          <button onClick={onBack} className=\"p-3 bg-zinc-900 hover:bg-zinc-800 rounded-full transition-colors shadow-lg\"><ArrowLeft className=\"w-5 h-5 text-white\" /></button>\r\n          <div className=\"flex items-center gap-3\">\r\n            <img src=\"https://pub-180171f859f64aa7aadb7001a6b96e65.r2.dev/homepage-graphic-assets/logos/saturdayam%20LOGO%20cleaned%20ToBeVectored%20foot.png\" alt=\"Saturday AM\" className=\"h-8 md:h-10 object-contain drop-shadow-md\" />\r\n            <h1 className=\"text-xl md:text-2xl font-black uppercase italic tracking-widest text-white flex items-center gap-2\">\r\n              Bingo <span className=\"text-red-600\">Book</span>\r\n            </h1>\r\n            <div className=\"ml-1 md:ml-3\">\r\n              <TutorialHelpButton onClick={() => setForceTutorial(true)} />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"max-w-4xl mx-auto px-4 py-8\">\r\n        <div className=\"mb-8 bg-gradient-to-r from-zinc-900/90 to-black/90 backdrop-blur-sm border-2 border-[#fe9a00]/60 rounded-2xl p-6 md:p-8 shadow-[0_0_40px_rgba(254,154,0,0.35)] relative overflow-hidden\">\r\n          <div className=\"absolute top-0 left-0 w-2 h-full bg-[#fe9a00] shadow-[0_0_20px_rgba(254,154,0,0.8)]\"></div>\r\n          <h2 className=\"text-[#fe9a00] text-lg md:text-xl font-black uppercase tracking-[0.2em] mb-3 flex items-center gap-3 drop-shadow-[0_2px_10px_rgba(254,154,0,0.5)]\"><Target className=\"w-6 h-6 md:w-7 md:h-7\" /> The Mission</h2>\r\n          <p className=\"text-white text-base md:text-lg font-bold leading-relaxed tracking-wide\">Find these creators at live shows or collect their digital signatures online!</p>\r\n        </div>\r\n\r\n        <div className=\"bg-zinc-900/80 backdrop-blur-sm border border-zinc-800 rounded-2xl p-6 mb-10 shadow-lg\">\r\n          <div className=\"flex justify-between items-end mb-2\">\r\n            <h2 className=\"text-xs font-black uppercase tracking-[0.2em] text-zinc-400\">Hunt Progress</h2>\r\n            <span className=\"text-xl font-black italic text-[#fe9a00]\">{unlockedCreators.length} / {CREATOR_TARGETS.length}</span>\r\n          </div>\r\n          <div className=\"w-full h-3 bg-black rounded-full overflow-hidden border border-zinc-800\">\r\n            <div className=\"h-full bg-gradient-to-r from-[#fe9a00] to-red-600 transition-all duration-1000 ease-out\" style={{ width: `${progressPercentage}%` }} />\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\r\n          {CREATOR_TARGETS.map((target) => {\r\n            const isCaught = unlockedCreators.includes(target.id);\r\n            return (\r\n              <button \r\n                key={target.id}\r\n                onClick={() => {\r\n                  if (!isCaught && userTier !== 'premium' && unlockedCreators.length >= 1) {\r\n                    setUpsellConfig({\r\n                      title: 'Premium Feature',\r\n                      message: 'Free members can only collect 1 digital autograph! Upgrade to Pro to complete your Bingo Book and get a massive boost to your Fandom Sc